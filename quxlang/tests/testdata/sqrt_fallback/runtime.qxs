LANGUAGE QUXLANG EN 0.0;

::SQRT DOC <$ Returns the operand unchanged to identify runtime dispatch in the square-root integration fixture. $>
  TEMPLATE(@BITS:bits VALUE SZ, @EXPONENT:exponent VALUE SZ)
  ENABLE_IF(bits == 24 && exponent == 7)
  FUNCTION(@ARG F24E7): F24E7
{
  RETURN ARG;
}

