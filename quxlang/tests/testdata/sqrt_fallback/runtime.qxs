::SQRT DOC <$ Deliberately violates the runtime result contract. $>
  TEMPLATE(@BITS:bits VALUE SZ, @EXPONENT:exponent VALUE SZ)
  ENABLE_IF(bits == 40 && exponent == 9)
  FUNCTION(@ARG F40E9): I32
{
  RETURN 0;
}
