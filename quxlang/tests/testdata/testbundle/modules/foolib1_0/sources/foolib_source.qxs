LANGUAGE QUXLANG EN 0.0;


::imported_function FUNCTION(): I32
{
    RETURN 42;
}


DOC <$ Accepts any explicitly supplied type without inspecting its declaration. $>
::accept_type
  TEMPLATE(@T TYPE AUTO) FUNCTION(): BOOL
{
  RETURN SAME_TYPES(T, T);
}


DOC <$ Accepts a value whose type is deduced by the function template. $>
::accept_deduced_type
  FUNCTION(@ARG:value AUTO& AUTO(t)): BOOL
{
  RETURN SAME_TYPES(t, t);
}
