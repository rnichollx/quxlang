LANGUAGE QUXLANG EN 0.0;

DOC <$ Provides observable module identity through renamed imports. $>
::import_identity
NAMESPACE
{
  IMPORT std;
  IMPORT std AS renamed_std;
  ::named_std IMPORT std;
  IMPORT_IF(TRUE) std AS conditional_std;
  ::exported_std ALIAS std;
  ::exported_string ALIAS named_std::string;

  DOC <$ Module-private imports remain usable within their declaring module. $>
  ::internal_import_access
    FUNCTION(): BOOL
  {
    RETURN SAME_TYPES(std::string, renamed_std::string) && SAME_TYPES(named_std::string, conditional_std::string);
  }

  DOC <$ Stores one mutable value shared by every import name for this module. $>
  ::value
    VAR CONSTEXPR_OK I32 := 17;
  DOC <$ Returns the module-owned value through a public function. $>
  ::read
    FUNCTION(): I32 { RETURN value; }
}
