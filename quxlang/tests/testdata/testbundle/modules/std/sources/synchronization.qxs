LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;
IMPORT posix;


PRIVATE(MODULE)
{
  ::wait_while_atomic_equals INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS) DOC <$
    Blocks while state still contains expected and may return spuriously.
    $>
    FUNCTION(@state MUT->ATOMIC#I32, @expected I32)
  {
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wait(@address IBC_GETADDR(@PTR state), @expected expected);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wait_on_address(
        @address IBC_GETADDR(@PTR state),
        @compare_address expected<-,
        @address_size SIZEOF(I32),
        @milliseconds (0 AS U32) #!!
      );
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      RUNTIME_MODULE::wait_at_u32_address(
        @address IBC_GETADDR(@PTR state), @expected expected AS PARTIAL U32);
    }
  }

  ::wake_one_atomic_waiter INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS) DOC <$
    Wakes at most one thread sleeping on state.
    $>
    FUNCTION(@state MUT->ATOMIC#I32)
  {
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wake(@address IBC_GETADDR(@PTR state), @count 1);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wake_by_address_single(@address IBC_GETADDR(@PTR state));
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      RUNTIME_MODULE::notify_one_at_address(
        @address IBC_GETADDR(@PTR state), @size SIZEOF(I32));
    }
  }
  ::wake_all_atomic_waiters INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS) DOC <$
    Wakes every thread sleeping on state.
    $>
    FUNCTION(@state MUT->ATOMIC#I32)
  {
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wake(@address IBC_GETADDR(@PTR state), @count 2147483647);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wake_by_address_all(@address IBC_GETADDR(@PTR state));
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      RUNTIME_MODULE::notify_all_at_address(
        @address IBC_GETADDR(@PTR state), @size SIZEOF(I32));
    }
  }
}
::thin_mutex DOC <$
  A compact non-recursive mutex optimized to minimize object size.
  $>
  STRUCT ROOTED
{
  PRIVATE(MODULE)
  {
    .atomic_state INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS) VAR ATOMIC#I32;
  }

  .CONSTRUCTOR DOC <$ Creates an unlocked thin mutex. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    {
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .DESTRUCTOR DOC <$ Destroys a thin mutex after all users leave. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    {
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .lock DOC <$ Blocks until the current thread acquires this thin mutex. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX || OS_WINDOWS)
    {
      VAR expected I32 := 0;
      IF (.atomic_state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(@EXPECTED expected, @DESIRED 1))
      {
        RETURN;
      }

      LOOP WHILE(TRUE) DO
      {
        VAR expected_uncontended I32 := 1;
        .atomic_state.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(@EXPECTED expected_uncontended, @DESIRED 2);

        VAR observed I32 := .atomic_state.LOAD#ATOMIC_ACQUIRE();
        IF (observed == 0)
        {
          VAR expected_unlocked I32 := 0;
          IF (.atomic_state.COMPARE_EXCHANGE#(
            @SUCCESS ATOMIC_ACQREL,
            @FAILURE ATOMIC_ACQUIRE
          )(@EXPECTED expected_unlocked, @DESIRED 2))
          {
            RETURN;
          }
        }
        ELSE IF (observed == 2)
        {
          wait_while_atomic_equals(@state .atomic_state<-, @expected 2);
        }
      };
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      syscall::os_unfair_lock_lock(@native_mutex .atomic_state<-);
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .try_lock DOC <$ Attempts to acquire this thin mutex without blocking. $>
    FUNCTION(): BOOL
  {
    STATIC_IF(OS_LINUX || OS_WINDOWS)
    {
      VAR expected I32 := 0;
      RETURN .atomic_state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(@EXPECTED expected, @DESIRED 1);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      RETURN syscall::os_unfair_lock_trylock(@native_mutex .atomic_state<-);
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .unlock DOC <$ Releases this thin mutex owned by the current thread. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX || OS_WINDOWS)
    {
      VAR expected_uncontended I32 := 1;
      IF (.atomic_state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(@EXPECTED expected_uncontended, @DESIRED 0))
      {
        RETURN;
      }

      ASSERT(expected_uncontended == 2, "Cannot unlock an unlocked mutex.");
      .atomic_state.STORE#ATOMIC_RELEASE(0);
      wake_one_atomic_waiter(@state .atomic_state<-);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      syscall::os_unfair_lock_unlock(@native_mutex .atomic_state<-);
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }
}

::ordering_mutex DOC <$
  A non-recursive mutex optimized for traditional throughput-oriented locking.
  $>
  STRUCT ROOTED
{
  PRIVATE(MODULE)
  {
    .thin INCLUDE_IF(OS_LINUX && ENVIRONMENT_IS_STATIC) VAR thin_mutex;
    .glibc_native INCLUDE_IF(ENVIRONMENT_IS_GLIBC) VAR posix::native_mutex_storage;
    .windows_native INCLUDE_IF(OS_WINDOWS) VAR syscall::windows::native_mutex_storage;
    .macos_native INCLUDE_IF(OS_MACOS) VAR posix::native_mutex_storage;
  }

  .CONSTRUCTOR DOC <$ Creates an unlocked ordering mutex. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX && ENVIRONMENT_IS_STATIC)
    {
    }
    STATIC_ELSE STATIC_IF(ENVIRONMENT_IS_GLIBC)
    {
      VAR attributes CONST->VOID;
      VAR result I32 := posix::pthread_mutex_init(
        @native_mutex .glibc_native<-,
        @attributes attributes
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_init failed.";
      }
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::initialize_critical_section(@native_mutex .windows_native<-);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      VAR attributes CONST->VOID;
      VAR result I32 := posix::pthread_mutex_init(
        @native_mutex .macos_native<-,
        @attributes attributes
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_init failed.";
      }
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .DESTRUCTOR DOC <$ Releases an ordering mutex after all users leave. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX && ENVIRONMENT_IS_STATIC)
    {
    }
    STATIC_ELSE STATIC_IF(ENVIRONMENT_IS_GLIBC)
    {
      VAR result I32 := posix::pthread_mutex_destroy(
        @native_mutex .glibc_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_destroy failed.";
      }
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::delete_critical_section(@native_mutex .windows_native<-);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      VAR result I32 := posix::pthread_mutex_destroy(
        @native_mutex .macos_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_destroy failed.";
      }
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .lock DOC <$ Blocks until the current thread acquires this ordering mutex. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX && ENVIRONMENT_IS_STATIC)
    {
      .thin.lock();
    }
    STATIC_ELSE STATIC_IF(ENVIRONMENT_IS_GLIBC)
    {
      VAR result I32 := posix::pthread_mutex_lock(
        @native_mutex .glibc_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_lock failed.";
      }
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::enter_critical_section(@native_mutex .windows_native<-);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      VAR result I32 := posix::pthread_mutex_lock(
        @native_mutex .macos_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_lock failed.";
      }
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .try_lock DOC <$ Attempts to acquire this ordering mutex without blocking. $>
    FUNCTION(): BOOL
  {
    STATIC_IF(OS_LINUX && ENVIRONMENT_IS_STATIC)
    {
      RETURN .thin.try_lock();
    }
    STATIC_ELSE STATIC_IF(ENVIRONMENT_IS_GLIBC)
    {
      VAR result I32 := posix::pthread_mutex_trylock(
        @native_mutex .glibc_native<-
      );
      IF (result != 0 && result != 16)
      {
        PANIC "pthread_mutex_trylock failed.";
      }
      RETURN result == 0;
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      RETURN syscall::windows::try_enter_critical_section(
        @native_mutex .windows_native<-
      );
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      VAR result I32 := posix::pthread_mutex_trylock(
        @native_mutex .macos_native<-
      );
      IF (result != 0 && result != 16)
      {
        PANIC "pthread_mutex_trylock failed.";
      }
      RETURN result == 0;
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }

  .unlock DOC <$ Releases this ordering mutex owned by the current thread. $>
    FUNCTION()
  {
    STATIC_IF(OS_LINUX && ENVIRONMENT_IS_STATIC)
    {
      .thin.unlock();
    }
    STATIC_ELSE STATIC_IF(ENVIRONMENT_IS_GLIBC)
    {
      VAR result I32 := posix::pthread_mutex_unlock(
        @native_mutex .glibc_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_unlock failed.";
      }
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::leave_critical_section(@native_mutex .windows_native<-);
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      VAR result I32 := posix::pthread_mutex_unlock(
        @native_mutex .macos_native<-
      );
      IF (result != 0)
      {
        PANIC "pthread_mutex_unlock failed.";
      }
    }
    STATIC_ELSE
    {
      UNIMPLEMENTED;
    }
  }
}

::unfair_mutex DOC <$
  A process-local mutex shared with the allocator. Contenders may acquire
  ownership before previously blocked threads.
  $> ALIAS RUNTIME_MODULE::mutex;

::condition_variable DOC <$
  A process-local condition variable backed by an atomic notification sequence.
  Wait registers the sequence before releasing the supplied mutex and
  reacquires the mutex before returning. Callers recheck their predicate
  because waits may return spuriously. Concurrent waiters use the same mutex,
  which protects the predicate. Notifications follow predicate changes.
  $> STRUCT ROOTED
{
  PRIVATE(CLASS)
  {
    .sequence VAR ATOMIC#I32;
    .waiters VAR ATOMIC#U32;
  }

  .CONSTRUCTOR DOC <$ Creates a condition variable with no waiters. $> FUNCTION()
  {
    STATIC_IF((OS_LINUX || OS_WINDOWS || OS_MACOS) == FALSE) { UNIMPLEMENTED; }
  }

  .wait DOC <$
    Releases the owned mutex while waiting and reacquires it before returning.
    The mutex type supplies lock and unlock operations.
    $> FUNCTION(@locked_mutex MUT& AUTO)
  {
    VAR observed I32 := .sequence.LOAD#ATOMIC_ACQUIRE();
    // Registration precedes unlocking so predicate changes observe this waiter.
    .waiters.ADD#ATOMIC_RELEASE(1);
    locked_mutex.unlock();
    wait_while_atomic_equals(@state .sequence<-, @expected observed);
    .waiters.SUB#ATOMIC_RELAXED(1);
    locked_mutex.lock();
  }

  .notify_one DOC <$ Wakes one thread waiting on this condition variable. $> FUNCTION()
  {
    .sequence.ADD#ATOMIC_RELEASE(1);
    IF (.waiters.LOAD#ATOMIC_ACQUIRE() == 0) { RETURN; }
    wake_one_atomic_waiter(@state .sequence<-);
  }

  .notify_all DOC <$ Wakes every thread waiting on this condition variable. $> FUNCTION()
  {
    .sequence.ADD#ATOMIC_RELEASE(1);
    IF (.waiters.LOAD#ATOMIC_ACQUIRE() == 0) { RETURN; }
    wake_all_atomic_waiters(@state .sequence<-);
  }
}


::semaphore DOC <$
  A process-local counting semaphore. acquire consumes one permit, try_acquire
  never blocks, and release publishes one or more permits.
  $>
  STRUCT ROOTED
{
  PRIVATE(CLASS)
  {
    .mtx VAR ordering_mutex;
    .condition VAR condition_variable;
    .count VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates a semaphore containing initial_count permits. $>
    FUNCTION(@initial_count SZ DEFAULT(0))
  {
    .count := initial_count;
  }

  .acquire DOC <$ Blocks until one permit is available and consumes it. $>
    FUNCTION()
  {
    .mtx.lock();
    LOOP WHILE (.count == 0) DO
    {
      .condition.wait(@locked_mutex .mtx);
    }
    .count--;
    .mtx.unlock();
  }

  .try_acquire DOC <$ Consumes one available permit without blocking. $>
    FUNCTION(): BOOL
  {
    .mtx.lock();
    IF (.count == 0)
    {
      .mtx.unlock();
      RETURN FALSE;
    }
    .count--;
    .mtx.unlock();
    RETURN TRUE;
  }

  .release DOC <$ Adds count permits and wakes blocked acquirers. $>
    FUNCTION(@count SZ DEFAULT(1))
  {
    ASSERT(count != 0, "Semaphore release count must be nonzero.");
    .mtx.lock();
    ASSERT(.count <= ((0 AS SZ) #!!) - count,
      "Semaphore count overflow.");
    .count += count;
    .mtx.unlock();
    IF (count == 1)
    {
      .condition.notify_one();
    }
    ELSE
    {
      .condition.notify_all();
    }
  }
}
