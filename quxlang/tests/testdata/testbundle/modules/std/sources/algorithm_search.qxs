  RETURN TRUE;
}

DOC <$ Counts elements satisfying the selected projected relation. $>
::count FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "equal") == FALSE)
  {
    VAR default_value equal_to;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .equal = default_value; })) TO count;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO count;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_FORWARD(options)) TO count_iterators;
  }
}

DOC <$ Counts elements satisfying the selected projected relation. $>
PRIVATE(MODULE)
::count_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @value CONST& AUTO, @equal TT(equal_type), @projection TT(projection_type)): SZ
{
  VAR result SZ := 0;
  LOOP WHILE (first != last) DO
  { IF (equal(@left projection(first->), @right value)) { result++; } first++; }
  RETURN result;
}

