LANGUAGE QUXLANG EN 0.0;

DOC <$ Tests projected elements in order and stops when the result is determined. $>
::all_of FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO all_of;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_FORWARD(options)) TO all_of_iterators;
  }
}

DOC <$ Tests projected elements in order and stops when the result is determined. $>
PRIVATE(MODULE)
::all_of_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @predicate TT(predicate_type), @projection TT(projection_type)): BOOL
{
  LOOP WHILE (first != last) DO
  {
    IF (predicate(projection(first->)) == FALSE) { RETURN FALSE; }
    first++;
  }
  RETURN TRUE;
}

DOC <$ Tests projected elements in order and stops when the result is determined. $>
::any_of FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO any_of;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_FORWARD(options)) TO any_of_iterators;
  }
}

DOC <$ Tests projected elements in order and stops when the result is determined. $>
PRIVATE(MODULE)
::any_of_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @predicate TT(predicate_type), @projection TT(projection_type)): BOOL
{
  LOOP WHILE (first != last) DO
  {
    IF (predicate(projection(first->))) { RETURN TRUE; }
    first++;
  }
  RETURN FALSE;
}

