  }
}

DOC <$ Counts elements satisfying the selected projected relation. $>
PRIVATE(MODULE)
::count_if_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @predicate TT(predicate_type), @projection TT(projection_type)): SZ
{
  VAR result SZ := 0;
  LOOP WHILE (first != last) DO
  { IF (predicate(projection(first->))) { result++; } first++; }
  RETURN result;
}

DOC <$ Returns the first matching iterator, or the input end. $>
::find FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "equal") == FALSE)
  {
    VAR default_value equal_to;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .equal = default_value; })) TO find;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO find;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS sentinel_type; }, COMPOSITE_FORWARD(options)) TO find_iterators;
  }
}

DOC <$ Returns the first matching iterator, or the input end. $>
PRIVATE(MODULE)
::find_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(sentinel_type), @value CONST& AUTO, @equal TT(equal_type), @projection TT(projection_type)): input_iterator
{
  LOOP WHILE (first != last) DO
  { IF (equal(@left projection(first->), @right value)) { BREAK; } first++; }
  RETURN first;
}

