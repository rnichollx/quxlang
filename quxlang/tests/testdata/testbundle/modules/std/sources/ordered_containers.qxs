    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned constant iterator. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Converts a mutable iterator to a constant iterator. $>
    FUNCTION(@OTHER CONST& map_iterator#(@INDEX INDEX, @VALUE VALUE))
  {
    .node := OTHER.node;
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& map_const_iterator#(@INDEX INDEX, @VALUE VALUE)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: map_const_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    INVARIANT(.node??, "A map end iterator cannot be incremented.");
    VAR previous map_const_iterator#(@INDEX INDEX, @VALUE VALUE) := THIS;
    .node := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns a read-only key-and-value reference for the current item. $>
    FUNCTION() CONST: map_const_item_ref#(@INDEX INDEX, @VALUE VALUE)
  {
    INVARIANT(.node??, "A map end iterator cannot be dereferenced.");
