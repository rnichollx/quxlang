LANGUAGE QUXLANG EN 0.0;

PRIVATE(MODULE, RUNTIME_MODULE)
{

  ::ordered_tree DOC <$
    Owns the root and element count shared by the ordered containers.
    $>
    TEMPLATE(@T TYPE AUTO) STRUCT MOVE_ONLY
  {
    .root VAR MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    .count VAR SZ;

    ::rebalance_from DOC <$ Restores AVL balance from node through the root. $>
      FUNCTION(
        @tree MUT& ordered_tree#(T),
        @node MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
      )
    {
      VAR current MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := node;
      LOOP WHILE (current??) DO
      {
        avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::refresh(current);
        VAR parent MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := current->.parent;
        VAR replacement MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := current;
        VAR left_height SZ := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(current->.left);
        VAR right_height SZ := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(current->.right);

        IF (right_height < left_height && left_height - right_height > (1 AS SZ))
        {
          VAR left MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := current->.left;
          IF (
            avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(left->.left) <
            avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(left->.right)
          )
          {
            current->.left := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::rotate_left(left);
          }
          replacement := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::rotate_right(current);
        }
        ELSE IF (left_height < right_height && right_height - left_height > (1 AS SZ))
        {
          VAR right MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := current->.right;
          IF (
            avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(right->.right) <
            avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::subtree_height(right->.left)
          )
          {
            current->.right := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::rotate_right(right);
          }
          replacement := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::rotate_left(current);
        }

        IF (parent??)
        {
          IF (parent->.left == current)
          {
            parent->.left := replacement;
          }
          ELSE
          {
            INVARIANT(parent->.right == current, "An AVL node must be linked by its parent.");
            parent->.right := replacement;
          }
        }
        ELSE
        {
          tree.root := replacement;
        }
        current := replacement->.parent;
      }
    }

    ::search DOC <$
      Finds a node or its unique insertion position in worst-case logarithmic
      time.
      $>
      TEMPLATE(@INDEX TYPE AUTO)
      FUNCTION(
        @tree CONST& ordered_tree#(T),
        @key CONST& INDEX
      ): ordered_tree_position#(T)
    {
      VAR result ordered_tree_position#(T);
      result.ordering := ORDER::EQUAL;
      VAR current MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := tree.root;
      LOOP WHILE (current??) DO
      {
        VAR ordering ORDER := key <=> current->.entry.ordered_key();
        IF (ordering == ORDER::LESS)
        {
          result.parent := current;
          result.ordering := ordering;
          current := current->.left;
        }
        ELSE IF (ordering == ORDER::GREATER)
        {
          result.parent := current;
          result.ordering := ordering;
          current := current->.right;
        }
        ELSE
        {
          result.node := current;
          RETURN result;
        }
      }
      RETURN result;
    }

    ::find_node DOC <$ Finds a node by key in worst-case logarithmic time. $>
      TEMPLATE(@INDEX TYPE AUTO)
      FUNCTION(
        @tree CONST& ordered_tree#(T),
        @key CONST& INDEX
      ): MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
    {
      VAR position ordered_tree_position#(T) :=
        ordered_tree#(T)::search#(@INDEX INDEX)(@tree tree, @key key);
      RETURN position.node;
    }

    ::allocate_node DOC <$ Allocates and constructs one detached tree node. $>
      FUNCTION(@ARG:entry TEMP& T): MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
    {
      VAR node MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
        NEW avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :[FORWARD(entry)];
      RETURN node;
    }

    ::insert_at DOC <$
      Inserts one entry at a previously searched missing position, consuming the
      entry and preserving AVL balance.
      $>
      FUNCTION(
        @tree MUT& ordered_tree#(T),
        @position CONST& ordered_tree_position#(T),
        @entry TEMP& T
      ): MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
    {
      INVARIANT(position.node!?, "An occupied ordered-tree position cannot be inserted.");
      IF UNLIKELY (tree.count == ((0 AS SZ) #!!)) { THROW container_error::size_overflow; }
      VAR inserted MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
        ordered_tree#(T)::allocate_node(MOVE(entry));
      inserted->.parent := position.parent;
      IF (position.parent!?)
      {
        INVARIANT(tree.root!?, "Only an empty ordered tree can insert without a parent.");
        tree.root := inserted;
      }
      ELSE IF (position.ordering == ORDER::LESS)
      {
        INVARIANT(position.parent->.left!?, "An ordered-tree insertion position must be empty.");
        position.parent->.left := inserted;
      }
      ELSE
      {
        INVARIANT(position.ordering == ORDER::GREATER, "A non-root insertion requires a strict ordering.");
        INVARIANT(position.parent->.right!?, "An ordered-tree insertion position must be empty.");
        position.parent->.right := inserted;
      }
      tree.count++;
      ordered_tree#(T)::rebalance_from(@tree tree, @node position.parent);
      RETURN inserted;
    }

    ::transplant DOC <$ Replaces one linked subtree without moving or assigning its entry. $>
      FUNCTION(
        @tree MUT& ordered_tree#(T),
        @removed MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE),
        @replacement MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
      )
    {
      VAR parent MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := removed->.parent;
      IF (parent!?)
      {
        tree.root := replacement;
      }
      ELSE IF (parent->.left == removed)
      {
        parent->.left := replacement;
      }
      ELSE
      {
        INVARIANT(parent->.right == removed, "An erased AVL node must be linked by its parent.");
        parent->.right := replacement;
      }
      IF (replacement??)
      {
        replacement->.parent := parent;
      }
    }

    ::erase_node DOC <$
      Physically removes node and transplants its successor when both children
      exist, preserving immutable and non-assignable keys.
      $>
      FUNCTION(
        @tree MUT& ordered_tree#(T),
        @node MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)
      )
    {
      INVARIANT(node??, "A valid node is required for erasure.");
      VAR rebalance_node MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

      IF (node->.left?? && node->.right??)
      {
        VAR successor MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
          avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(node->.right);
        IF (successor->.parent == node)
        {
          ordered_tree#(T)::transplant(
            @tree tree,
            @removed node,
            @replacement successor
          );
          successor->.left := node->.left;
          successor->.left->.parent := successor;
          rebalance_node := successor;
        }
        ELSE
        {
          VAR successor_parent MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := successor->.parent;
          ordered_tree#(T)::transplant(
            @tree tree,
            @removed successor,
            @replacement successor->.right
          );
          successor->.right := node->.right;
          successor->.right->.parent := successor;
          ordered_tree#(T)::transplant(
            @tree tree,
            @removed node,
            @replacement successor
          );
          successor->.left := node->.left;
          successor->.left->.parent := successor;
          rebalance_node := successor_parent;
        }
      }
      ELSE
      {
        VAR parent MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := node->.parent;
        VAR replacement MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := node->.left;
        IF (replacement!?)
        {
          replacement := node->.right;
        }
        ordered_tree#(T)::transplant(
          @tree tree,
          @removed node,
          @replacement replacement
        );
        IF (parent??)
        {
          rebalance_node := parent;
        }
        ELSE
        {
          rebalance_node := replacement;
        }
      }

      tree.count--;
      DELETE node;
      ordered_tree#(T)::rebalance_from(@tree tree, @node rebalance_node);
    }

    ::clear DOC <$ Removes and destroys every entry owned by tree. $>
      FUNCTION(@ARG:tree MUT& ordered_tree#(T))
    {
      VAR released_root MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := tree.root;
      VAR empty_root MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
      tree.root := empty_root;
      tree.count := 0;
      avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::destroy_subtree(released_root);
    }

    ::copy DOC <$
      Copy-constructs an empty destination in linear time while preserving the
      source tree's topology.
      $>
      FUNCTION(
        @destination MUT& ordered_tree#(T),
        @source CONST& ordered_tree#(T)
      )
    {
      INVARIANT(destination.count == 0, "An ordered tree copy destination must be empty.");
      INVARIANT(destination.root!?, "An empty ordered tree cannot have a root.");
      VAR empty_parent MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
      destination.root := avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::clone_subtree(
        @source source.root,
        @parent empty_parent
      );
      destination.count := source.count;
    }

    ::take DOC <$ Transfers all nodes from source into an empty destination tree. $>
      FUNCTION(
        @destination MUT& ordered_tree#(T),
        @source MUT& ordered_tree#(T)
      )
    {
      INVARIANT(destination.count == 0, "An ordered tree move destination must be empty.");
      destination.root <-> source.root;
      destination.count <-> source.count;
    }
  }

  ::ordered_tree_position DOC <$
    Identifies either a matching node or the parent and ordering for one missing
    key's insertion position.
    $>
    TEMPLATE(@T TYPE AUTO) STRUCT
  {
    .node VAR MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    .parent VAR MUT->avl_node#(@T T, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    .ordering VAR ORDER;
  }

  ::ordered_map_entry DOC <$ Owns one immutable map key and its associated mutable value. $>
    TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
  {
    .key VAR INDEX;
    .value VAR VALUE;

    .CONSTRUCTOR DOC <$ Copy-constructs a map entry's key and value. $>
      FUNCTION(@key CONST& INDEX, @value CONST& VALUE) :>
        .key:(@OTHER FORWARD(key)),
        .value:(@OTHER FORWARD(value))
    {
    }

    .CONSTRUCTOR DOC <$ Move-constructs a map entry's key and copies its value. $>
      FUNCTION(@key TEMP& INDEX, @value CONST& VALUE) :>
        .key:(@OTHER FORWARD(key)),
        .value:(@OTHER FORWARD(value))
    {
    }

    .CONSTRUCTOR DOC <$ Copies a map entry's key and move-constructs its value. $>
      FUNCTION(@key CONST& INDEX, @value TEMP& VALUE) :>
        .key:(@OTHER FORWARD(key)),
        .value:(@OTHER FORWARD(value))
    {
    }

    .CONSTRUCTOR DOC <$ Move-constructs a map entry's key and value. $>
      FUNCTION(@key TEMP& INDEX, @value TEMP& VALUE) :>
        .key:(@OTHER FORWARD(key)),
        .value:(@OTHER FORWARD(value))
    {
    }

    .CONSTRUCTOR DOC <$ Copies a key and default-constructs its associated value. $>
      FUNCTION(@key CONST& INDEX) :> .key:(@OTHER FORWARD(key)), .value:[]
    {
    }

    .CONSTRUCTOR DOC <$ Moves a key and default-constructs its associated value. $>
      FUNCTION(@key TEMP& INDEX) :> .key:(@OTHER FORWARD(key)), .value:[]
    {
    }

    .ordered_key DOC <$ Returns the key used by the ordered tree. $>
      FUNCTION() CONST: CONST& INDEX
    {
      RETURN .key;
    }
  }

  ::ordered_set_entry DOC <$ Owns one immutable set key. $>
    TEMPLATE(@T TYPE AUTO) STRUCT
  {
    .key VAR T;

    .CONSTRUCTOR DOC <$ Copy-constructs a set entry's key. $>
      FUNCTION(@key CONST& T) :> .key:(@OTHER FORWARD(key))
    {
    }

    .CONSTRUCTOR DOC <$ Move-constructs a set entry's key. $>
      FUNCTION(@key TEMP& T) :> .key:(@OTHER FORWARD(key))
    {
    }

    .ordered_key DOC <$ Returns the key used by the ordered tree. $>
      FUNCTION() CONST: CONST& T
    {
      RETURN .key;
    }
  }

}

::map_item_ref DOC <$
  Refers to one mutable map item while keeping its key immutable.
  key and INDEX return the key; value and VALUE return the associated value.
  $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .key_pointer VAR CONST->INDEX;
    .value_pointer VAR MUT->VALUE;
  }

  .CONSTRUCTOR DOC <$ Creates an item reference from a key and value. $>
    FUNCTION(@key CONST& INDEX, @value MUT& VALUE)
  {
    .key_pointer := key<-;
    .value_pointer := value<-;
  }

  .key DOC <$ Returns the immutable key. $>
    FUNCTION() CONST: CONST& INDEX
  {
    RETURN .key_pointer->;
  }

  .INDEX DOC <$ Returns the immutable key for INDEX and VALUE iteration. $>
    FUNCTION() CONST: CONST& INDEX
  {
    RETURN .key_pointer->;
  }

  .value DOC <$ Returns the mutable associated value. $>
    FUNCTION() CONST: MUT& VALUE
  {
    RETURN .value_pointer->;
  }

  .VALUE DOC <$ Returns the mutable associated value. $>
    FUNCTION() CONST: MUT& VALUE
  {
    RETURN .value_pointer->;
  }
}

::map_const_item_ref DOC <$
  Refers read-only to one map item. key and INDEX return the key, while value
  and VALUE return the associated value.
  $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .key_pointer VAR CONST->INDEX;
    .value_pointer VAR CONST->VALUE;
  }

  .CONSTRUCTOR DOC <$ Creates a constant item reference from a key and value. $>
    FUNCTION(@key CONST& INDEX, @value CONST& VALUE)
  {
    .key_pointer := key<-;
    .value_pointer := value<-;
  }

  .key DOC <$ Returns the immutable key. $>
    FUNCTION() CONST: CONST& INDEX
  {
    RETURN .key_pointer->;
  }

  .INDEX DOC <$ Returns the immutable key for INDEX and VALUE iteration. $>
    FUNCTION() CONST: CONST& INDEX
  {
    RETURN .key_pointer->;
  }

  .VALUE DOC <$ Returns the associated value. $>
    FUNCTION() CONST: CONST& VALUE
  {
    RETURN .value_pointer->;
  }

  .value DOC <$ Returns the associated value. $>
    FUNCTION() CONST: CONST& VALUE
  {
    RETURN .value_pointer->;
  }
}

::map_iterator DOC <$ Traverses mutable map values in ascending key order. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates an iterator positioned at node. $>
      FUNCTION(@node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned iterator. $>
    FUNCTION()
  {
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& map_iterator#(@INDEX INDEX, @VALUE VALUE)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: map_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    INVARIANT(.node??, "A map end iterator cannot be incremented.");
    VAR previous map_iterator#(@INDEX INDEX, @VALUE VALUE) := THIS;
    .node := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns a key-and-value reference for the current item. $>
    FUNCTION() CONST: map_item_ref#(@INDEX INDEX, @VALUE VALUE)
  {
    INVARIANT(.node??, "A map end iterator cannot be dereferenced.");
    RETURN map_item_ref#(@INDEX INDEX, @VALUE VALUE)(
      @key .node->.entry.key,
      @value .node->.entry.value
    );
  }
}

::map_const_iterator DOC <$ Traverses a constant map in ascending key order. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

