::map DOC <$
  Owns unique keys and associated values in ascending key order. Lookup,
  insertion, and removal have worst-case logarithmic complexity.
  $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    ::insert_value DOC <$ Constructs and inserts one map entry from forwarded arguments. $>
      FUNCTION(
        @tree MUT& ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)),
        @key AUTO& INDEX,
        @value AUTO& VALUE
      ): BOOL
    {
      VAR position ordered_tree_position#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)) :=
        ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::search#(@INDEX INDEX)(@tree tree, @key key);
      IF (position.node??)
      {
        RETURN FALSE;
      }
      VAR entry ordered_map_entry#(@INDEX INDEX, @VALUE VALUE) :=
        ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)(
          @key FORWARD(key),
          @value FORWARD(value)
        );
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::insert_at(
        @tree tree,
        @position position,
        @entry MOVE(entry)
      );
      RETURN TRUE;
    }

    ::insert_or_assign_value DOC <$
      Inserts one map entry or assigns the forwarded value to an existing entry.
      $>
      FUNCTION(
        @tree MUT& ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)),
        @key AUTO& INDEX,
        @value AUTO& VALUE
      ): BOOL
    {
      VAR position ordered_tree_position#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)) :=
        ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::search#(@INDEX INDEX)(@tree tree, @key key);
      IF (position.node??)
      {
        position.node->.entry.value := FORWARD(value);
        RETURN FALSE;
      }
      VAR entry ordered_map_entry#(@INDEX INDEX, @VALUE VALUE) :=
        ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)(
          @key FORWARD(key),
          @value FORWARD(value)
        );
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::insert_at(
        @tree tree,
        @position position,
        @entry MOVE(entry)
      );
      RETURN TRUE;
    }

    ::index_value DOC <$ Finds a key or inserts it with a default-constructed value. $>
      FUNCTION(
        @tree MUT& ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)),
        @key AUTO& INDEX
      ): MUT& VALUE
    {
      VAR position ordered_tree_position#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)) :=
        ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::search#(@INDEX INDEX)(@tree tree, @key key);
      IF (position.node??)
      {
        RETURN position.node->.entry.value;
      }
      VAR entry ordered_map_entry#(@INDEX INDEX, @VALUE VALUE) :=
        ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)(@key FORWARD(key));
      VAR inserted MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
        ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::insert_at(
          @tree tree,
          @position position,
          @entry MOVE(entry)
        );
      RETURN inserted->.entry.value;
    }

    .tree VAR ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE));
  }

  .CONSTRUCTOR DOC <$ Constructs an empty map. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copy-constructs all entries from OTHER. $>
    FUNCTION(@OTHER CONST& map#[INDEX:VALUE])
  {
    ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::copy(
      @destination .tree,
      @source OTHER.tree
    );
  }

  .CONSTRUCTOR DOC <$ Transfers all entries from OTHER. $>
    FUNCTION(@OTHER TEMP& map#[INDEX:VALUE])
  {
    VAR source MUT& ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE)) :=
      OTHER.tree AS MUT& ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE));
    ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::take(
      @destination .tree,
      @source source
    );
  }

  .DESTRUCTOR DOC <$ Destroys every entry and releases every node allocation. $>
    FUNCTION()
  {
    ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::clear(.tree);
  }

  .size DOC <$ Returns the number of entries. $>
    FUNCTION() CONST: SZ
  {
    RETURN .tree.count;
  }

  .empty DOC <$ Reports whether the map contains no entries. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .tree.count == 0;
  }

  .clear DOC <$ Removes and destroys every map entry. $>
    FUNCTION() MUT
  {
    ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::clear(.tree);
  }

  .contains DOC <$ Reports whether key is present. $>
    FUNCTION(@key CONST& INDEX) CONST: BOOL
  {
    RETURN ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(
      @tree .tree,
      @key key
    )??;
  }

  .find DOC <$ Returns a mutable iterator for key or END when absent. $>
    FUNCTION(@key CONST& INDEX) MUT: map_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(@tree .tree, @key key);
    RETURN map_iterator#(@INDEX INDEX, @VALUE VALUE)(@node node);
  }

  .find DOC <$ Returns a constant iterator for key or END when absent. $>
    FUNCTION(@key CONST& INDEX) CONST: map_const_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(@tree .tree, @key key);
    RETURN map_const_iterator#(@INDEX INDEX, @VALUE VALUE)(@node node);
  }

  .insert DOC <$
    Inserts key and value, consuming temporary arguments only when insertion
    succeeds.
    $>
    FUNCTION(
      @key AUTO& INDEX,
      @value AUTO& VALUE
    ) MUT: BOOL
  {
    RETURN map#(@INDEX INDEX, @VALUE VALUE)::insert_value(
      @tree .tree,
      @key FORWARD(key),
      @value FORWARD(value)
    );
  }

  .insert_or_assign DOC <$
    Inserts a missing key or assigns value to the existing associated value.
    Returns true only when a new entry was inserted.
    $>
    FUNCTION(
      @key AUTO& INDEX,
      @value AUTO& VALUE
    ) MUT: BOOL
  {
    RETURN map#(@INDEX INDEX, @VALUE VALUE)::insert_or_assign_value(
      @tree .tree,
      @key FORWARD(key),
      @value FORWARD(value)
    );
  }

  .erase DOC <$ Removes key when present and reports whether an entry was erased. $>
    FUNCTION(@key CONST& INDEX) MUT: BOOL
  {
    VAR node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(@tree .tree, @key key);
    IF (node!?)
    {
      RETURN FALSE;
    }
    ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::erase_node(@tree .tree, @node node);
    RETURN TRUE;
  }

  .at DOC <$ Returns the mutable value associated with key. Throws container_error::missing_key when key is absent. $>
    FUNCTION(@key CONST& INDEX) MUT: MUT& VALUE
  {
    VAR node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(@tree .tree, @key key);
    IF UNLIKELY (node!?) { THROW container_error::missing_key; }
    RETURN node->.entry.value;
  }

  .at DOC <$ Returns the constant value associated with key. Throws container_error::missing_key when key is absent. $>
    FUNCTION(@key CONST& INDEX) CONST: CONST& VALUE
  {
    VAR node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_map_entry#(@INDEX INDEX, @VALUE VALUE))::find_node#(@INDEX INDEX)(@tree .tree, @key key);
    IF UNLIKELY (node!?) { THROW container_error::missing_key; }
    RETURN node->.entry.value;
  }

  .OPERATOR[] DOC <$ Returns the value for key, default-inserting when absent. $>
    FUNCTION(%key AUTO& INDEX) MUT: MUT& VALUE
  {
    RETURN map#(@INDEX INDEX, @VALUE VALUE)::index_value(@tree .tree, @key FORWARD(key));
  }

  .BEGIN DOC <$ Returns an iterator to the first mutable map item. $>
    FUNCTION() MUT: map_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_iterator#(@INDEX INDEX, @VALUE VALUE)(@node first);
  }

  .BEGIN DOC <$ Returns an iterator to the first constant map item. $>
    FUNCTION() CONST: map_const_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_const_iterator#(@INDEX INDEX, @VALUE VALUE)(@node first);
  }

  .END DOC <$ Returns the past-the-end mutable map iterator. $>
    FUNCTION() MUT: map_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR end_node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN map_iterator#(@INDEX INDEX, @VALUE VALUE)(@node end_node);
  }

  .END DOC <$ Returns the past-the-end constant map iterator. $>
    FUNCTION() CONST: map_const_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR end_node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN map_const_iterator#(@INDEX INDEX, @VALUE VALUE)(@node end_node);
  }

  .items DOC <$ Returns a mutable item range in ascending key order. $>
    FUNCTION() MUT: map_item_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_item_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .items DOC <$ Returns a constant item range in ascending key order. $>
    FUNCTION() CONST: map_const_item_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_const_item_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .INDEXES DOC <$ Returns the immutable keys in ascending order. $>
    FUNCTION() CONST: map_key_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_key_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .VALUES DOC <$ Returns the mutable values in ascending key order. $>
    FUNCTION() MUT: map_value_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_value_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .VALUES DOC <$ Returns the constant values in ascending key order. $>
    FUNCTION() CONST: map_const_value_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_const_value_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .IV_PAIRS DOC <$ Returns mutable INDEX/VALUE pairs in ascending key order. $>
    FUNCTION() MUT: map_item_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_item_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }

  .IV_PAIRS DOC <$ Returns constant INDEX/VALUE pairs in ascending key order. $>
    FUNCTION() CONST: map_const_item_range#(@INDEX INDEX, @VALUE VALUE)
  {
    VAR first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN map_const_item_range#(@INDEX INDEX, @VALUE VALUE)(@first first);
  }
}

::set_iterator DOC <$ Traverses a mutable set's immutable keys in ascending order. $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates an iterator positioned at node. $>
      FUNCTION(@node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned set iterator. $>
    FUNCTION()
  {
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& set_iterator#(T)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: set_iterator#(T)
  {
    INVARIANT(.node??, "A set end iterator cannot be incremented.");
    VAR previous set_iterator#(T) := THIS;
    .node := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns the current immutable key. $>
    FUNCTION() CONST: CONST& T
  {
    INVARIANT(.node??, "A set end iterator cannot be dereferenced.");
    RETURN .node->.entry.key;
  }
}

::set_const_iterator DOC <$ Traverses a constant set in ascending order. $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates an iterator positioned at node. $>
      FUNCTION(@node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned constant set iterator. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Converts a mutable set iterator to a constant iterator. $>
    FUNCTION(@OTHER CONST& set_iterator#(T))
  {
    .node := OTHER.node;
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& set_const_iterator#(T)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: set_const_iterator#(T)
  {
    INVARIANT(.node??, "A set end iterator cannot be incremented.");
    VAR previous set_const_iterator#(T) := THIS;
    .node := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns the current immutable key. $>
    FUNCTION() CONST: CONST& T
  {
    INVARIANT(.node??, "A set end iterator cannot be dereferenced.");
    RETURN .node->.entry.key;
  }
}

::set_range DOC <$ Provides a mutable set's immutable keys in ascending order. $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .first VAR MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates a set range beginning at first. $>
      FUNCTION(@first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .first := first;
    }
  }

  .BEGIN DOC <$ Returns the first set iterator. $>
    FUNCTION() CONST: set_iterator#(T)
  {
    RETURN set_iterator#(T)(@node .first);
  }

  .END DOC <$ Returns the past-the-end set iterator. $>
    FUNCTION() CONST: set_iterator#(T)
  {
    VAR end_node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN set_iterator#(T)(@node end_node);
  }
}

::set_const_range DOC <$ Provides a constant set's keys in ascending order. $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .first VAR MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates a constant set range beginning at first. $>
      FUNCTION(@first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .first := first;
    }
  }

  .BEGIN DOC <$ Returns the first constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(T)
  {
    RETURN set_const_iterator#(T)(@node .first);
  }

  .END DOC <$ Returns the past-the-end constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(T)
  {
    VAR end_node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN set_const_iterator#(T)(@node end_node);
  }
}

::set DOC <$
  Owns unique keys in ascending order. Lookup, insertion, and removal have
  worst-case logarithmic complexity.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    ::insert_key DOC <$ Constructs and inserts one set key from a forwarded argument. $>
      FUNCTION(
        @tree MUT& ordered_tree#(ordered_set_entry#(T)),
        @key AUTO& T
      ): BOOL
    {
      VAR position ordered_tree_position#(ordered_set_entry#(T)) :=
        ordered_tree#(ordered_set_entry#(T))::search#(@INDEX T)(@tree tree, @key key);
      IF (position.node??)
      {
        RETURN FALSE;
      }
      VAR entry ordered_set_entry#(T) := ordered_set_entry#(T)(@key FORWARD(key));
      ordered_tree#(ordered_set_entry#(T))::insert_at(
        @tree tree,
        @position position,
        @entry MOVE(entry)
      );
      RETURN TRUE;
    }

    .tree VAR ordered_tree#(ordered_set_entry#(T));
  }

  .CONSTRUCTOR DOC <$ Constructs an empty set. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copy-constructs all keys from OTHER. $>
    FUNCTION(@OTHER CONST& set#(T))
  {
    ordered_tree#(ordered_set_entry#(T))::copy(
      @destination .tree,
      @source OTHER.tree
    );
  }

  .CONSTRUCTOR DOC <$ Transfers all keys from OTHER. $>
    FUNCTION(@OTHER TEMP& set#(T))
  {
    VAR source MUT& ordered_tree#(ordered_set_entry#(T)) :=
      OTHER.tree AS MUT& ordered_tree#(ordered_set_entry#(T));
    ordered_tree#(ordered_set_entry#(T))::take(
      @destination .tree,
      @source source
    );
  }

  .DESTRUCTOR DOC <$ Destroys every key and releases every node allocation. $>
    FUNCTION()
  {
    ordered_tree#(ordered_set_entry#(T))::clear(.tree);
  }

  .size DOC <$ Returns the number of keys. $>
    FUNCTION() CONST: SZ
  {
    RETURN .tree.count;
  }

  .empty DOC <$ Reports whether the set contains no keys. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .tree.count == 0;
  }

  .clear DOC <$ Removes and destroys every set key. $>
    FUNCTION() MUT
  {
    ordered_tree#(ordered_set_entry#(T))::clear(.tree);
  }

  .contains DOC <$ Reports whether key is present. $>
    FUNCTION(@key CONST& T) CONST: BOOL
  {
    RETURN ordered_tree#(ordered_set_entry#(T))::find_node#(@INDEX T)(
      @tree .tree,
      @key key
    )??;
  }

  .find DOC <$ Returns an iterator for key or END when absent. $>
    FUNCTION(@key CONST& T) MUT: set_iterator#(T)
  {
    VAR node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_set_entry#(T))::find_node#(@INDEX T)(@tree .tree, @key key);
    RETURN set_iterator#(T)(@node node);
  }

  .find DOC <$ Returns a constant iterator for key or END when absent. $>
    FUNCTION(@key CONST& T) CONST: set_const_iterator#(T)
  {
    VAR node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_set_entry#(T))::find_node#(@INDEX T)(@tree .tree, @key key);
    RETURN set_const_iterator#(T)(@node node);
  }

  .insert DOC <$ Inserts a key, consuming a temporary only when insertion succeeds. $>
    FUNCTION(@key AUTO& T) MUT: BOOL
  {
    RETURN set#(T)::insert_key(@tree .tree, @key FORWARD(key));
  }

  .erase DOC <$ Removes key when present and reports whether a key was erased. $>
    FUNCTION(@key CONST& T) MUT: BOOL
  {
    VAR node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) :=
      ordered_tree#(ordered_set_entry#(T))::find_node#(@INDEX T)(@tree .tree, @key key);
    IF (node!?)
    {
      RETURN FALSE;
    }
    ordered_tree#(ordered_set_entry#(T))::erase_node(@tree .tree, @node node);
    RETURN TRUE;
  }

  .BEGIN DOC <$ Returns an iterator to the first set key. $>
    FUNCTION() MUT: set_iterator#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_iterator#(T)(@node first);
  }

  .BEGIN DOC <$ Returns an iterator to the first constant set key. $>
    FUNCTION() CONST: set_const_iterator#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_const_iterator#(T)(@node first);
  }

  .END DOC <$ Returns the past-the-end set iterator. $>
    FUNCTION() MUT: set_iterator#(T)
  {
    VAR end_node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN set_iterator#(T)(@node end_node);
  }

  .END DOC <$ Returns the past-the-end constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(T)
  {
    VAR end_node MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
    RETURN set_const_iterator#(T)(@node end_node);
  }

  .items DOC <$ Returns this mutable set's immutable keys in ascending order. $>
    FUNCTION() MUT: set_range#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_range#(T)(@first first);
  }

  .items DOC <$ Returns this constant set's keys in ascending order. $>
    FUNCTION() CONST: set_const_range#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_const_range#(T)(@first first);
  }

  .VALUES DOC <$ Returns this mutable set's immutable keys in ascending order. $>
    FUNCTION() MUT: set_range#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_range#(T)(@first first);
  }

  .VALUES DOC <$ Returns this constant set's keys in ascending order. $>
    FUNCTION() CONST: set_const_range#(T)
  {
    VAR first MUT->avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .tree.root;
    IF (first??)
    {
      first := avl_node#(@T ordered_set_entry#(T), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::minimum(first);
    }
    RETURN set_const_range#(T)(@first first);
  }
}
