::map_const_value_iterator DOC <$ Traverses constant map values in ascending key order. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates an iterator positioned at node. $>
      FUNCTION(@node MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned constant value iterator. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Converts a mutable value iterator to a constant value iterator. $>
    FUNCTION(@OTHER CONST& map_value_iterator#(@INDEX INDEX, @VALUE VALUE))
  {
    .node := OTHER.node;
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& map_const_value_iterator#(@INDEX INDEX, @VALUE VALUE)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: map_const_value_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    INVARIANT(.node??, "A map value end iterator cannot be incremented.");
    VAR previous map_const_value_iterator#(@INDEX INDEX, @VALUE VALUE) := THIS;
    .node := avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns the current constant value. $>
    FUNCTION() CONST: CONST& VALUE
  {
    INVARIANT(.node??, "A map value end iterator cannot be dereferenced.");
    RETURN .node->.entry.value;
  }
}

::map_item_range DOC <$ Provides mutable map items and INDEX/VALUE pairs in ascending key order. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .first VAR MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);

    .CONSTRUCTOR DOC <$ Creates an item range beginning at first. $>
      FUNCTION(@first MUT->avl_node#(@T ordered_map_entry#(@INDEX INDEX, @VALUE VALUE), @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE))
    {
      .first := first;
    }
  }

  .BEGIN DOC <$ Returns the first mutable item iterator. $>
    FUNCTION() CONST: map_iterator#(@INDEX INDEX, @VALUE VALUE)
  {
    RETURN map_iterator#(@INDEX INDEX, @VALUE VALUE)(@node .first);
  }

  .END DOC <$ Returns the past-the-end mutable item iterator. $>
    FUNCTION() CONST: map_iterator#(@INDEX INDEX, @VALUE VALUE)
