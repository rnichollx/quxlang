LANGUAGE QUXLANG EN 0.0;


DOC <$
  Owns a contiguous, allocator-backed sequence of T values. Growth preserves
  element order, and operations destroy every removed value exactly once.
  $>
::dynarr
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  DOC <$
    Iterates mutable elements in a dynarr#(T). The iterator remains valid until
    the owning array reallocates or shifts or destroys its referenced element.
    $>
  ::iterator
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates an iterator at index within storage. $>
    .CONSTRUCTOR
      FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Reports whether two iterators identify the same position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& dynarr#(T)::iterator) CONST: BOOL
    {
      RETURN .storage == OTHER.storage && .index == OTHER.index;
    }

    DOC <$ Orders positions within one dynamic array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& dynarr#(T)::iterator) CONST: ORDER
    {
      ASSERT(.storage == OTHER.storage,
        "Cannot order iterators from different dynamic arrays.");
      RETURN .index <=> OTHER.index;
    }

    DOC <$ Advances one position and returns the previous iterator. $>
    .OPERATOR++
      FUNCTION() MUT: dynarr#(T)::iterator
    {
      VAR previous dynarr#(T)::iterator := THIS;
      .index++;
      RETURN previous;
    }

    DOC <$ Advances by count positions. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::iterator
    {
      .index += OTHER;
      RETURN THIS;
    }

    DOC <$ Retreats one position and returns the previous iterator. $>
    .OPERATOR-- FUNCTION() MUT: dynarr#(T)::iterator
    { VAR previous dynarr#(T)::iterator := THIS; .index--; RETURN previous; }

    DOC <$ Retreats by the supplied unsigned element count. $>
    .OPERATOR-= FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::iterator
    { .index -= OTHER; RETURN THIS; }

    DOC <$ Returns the position count elements after this iterator. $>
    .OPERATOR+ FUNCTION(@OTHER SZ) CONST: dynarr#(T)::iterator
    { RETURN dynarr#(T)::iterator(@storage .storage, @index .index + OTHER); }

    DOC <$ Returns the position count elements before this iterator. $>
    .OPERATOR- FUNCTION(@OTHER SZ) CONST: dynarr#(T)::iterator
    { RETURN dynarr#(T)::iterator(@storage .storage, @index .index - OTHER); }

    DOC <$ Returns the signed element distance between positions in one allocation. $>
    .OPERATOR- FUNCTION(@OTHER CONST& dynarr#(T)::iterator) CONST: iterator_difference
    {
      ASSERT(.storage == OTHER.storage, "Cannot subtract iterators from different dynamic arrays.");
      IF (.index >= OTHER.index) { RETURN (.index - OTHER.index) AS ASSUME iterator_difference; }
      VAR magnitude SZ := OTHER.index - .index;
      RETURN (0 AS iterator_difference) - ((magnitude - 1) AS ASSUME iterator_difference) - 1;
    }

    DOC <$ Returns a mutable reference to the current element. $>
    .OPERATOR->
      FUNCTION() CONST: MUT& T
    {
      RETURN PUN .storage[.index] AS T;
    }
  }


  DOC <$
    Iterates constant elements in a dynarr#(T). The iterator remains valid until
    the owning array reallocates or shifts or destroys its referenced element.
    $>
  ::const_iterator
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR CONST=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates a constant iterator at index within storage. $>
    .CONSTRUCTOR
      FUNCTION(@storage CONST=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Converts a mutable iterator to a constant iterator. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER CONST& dynarr#(T)::iterator)
    {
      .storage := OTHER.storage;
      .index := OTHER.index;
    }

    DOC <$ Reports whether two iterators identify the same position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& dynarr#(T)::const_iterator) CONST: BOOL
    {
      RETURN .storage == OTHER.storage && .index == OTHER.index;
    }

    DOC <$ Orders positions within one dynamic array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& dynarr#(T)::const_iterator) CONST: ORDER
    {
      ASSERT(.storage == OTHER.storage,
        "Cannot order iterators from different dynamic arrays.");
      RETURN .index <=> OTHER.index;
    }

    DOC <$ Advances one position and returns the previous iterator. $>
    .OPERATOR++
      FUNCTION() MUT: dynarr#(T)::const_iterator
    {
      VAR previous dynarr#(T)::const_iterator := THIS;
      .index++;
      RETURN previous;
    }

    DOC <$ Advances by count positions. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::const_iterator
    {
      .index += OTHER;
      RETURN THIS;
    }

    DOC <$ Retreats one position and returns the previous iterator. $>
    .OPERATOR-- FUNCTION() MUT: dynarr#(T)::const_iterator
    { VAR previous dynarr#(T)::const_iterator := THIS; .index--; RETURN previous; }

    DOC <$ Retreats by the supplied unsigned element count. $>
    .OPERATOR-= FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::const_iterator
    { .index -= OTHER; RETURN THIS; }

    DOC <$ Returns the position count elements after this iterator. $>
    .OPERATOR+ FUNCTION(@OTHER SZ) CONST: dynarr#(T)::const_iterator
    { RETURN dynarr#(T)::const_iterator(@storage .storage, @index .index + OTHER); }

    DOC <$ Returns the position count elements before this iterator. $>
    .OPERATOR- FUNCTION(@OTHER SZ) CONST: dynarr#(T)::const_iterator
    { RETURN dynarr#(T)::const_iterator(@storage .storage, @index .index - OTHER); }

    DOC <$ Returns the signed element distance between positions in one allocation. $>
    .OPERATOR- FUNCTION(@OTHER CONST& dynarr#(T)::const_iterator) CONST: iterator_difference
    {
      ASSERT(.storage == OTHER.storage, "Cannot subtract iterators from different dynamic arrays.");
      IF (.index >= OTHER.index) { RETURN (.index - OTHER.index) AS ASSUME iterator_difference; }
      VAR magnitude SZ := OTHER.index - .index;
      RETURN (0 AS iterator_difference) - ((magnitude - 1) AS ASSUME iterator_difference) - 1;
    }

    DOC <$ Returns a constant reference to the current element. $>
    .OPERATOR->
      FUNCTION() CONST: CONST& T
    {
      RETURN PUN .storage[.index] AS T;
    }
  }


  DOC <$ Iterates zero-based indexes in a dynamic array. $>
  ::index_iterator
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .index VAR SZ;
    }

    DOC <$ Creates an index iterator at index. $>
    .CONSTRUCTOR
      FUNCTION(@index SZ)
    {
      .index := index;
    }

    DOC <$ Reports whether two index iterators identify the same index. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& dynarr#(T)::index_iterator) CONST: BOOL
    {
      RETURN .index == OTHER.index;
    }

    DOC <$ Orders two indexes. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& dynarr#(T)::index_iterator) CONST: ORDER
    {
      RETURN .index <=> OTHER.index;
    }

    DOC <$ Advances one index and returns the previous iterator. $>
    .OPERATOR++
      FUNCTION() MUT: dynarr#(T)::index_iterator
    {
      VAR previous dynarr#(T)::index_iterator := THIS;
      .index++;
      RETURN previous;
    }

    DOC <$ Advances by count indexes. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::index_iterator
    {
      .index += OTHER;
      RETURN THIS;
    }

    DOC <$ Returns the current zero-based index. $>
    .OPERATOR->
      FUNCTION() CONST: SZ
    {
      RETURN .index;
    }
  }


  DOC <$ Presents the zero-based indexes of a dynamic array as a range. $>
  ::index_range
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .count VAR SZ;
    }

    DOC <$ Creates an index range containing count indexes. $>
    .CONSTRUCTOR
      FUNCTION(@count SZ)
    {
      .count := count;
    }

    DOC <$ Returns an iterator to index zero. $>
    .BEGIN
      FUNCTION() CONST: dynarr#(T)::index_iterator
    {
      RETURN dynarr#(T)::index_iterator(@index 0);
    }

    DOC <$ Returns an iterator one position beyond the final index. $>
    .END
      FUNCTION() CONST: dynarr#(T)::index_iterator
    {
      RETURN dynarr#(T)::index_iterator(@index .count);
    }
  }


  DOC <$
    Refers to one mutable dynamic-array element together with its zero-based
    index for combined INDEX and VALUE range iteration.
    $>
  ::index_value
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates an index/value projection for one element. $>
    .CONSTRUCTOR
      FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Returns the element's zero-based index. $>
    .INDEX
      FUNCTION() CONST: SZ
    {
      RETURN .index;
    }

    DOC <$ Returns a mutable reference to the indexed element. $>
    .VALUE
      FUNCTION() CONST: MUT& T
    {
      RETURN PUN .storage[.index] AS T;
    }
  }


  DOC <$
    Refers to one constant dynamic-array element together with its zero-based
    index for combined INDEX and VALUE range iteration.
    $>
  ::const_index_value
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR CONST=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates a constant index/value projection for one element. $>
    .CONSTRUCTOR
      FUNCTION(@storage CONST=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Returns the element's zero-based index. $>
    .INDEX
      FUNCTION() CONST: SZ
    {
      RETURN .index;
    }

    DOC <$ Returns a constant reference to the indexed element. $>
    .VALUE
      FUNCTION() CONST: CONST& T
    {
      RETURN PUN .storage[.index] AS T;
    }
  }


  DOC <$ Iterates mutable index/value projections. $>
  ::index_value_iterator
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates an index/value iterator at index within storage. $>
    .CONSTRUCTOR
      FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Reports whether two iterators identify the same position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& dynarr#(T)::index_value_iterator) CONST: BOOL
    {
      RETURN .storage == OTHER.storage && .index == OTHER.index;
    }

    DOC <$ Orders positions within one dynamic array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& dynarr#(T)::index_value_iterator) CONST: ORDER
    {
      ASSERT(.storage == OTHER.storage,
        "Cannot order iterators from different dynamic arrays.");
      RETURN .index <=> OTHER.index;
    }

    DOC <$ Advances one position and returns the previous iterator. $>
    .OPERATOR++
      FUNCTION() MUT: dynarr#(T)::index_value_iterator
    {
      VAR previous dynarr#(T)::index_value_iterator := THIS;
      .index++;
      RETURN previous;
    }

    DOC <$ Advances by count positions. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& dynarr#(T)::index_value_iterator
    {
      .index += OTHER;
      RETURN THIS;
    }

    DOC <$ Returns the current mutable index/value projection. $>
    .OPERATOR->
      FUNCTION() CONST: dynarr#(T)::index_value
    {
      RETURN dynarr#(T)::index_value(@storage .storage, @index .index);
    }
  }


  DOC <$ Iterates constant index/value projections. $>
  ::const_index_value_iterator
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR CONST=>>TYPED_STORAGE(T);
      .index VAR SZ;
    }

    DOC <$ Creates a constant index/value iterator at index within storage. $>
    .CONSTRUCTOR
      FUNCTION(@storage CONST=>>TYPED_STORAGE(T), @index SZ)
    {
      .storage := storage;
      .index := index;
    }

    DOC <$ Reports whether two iterators identify the same position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& dynarr#(T)::const_index_value_iterator) CONST: BOOL
    {
      RETURN .storage == OTHER.storage && .index == OTHER.index;
