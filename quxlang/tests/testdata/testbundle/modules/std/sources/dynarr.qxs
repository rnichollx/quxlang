  DOC <$ Presents mutable index/value projections as a range. $>
  ::index_value_range
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .count VAR SZ;
    }

    DOC <$ Creates a mutable index/value range over count elements. $>
    .CONSTRUCTOR
      FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @count SZ)
    {
      .storage := storage;
      .count := count;
    }

    DOC <$ Returns an iterator to the first projection. $>
    .BEGIN
      FUNCTION() CONST: dynarr#(T)::index_value_iterator
    {
      RETURN dynarr#(T)::index_value_iterator(@storage .storage, @index 0);
    }

    DOC <$ Returns an iterator one position beyond the final projection. $>
    .END
      FUNCTION() CONST: dynarr#(T)::index_value_iterator
    {
      RETURN dynarr#(T)::index_value_iterator(@storage .storage, @index .count);
    }
  }


  DOC <$ Presents constant index/value projections as a range. $>
  ::const_index_value_range
    STRUCT
  {
    PRIVATE(CLASS)
    {
      .storage VAR CONST=>>TYPED_STORAGE(T);
      .count VAR SZ;
    }

    DOC <$ Creates a constant index/value range over count elements. $>
    .CONSTRUCTOR
      FUNCTION(@storage CONST=>>TYPED_STORAGE(T), @count SZ)
    {
      .storage := storage;
      .count := count;
    }

    DOC <$ Returns an iterator to the first projection. $>
    .BEGIN
      FUNCTION() CONST: dynarr#(T)::const_index_value_iterator
    {
      RETURN dynarr#(T)::const_index_value_iterator(@storage .storage, @index 0);
    }

    DOC <$ Returns an iterator one position beyond the final projection. $>
    .END
      FUNCTION() CONST: dynarr#(T)::const_index_value_iterator
    {
      RETURN dynarr#(T)::const_index_value_iterator(@storage .storage, @index .count);
    }
  }

  PRIVATE(CLASS)
  {
    .data VAR MUT=>>TYPED_STORAGE(T);
    .length VAR SZ;
    .allocated_count VAR SZ;

    DOC <$
      Grows geometrically until at least minimum elements fit without changing
      the logical size.
      $>
    .ensure_capacity
      FUNCTION(@minimum SZ) MUT: VOID
    {
      IF (.allocated_count >= minimum)
      {
        RETURN;
      }

      VAR maximum SZ := (0 AS SZ) #!!;
      VAR next_capacity SZ := .allocated_count;
      IF (next_capacity == 0)
      {
        next_capacity := 1;
      }
      LOOP WHILE (next_capacity < minimum) DO
      {
        IF (next_capacity > maximum / (2 AS SZ))
        {
          next_capacity := minimum;
        }
        ELSE
        {
          next_capacity *= 2;
        }
      }
      .reserve(next_capacity);
    }
  }

  DOC <$ Creates an empty dynamic array. $>
  .CONSTRUCTOR
    FUNCTION()
  {
  }

  DOC <$ Copies every element from OTHER in order. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER CONST& dynarr#(T))
  {
    .reserve(OTHER.length);
    LOOP WHILE (.length < OTHER.length) DO
    {
      PLACE AT(.data[.length]) T := PUN OTHER.data[.length] AS T;
      .length++;
    }
  }

  DOC <$ Transfers the allocation owned by OTHER. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER TEMP& dynarr#(T))
  {
    .data <-> OTHER.data;
    .length <-> OTHER.length;
    .allocated_count <-> OTHER.allocated_count;
  }

  DOC <$ Destroys all elements and releases the backing allocation. $>
  .DESTRUCTOR
    FUNCTION()
  {
    .clear();
    IF (.allocated_count != 0)
    {
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(
        @PTR .data,
        @COUNT .allocated_count
      );
    }
  }

  DOC <$ Returns the number of live elements. $>
  .size
    FUNCTION() CONST: SZ
  {
    RETURN .length;
  }

  DOC <$ Returns the number of elements that fit without reallocating. $>
  .capacity
    FUNCTION() CONST: SZ
  {
    RETURN .allocated_count;
  }

  DOC <$ Reports whether the array contains no elements. $>
  .empty
    FUNCTION() CONST: BOOL
  {
    RETURN .length == 0;
  }

  DOC <$ Ensures capacity elements fit without changing the logical size. $>
  .reserve
    FUNCTION(@ARG:capacity SZ) MUT: VOID
  {
    IF (capacity <= .allocated_count)
    {
      RETURN;
    }

    VAR replacement MUT=>>TYPED_STORAGE(T) :=
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_ALLOC(@COUNT capacity);
    VAR moved_count SZ := 0;
    LOOP WHILE (moved_count < .length) DO
    {
      VAR source MUT& T := PUN .data[moved_count] AS T;
      PLACE AT(replacement[moved_count]) T := MOVE(source);
      moved_count++;
    }

    VAR released_data MUT=>>TYPED_STORAGE(T) := .data;
    VAR released_capacity SZ := .allocated_count;
    .data := replacement;
    .allocated_count := capacity;

    VAR destroyed_count SZ := 0;
    LOOP WHILE (destroyed_count < .length) DO
    {
      DESTROY AT(released_data[destroyed_count]) T;
      destroyed_count++;
    }
    IF (released_capacity != 0)
    {
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(
        @PTR released_data,
        @COUNT released_capacity
      );
    }
  }

  DOC <$ Destroys all elements while retaining the allocation. $>
  .clear
    FUNCTION() MUT: VOID
  {
    LOOP WHILE (.length != 0) DO
    {
      .pop_back();
    }
  }

  DOC <$ Takes ownership of value before growth and moves it into the array. $>
  .push_back
    FUNCTION(@ARG:value T) MUT: VOID
  {
    .insert(@index .length, @value MOVE(value));
  }

  DOC <$ Inserts a copy of value before index and shifts later elements right. $>
  .insert
    FUNCTION(@index SZ, @value CONST& T) MUT: VOID
  {
    ASSERT(index <= .length, "Dynamic-array insertion index is out of range.");
    ASSERT(.length != ((0 AS SZ) #!!), "Dynamic-array size overflow.");
    VAR staged T := value;
    .ensure_capacity(@minimum .length + (1 AS SZ));

    VAR destination SZ := .length;
    LOOP WHILE (destination > index) DO
    {
      VAR source MUT& T := PUN .data[destination - (1 AS SZ)] AS T;
      PLACE AT(.data[destination]) T := MOVE(source);
      DESTROY AT(.data[destination - (1 AS SZ)]) T;
      destination--;
    }
    PLACE AT(.data[index]) T := MOVE(staged);
    .length++;
  }

  DOC <$ Inserts value by move construction and shifts later elements right. $>
  .insert
    FUNCTION(@index SZ, @value TEMP& T) MUT: VOID
  {
    ASSERT(index <= .length, "Dynamic-array insertion index is out of range.");
    ASSERT(.length != ((0 AS SZ) #!!), "Dynamic-array size overflow.");
    VAR staged T := FORWARD(value);
    .ensure_capacity(@minimum .length + (1 AS SZ));

    VAR destination SZ := .length;
    LOOP WHILE (destination > index) DO
    {
      VAR source MUT& T := PUN .data[destination - (1 AS SZ)] AS T;
      PLACE AT(.data[destination]) T := MOVE(source);
      DESTROY AT(.data[destination - (1 AS SZ)]) T;
      destination--;
    }
    PLACE AT(.data[index]) T := MOVE(staged);
    .length++;
  }

  DOC <$ Erases the element at index and shifts later elements left. $>
  .erase
    FUNCTION(@index SZ) MUT: VOID
  {
    ASSERT(index < .length, "Dynamic-array erase index is out of range.");
    DESTROY AT(.data[index]) T;
    VAR source SZ := index + (1 AS SZ);
    LOOP WHILE (source < .length) DO
    {
      VAR relocated MUT& T := PUN .data[source] AS T;
      PLACE AT(.data[source - (1 AS SZ)]) T := MOVE(relocated);
      DESTROY AT(.data[source]) T;
      source++;
    }
    .length--;
  }

  DOC <$
    Shrinks by destroying trailing elements or grows by default-constructing
    elements until size is reached.
    $>
  .resize
    FUNCTION(@ARG:size SZ) MUT: VOID
  {
    LOOP WHILE (.length > size) DO
    {
      .pop_back();
    }
    IF (.length < size)
    {
      .ensure_capacity(@minimum size);
      LOOP WHILE (.length < size) DO
      {
        PLACE AT(.data[.length]) T;
        .length++;
      }
    }
  }

  DOC <$ Destroys and removes the final element. $>
  .pop_back
    FUNCTION() MUT: VOID
  {
    ASSERT(.length != 0, "Cannot pop from an empty dynamic array.");
    .length--;
    DESTROY AT(.data[.length]) T;
  }

  DOC <$ Returns a mutable reference to the first element. $>
  .front
    FUNCTION() MUT: MUT& T
  {
    ASSERT(.length != 0, "Cannot access the front of an empty dynamic array.");
    RETURN PUN .data[0] AS T;
  }

  DOC <$ Returns a constant reference to the first element. $>
  .front
    FUNCTION() CONST: CONST& T
  {
    ASSERT(.length != 0, "Cannot access the front of an empty dynamic array.");
    RETURN PUN .data[0] AS T;
  }

  DOC <$ Returns a mutable reference to the final element. $>
  .back
    FUNCTION() MUT: MUT& T
  {
    ASSERT(.length != 0, "Cannot access the back of an empty dynamic array.");
    RETURN PUN .data[.length - (1 AS SZ)] AS T;
  }

  DOC <$ Returns a constant reference to the final element. $>
  .back
    FUNCTION() CONST: CONST& T
  {
    ASSERT(.length != 0, "Cannot access the back of an empty dynamic array.");
    RETURN PUN .data[.length - (1 AS SZ)] AS T;
  }

  DOC <$ Returns a mutable reference to the element at index. $>
  .OPERATOR[]
    FUNCTION(%index SZ) MUT: MUT& T
  {
    ASSERT(index < .length, "Dynamic-array index is out of range.");
    RETURN PUN .data[index] AS T;
  }

  DOC <$ Returns a constant reference to the element at index. $>
  .OPERATOR[]
    FUNCTION(%index SZ) CONST: CONST& T
  {
    ASSERT(index < .length, "Dynamic-array index is out of range.");
    RETURN PUN .data[index] AS T;
  }

  DOC <$ Returns a mutable iterator to the first element. $>
  .BEGIN
    FUNCTION() MUT: dynarr#(T)::iterator
  {
    RETURN dynarr#(T)::iterator(@storage .data, @index 0);
  }

  DOC <$ Returns a constant iterator to the first element. $>
  .BEGIN
    FUNCTION() CONST: dynarr#(T)::const_iterator
  {
    RETURN dynarr#(T)::const_iterator(@storage .data, @index 0);
  }

  DOC <$ Returns a mutable iterator one position beyond the final element. $>
  .END
    FUNCTION() MUT: dynarr#(T)::iterator
  {
    RETURN dynarr#(T)::iterator(@storage .data, @index .length);
  }

  DOC <$ Returns a constant iterator one position beyond the final element. $>
  .END
    FUNCTION() CONST: dynarr#(T)::const_iterator
  {
    RETURN dynarr#(T)::const_iterator(@storage .data, @index .length);
  }

  DOC <$ Returns this mutable array as its value range. $>
  .VALUES
    FUNCTION() MUT: MUT& dynarr#(T)
  {
    RETURN THIS;
  }

  DOC <$ Returns this constant array as its value range. $>
  .VALUES
    FUNCTION() CONST: CONST& dynarr#(T)
  {
    RETURN THIS;
  }

  DOC <$ Returns the array's zero-based indexes as a range. $>
  .INDEXES
    FUNCTION() CONST: dynarr#(T)::index_range
  {
    RETURN dynarr#(T)::index_range(@count .length);
  }

  DOC <$ Returns mutable zero-based index/value projections as a range. $>
  .IV_PAIRS
    FUNCTION() MUT: dynarr#(T)::index_value_range
  {
    RETURN dynarr#(T)::index_value_range(@storage .data, @count .length);
  }

  DOC <$ Returns constant zero-based index/value projections as a range. $>
  .IV_PAIRS
    FUNCTION() CONST: dynarr#(T)::const_index_value_range
  {
    RETURN dynarr#(T)::const_index_value_range(@storage .data, @count .length);
  }
}


DOC <$
  Tracks ownership transfer and destruction for dynamic-array lifecycle validation.
  $>
PRIVATE(MODULE, RUNTIME_MODULE) ::dynarr_move_lifecycle_test_value
  STRUCT MOVE_ONLY
{
  .value VAR I32;
  .destruction_count VAR MUT->I32;

  DOC <$ Constructs the probe value. $>
  .CONSTRUCTOR
    FUNCTION(@value I32, @destruction_count MUT& I32)
  {
    .value := value;
    .destruction_count := destruction_count<-;
  }

  DOC <$ Move-constructs the probe value. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER TEMP& dynarr_move_lifecycle_test_value)
  {
    .value := OTHER.value;
    VAR other_destruction_count MUT& MUT->I32 :=
      OTHER.destruction_count AS MUT& MUT->I32;
    .destruction_count := other_destruction_count;
    VAR empty MUT->I32;
    other_destruction_count := empty;
  }

  DOC <$ Records destruction of the currently owned probe value. $>
  .DESTRUCTOR
    FUNCTION()
  {
    IF (.destruction_count??)
    {
      .destruction_count-> := .destruction_count-> + 1;
    }
  }
}
