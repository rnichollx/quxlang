    DOC <$ Orders positions within one dynamic array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& dynarr#(T)::const_index_value_iterator) CONST: ORDER
    {
      ASSERT(.storage == OTHER.storage,
        "Cannot order iterators from different dynamic arrays.");
      RETURN .index <=> OTHER.index;
    }

    DOC <$ Advances one position and returns the previous iterator. $>
