::dynarr DOC <$
  Owns a contiguous, allocator-backed sequence of T values. Growth preserves
  element order, and operations destroy every removed value exactly once.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .data VAR MUT=>>TYPED_STORAGE(T);
    .length VAR SZ;
    .allocated_count VAR SZ;

    .ensure_capacity DOC <$
      Grows geometrically until at least minimum elements fit without changing
      the logical size.
      $>
      FUNCTION(@minimum SZ) MUT: VOID
    {
      IF (.allocated_count >= minimum)
      {
        RETURN;
      }

      VAR maximum SZ := (0 AS SZ) #!!;
      VAR next_capacity SZ := .allocated_count;
      IF (next_capacity == 0)
      {
        next_capacity := 1;
      }
      WHILE (next_capacity < minimum)
      {
        IF (next_capacity > maximum / (2 AS SZ))
        {
          next_capacity := minimum;
        }
        ELSE
        {
          next_capacity *= 2;
        }
      }
      .reserve(@capacity next_capacity);
    }
  }

  .CONSTRUCTOR DOC <$ Creates an empty dynamic array. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copies every element from OTHER in order. $>
    FUNCTION(@OTHER CONST& dynarr#(T))
  {
    .reserve(@capacity OTHER.length);
    WHILE (.length < OTHER.length)
    {
      PLACE AT(.data[.length]) T := PUN OTHER.data[.length] AS T;
      .length++;
    }
  }

  .CONSTRUCTOR DOC <$ Transfers the allocation owned by OTHER. $>
    FUNCTION(@OTHER TEMP& dynarr#(T))
  {
    VAR empty_data MUT=>>TYPED_STORAGE(T);
    .data := empty_data;
    .length := 0;
    .allocated_count := 0;
    VAR other_data MUT& MUT=>>TYPED_STORAGE(T) :=
      OTHER.data AS MUT& MUT=>>TYPED_STORAGE(T);
    VAR other_length MUT& SZ := OTHER.length AS MUT& SZ;
    VAR other_allocated_count MUT& SZ := OTHER.allocated_count AS MUT& SZ;
    .data <-> other_data;
    .length <-> other_length;
    .allocated_count <-> other_allocated_count;
  }

  .DESTRUCTOR DOC <$ Destroys all elements and releases the backing allocation. $>
    FUNCTION()
  {
    .clear();
    IF (.allocated_count != 0)
    {
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(
        @PTR .data,
        @COUNT .allocated_count
      );
    }
  }

  .size DOC <$ Returns the number of live elements. $>
    FUNCTION() CONST: SZ
  {
    RETURN .length;
  }

  .capacity DOC <$ Returns the number of elements that fit without reallocating. $>
    FUNCTION() CONST: SZ
  {
    RETURN .allocated_count;
  }

  .empty DOC <$ Reports whether the array contains no elements. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .length == 0;
  }

  .reserve DOC <$ Ensures capacity elements fit without changing the logical size. $>
    FUNCTION(@capacity SZ) MUT: VOID
  {
    IF (capacity <= .allocated_count)
    {
      RETURN;
    }

    VAR replacement MUT=>>TYPED_STORAGE(T) :=
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_ALLOC(@COUNT capacity);
    VAR moved_count SZ := 0;
    WHILE (moved_count < .length)
    {
      VAR source MUT& T := PUN .data[moved_count] AS T;
      PLACE AT(replacement[moved_count]) T := MOVE(source);
      moved_count++;
    }

    VAR released_data MUT=>>TYPED_STORAGE(T) := .data;
    VAR released_capacity SZ := .allocated_count;
    .data := replacement;
    .allocated_count := capacity;

    VAR destroyed_count SZ := 0;
    WHILE (destroyed_count < .length)
    {
      DESTROY AT(released_data[destroyed_count]) T;
      destroyed_count++;
    }
    IF (released_capacity != 0)
    {
      RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(
        @PTR released_data,
        @COUNT released_capacity
      );
    }
  }

  .clear DOC <$ Destroys all elements while retaining the allocation. $>
    FUNCTION() MUT: VOID
  {
    WHILE (.length != 0)
    {
      .pop_back();
    }
  }

  .push_back DOC <$ Appends a copy of value. $>
    FUNCTION(@value CONST& T) MUT: VOID
  {
    .insert(@index .length, @value value);
  }

  .push_back DOC <$ Appends value by move construction. $>
    FUNCTION(@value TEMP& T) MUT: VOID
  {
    .insert(@index .length, @value FORWARD(value));
  }

  .insert DOC <$ Inserts a copy of value before index and shifts later elements right. $>
    FUNCTION(@index SZ, @value CONST& T) MUT: VOID
  {
    ASSERT(index <= .length, "Dynamic-array insertion index is out of range.");
    ASSERT(.length != ((0 AS SZ) #!!), "Dynamic-array size overflow.");
    VAR staged T := value;
    .ensure_capacity(@minimum .length + (1 AS SZ));

    VAR destination SZ := .length;
    WHILE (destination > index)
    {
      VAR source MUT& T := PUN .data[destination - (1 AS SZ)] AS T;
      PLACE AT(.data[destination]) T := MOVE(source);
      DESTROY AT(.data[destination - (1 AS SZ)]) T;
      destination--;
    }
    PLACE AT(.data[index]) T := MOVE(staged);
    .length++;
  }

  .insert DOC <$ Inserts value by move construction and shifts later elements right. $>
    FUNCTION(@index SZ, @value TEMP& T) MUT: VOID
  {
    ASSERT(index <= .length, "Dynamic-array insertion index is out of range.");
    ASSERT(.length != ((0 AS SZ) #!!), "Dynamic-array size overflow.");
    VAR staged T := FORWARD(value);
    .ensure_capacity(@minimum .length + (1 AS SZ));

    VAR destination SZ := .length;
    WHILE (destination > index)
    {
      VAR source MUT& T := PUN .data[destination - (1 AS SZ)] AS T;
      PLACE AT(.data[destination]) T := MOVE(source);
      DESTROY AT(.data[destination - (1 AS SZ)]) T;
      destination--;
    }
    PLACE AT(.data[index]) T := MOVE(staged);
    .length++;
  }

  .erase DOC <$ Erases the element at index and shifts later elements left. $>
    FUNCTION(@index SZ) MUT: VOID
  {
    ASSERT(index < .length, "Dynamic-array erase index is out of range.");
    DESTROY AT(.data[index]) T;
    VAR source SZ := index + (1 AS SZ);
    WHILE (source < .length)
    {
      VAR relocated MUT& T := PUN .data[source] AS T;
      PLACE AT(.data[source - (1 AS SZ)]) T := MOVE(relocated);
      DESTROY AT(.data[source]) T;
      source++;
    }
    .length--;
  }

  .resize DOC <$
    Shrinks by destroying trailing elements or grows by default-constructing
    elements until size is reached.
    $>
    FUNCTION(@size SZ) MUT: VOID
  {
    WHILE (.length > size)
    {
      .pop_back();
    }
    IF (.length < size)
    {
      .ensure_capacity(@minimum size);
      WHILE (.length < size)
      {
        PLACE AT(.data[.length]) T;
        .length++;
      }
    }
  }

  .pop_back DOC <$ Destroys and removes the final element. $>
    FUNCTION() MUT: VOID
  {
    ASSERT(.length != 0, "Cannot pop from an empty dynamic array.");
    .length--;
    DESTROY AT(.data[.length]) T;
  }

  .front DOC <$ Returns a mutable reference to the first element. $>
    FUNCTION() MUT: MUT& T
  {
    ASSERT(.length != 0, "Cannot access the front of an empty dynamic array.");
    RETURN PUN .data[0] AS T;
  }

  .front DOC <$ Returns a constant reference to the first element. $>
    FUNCTION() CONST: CONST& T
  {
    ASSERT(.length != 0, "Cannot access the front of an empty dynamic array.");
    RETURN PUN .data[0] AS T;
  }

  .back DOC <$ Returns a mutable reference to the final element. $>
    FUNCTION() MUT: MUT& T
  {
    ASSERT(.length != 0, "Cannot access the back of an empty dynamic array.");
    RETURN PUN .data[.length - (1 AS SZ)] AS T;
  }

  .back DOC <$ Returns a constant reference to the final element. $>
    FUNCTION() CONST: CONST& T
  {
    ASSERT(.length != 0, "Cannot access the back of an empty dynamic array.");
    RETURN PUN .data[.length - (1 AS SZ)] AS T;
  }

  .OPERATOR[] DOC <$ Returns a mutable reference to the element at index. $>
    FUNCTION(%index SZ) MUT: MUT& T
  {
    ASSERT(index < .length, "Dynamic-array index is out of range.");
    RETURN PUN .data[index] AS T;
  }

  .OPERATOR[] DOC <$ Returns a constant reference to the element at index. $>
    FUNCTION(%index SZ) CONST: CONST& T
  {
    ASSERT(index < .length, "Dynamic-array index is out of range.");
    RETURN PUN .data[index] AS T;
  }

  .BEGIN DOC <$ Returns a mutable iterator to the first element. $>
    FUNCTION() MUT: dynarr_iterator#(T)
  {
    RETURN dynarr_iterator#(T)(@storage .data, @index 0);
  }

  .BEGIN DOC <$ Returns a constant iterator to the first element. $>
    FUNCTION() CONST: dynarr_const_iterator#(T)
  {
    RETURN dynarr_const_iterator#(T)(@storage .data, @index 0);
  }

  .END DOC <$ Returns a mutable iterator one position beyond the final element. $>
    FUNCTION() MUT: dynarr_iterator#(T)
  {
    RETURN dynarr_iterator#(T)(@storage .data, @index .length);
  }

  .END DOC <$ Returns a constant iterator one position beyond the final element. $>
    FUNCTION() CONST: dynarr_const_iterator#(T)
  {
    RETURN dynarr_const_iterator#(T)(@storage .data, @index .length);
  }

  .VALUES DOC <$ Returns this mutable array as its value range. $>
    FUNCTION() MUT: MUT& dynarr#(T)
  {
    RETURN THIS;
  }

  .VALUES DOC <$ Returns this constant array as its value range. $>
    FUNCTION() CONST: CONST& dynarr#(T)
  {
    RETURN THIS;
  }

  .INDEXES DOC <$ Returns the array's zero-based indexes as a range. $>
    FUNCTION() CONST: dynarr_index_range
  {
    RETURN dynarr_index_range(@count .length);
  }

  .IV_PAIRS DOC <$ Returns mutable zero-based index/value projections as a range. $>
    FUNCTION() MUT: dynarr_index_value_range#(T)
  {
    RETURN dynarr_index_value_range#(T)(@storage .data, @count .length);
  }

  .IV_PAIRS DOC <$ Returns constant zero-based index/value projections as a range. $>
    FUNCTION() CONST: dynarr_const_index_value_range#(T)
  {
    RETURN dynarr_const_index_value_range#(T)(@storage .data, @count .length);
  }
}


PRIVATE(MODULE, RUNTIME_MODULE) ::dynarr_move_lifecycle_test_value DOC <$
  Tracks ownership transfer and destruction for dynamic-array lifecycle validation.
  $>
  STRUCT MOVE_ONLY
{
  .value VAR I32;
  .destruction_count VAR MUT->I32;

  .CONSTRUCTOR DOC <$ Constructs the probe value. $>
    FUNCTION(@value I32, @destruction_count MUT& I32)
  {
    .value := value;
    .destruction_count := destruction_count<-;
  }

  .CONSTRUCTOR DOC <$ Move-constructs the probe value. $>
    FUNCTION(@OTHER TEMP& dynarr_move_lifecycle_test_value)
  {
    .value := OTHER.value;
    VAR other_destruction_count MUT& MUT->I32 :=
      OTHER.destruction_count AS MUT& MUT->I32;
    .destruction_count := other_destruction_count;
    VAR empty MUT->I32;
    other_destruction_count := empty;
  }

  .DESTRUCTOR DOC <$ Records destruction of the currently owned probe value. $>
    FUNCTION()
  {
    IF (.destruction_count??)
    {
      .destruction_count-> := .destruction_count-> + 1;
    }
  }
}


PRIVATE(MODULE) ::dynarr_operations_and_lifecycle_static_test STATIC_TEST
{
  VAR values dynarr#(I32);
  values.push_back(@value (2 AS I32));
  values.push_back(@value (6 AS I32));
  values.insert(@index 1, @value (4 AS I32));
  ASSERT(values.size() == 3);
  ASSERT(values.front() == 2);
  ASSERT(values[1] == 4);
  ASSERT(values.back() == 6);
  values.erase(@index 0);
  ASSERT(values[0] == 4);
  values.resize(@size 4);
  ASSERT(values.size() == 4);
  VAR index_total SZ := 0;
  LOOP INDEX(index) IN(values) DO
  {
    index_total += index;
  };
  ASSERT(index_total == 6);
  VAR pair_index_total SZ := 0;
  VAR pair_value_total I32 := 0;
  LOOP INDEX(index) VALUE(value) IN(values) DO
  {
    pair_index_total += index;
    pair_value_total += value;
    value++;
  };
  ASSERT(pair_index_total == 6);
  ASSERT(pair_value_total == 10);
  VAR constant_values CONST& dynarr#(I32) := values;
  VAR constant_iterator dynarr_const_iterator#(I32) := constant_values.BEGIN();
  ASSERT(constant_iterator-> == 5);
  VAR constant_total I32 := 0;
  LOOP VALUE(value) IN(constant_values) DO
  {
    constant_total += value;
  };
  ASSERT(constant_total == 14);
  VAR constant_pair_total I32 := 0;
  LOOP INDEX(index) VALUE(value) IN(constant_values) DO
  {
    constant_pair_total += value + (index AS CHECKED I32);
  };
  ASSERT(constant_pair_total == 20);

  VAR destruction_count I32 := 0;
  {
    VAR moved_values dynarr#(dynarr_move_lifecycle_test_value);
    moved_values.push_back(
      @value dynarr_move_lifecycle_test_value(
        @value 11,
        @destruction_count destruction_count
      )
    );
    moved_values.push_back(
      @value dynarr_move_lifecycle_test_value(
        @value 17,
        @destruction_count destruction_count
      )
    );
    moved_values.insert(
      @index 1,
      @value dynarr_move_lifecycle_test_value(
        @value 13,
        @destruction_count destruction_count
      )
    );
    moved_values.erase(@index 0);
    ASSERT(moved_values.size() == 2);
    ASSERT(moved_values[0].value == 13);
    ASSERT(moved_values[1].value == 17);
  }
  ASSERT(destruction_count == 3);
}
