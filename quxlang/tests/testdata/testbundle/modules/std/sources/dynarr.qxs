LANGUAGE QUXLANG EN 0.0;


::dynarr_iterator DOC <$
  Iterates mutable elements in a dynarr#(T). The iterator remains valid until
  the owning array reallocates or shifts or destroys its referenced element.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .storage VAR MUT=>>TYPED_STORAGE(T);
    .index VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates an iterator at index within storage. $>
    FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @index SZ)
  {
    .storage := storage;
    .index := index;
  }

  .OPERATOR== DOC <$ Reports whether two iterators identify the same position. $>
    FUNCTION(@OTHER CONST& dynarr_iterator#T) CONST: BOOL
  {
    RETURN .storage == OTHER.storage && .index == OTHER.index;
  }

  .OPERATOR<=> DOC <$ Orders positions within one dynamic array. $>
    FUNCTION(@OTHER CONST& dynarr_iterator#(T)) CONST: ORDER
  {
    ASSERT(.storage == OTHER.storage,
      "Cannot order iterators from different dynamic arrays.");
    RETURN .index <=> OTHER.index;
  }

  .OPERATOR++ DOC <$ Advances one position and returns the previous iterator. $>
    FUNCTION() MUT: dynarr_iterator#(T)
  {
    VAR previous dynarr_iterator#(T) := THIS;
    .index++;
    RETURN previous;
  }

  .OPERATOR+= DOC <$ Advances by count positions. $>
    FUNCTION(@OTHER SZ) MUT: MUT& dynarr_iterator#(T)
  {
    .index += OTHER;
    RETURN THIS;
  }

  .OPERATOR-> DOC <$ Returns a mutable reference to the current element. $>
    FUNCTION() CONST: MUT& T
  {
    RETURN PUN .storage[.index] AS T;
  }
}


::dynarr_const_iterator DOC <$
  Iterates constant elements in a dynarr#(T). The iterator remains valid until
  the owning array reallocates or shifts or destroys its referenced element.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .storage VAR CONST=>>TYPED_STORAGE(T);
    .index VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates a constant iterator at index within storage. $>
    FUNCTION(@storage CONST=>>TYPED_STORAGE(T), @index SZ)
  {
    .storage := storage;
    .index := index;
  }

  .CONSTRUCTOR DOC <$ Converts a mutable iterator to a constant iterator. $>
    FUNCTION(@OTHER CONST& dynarr_iterator#(T))
  {
    .storage := OTHER.storage;
    .index := OTHER.index;
  }

  .OPERATOR== DOC <$ Reports whether two iterators identify the same position. $>
    FUNCTION(@OTHER CONST& dynarr_const_iterator#(T)) CONST: BOOL
  {
    RETURN .storage == OTHER.storage && .index == OTHER.index;
  }

  .OPERATOR<=> DOC <$ Orders positions within one dynamic array. $>
    FUNCTION(@OTHER CONST& dynarr_const_iterator#(T)) CONST: ORDER
  {
    ASSERT(.storage == OTHER.storage,
      "Cannot order iterators from different dynamic arrays.");
    RETURN .index <=> OTHER.index;
  }

  .OPERATOR++ DOC <$ Advances one position and returns the previous iterator. $>
    FUNCTION() MUT: dynarr_const_iterator#(T)
  {
    VAR previous dynarr_const_iterator#(T) := THIS;
    .index++;
    RETURN previous;
  }

  .OPERATOR+= DOC <$ Advances by count positions. $>
    FUNCTION(@OTHER SZ) MUT: MUT& dynarr_const_iterator#(T)
  {
    .index += OTHER;
    RETURN THIS;
  }

  .OPERATOR-> DOC <$ Returns a constant reference to the current element. $>
    FUNCTION() CONST: CONST& T
  {
    RETURN PUN .storage[.index] AS T;
  }
}


::dynarr_index_iterator DOC <$ Iterates zero-based indexes in a dynamic array. $>
  STRUCT
{
  PRIVATE(CLASS)
  {
    .index VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates an index iterator at index. $>
    FUNCTION(@index SZ)
  {
    .index := index;
  }

  .OPERATOR== DOC <$ Reports whether two index iterators identify the same index. $>
    FUNCTION(@OTHER CONST& dynarr_index_iterator) CONST: BOOL
  {
    RETURN .index == OTHER.index;
  }

  .OPERATOR<=> DOC <$ Orders two indexes. $>
    FUNCTION(@OTHER CONST& dynarr_index_iterator) CONST: ORDER
  {
    RETURN .index <=> OTHER.index;
  }

  .OPERATOR++ DOC <$ Advances one index and returns the previous iterator. $>
    FUNCTION() MUT: dynarr_index_iterator
  {
    VAR previous dynarr_index_iterator := THIS;
    .index++;
    RETURN previous;
  }

  .OPERATOR+= DOC <$ Advances by count indexes. $>
    FUNCTION(@OTHER SZ) MUT: MUT& dynarr_index_iterator
  {
    .index += OTHER;
    RETURN THIS;
  }

  .OPERATOR-> DOC <$ Returns the current zero-based index. $>
    FUNCTION() CONST: SZ
  {
    RETURN .index;
  }
}


::dynarr_index_range DOC <$ Presents the zero-based indexes of a dynamic array as a range. $>
  STRUCT
{
  PRIVATE(CLASS)
  {
    .count VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates an index range containing count indexes. $>
    FUNCTION(@count SZ)
  {
    .count := count;
  }

  .BEGIN DOC <$ Returns an iterator to index zero. $>
    FUNCTION() CONST: dynarr_index_iterator
  {
    RETURN dynarr_index_iterator(@index 0);
  }

  .END DOC <$ Returns an iterator one position beyond the final index. $>
    FUNCTION() CONST: dynarr_index_iterator
  {
    RETURN dynarr_index_iterator(@index .count);
  }
}


::dynarr_index_value DOC <$
  Refers to one mutable dynamic-array element together with its zero-based
  index for combined INDEX and VALUE range iteration.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .storage VAR MUT=>>TYPED_STORAGE(T);
    .index VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates an index/value projection for one element. $>
    FUNCTION(@storage MUT=>>TYPED_STORAGE(T), @index SZ)
  {
    .storage := storage;
    .index := index;
  }

  .INDEX DOC <$ Returns the element's zero-based index. $>
    FUNCTION() CONST: SZ
  {
    RETURN .index;
  }

  .VALUE DOC <$ Returns a mutable reference to the indexed element. $>
    FUNCTION() CONST: MUT& T
  {
    RETURN PUN .storage[.index] AS T;
  }
}


