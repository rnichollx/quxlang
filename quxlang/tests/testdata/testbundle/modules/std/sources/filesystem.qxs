LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

DOC <$
  Reports the outcome of one file transfer. A successful transfer may contain
  fewer bytes than requested, including zero bytes at end of file.
  $>
::transfer_result
  STRUCT
{
  .size VAR SZ;
  .succeeded VAR BOOL;
}

DOC <$
  A non-owning reference to a mutable byte range. The referenced storage must
  remain alive for every operation that uses the reference.
  $>
::buffer_ref
  STRUCT
{
  .data VAR MUT=>>BYTE;
  .size VAR SZ;

  DOC <$ Creates a reference to data[0..size). $>
  .CONSTRUCTOR
    FUNCTION(@data MUT=>>BYTE, @size SZ)
  {
    .data := data;
    .size := size;
  }
}

::java_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/File"];

::java_random_access_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/RandomAccessFile"];

::jvm_file_create_temp_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"createTempFile"]
  CALLABLE CALLCONV JVM_STATIC(
    @prefix ~> RUNTIME_MODULE::java_string,
    @suffix ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_file
  );

::jvm_file_get_path INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"getPath"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_file;
    RETURN ~> RUNTIME_MODULE::java_string
  );

::jvm_file_delete_on_exit INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"deleteOnExit"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_file);

::jvm_random_access_file_constructor INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"<init>"]
  CALLABLE CALLCONV JVM_CONSTRUCTOR(
    @path ~> RUNTIME_MODULE::java_string,
    @mode ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_random_access_file
  );

::jvm_random_access_file_read INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"read"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I32
  );

::jvm_random_access_file_write INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"write"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @value I32
  );

::jvm_random_access_file_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"length"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I64
  );

::jvm_random_access_file_set_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"setLength"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @length I64
  );

::jvm_random_access_file_close INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"close"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_random_access_file);

DOC <$
  A non-owning reference to an open Linux file descriptor. Destroying this
  value does not close the descriptor.
  $>
::file_ref INCLUDE_IF(OS_LINUX)
  STRUCT
{
  .descriptor VAR I32;

  DOC <$ Creates an empty file reference. $>
  .CONSTRUCTOR
    FUNCTION() { .descriptor := -1; }

  DOC <$ Reports whether the reference contains a nonnegative descriptor. $>
  .is_valid
    FUNCTION() CONST: BOOL { RETURN .descriptor >= 0; }

  DOC <$ Creates a non-owning reference to descriptor. $>
  .CONSTRUCTOR
    FUNCTION(@descriptor I32)
  {
    .descriptor := descriptor;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::linux::read(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
  .write
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::linux::write(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$
    Closes the referenced descriptor. This operation does not track whether
    another file_ref still refers to the same descriptor.
    $>
  .close
    FUNCTION(): BOOL
  {
    RETURN syscall::linux::close(@fd .descriptor) == 0;
  }
}

DOC <$
  A non-owning reference to an open macOS file descriptor. Destroying this
  value does not close the descriptor.
  $>
::file_ref INCLUDE_IF(OS_MACOS)
  STRUCT
{
  .descriptor VAR I32;

  DOC <$ Creates an empty file reference. $>
  .CONSTRUCTOR
    FUNCTION() { .descriptor := -1; }

  DOC <$ Reports whether the reference contains a nonnegative descriptor. $>
  .is_valid
    FUNCTION() CONST: BOOL { RETURN .descriptor >= 0; }

  DOC <$ Creates a non-owning reference to descriptor. $>
  .CONSTRUCTOR
    FUNCTION(@descriptor I32)
  {
    .descriptor := descriptor;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::macos::read(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
  .write
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::macos::write(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$
    Closes the referenced descriptor. This operation does not track whether
    another file_ref still refers to the same descriptor.
    $>
  .close
    FUNCTION(): BOOL
  {
    RETURN syscall::macos::close(@fd .descriptor) == 0;
  }
}

DOC <$
  A non-owning reference to an open Java random-access file. Destroying this
  value does not close the Java object.
  $>
::file_ref INCLUDE_IF(ARCH_IS_JVM)
  STRUCT
{
  .random_access_file VAR ~> java_random_access_file;

  DOC <$ Creates an empty file reference. $>
  .CONSTRUCTOR
    FUNCTION() { }

  DOC <$ Reports whether the reference contains a Java file object. $>
  .is_valid
    FUNCTION() CONST: BOOL { RETURN .random_access_file != NULL; }

  DOC <$ Creates a non-owning reference to random_access_file. $>
  .CONSTRUCTOR
    FUNCTION(@random_access_file ~> java_random_access_file)
  {
    .random_access_file := random_access_file;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.succeeded := TRUE;
    LOOP WHILE (outcome.size < buffer.size) DO
    {
      VAR value I32 := jvm_random_access_file_read(@THIS .random_access_file);
      IF (value < 0)
      {
        result := outcome;
        RETURN;
      }
      buffer.data[outcome.size] := (value AS CHECKED U8) AS BYTE;
      outcome.size++;
    }
    result := outcome;
  }

  DOC <$ Writes buffer.size bytes from buffer and stores the outcome in result. $>
  .write
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    LOOP WHILE (outcome.size < buffer.size) DO
    {
      VAR value BYTE := buffer.data[outcome.size];
      jvm_random_access_file_write(
        @THIS .random_access_file,
        @value ((value AS U8) AS ASSUME I32)
      );
      outcome.size++;
    }
    outcome.succeeded := TRUE;
    result := outcome;
  }

  DOC <$ Returns the current file length in bytes. $>
  .size
    FUNCTION(): SZ
  {
    VAR length I64 := jvm_random_access_file_length(
      @THIS .random_access_file
    );
    RETURN length AS CHECKED SZ;
  }

  DOC <$ Truncates the file to zero bytes. $>
  .truncate
    FUNCTION()
  {
    jvm_random_access_file_set_length(
      @THIS .random_access_file,
      @length 0
    );
  }

  DOC <$ Closes the referenced Java random-access file. $>
  .close
    FUNCTION(): BOOL
  {
    jvm_random_access_file_close(@THIS .random_access_file);
    RETURN TRUE;
  }
}

::windows_read_file INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"ReadFile"]
  CALLABLE CALLCONV CCALL(
    @handle ADDRESS,
    @buffer MUT=>>BYTE,
    @count U32,
    @transferred MUT->U32,
    @overlapped =>>BYTE;
    RETURN BOOL
  );

::windows_write_file INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"WriteFile"]
  CALLABLE CALLCONV CCALL(
    @handle ADDRESS,
    @buffer CONST=>>BYTE,
    @count U32,
    @transferred MUT->U32,
    @overlapped =>>BYTE;
    RETURN BOOL
  );

::windows_close_handle INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"CloseHandle"]
  CALLABLE CALLCONV CCALL(@handle ADDRESS; RETURN BOOL);

DOC <$
  Limits one Windows transfer to the DWORD count accepted by ReadFile and
  WriteFile. Callers can continue with the untransferred suffix.
  $>
::windows_transfer_size INCLUDE_IF(OS_WINDOWS)
  FUNCTION(@size SZ): U32
{
  VAR maximum U32 := (0 AS U32) #!!;
  IF (size > maximum AS SZ)
  {
    RETURN maximum;
  }
  RETURN size AS ASSUME U32;
}

DOC <$
  A non-owning reference to an open Windows file HANDLE. Destroying this value
  does not close the handle.
  $>
::file_ref INCLUDE_IF(OS_WINDOWS)
  STRUCT
{
  DOC <$ Borrows a Windows process standard handle selected by ARG. $>
  ::get_standard_handle
    EXTERN_PROCEDURE["kernel32":"GetStdHandle"]
    CALLABLE CALLCONV CCALL(@ARG I32; RETURN ADDRESS);

  .handle VAR ADDRESS;

  DOC <$ Creates an empty file reference. $>
  .CONSTRUCTOR
    FUNCTION() { }

  DOC <$ Rejects null and INVALID_HANDLE_VALUE references. $>
  .is_valid
    FUNCTION() CONST: BOOL
  {
    VAR null_address ADDRESS;
    RETURN .handle != NULL && .handle != null_address - (1 AS SZ);
  }

  DOC <$ Creates a non-owning reference to handle. $>
  .CONSTRUCTOR
    FUNCTION(@handle ADDRESS)
  {
    .handle := handle;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped =>>BYTE;
    outcome.succeeded := windows_read_file(
      @handle .handle,
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    );
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
  .write
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped =>>BYTE;
    outcome.succeeded := windows_write_file(
      @handle .handle,
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    );
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  DOC <$
    Closes the referenced handle. This operation does not track whether another
    file_ref still refers to the same handle.
    $>
  .close
    FUNCTION(): BOOL
  {
    RETURN windows_close_handle(@handle .handle);
  }
}

DOC <$
  A move-only RAII owner of a file_ref. Default construction creates a closed
  owner. Construction from a valid file_ref transfers exclusive ownership;
  the caller retains no responsibility for closing the native resource.
  Moving releases the source. Destruction closes a valid owned reference once.
  $>
::file
  STRUCT MOVE_ONLY
{
  PRIVATE(CLASS)
  {
    .native_ref VAR file_ref;
  }

  DOC <$ Creates a closed owner. $>
  .CONSTRUCTOR
    FUNCTION() { }

  DOC <$ Takes exclusive ownership of native_ref. Empty references remain closed. $>
  .CONSTRUCTOR
    FUNCTION(@native_ref file_ref)
  {
    .native_ref := native_ref;
  }

  DOC <$ Transfers ownership from OTHER and leaves OTHER closed. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER TEMP& file)
  {
    .native_ref := OTHER.release();
  }

  DOC <$ Closes the current resource and transfers ownership from OTHER. Self-move preserves ownership. $>
  .OPERATOR:=
    FUNCTION(@OTHER TEMP& file) MUT
  {
    VAR incoming file_ref := OTHER.release();
    .close();
    .native_ref := incoming;
  }

  DOC <$ Closes the owned reference if it is valid. $>
  .DESTRUCTOR
    FUNCTION() { .close(); }

  DOC <$ Borrows the owned reference without transferring responsibility for closing it. $>
  .reference
    FUNCTION() CONST: file_ref
  {
    RETURN .native_ref;
  }

  DOC <$ Reports whether this value owns a valid native reference. $>
  .is_open
    FUNCTION() CONST: BOOL
  {
    RETURN .native_ref.is_valid();
  }

  DOC <$ Transfers responsibility for closing the reference to the caller and leaves this owner closed. $>
  .release
    FUNCTION() MUT: file_ref
  {
    VAR previous file_ref := .native_ref;
    VAR empty file_ref;
    .native_ref := empty;
    RETURN previous;
  }

  DOC <$ Reads into buffer through the owned reference. Closed owners report an unsuccessful transfer. $>
  .read
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.is_open())
    {
      .native_ref.read(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    result := outcome;
  }

  DOC <$ Writes buffer through the owned reference. Closed owners report an unsuccessful transfer. $>
  .write
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.is_open())
    {
      .native_ref.write(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    result := outcome;
  }

  DOC <$ Relinquishes ownership before closing the native reference. Closed owners succeed without a native call; failed closes are not retried. $>
  .close
    FUNCTION(): BOOL
  {
    IF (.is_open() == FALSE) { RETURN TRUE; }
    VAR previous file_ref := .release();
    RETURN previous.close();
  }
}

PRIVATE(MODULE)
{
  ::posix_filesystem INCLUDE_IF(OS_LINUX) ALIAS syscall::linux;
  ::posix_filesystem INCLUDE_IF(OS_MACOS) ALIAS syscall::macos;

  DOC <$
    Opens a null-terminated copy of path with flags and transfers the descriptor
    to an owning file. Embedded null bytes and open failures throw an I32 value.
    Creation permissions are read/write for all users, restricted by the process umask.
    $>
  ::open_posix INCLUDE_IF(OS_LINUX || OS_MACOS)
    FUNCTION(@path CONST& string, @flags posix_filesystem::open_flags): file
  {
    VAR native_path dynarr#BYTE;
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(path.size()) DO
    {
      VAR character BYTE := path[index];
      IF (character == 0) { THROW (-1 AS I32); }
      native_path.push_back(character);
    }
    native_path.push_back(0);
    VAR address ADDRESS := IBC_GETADDR(@PTR native_path[0]<-);
    VAR bytes CONST=>>BYTE := IBC_PUN#(CONST=>>BYTE)(@ADDR address);
    VAR descriptor I32 := posix_filesystem::open(
      @path bytes,
      @flags flags #|| posix_filesystem::open_flags::cloexec,
      @mode posix_filesystem::file_mode::rusr #|| posix_filesystem::file_mode::wusr
        #|| posix_filesystem::file_mode::rgrp #|| posix_filesystem::file_mode::wgrp
        #|| posix_filesystem::file_mode::roth #|| posix_filesystem::file_mode::woth
    );
    IF (descriptor < 0) { THROW descriptor; }
    RETURN file(@native_ref file_ref(@descriptor descriptor));
  }
}

DOC <$
  Opens an existing path for reading and returns its owner. Embedded null bytes
  and open failures throw an I32 value. The file is closed during unwinding.
  $>
::open_read INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& string): file
{
  RETURN open_posix(@path path, @flags posix_filesystem::rdonly);
}

DOC <$
  Opens path for reading and writing, creating it when absent, and returns its
  owner. Existing contents are preserved. Embedded null bytes and open failures
  throw an I32 value. Creation permissions are restricted by the process umask.
  $>
::open_read_write INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& string): file
{
  RETURN open_posix(@path path,
    @flags posix_filesystem::open_flags::rdwr #|| posix_filesystem::open_flags::creat);
}

DOC <$
  Opens path for reading and writing, creating it when absent and truncating
  existing contents, and returns its owner. Embedded null bytes and open failures
  throw an I32 value. Creation permissions are restricted by the process umask.
  $>
::open_replace INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& string): file
{
  RETURN open_posix(@path path,
    @flags posix_filesystem::open_flags::rdwr #|| posix_filesystem::open_flags::creat
      #|| posix_filesystem::open_flags::trunc);
}

DOC <$
  Opens path for Java random-access reading and writing and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
::open_read_write INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

DOC <$
  Opens path for Java random-access reading and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
::open_read INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "r";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

DOC <$
  Opens path for Java random-access reading and writing, truncates it, and
  returns its owner. Java I/O exceptions propagate out of the generated JVM
  program.
  $>
::open_replace INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  VAR reference file_ref := file_ref(
    @random_access_file random_access_file
  );
  reference.truncate();
  RETURN file(@native_ref reference);
}

DOC <$
  Creates an empty temporary file, schedules deletion when the JVM exits, and
  returns its path.
  $>
::create_temporary_path INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(): string
{
  VAR prefix string := "quxlang-cortado-";
  VAR suffix string := ".tmp";
  VAR java_prefix ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value prefix);
  VAR java_suffix ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value suffix);
  VAR temporary_file ~> java_file := jvm_file_create_temp_file(
    @prefix java_prefix,
    @suffix java_suffix
  );
  jvm_file_delete_on_exit(@THIS temporary_file);
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    jvm_file_get_path(@THIS temporary_file);
  RETURN string_from_java_string(@value java_path);
}
