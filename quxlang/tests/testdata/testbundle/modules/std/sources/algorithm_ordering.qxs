DOC <$ Tests whether the sorted first input contains every second-input multiplicity. $>
::includes FUNCTION(@first1 AUTO(iterator1), @last1 AUTO(sentinel1), @first2 AUTO(iterator2), @last2 AUTO(sentinel2), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "compare") == FALSE)
  {
    VAR default_value compare_three_way;
    RETURN APPLY COMPOSITE_JOIN(:{ .first1 = first1 AS iterator1; .last1 = last1 AS sentinel1; .first2 = first2 AS iterator2; .last2 = last2 AS sentinel2; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .compare = default_value; })) TO includes;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection1") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first1 = first1 AS iterator1; .last1 = last1 AS sentinel1; .first2 = first2 AS iterator2; .last2 = last2 AS sentinel2; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection1 = default_value; })) TO includes;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection2") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first1 = first1 AS iterator1; .last1 = last1 AS sentinel1; .first2 = first2 AS iterator2; .last2 = last2 AS sentinel2; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection2 = default_value; })) TO includes;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first1 = first1 AS iterator1; .last1 = last1 AS sentinel1; .first2 = first2 AS iterator2; .last2 = last2 AS sentinel2; }, COMPOSITE_FORWARD(options)) TO includes_iterators;
  }
}

DOC <$ Tests whether the sorted first input contains every second-input multiplicity. $>
PRIVATE(MODULE)
::includes_iterators
  FUNCTION(@first1 AUTO(iterator1), @last1 AUTO(sentinel1), @first2 AUTO(iterator2), @last2 AUTO(sentinel2), @compare TT(compare_type), @projection1 TT(projection1_type), @projection2 TT(projection2_type)): BOOL
{
  LOOP WHILE (first2 != last2) DO
  {
    IF (first1 == last1) { RETURN FALSE; }
    VAR order ORDER := compare(@left projection1(first1->), @right projection2(first2->));
    IF (order == ORDER::GREATER) { RETURN FALSE; }
    IF (order == ORDER::EQUAL) { first2++; }
    first1++;
  }
  RETURN TRUE;
}

DOC <$ Advances the bidirectional permutation, wrapping to its opposite extreme on failure. $>
::next_permutation FUNCTION(@first AUTO(input_iterator), @last AUTO(input_iterator), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "compare") == FALSE)
  {
    VAR default_value compare_three_way;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .compare = default_value; })) TO next_permutation;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO next_permutation;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_FORWARD(options)) TO next_permutation_iterators;
  }
}

DOC <$ Advances the bidirectional permutation, wrapping to its opposite extreme on failure. $>
PRIVATE(MODULE)
::next_permutation_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(input_iterator), @compare TT(compare_type), @projection TT(projection_type)): BOOL
{
  IF (first == last) { RETURN FALSE; }
  VAR cursor input_iterator := last; cursor--;
  IF (cursor == first) { RETURN FALSE; }
  LOOP DO
  {
    VAR suffix input_iterator := cursor;
    cursor--;
    IF (compare(@left projection(cursor->), @right projection(suffix->)) == ORDER::LESS)
    {
      VAR selected input_iterator := last;
      LOOP DO
      { selected--; IF (compare(@left projection(cursor->), @right projection(selected->)) == ORDER::LESS) { BREAK; } }
      cursor-> <-> selected->;
      reverse(@first suffix, @last last);
      RETURN TRUE;
    }
    IF (cursor == first) { reverse(@first first, @last last); RETURN FALSE; }
  }
}

DOC <$ Advances the bidirectional permutation, wrapping to its opposite extreme on failure. $>
::prev_permutation FUNCTION(@first AUTO(input_iterator), @last AUTO(input_iterator), @KWARGS:options ...): AUTO
{
  STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "compare") == FALSE)
  {
    VAR default_value compare_three_way;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .compare = default_value; })) TO prev_permutation;
  }
  STATIC_ELSE STATIC_IF(COMPOSITE_CONTAINS(DECLTYPE(options), "projection") == FALSE)
  {
    VAR default_value identity;
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_JOIN(COMPOSITE_FORWARD(options), :{ .projection = default_value; })) TO prev_permutation;
  }
  STATIC_ELSE
  {
    RETURN APPLY COMPOSITE_JOIN(:{ .first = first AS input_iterator; .last = last AS input_iterator; }, COMPOSITE_FORWARD(options)) TO prev_permutation_iterators;
  }
}

DOC <$ Advances the bidirectional permutation, wrapping to its opposite extreme on failure. $>
PRIVATE(MODULE)
::prev_permutation_iterators
  FUNCTION(@first AUTO(input_iterator), @last AUTO(input_iterator), @compare TT(compare_type), @projection TT(projection_type)): BOOL
{
  IF (first == last) { RETURN FALSE; }
  VAR cursor input_iterator := last; cursor--;
  IF (cursor == first) { RETURN FALSE; }
  LOOP DO
  {
    VAR suffix input_iterator := cursor;
    cursor--;
    IF (compare(@left projection(cursor->), @right projection(suffix->)) == ORDER::GREATER)
    {
      VAR selected input_iterator := last;
      LOOP DO
      { selected--; IF (compare(@left projection(cursor->), @right projection(selected->)) == ORDER::GREATER) { BREAK; } }
      cursor-> <-> selected->;
      reverse(@first suffix, @last last);
      RETURN TRUE;
    }
    IF (cursor == first) { reverse(@first first, @last last); RETURN FALSE; }
  }
}

