DOC <$ Combines sorted inputs with stable first-input preference and duplicate multiplicities. $>
PRIVATE(MODULE)
::set_intersection_iterators
  FUNCTION(@first1 AUTO(iterator1), @last1 AUTO(sentinel1), @first2 AUTO(iterator2), @last2 AUTO(sentinel2), @output AUTO(output_iterator), @compare TT(compare_type), @projection1 TT(projection1_type), @projection2 TT(projection2_type)): AUTO
