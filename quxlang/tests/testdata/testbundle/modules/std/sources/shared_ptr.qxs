LANGUAGE QUXLANG EN 0.0;


PRIVATE(MODULE, RUNTIME_MODULE)
{
  ::strong_control_block DOC <$
    Stores one shared object and the atomic strong and weak ownership counts
    governing its lifetime.
    $>
  TEMPLATE(@T TYPE AUTO) STRUCT MOVE_ONLY
  {
    .strong_count VAR ATOMIC#SZ;
    .weak_count VAR ATOMIC#SZ;
    .value_storage VAR TYPED_STORAGE(T);

    .CONSTRUCTOR DOC <$ Default-constructs the owned value with one strong and one implicit weak reference. $>
      FUNCTION()
    {
      .strong_count.STORE#ATOMIC_RELEASE(1);
      .weak_count.STORE#ATOMIC_RELEASE(1);
      PLACE AT(.value_storage) T;
    }

    .CONSTRUCTOR DOC <$ Constructs the owned value with one strong and one implicit weak reference. $>
      FUNCTION(%value AUTO& T)
    {
      .strong_count.STORE#ATOMIC_RELEASE(1);
      .weak_count.STORE#ATOMIC_RELEASE(1);
      PLACE AT(.value_storage) T := FORWARD(value);
    }
  }

  ::retain_strong_reference DOC <$
    Adds one strong reference while another strong reference keeps the object
    alive.
    $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@control MUT->strong_control_block#(T))
  {
    VAR observed SZ := control->.strong_count.LOAD#ATOMIC_ACQUIRE();
    LOOP WHILE(TRUE) DO
    {
      ASSERT(observed != 0, "Cannot retain an expired shared object.");
      ASSERT(observed != ((0 AS SZ) #!!), "Shared reference count overflow.");
      IF (control->.strong_count.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(% [observed, observed + (1 AS SZ)]))
      {
        RETURN;
      }
    };
  }

  ::release_strong_reference DOC <$
    Releases one strong reference, destroying the object and its implicit weak
    reference when the final owner leaves.
    $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@control MUT->strong_control_block#(T))
  {
    VAR previous_strong SZ :=
      control->.strong_count.FETCH_SUB#ATOMIC_ACQREL(1);
    ASSERT(previous_strong != 0, "Shared reference count underflow.");
    IF (previous_strong == 1)
    {
      DESTROY AT(control->.value_storage) T;
      VAR previous_weak SZ :=
        control->.weak_count.FETCH_SUB#ATOMIC_ACQREL(1);
      ASSERT(previous_weak != 0, "Weak reference count underflow.");
      IF (previous_weak == 1)
      {
        DELETE control;
      }
    }
  }

  ::retain_weak_reference DOC <$
    Adds one weak reference while an existing strong or weak reference keeps
    the control block alive.
    $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@control MUT->strong_control_block#(T))
  {
    VAR observed SZ := control->.weak_count.LOAD#ATOMIC_ACQUIRE();
    LOOP WHILE(TRUE) DO
    {
      ASSERT(observed != 0, "Cannot retain a released shared control block.");
      ASSERT(observed != ((0 AS SZ) #!!), "Weak reference count overflow.");
      IF (control->.weak_count.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(% [observed, observed + (1 AS SZ)]))
      {
        RETURN;
      }
    };
  }

  ::release_weak_reference DOC <$
    Releases one weak reference and frees the expired control block after the
    final observer leaves.
    $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@control MUT->strong_control_block#(T))
  {
    VAR previous SZ := control->.weak_count.FETCH_SUB#ATOMIC_ACQREL(1);
    ASSERT(previous != 0, "Weak reference count underflow.");
    IF (previous == 1)
    {
      ASSERT(control->.strong_count.LOAD#ATOMIC_ACQUIRE() == 0,
        "A live shared object must retain its implicit weak reference.");
      DELETE control;
    }
  }
}


::strong_ptr DOC <$
  Shares ownership of one heap-allocated T through an atomic control block.
  Copies share ownership, moves transfer ownership, and the final strong owner
  destroys T.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .control VAR MUT->strong_control_block#(T);

    .CONSTRUCTOR DOC <$ Adopts one strong reference already recorded by control. $>
      FUNCTION(@control MUT->strong_control_block#(T))
    {
      .control := control;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an empty shared pointer. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Shares ownership held by OTHER. $>
    FUNCTION(@OTHER CONST& strong_ptr#(T))
  {
    .control := OTHER.control;
    IF (.control??)
    {
      retain_strong_reference#T(@control .control);
    }
  }

  .CONSTRUCTOR DOC <$ Transfers ownership from OTHER without changing the reference count. $>
    FUNCTION(@OTHER TEMP& strong_ptr#(T))
  {
    VAR empty MUT->strong_control_block#(T);
    .control := empty;
    VAR other_control MUT& MUT->strong_control_block#(T) :=
      OTHER.control AS MUT& MUT->strong_control_block#(T);
    .control <-> other_control;
  }

  .DESTRUCTOR DOC <$ Releases this object's strong reference, if any. $>
    FUNCTION()
  {
    .reset();
  }

  .reset DOC <$ Releases ownership and leaves this pointer empty. $>
    FUNCTION()
  {
    IF (.control??)
    {
      VAR released MUT->strong_control_block#(T) := .control;
      VAR empty MUT->strong_control_block#(T);
      .control := empty;
      release_strong_reference#T(@control released);
    }
  }

  .has_value DOC <$ Reports whether this pointer owns a live object. $>
    FUNCTION(): BOOL
  {
    RETURN .control??;
  }

  .get DOC <$ Returns the owned object pointer, or a null pointer when empty. $>
    FUNCTION(): MUT->T
  {
    IF ((.control??) == FALSE)
    {
      VAR empty MUT->T;
      RETURN empty;
    }
    RETURN (PUN .control->.value_storage AS T)<-;
  }

  .use_count DOC <$ Returns the current number of strong owners. $>
    FUNCTION(): SZ
  {
    IF ((.control??) == FALSE)
    {
      RETURN 0;
    }
    RETURN .control->.strong_count.LOAD#ATOMIC_ACQUIRE();
  }

  .OPERATOR-> DOC <$ Returns a mutable reference to the owned object. $>
    FUNCTION(): MUT& T
  {
    ASSERT(.control??, "Cannot dereference an empty shared pointer.");
    RETURN (PUN .control->.value_storage AS T);
  }

  .OPERATOR== DOC <$ Compares ownership identities. $>
    FUNCTION(@OTHER CONST& strong_ptr#(T)): BOOL
  {
    RETURN .control == OTHER.control;
  }
}


::weak_ptr DOC <$
  Observes an object owned by strong_ptr#(T) without extending its lifetime.
  lock atomically creates a strong owner only while the object remains alive.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(CLASS)
  {
    .control VAR MUT->strong_control_block#(T);
  }

  .CONSTRUCTOR DOC <$ Creates an empty weak pointer. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Observes the object owned by OTHER. $>
    FUNCTION(@OTHER CONST& strong_ptr#(T))
  {
    .control := OTHER.control;
    IF (.control??)
    {
      retain_weak_reference#T(@control .control);
    }
  }

  .CONSTRUCTOR DOC <$ Copies another weak observation. $>
    FUNCTION(@OTHER CONST& weak_ptr#(T))
  {
    .control := OTHER.control;
    IF (.control??)
    {
      retain_weak_reference#T(@control .control);
    }
  }

  .CONSTRUCTOR DOC <$ Transfers another weak observation without changing the reference count. $>
    FUNCTION(@OTHER TEMP& weak_ptr#(T))
  {
    VAR empty MUT->strong_control_block#(T);
    .control := empty;
    VAR other_control MUT& MUT->strong_control_block#(T) :=
      OTHER.control AS MUT& MUT->strong_control_block#(T);
    .control <-> other_control;
  }

  .DESTRUCTOR DOC <$ Releases this object's weak reference, if any. $>
    FUNCTION()
  {
    .reset();
  }

  .reset DOC <$ Releases the observation and leaves this pointer empty. $>
    FUNCTION()
  {
    IF (.control??)
    {
      VAR released MUT->strong_control_block#(T) := .control;
      VAR empty MUT->strong_control_block#(T);
      .control := empty;
      release_weak_reference#T(@control released);
    }
  }

  .use_count DOC <$ Returns the current number of strong owners. $>
    FUNCTION(): SZ
  {
    IF ((.control??) == FALSE)
    {
      RETURN 0;
    }
    RETURN .control->.strong_count.LOAD#ATOMIC_ACQUIRE();
  }

  .expired DOC <$ Reports whether no strong owners remain. $>
    FUNCTION(): BOOL
  {
    RETURN .use_count() == 0;
  }

  .lock DOC <$ Atomically acquires shared ownership when the object is still alive. $>
    FUNCTION(): strong_ptr#(T)
  {
    IF (.control??)
    {
      VAR observed SZ := .control->.strong_count.LOAD#ATOMIC_ACQUIRE();
      LOOP WHILE (observed != 0) DO
      {
        ASSERT(observed != ((0 AS SZ) #!!), "Shared reference count overflow.");
        IF (.control->.strong_count.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(% [observed, observed + (1 AS SZ)]))
        {
          RETURN strong_ptr#(T)(@control .control);
        }
      }
    }
    VAR empty strong_ptr#(T);
    RETURN empty;
  }
}


::make_strong DOC <$
  Allocates one control block containing a default-constructed T and returns its
  first strong owner.
  $>
  TEMPLATE(@T TYPE AUTO) FUNCTION(): strong_ptr#(T)
{
  VAR control MUT->strong_control_block#(T) := NEW strong_control_block#(T);
  RETURN strong_ptr#(T)(@control control);
}


::make_strong_value DOC <$
  Allocates one control block containing a T constructed from value and returns
  its first strong owner.
  $>
  TEMPLATE(@T TYPE AUTO)
    FUNCTION(@ARG:value AUTO& T): strong_ptr#(T)
{
  VAR control MUT->strong_control_block#(T) := NEW strong_control_block#(T):[FORWARD(value)];
  RETURN strong_ptr#(T)(@control control);
}


::shared_pointer_layout_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STATIC_TEST
{
  TEST_ASSERT(SIZEOF(strong_ptr#(I32)) == SIZEOF(UINTPTR));
  TEST_ASSERT(SIZEOF(weak_ptr#(I32)) == SIZEOF(UINTPTR));
}


PRIVATE(MODULE, RUNTIME_MODULE)
{
  ::shared_allocation DOC <$ Stores one object and its atomic ownership count in one allocation. $>
    TEMPLATE(@T TYPE AUTO) STRUCT MOVE_ONLY
  {
    .count VAR ATOMIC#SZ;
    .value VAR T;

    .CONSTRUCTOR DOC <$ Default-constructs the object with one owner. $>
      FUNCTION()
    {
      .count.STORE#ATOMIC_RELEASE(1);
    }

    .CONSTRUCTOR DOC <$ Constructs the object from value with one owner. $>
      FUNCTION(%value AUTO& T)
    {
      .value := FORWARD(value);
      .count.STORE#ATOMIC_RELEASE(1);
    }
  }
}


::shared_ptr DOC <$
  Shares ownership of one object allocated together with an atomic reference count.
  The final owner destroys the object and releases the allocation.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE)
  {
    .allocation VAR MUT->shared_allocation#(T);

    .CONSTRUCTOR DOC <$ Adopts the initial reference in allocation. $>
      FUNCTION(@allocation MUT->shared_allocation#(T))
    {
      .allocation := allocation;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an empty shared pointer. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Shares ownership held by OTHER. $>
    FUNCTION(@OTHER CONST& shared_ptr#(T))
  {
    .allocation := OTHER.allocation;
    IF (.allocation??)
    {
      VAR allocation MUT& shared_allocation#(T) := .allocation->;
      VAR observed SZ := allocation.count.LOAD#ATOMIC_ACQUIRE();
      LOOP WHILE(TRUE) DO
      {
        ASSERT(observed != 0, "Cannot retain an expired shared object.");
        ASSERT(observed != ((0 AS SZ) #!!), "Shared reference count overflow.");
        IF (allocation.count.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(% [observed, observed + (1 AS SZ)]))
        {
          RETURN;
        }
      };
    }
  }

  .CONSTRUCTOR DOC <$ Transfers ownership from OTHER without changing the reference count. $>
    FUNCTION(@OTHER TEMP& shared_ptr#(T))
  {
    VAR other_allocation MUT& MUT->shared_allocation#(T) :=
      OTHER.allocation AS MUT& MUT->shared_allocation#(T);
    .allocation <-> other_allocation;
  }

  .DESTRUCTOR DOC <$ Releases this object's reference, if any. $>
    FUNCTION()
  {
    .reset();
  }

  .reset DOC <$ Releases ownership and leaves this pointer empty. $>
    FUNCTION()
  {
    IF (.allocation??)
    {
      VAR released MUT->shared_allocation#(T) := .allocation;
      .allocation := NULL;
      VAR allocation MUT& shared_allocation#(T) := released->;
      VAR previous SZ := allocation.count.FETCH_SUB#ATOMIC_ACQREL(1);
      ASSERT(previous != 0, "Shared reference count underflow.");
      IF (previous == 1)
      {
        DELETE released;
      }
    }
  }

  .has_value DOC <$ Reports whether this pointer owns an object. $>
    FUNCTION(): BOOL
  {
    RETURN .allocation??;
  }

  .get DOC <$ Returns the owned object pointer, or a null pointer when empty. $>
    FUNCTION(): MUT->T
  {
    IF ((.allocation??) == FALSE)
    {
      VAR empty MUT->T;
      RETURN empty;
    }
    RETURN .allocation->.value<-;
  }

  .use_count DOC <$ Returns the current number of owners. $>
    FUNCTION(): SZ
  {
    IF ((.allocation??) == FALSE)
    {
      RETURN 0;
    }
    RETURN .allocation->.count.LOAD#ATOMIC_ACQUIRE();
  }

  .OPERATOR-> DOC <$ Returns a mutable reference to the owned object. $>
    FUNCTION(): MUT& T
  {
    ASSERT(.allocation??, "Cannot dereference an empty shared pointer.");
    RETURN .allocation->.value;
  }

  .OPERATOR== DOC <$ Compares ownership identities. $>
    FUNCTION(@OTHER CONST& shared_ptr#(T)): BOOL
  {
    RETURN .allocation == OTHER.allocation;
  }
}


::make_shared DOC <$ Allocates an object and its reference count together and returns its first owner. $>
  TEMPLATE(@T TYPE AUTO) FUNCTION(): shared_ptr#(T)
{
  VAR allocation MUT->shared_allocation#(T) := NEW shared_allocation#(T);
  RETURN shared_ptr#(T)(@allocation allocation);
}


::make_shared_value DOC <$ Allocates an object constructed from value together with its reference count. $>
  TEMPLATE(@T TYPE AUTO) FUNCTION(@ARG:value AUTO& T): shared_ptr#(T)
{
  VAR allocation MUT->shared_allocation#(T) := NEW shared_allocation#(T):[FORWARD(value)];
  RETURN shared_ptr#(T)(@allocation allocation);
}


::shared_allocation_layout_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STATIC_TEST
{
  TEST_ASSERT(SIZEOF(shared_ptr#(I32)) == SIZEOF(UINTPTR));
  TEST_ASSERT(SIZEOF(shared_allocation#(SZ)) == SIZEOF(ATOMIC#SZ) + SIZEOF(SZ));
  TEST_ASSERT(SIZEOF(strong_control_block#(SZ)) == 2 * SIZEOF(ATOMIC#SZ) + SIZEOF(SZ));
}
