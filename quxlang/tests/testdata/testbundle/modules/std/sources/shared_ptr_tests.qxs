LANGUAGE QUXLANG EN 0.0;

::shared_pointer_layout_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STATIC_TEST
{
  TEST_ASSERT(SIZEOF(strong_ptr#(I32)) == SIZEOF(UINTPTR));
  TEST_ASSERT(SIZEOF(weak_ptr#(I32)) == SIZEOF(UINTPTR));
}

::shared_allocation_layout_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STATIC_TEST
{
  TEST_ASSERT(SIZEOF(shared_ptr#(I32)) == SIZEOF(UINTPTR));
  TEST_ASSERT(SIZEOF(shared_allocation#(SZ)) == SIZEOF(ATOMIC#SZ) + SIZEOF(SZ));
  TEST_ASSERT(SIZEOF(strong_control_block#(SZ)) == 2 * SIZEOF(ATOMIC#SZ) + SIZEOF(SZ));
}
