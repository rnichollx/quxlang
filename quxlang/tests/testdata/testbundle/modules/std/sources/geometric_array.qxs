LANGUAGE QUXLANG EN 0.0;

DOC <$ Returns the number of significant bits of value, or zero for zero. $>
::bit_width
  FUNCTION(@ARG:value SZ): SZ
{
  VAR remaining SZ := value;
  VAR result SZ := 0;
  LOOP WHILE (remaining != 0) DO
  { remaining := remaining #-- 1; result++; }
  RETURN result;
}

DOC <$
  Owns a sequence in segments of one, two, four and successively doubled sizes.
  Append and reserve preserve element addresses. Indexing uses the significant
  bits of index plus one to select a segment. Empty slots do not construct T.
  Removal retains at most one empty trailing segment; shrink_to_fit releases all
  empty segments. Moves transfer ownership and leave the source empty.
  Failed reserve or resize preserves the original elements and size. Capacity
  may change after a failed resize. Counts must remain below the maximum SZ
  value; exceeding that limit throws container_error::size_overflow.
  Element destructors must not throw.
  $>
::geometric_array
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE, RUNTIME_MODULE)
  {
    DOC <$ Owns one allocation and the constructed prefix of its typed slots. $>
    ::segment
      STRUCT MOVE_ONLY
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .capacity VAR SZ;
      .count VAR SZ;

      .CONSTRUCTOR FUNCTION(@EXPLICIT:capacity SZ)
      {
        .storage := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_ALLOC(@COUNT capacity);
        .capacity := capacity;
      }
      .CONSTRUCTOR FUNCTION(@OTHER TEMP& geometric_array#(T)::segment)
      {
        .storage <-> OTHER.storage;
        .capacity <-> OTHER.capacity;
        .count <-> OTHER.count;
      }
      .DESTRUCTOR FUNCTION()
      {
        LOOP WHILE (.count != 0) DO
        { .count--; DESTROY AT(.storage[.count]) T; }
        IF (.capacity != 0)
        { RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(@PTR .storage, @COUNT .capacity); }
      }
    }
  }

  DOC <$ Traverses mut elements in geometric_array. Erasure invalidates the erased position; ownership transfer may invalidate the iterator. $>
  ::iterator
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR MUT->geometric_array#T;
      .index VAR SZ;
      .CONSTRUCTOR FUNCTION(@owner MUT->geometric_array#T, @index SZ) { .owner := owner; .index := index; }
    }
    DOC <$ Compares iterator positions. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& geometric_array#(T)::iterator) CONST: BOOL { RETURN .owner == OTHER.owner && .index == OTHER.index; }
    DOC <$ Advances and returns the previous position. $>
    .OPERATOR++
      FUNCTION() MUT: geometric_array#(T)::iterator
    { VAR previous geometric_array#(T)::iterator := THIS; INVARIANT(.index < .owner->.size(), "Cannot advance a geometric-array end iterator."); .index++; RETURN previous; }
    DOC <$ Returns the current element with the iterator's access qualification. $>
    .OPERATOR->
      FUNCTION() CONST: MUT& T { RETURN (.owner->)[.index]; }
  }

  DOC <$ Traverses const elements in geometric_array. Erasure invalidates the erased position; ownership transfer may invalidate the iterator. $>
  ::const_iterator
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR CONST->geometric_array#T;
      .index VAR SZ;
      .CONSTRUCTOR FUNCTION(@owner CONST->geometric_array#T, @index SZ) { .owner := owner; .index := index; }
    }
    DOC <$ Compares iterator positions. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& geometric_array#(T)::const_iterator) CONST: BOOL { RETURN .owner == OTHER.owner && .index == OTHER.index; }
    DOC <$ Advances and returns the previous position. $>
    .OPERATOR++
      FUNCTION() MUT: geometric_array#(T)::const_iterator
    { VAR previous geometric_array#(T)::const_iterator := THIS; INVARIANT(.index < .owner->.size(), "Cannot advance a geometric-array end iterator."); .index++; RETURN previous; }
    DOC <$ Returns the current element with the iterator's access qualification. $>
    .OPERATOR->
      FUNCTION() CONST: CONST& T { RETURN (.owner->)[.index]; }
  }

  PRIVATE(CLASS)
  {
    .segments VAR dynarr#(geometric_array#(T)::segment);
    .length VAR SZ;

    DOC <$ Releases trailing empty segments until retained segments remain. $>
    .trim
      FUNCTION(@ARG:retained SZ) MUT
    {
      LOOP WHILE (.segments.size() > retained) DO { .segments.pop_back(); }
    }
  }

  DOC <$ Creates an empty sequence without allocating storage. $>
  .CONSTRUCTOR
    FUNCTION() { }

  DOC <$ Copies elements in order into independent segments. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER CONST& geometric_array#T)
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(OTHER.size()) DO
    { .emplace_back(@OTHER OTHER[index]); }
  }

  DOC <$ Transfers segments and leaves OTHER empty. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER TEMP& geometric_array#T)
  { .segments <-> OTHER.segments; .length <-> OTHER.length; }

  DOC <$ Exchanges segment ownership and logical sizes. $>
  .OPERATOR<->
    FUNCTION(@OTHER MUT& geometric_array#T) MUT
  { .segments <-> OTHER.segments; .length <-> OTHER.length; }

  DOC <$ Copies OTHER before replacing the current sequence. $>
  .OPERATOR:=
    FUNCTION(@OTHER CONST& geometric_array#T) MUT
  { VAR replacement geometric_array#T := OTHER; THIS <-> replacement; }

  DOC <$ Replaces the sequence by OTHER, leaving OTHER empty. Self-move preserves the sequence. $>
  .OPERATOR:=
    FUNCTION(@OTHER TEMP& geometric_array#T) MUT
  {
    IF (THIS<- == OTHER<-) { RETURN; }
    VAR replacement geometric_array#T := MOVE(OTHER);
    THIS <-> replacement;
  }

  DOC <$ Returns the number of constructed elements. $>
  .size
    FUNCTION() CONST: SZ { RETURN .length; }

  DOC <$ Returns the number of allocated slots. $>
  .capacity
    FUNCTION() CONST: SZ
  {
    IF (.segments.size() == SIZEOF(SZ) * 8) { RETURN (0 AS SZ) #!!; }
    RETURN ((1 AS SZ) #++ .segments.size()) - 1;
  }

  DOC <$ Reports whether the sequence is empty. $>
  .empty
    FUNCTION() CONST: BOOL { RETURN .length == 0; }

  DOC <$ Allocates complete segments for capacity elements, preserving live objects. Failure releases newly allocated segments. $>
  .reserve
    FUNCTION(@ARG:capacity SZ) MUT
  {
    IF UNLIKELY (capacity == ((0 AS SZ) #!!)) { THROW container_error::size_overflow; }
    VAR required SZ := bit_width(capacity);
    VAR original SZ := .segments.size();
    VAR committed BOOL := FALSE;
    DEFER { IF (committed == FALSE) { .trim(original); } }
    .segments.reserve(required);
    LOOP WHILE (.segments.size() < required) DO
    {
      VAR segment geometric_array#(T)::segment :(@EXPLICIT (1 AS SZ) #++ .segments.size());
      .segments.push_back(MOVE(segment));
    }
    committed := TRUE;
  }

  DOC <$ Constructs one element from forwarded arguments and commits its size after construction succeeds. $>
  .emplace_back
    FUNCTION(%...values AUTO& AUTO, @KWARGS ...) MUT: MUT& T
  {
    IF UNLIKELY (.length >= (((0 AS SZ) #!!) - 1)) { THROW container_error::size_overflow; }
    VAR segment_index SZ := bit_width(.length + 1) - 1;
    IF (segment_index == .segments.size())
    {
      VAR segment geometric_array#(T)::segment :(@EXPLICIT (1 AS SZ) #++ segment_index);
      PLACE AT(segment.storage[0]) T :(
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(values)),
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(KWARGS))
      );
      segment.count := 1;
      .segments.push_back(MOVE(segment));
    }
    ELSE
    {
      VAR segment MUT& geometric_array#(T)::segment := .segments[segment_index];
      PLACE AT(segment.storage[segment.count]) T :(
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(values)),
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(KWARGS))
      );
      segment.count++;
    }
    .length++;
    RETURN THIS[.length - 1];
  }

  DOC <$ Appends a copied or moved value without relocating existing elements. $>
  .push_back
    FUNCTION(@ARG:value AUTO& T) MUT
  { .emplace_back(@OTHER FORWARD(value)); }

  DOC <$ Destroys the last element and retains at most one empty trailing segment. Requires a nonempty sequence. $>
  .pop_back
    FUNCTION() MUT
  {
    INVARIANT(.length != 0, "Cannot pop an empty geometric array.");
    VAR segment_index SZ := bit_width(.length) - 1;
    VAR segment MUT& geometric_array#(T)::segment := .segments[segment_index];
    segment.count--;
    .length--;
    DESTROY AT(segment.storage[segment.count]) T;
    .trim(bit_width(.length) + 1);
  }

  DOC <$ Destroys a suffix or default-constructs a suffix, rolling back newly constructed elements on failure. $>
  .resize
    FUNCTION(@ARG:size SZ) MUT
  {
    LOOP WHILE (.length > size) DO { .pop_back(); }
    VAR original SZ := .length;
    VAR committed BOOL := FALSE;
    DEFER { IF (committed == FALSE) { LOOP WHILE (.length > original) DO { .pop_back(); } } }
    .reserve(size);
    LOOP WHILE (.length < size) DO { .emplace_back(); }
    committed := TRUE;
  }

  DOC <$ Destroys all elements, retaining at most the initial segment. $>
  .clear
    FUNCTION() MUT { LOOP WHILE (.length != 0) DO { .pop_back(); } .trim(1); }

  DOC <$ Releases every empty trailing segment without relocating live elements. $>
  .shrink_to_fit
    FUNCTION() MUT { .trim(bit_width(.length)); }

  DOC <$ Returns the mutable element at index. Requires index less than size. $>
  .OPERATOR[]
    FUNCTION(%index SZ) MUT: MUT& T
  {
    INVARIANT(index < .length, "Geometric-array index is out of range.");
    VAR segment SZ := bit_width(index + 1) - 1;
    RETURN PUN .segments[segment].storage[(index + 1) - ((1 AS SZ) #++ segment)] AS T;
  }

  DOC <$ Returns the constant element at index. Requires index less than size. $>
  .OPERATOR[]
    FUNCTION(%index SZ) CONST: CONST& T
  {
    INVARIANT(index < .length, "Geometric-array index is out of range.");
    VAR segment SZ := bit_width(index + 1) - 1;
    RETURN PUN .segments[segment].storage[(index + 1) - ((1 AS SZ) #++ segment)] AS T;
  }

  DOC <$ Returns the first element. Requires a nonempty sequence. $>
  .front
    FUNCTION(@THIS AUTO& THISTYPE): AUTO& T { RETURN THIS[0]; }

  DOC <$ Returns the last element. Requires a nonempty sequence. $>
  .back
    FUNCTION(@THIS AUTO& THISTYPE): AUTO& T { RETURN THIS[.length - 1]; }

  DOC <$ Returns the first mut iterator. $>
  .BEGIN
    FUNCTION() MUT: geometric_array#(T)::iterator { RETURN geometric_array#(T)::iterator(@owner THIS<-, @index 0); }
  DOC <$ Returns the past-the-end mut iterator. $>
  .END
    FUNCTION() MUT: geometric_array#(T)::iterator { RETURN geometric_array#(T)::iterator(@owner THIS<-, @index .length); }
  DOC <$ Exposes mut element iteration. $>
  .VALUES
    FUNCTION() MUT: MUT& geometric_array#T { RETURN THIS; }

  DOC <$ Returns the first const iterator. $>
  .BEGIN
    FUNCTION() CONST: geometric_array#(T)::const_iterator { RETURN geometric_array#(T)::const_iterator(@owner THIS<-, @index 0); }
  DOC <$ Returns the past-the-end const iterator. $>
  .END
    FUNCTION() CONST: geometric_array#(T)::const_iterator { RETURN geometric_array#(T)::const_iterator(@owner THIS<-, @index .length); }
  DOC <$ Exposes const element iteration. $>
  .VALUES
    FUNCTION() CONST: CONST& geometric_array#T { RETURN THIS; }
}
