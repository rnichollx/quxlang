LANGUAGE QUXLANG EN 0.0;

DOC <$ The bit_width function returns the number of significant bits in value. The result is zero when value is zero. $>
::bit_width
  FUNCTION(@ARG:value SZ): SZ
{
  VAR remaining SZ := value;
  VAR result SZ := 0;
  LOOP WHILE (remaining != 0) DO
  { remaining := remaining #-- 1; result++; }
  RETURN result;
}

DOC <$
  A geometric_array stores T objects in segments whose capacities are successive
  powers of two, beginning with one element. Appending elements and reserving
  capacity preserve existing element addresses. Indexing selects a segment from
  the most significant set bit of index plus one. Unused slots contain no live
  T objects.
  Element removal retains at most one empty trailing segment. The shrink_to_fit
  operation releases all empty segments. A move from a different array transfers
  segment ownership and leaves the source array empty.
  A failed reserve or resize operation preserves the original elements and size.
  A failed resize operation may change capacity. Element counts must be less than
  the maximum SZ value. A requested size or capacity equal to that value causes
  container_error::size_overflow to be thrown.
  Mutable and constant iterators support random access by logical element index.
  The position produced by iterator arithmetic must lie between BEGIN() and END(),
  inclusive. Ordering and iterator subtraction require iterators from the same
  array. Iterator differences must be representable in iterator_difference.
  Element destructors must not throw.
  $>
::geometric_array
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  PRIVATE(MODULE, RUNTIME_MODULE)
  {
    DOC <$ A segment owns one allocation and the live objects in the initial portion of its typed storage. $>
    ::segment
      STRUCT MOVE_ONLY
    {
      .storage VAR MUT=>>TYPED_STORAGE(T);
      .capacity VAR SZ;
      .count VAR SZ;

      .CONSTRUCTOR FUNCTION(@EXPLICIT:capacity SZ)
      {
        .storage := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_ALLOC(@COUNT capacity);
        .capacity := capacity;
      }
      .CONSTRUCTOR FUNCTION(@OTHER TEMP& geometric_array#(T)::segment)
      {
        .storage <-> OTHER.storage;
        .capacity <-> OTHER.capacity;
        .count <-> OTHER.count;
      }
      .DESTRUCTOR FUNCTION()
      {
        LOOP WHILE (.count != 0) DO
        { .count--; DESTROY AT(.storage[.count]) T; }
        IF (.capacity != 0)
        { RUNTIME_MODULE::DEFAULT_ALLOCATOR#(T)::MULTI_DEALLOC(@PTR .storage, @COUNT .capacity); }
      }
    }
  }

  DOC <$ The iterator type provides random access to mutable elements. Removing an element invalidates iterators to that element. Moving or swapping the array may invalidate its iterators. $>
  ::iterator
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR MUT->geometric_array#T;
      .index VAR SZ;
      .CONSTRUCTOR FUNCTION(@owner MUT->geometric_array#T, @index SZ) { .owner := owner; .index := index; }
    }
    DOC <$ The equality operator returns TRUE when both iterators refer to the same array and position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& geometric_array#(T)::iterator) CONST: BOOL { RETURN .owner == OTHER.owner && .index == OTHER.index; }
    DOC <$ The three-way comparison operator orders iterators by logical element index. Both iterators must refer to the same array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& geometric_array#(T)::iterator) CONST: ORDER
    {
      ASSERT(.owner == OTHER.owner, "Cannot order iterators from different geometric arrays.");
      RETURN .index <=> OTHER.index;
    }
    DOC <$ The postfix increment operator advances the iterator by one element and returns its previous value. The iterator must precede END(). $>
    .OPERATOR++
      FUNCTION() MUT: geometric_array#(T)::iterator
    { VAR previous geometric_array#(T)::iterator := THIS; INVARIANT(.index < .owner->.size(), "Cannot advance a geometric-array end iterator."); .index++; RETURN previous; }
    DOC <$ The postfix decrement operator moves the iterator back by one element and returns its previous value. The iterator must follow BEGIN(). $>
    .OPERATOR--
      FUNCTION() MUT: geometric_array#(T)::iterator
    { VAR previous geometric_array#(T)::iterator := THIS; .index--; RETURN previous; }
    DOC <$ The += operator advances the iterator by OTHER elements and returns a reference to the modified iterator. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& geometric_array#(T)::iterator
    { .index += OTHER; RETURN THIS; }
    DOC <$ The -= operator moves the iterator back by OTHER elements and returns a reference to the modified iterator. $>
    .OPERATOR-=
      FUNCTION(@OTHER SZ) MUT: MUT& geometric_array#(T)::iterator
    { .index -= OTHER; RETURN THIS; }
    DOC <$ The + operator returns an iterator OTHER elements after the current position. $>
    .OPERATOR+
      FUNCTION(@OTHER SZ) CONST: geometric_array#(T)::iterator
    { RETURN geometric_array#(T)::iterator(@owner .owner, @index .index + OTHER); }
    DOC <$ The - operator with an SZ operand returns an iterator OTHER elements before the current position. $>
    .OPERATOR-
      FUNCTION(@OTHER SZ) CONST: geometric_array#(T)::iterator
    { RETURN geometric_array#(T)::iterator(@owner .owner, @index .index - OTHER); }
    DOC <$ Subtracting another iterator returns the signed number of elements from OTHER to THIS. Both iterators must refer to the same array. $>
    .OPERATOR-
      FUNCTION(@OTHER CONST& geometric_array#(T)::iterator) CONST: iterator_difference
    {
      ASSERT(.owner == OTHER.owner, "Cannot subtract iterators from different geometric arrays.");
      IF (.index >= OTHER.index) { RETURN (.index - OTHER.index) AS ASSUME iterator_difference; }
      VAR magnitude SZ := OTHER.index - .index;
      RETURN (0 AS iterator_difference) - ((magnitude - 1) AS ASSUME iterator_difference) - 1;
    }
    DOC <$ The subscript operator returns a mutable reference to the element at the specified offset from the iterator. The selected position must precede END(). $>
    .OPERATOR[]
      FUNCTION(%offset SZ) CONST: MUT& T { RETURN (.owner->)[.index + offset]; }
    DOC <$ The dereference operator returns a mutable reference to the current element. The iterator must precede END(). $>
    .OPERATOR->
      FUNCTION() CONST: MUT& T { RETURN (.owner->)[.index]; }
  }

  DOC <$ The const_iterator type provides random access to constant elements. Removing an element invalidates iterators to that element. Moving or swapping the array may invalidate its iterators. $>
  ::const_iterator
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR CONST->geometric_array#T;
      .index VAR SZ;
      .CONSTRUCTOR FUNCTION(@owner CONST->geometric_array#T, @index SZ) { .owner := owner; .index := index; }
    }
    DOC <$ The constructor creates a constant iterator that refers to the same array and position as OTHER. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER CONST& geometric_array#(T)::iterator)
    { .owner := OTHER.owner; .index := OTHER.index; }
    DOC <$ The equality operator returns TRUE when both iterators refer to the same array and position. $>
    .OPERATOR==
      FUNCTION(@OTHER CONST& geometric_array#(T)::const_iterator) CONST: BOOL { RETURN .owner == OTHER.owner && .index == OTHER.index; }
    DOC <$ The three-way comparison operator orders iterators by logical element index. Both iterators must refer to the same array. $>
    .OPERATOR<=>
      FUNCTION(@OTHER CONST& geometric_array#(T)::const_iterator) CONST: ORDER
    {
      ASSERT(.owner == OTHER.owner, "Cannot order iterators from different geometric arrays.");
      RETURN .index <=> OTHER.index;
    }
    DOC <$ The postfix increment operator advances the iterator by one element and returns its previous value. The iterator must precede END(). $>
    .OPERATOR++
      FUNCTION() MUT: geometric_array#(T)::const_iterator
    { VAR previous geometric_array#(T)::const_iterator := THIS; INVARIANT(.index < .owner->.size(), "Cannot advance a geometric-array end iterator."); .index++; RETURN previous; }
    DOC <$ The postfix decrement operator moves the iterator back by one element and returns its previous value. The iterator must follow BEGIN(). $>
    .OPERATOR--
      FUNCTION() MUT: geometric_array#(T)::const_iterator
    { VAR previous geometric_array#(T)::const_iterator := THIS; .index--; RETURN previous; }
    DOC <$ The += operator advances the iterator by OTHER elements and returns a reference to the modified iterator. $>
    .OPERATOR+=
      FUNCTION(@OTHER SZ) MUT: MUT& geometric_array#(T)::const_iterator
    { .index += OTHER; RETURN THIS; }
    DOC <$ The -= operator moves the iterator back by OTHER elements and returns a reference to the modified iterator. $>
    .OPERATOR-=
      FUNCTION(@OTHER SZ) MUT: MUT& geometric_array#(T)::const_iterator
    { .index -= OTHER; RETURN THIS; }
    DOC <$ The + operator returns an iterator OTHER elements after the current position. $>
    .OPERATOR+
      FUNCTION(@OTHER SZ) CONST: geometric_array#(T)::const_iterator
    { RETURN geometric_array#(T)::const_iterator(@owner .owner, @index .index + OTHER); }
    DOC <$ The - operator with an SZ operand returns an iterator OTHER elements before the current position. $>
    .OPERATOR-
      FUNCTION(@OTHER SZ) CONST: geometric_array#(T)::const_iterator
    { RETURN geometric_array#(T)::const_iterator(@owner .owner, @index .index - OTHER); }
    DOC <$ Subtracting another iterator returns the signed number of elements from OTHER to THIS. Both iterators must refer to the same array. $>
    .OPERATOR-
      FUNCTION(@OTHER CONST& geometric_array#(T)::const_iterator) CONST: iterator_difference
    {
      ASSERT(.owner == OTHER.owner, "Cannot subtract iterators from different geometric arrays.");
      IF (.index >= OTHER.index) { RETURN (.index - OTHER.index) AS ASSUME iterator_difference; }
      VAR magnitude SZ := OTHER.index - .index;
      RETURN (0 AS iterator_difference) - ((magnitude - 1) AS ASSUME iterator_difference) - 1;
    }
    DOC <$ The subscript operator returns a constant reference to the element at the specified offset from the iterator. The selected position must precede END(). $>
    .OPERATOR[]
      FUNCTION(%offset SZ) CONST: CONST& T { RETURN (.owner->)[.index + offset]; }
    DOC <$ The dereference operator returns a constant reference to the current element. The iterator must precede END(). $>
    .OPERATOR->
      FUNCTION() CONST: CONST& T { RETURN (.owner->)[.index]; }
  }

  PRIVATE(CLASS)
  {
    .segments VAR dynarr#(geometric_array#(T)::segment);
    .length VAR SZ;

    DOC <$ The trim function releases trailing empty segments until at most retained segments remain. $>
    .trim
      FUNCTION(@ARG:retained SZ) MUT
    {
      LOOP WHILE (.segments.size() > retained) DO { .segments.pop_back(); }
    }
  }

  DOC <$ The default constructor creates an empty array without allocating storage. $>
  .CONSTRUCTOR
    FUNCTION() { }

  DOC <$ The copy constructor copies the elements of OTHER, in order, into separately allocated segments. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER CONST& geometric_array#T)
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(OTHER.size()) DO
    { .emplace_back(@OTHER OTHER[index]); }
  }

  DOC <$ The move constructor transfers the segments of OTHER to the new array and leaves OTHER empty. $>
  .CONSTRUCTOR
    FUNCTION(@OTHER TEMP& geometric_array#T)
  { .segments <-> OTHER.segments; .length <-> OTHER.length; }

  DOC <$ The swap operator exchanges the segments and sizes of the two arrays. $>
  .OPERATOR<->
    FUNCTION(@OTHER MUT& geometric_array#T) MUT
  { .segments <-> OTHER.segments; .length <-> OTHER.length; }

  DOC <$ Copy assignment constructs a copy of OTHER before replacing the current array. $>
  .OPERATOR:=
    FUNCTION(@OTHER CONST& geometric_array#T) MUT
  { VAR replacement geometric_array#T := OTHER; THIS <-> replacement; }

  DOC <$ Move assignment transfers the contents of OTHER to the current array and leaves OTHER empty. Assignment from the same array preserves its contents. $>
  .OPERATOR:=
    FUNCTION(@OTHER TEMP& geometric_array#T) MUT
  {
    IF (THIS<- == OTHER<-) { RETURN; }
    VAR replacement geometric_array#T := MOVE(OTHER);
    THIS <-> replacement;
  }

  DOC <$ The size function returns the number of live elements. $>
  .size
    FUNCTION() CONST: SZ { RETURN .length; }

  DOC <$ The capacity function returns the number of allocated element slots. $>
  .capacity
    FUNCTION() CONST: SZ
  {
    IF (.segments.size() == SIZEOF(SZ) * 8) { RETURN (0 AS SZ) #!!; }
    RETURN ((1 AS SZ) #++ .segments.size()) - 1;
  }

  DOC <$ The empty function returns TRUE when the array contains no elements. $>
  .empty
    FUNCTION() CONST: BOOL { RETURN .length == 0; }

  DOC <$ The reserve function allocates sufficient segments for at least capacity elements and preserves existing elements. The function releases newly allocated segments if allocation fails. $>
  .reserve
    FUNCTION(@ARG:capacity SZ) MUT
  {
    IF UNLIKELY (capacity == ((0 AS SZ) #!!)) { THROW container_error::size_overflow; }
    VAR required SZ := bit_width(capacity);
    VAR original SZ := .segments.size();
    VAR committed BOOL := FALSE;
    DEFER { IF (committed == FALSE) { .trim(original); } }
    .segments.reserve(required);
    LOOP WHILE (.segments.size() < required) DO
    {
      VAR segment geometric_array#(T)::segment :(@EXPLICIT (1 AS SZ) #++ .segments.size());
      .segments.push_back(MOVE(segment));
    }
    committed := TRUE;
  }

  DOC <$ The emplace_back function constructs an element at the end of the array from the forwarded arguments. The array size increases after construction succeeds. $>
  .emplace_back
    FUNCTION(%...values AUTO& AUTO, @KWARGS ...) MUT: MUT& T
  {
    IF UNLIKELY (.length >= (((0 AS SZ) #!!) - 1)) { THROW container_error::size_overflow; }
    VAR segment_index SZ := bit_width(.length + 1) - 1;
    IF (segment_index == .segments.size())
    {
      VAR segment geometric_array#(T)::segment :(@EXPLICIT (1 AS SZ) #++ segment_index);
      PLACE AT(segment.storage[0]) T :(
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(values)),
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(KWARGS))
      );
      segment.count := 1;
      .segments.push_back(MOVE(segment));
    }
    ELSE
    {
      VAR segment MUT& geometric_array#(T)::segment := .segments[segment_index];
      PLACE AT(segment.storage[segment.count]) T :(
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(values)),
        COMPOSITE_UNPACK(COMPOSITE_FORWARD(KWARGS))
      );
      segment.count++;
    }
    .length++;
    RETURN THIS[.length - 1];
  }

  DOC <$ The push_back function appends a copy of value or moves value into the array. Existing element addresses remain valid. $>
  .push_back
    FUNCTION(@ARG:value AUTO& T) MUT
  { .emplace_back(@OTHER FORWARD(value)); }

  DOC <$ The pop_back function destroys the last element and retains at most one empty trailing segment. The array must contain at least one element. $>
  .pop_back
    FUNCTION() MUT
  {
    INVARIANT(.length != 0, "Cannot pop an empty geometric array.");
    VAR segment_index SZ := bit_width(.length) - 1;
    VAR segment MUT& geometric_array#(T)::segment := .segments[segment_index];
    segment.count--;
    .length--;
    DESTROY AT(segment.storage[segment.count]) T;
    .trim(bit_width(.length) + 1);
  }

  DOC <$ The resize function removes elements from the end or default constructs new elements to obtain the requested size. The function destroys newly constructed elements if growth fails. $>
  .resize
    FUNCTION(@ARG:size SZ) MUT
  {
    LOOP WHILE (.length > size) DO { .pop_back(); }
    VAR original SZ := .length;
    VAR committed BOOL := FALSE;
    DEFER { IF (committed == FALSE) { LOOP WHILE (.length > original) DO { .pop_back(); } } }
    .reserve(size);
    LOOP WHILE (.length < size) DO { .emplace_back(); }
    committed := TRUE;
  }

  DOC <$ The clear function destroys all elements and retains at most the initial segment. $>
  .clear
    FUNCTION() MUT { LOOP WHILE (.length != 0) DO { .pop_back(); } .trim(1); }

  DOC <$ The shrink_to_fit function releases all empty trailing segments and preserves existing element addresses. $>
  .shrink_to_fit
    FUNCTION() MUT { .trim(bit_width(.length)); }

  DOC <$ The subscript operator returns a mutable reference to the element at index. The index must be less than size(). $>
  .OPERATOR[]
    FUNCTION(%index SZ) MUT: MUT& T
  {
    INVARIANT(index < .length, "Geometric-array index is out of range.");
    VAR segment SZ := bit_width(index + 1) - 1;
    RETURN PUN .segments[segment].storage[(index + 1) - ((1 AS SZ) #++ segment)] AS T;
  }

  DOC <$ The subscript operator returns a constant reference to the element at index. The index must be less than size(). $>
  .OPERATOR[]
    FUNCTION(%index SZ) CONST: CONST& T
  {
    INVARIANT(index < .length, "Geometric-array index is out of range.");
    VAR segment SZ := bit_width(index + 1) - 1;
    RETURN PUN .segments[segment].storage[(index + 1) - ((1 AS SZ) #++ segment)] AS T;
  }

  DOC <$ The front function returns a reference to the first element. The array must contain at least one element. $>
  .front
    FUNCTION(@THIS AUTO& THISTYPE): AUTO& T { RETURN THIS[0]; }

  DOC <$ The back function returns a reference to the last element. The array must contain at least one element. $>
  .back
    FUNCTION(@THIS AUTO& THISTYPE): AUTO& T { RETURN THIS[.length - 1]; }

  DOC <$ The mutable BEGIN overload returns an iterator at the beginning of the array. $>
  .BEGIN
    FUNCTION() MUT: geometric_array#(T)::iterator { RETURN geometric_array#(T)::iterator(@owner THIS<-, @index 0); }
  DOC <$ The mutable END overload returns an iterator at the exclusive end of the array. $>
  .END
    FUNCTION() MUT: geometric_array#(T)::iterator { RETURN geometric_array#(T)::iterator(@owner THIS<-, @index .length); }
  DOC <$ The mutable VALUES overload returns a mutable reference to the array for element iteration. $>
  .VALUES
    FUNCTION() MUT: MUT& geometric_array#T { RETURN THIS; }

  DOC <$ The constant BEGIN overload returns an iterator at the beginning of the array. $>
  .BEGIN
    FUNCTION() CONST: geometric_array#(T)::const_iterator { RETURN geometric_array#(T)::const_iterator(@owner THIS<-, @index 0); }
  DOC <$ The constant END overload returns an iterator at the exclusive end of the array. $>
  .END
    FUNCTION() CONST: geometric_array#(T)::const_iterator { RETURN geometric_array#(T)::const_iterator(@owner THIS<-, @index .length); }
  DOC <$ The constant VALUES overload returns a constant reference to the array for element iteration. $>
  .VALUES
    FUNCTION() CONST: CONST& geometric_array#T { RETURN THIS; }
}
