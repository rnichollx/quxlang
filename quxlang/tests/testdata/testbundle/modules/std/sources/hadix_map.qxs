LANGUAGE QUXLANG EN 0.0;

::hadix_map DOC <$
  Owns unique keys and mapped values in a hash-radix table. hasher_type.hash accepts
  a constant key reference and returns U64. Key comparison supplies a total
  order, and keys that compare equal must have identical hashes. Values have
  stable addresses. The two-type specialization selects default_hasher, which
  consumes each key's SERIALIZE output.
  A geometric bucket directory stores fifteen inline index entries per bucket
  and an AVL overflow sequence. Inline entries are unordered; overflow entries
  are ordered by reversed hashes and then keys.
  Growth splits one bucket per insertion when occupancy exceeds eight entries
  per bucket. Erasure joins at most one pair with two buckets of hysteresis.
  Indexing nodes may move between buckets, but retained records never move.
  Failed allocation or value construction preserves existing entries; bucket
  count may change. Destructors and hasher exchange must not throw. Hash and
  comparison functions must remain stable for stored keys. Copying and moving
  copy the hasher; exchange transfers it with the records.
  Moves leave the source empty and retain its hasher.
  $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO, @hasher_type TYPE AUTO) STRUCT
{
  PRIVATE(MODULE, RUNTIME_MODULE)
  {
    ::boundary DOC <$ Orders an incremental bucket boundary before every equal-hash entry. $>
      STRUCT
    {
      .hash VAR U64;
      .OPERATOR<=> FUNCTION(@OTHER CONST& AUTO) CONST: ORDER { RETURN .hash <=> OTHER.hash; }
    }

    ::record DOC <$ Owns one map key and its associated value at a stable address. $>
      STRUCT
    {
      .key VAR INDEX;
      .value VAR VALUE;
      .CONSTRUCTOR FUNCTION(@EXPLICIT:key AUTO& INDEX) :> .key:(@OTHER FORWARD(key)) { }
      .CONSTRUCTOR FUNCTION(@key AUTO& INDEX, @value AUTO& VALUE) :>
        .key:(@OTHER FORWARD(key)), .value:(@OTHER FORWARD(value)) { }
    }

    ::index DOC <$ Stores non-owning indexing metadata for a separately allocated map record. $>
      STRUCT
    {
      .hash VAR U64;
      .record VAR MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record;
    }

    ::probe DOC <$ Orders a lookup key by reversed hash followed by key comparison. $>
      STRUCT
    {
      .hash VAR U64;
      .key VAR CONST->INDEX;
      .OPERATOR<=> FUNCTION(@OTHER CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index) CONST: ORDER
      {
        RETURN_UNEQUAL .hash <=> OTHER.hash;
        RETURN .key-> <=> OTHER.record->.key;
      }
    }

    ::search_result DOC <$ Identifies a matching stable record and its traversal position when requested. $>
      STRUCT
    {
      .record VAR MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record;
      .position VAR SZ;
    }

    ::bucket DOC <$ Owns records indexed by fifteen unordered inline entries and a sorted AVL overflow sequence. Separate hash and record arrays support independent hash comparisons. $>
      STRUCT ALIGN(SIZEOF(SZ) * 8) MOVE_ONLY
    {
      .hashes VAR [15]U64;
      .records VAR [15]MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record;
      .used VAR SZ;
      .overflow VAR avl_tree#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index);

      .CONSTRUCTOR FUNCTION() { }
      .CONSTRUCTOR FUNCTION(@OTHER TEMP& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket)
      { .hashes <-> OTHER.hashes; .records <-> OTHER.records; .used <-> OTHER.used; .overflow <-> OTHER.overflow; }
      .DESTRUCTOR FUNCTION()
      {
        LOOP VALUE(index) FROM(0 AS SZ) UNTIL(.used) DO { DELETE .records[index]; }
        LOOP ITEM(entry) IN(.overflow) DO { DELETE entry.record; }
      }
      .size FUNCTION() CONST: SZ { RETURN .used + .overflow.size(); }

      .search DOC <$ Scans inline hashes before searching ordered overflow nodes. compute_position selects traversal rank calculation. An absent key returns a null record. $>
        TEMPLATE(@compute_position VALUE BOOL)
        FUNCTION(@ARG:probe CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe) CONST: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result
      {
        VAR result hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result;
        VAR matches U32 := 0;
        LOOP VALUE(index) FROM(0 AS SZ) UNTIL(15) DO
        { IF (.hashes[index] == probe.hash) { matches := matches #|| ((1 AS U32) #++ index); } }
        matches := matches #&& (((1 AS U32) #++ .used) - 1);
        LOOP WHILE (matches != 0) DO
        {
          VAR index SZ := bit_width((matches #&& (0 - matches)) AS SZ) - 1;
          IF ((probe.key-> <=> .records[index]->.key) == ORDER::EQUAL)
          {
            result.record := .records[index];
            STATIC_IF (compute_position) { result.position := index; }
            RETURN result;
          }
          matches := matches #&& (matches - 1);
        }
        VAR node MUT->avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE) := .overflow.root;
        VAR rank SZ := .used;
        LOOP WHILE (node??) DO
        {
          VAR order ORDER := probe <=> node->.entry;
          IF (order == ORDER::EQUAL)
          {
            result.record := node->.entry.record;
            STATIC_IF (compute_position)
            { result.position := rank + avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::size(node->.left); }
            RETURN result;
          }
          IF (order == ORDER::LESS) { node := node->.left; }
          ELSE
          {
            STATIC_IF (compute_position)
            { rank += avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::size(node->.left) + 1; }
            node := node->.right;
          }
        }
        RETURN result;
      }

      .at_rank DOC <$ Returns the indexing metadata at a valid rank. $>
        FUNCTION(@ARG:index SZ) CONST: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index
      {
        IF (index < .used)
        {
          VAR entry hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index;
          entry.hash := .hashes[index];
          entry.record := .records[index];
          RETURN entry;
        }
        RETURN .overflow[index - .used];
      }

      .insert DOC <$ Appends inline metadata or inserts it into the ordered overflow sequence. $>
        FUNCTION(@ARG:entry CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index) MUT
      {
        IF (.used < 15)
        { .hashes[.used] := entry.hash; .records[.used] := entry.record; .used++; RETURN; }
        VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
        probe.hash := entry.hash;
        probe.key := entry.record->.key<-;
        .overflow.insert(@index .overflow.lower_bound(probe), @value entry);
      }

      .fill_prefix DOC <$ Fills available inline slots by extracting overflow entries without allocating. $>
        FUNCTION() MUT
      {
        LOOP WHILE (.used < 15 && .overflow.empty() == FALSE) DO
        {
          VAR entry hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index := .overflow[0];
          .hashes[.used] := entry.hash;
          .records[.used] := entry.record;
          .used++;
          .overflow.erase(0);
        }
      }

      .erase DOC <$ Removes one record and restores the inline prefix without allocating. $>
        FUNCTION(@ARG:index SZ) MUT
      {
        VAR removed hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index := .at_rank(index);
        IF (index < .used)
        {
          .used--;
          .hashes[index] := .hashes[.used];
          .records[index] := .records[.used];
          .fill_prefix();
        }
        ELSE { .overflow.erase(index - .used); }
        DELETE removed.record;
      }
    }
  }

  ::iterator DOC <$ Traverses mut map items in bucket order. Structural changes may invalidate iterators; retained record references remain valid. $>
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type);
      .bucket VAR SZ;
      .position VAR SZ;
      .node VAR MUT->avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
      .normalize DOC <$ Advances over empty buckets and initializes overflow traversal when needed. $>
        FUNCTION() MUT
      {
        LOOP WHILE (.bucket < .owner->.buckets.size()) DO
        {
          VAR bucket MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .owner->.buckets[.bucket];
          IF (.position < bucket.used) { RETURN; }
          IF (.position < bucket.size())
          { .node := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::select(@root bucket.overflow.root, @index .position - bucket.used); RETURN; }
          .bucket++;
          .position := 0;
        }
      }
      .CONSTRUCTOR FUNCTION(@owner MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type), @bucket SZ, @position SZ)
      { .owner := owner; .bucket := bucket; .position := position; .normalize(); }
    }
    .OPERATOR== DOC <$ Compares owner and traversal position. $>
      FUNCTION(@OTHER CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator) CONST: BOOL
    { RETURN .owner == OTHER.owner && .bucket == OTHER.bucket && .position == OTHER.position; }
    .OPERATOR++ DOC <$ Advances to the next item and returns the previous iterator. $>
      FUNCTION() MUT: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator
    {
      INVARIANT(.bucket < .owner->.buckets.size(), "Cannot advance a hadix end iterator.");
      VAR previous hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator := THIS;
      .position++;
      IF (.node??)
      {
        .node := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
        IF (.node??) { RETURN previous; }
        .bucket++;
        .position := 0;
      }
      .normalize();
      RETURN previous;
    }
    .OPERATOR-> DOC <$ Returns an immutable key and a mut mapped-value reference. $>
      FUNCTION() CONST: map_item_ref#[INDEX:VALUE]
    {
      INVARIANT(.bucket < .owner->.buckets.size(), "Cannot dereference a hadix end iterator.");
      VAR record MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record;
      IF (.node??) { record := .node->.entry.record; }
      ELSE { record := .owner->.buckets[.bucket].records[.position]; }
      RETURN map_item_ref#[INDEX:VALUE](@key record->.key, @value record->.value);
    }
  }

  ::const_iterator DOC <$ Traverses const map items in bucket order. Structural changes may invalidate iterators; retained record references remain valid. $>
    STRUCT
  {
    PRIVATE(MODULE)
    {
      .owner VAR CONST->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type);
      .bucket VAR SZ;
      .position VAR SZ;
      .node VAR MUT->avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
      .normalize DOC <$ Advances over empty buckets and initializes overflow traversal when needed. $>
        FUNCTION() MUT
      {
        LOOP WHILE (.bucket < .owner->.buckets.size()) DO
        {
          VAR bucket CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .owner->.buckets[.bucket];
          IF (.position < bucket.used) { RETURN; }
          IF (.position < bucket.size())
          { .node := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::select(@root bucket.overflow.root, @index .position - bucket.used); RETURN; }
          .bucket++;
          .position := 0;
        }
      }
      .CONSTRUCTOR FUNCTION(@owner CONST->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type), @bucket SZ, @position SZ)
      { .owner := owner; .bucket := bucket; .position := position; .normalize(); }
    }
    .OPERATOR== DOC <$ Compares owner and traversal position. $>
      FUNCTION(@OTHER CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator) CONST: BOOL
    { RETURN .owner == OTHER.owner && .bucket == OTHER.bucket && .position == OTHER.position; }
    .OPERATOR++ DOC <$ Advances to the next item and returns the previous iterator. $>
      FUNCTION() MUT: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator
    {
      INVARIANT(.bucket < .owner->.buckets.size(), "Cannot advance a hadix end iterator.");
      VAR previous hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator := THIS;
      .position++;
      IF (.node??)
      {
        .node := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::successor(.node);
        IF (.node??) { RETURN previous; }
        .bucket++;
        .position := 0;
      }
      .normalize();
      RETURN previous;
    }
    .OPERATOR-> DOC <$ Returns an immutable key and a const mapped-value reference. $>
      FUNCTION() CONST: map_const_item_ref#[INDEX:VALUE]
    {
      INVARIANT(.bucket < .owner->.buckets.size(), "Cannot dereference a hadix end iterator.");
      VAR record MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record;
      IF (.node??) { record := .node->.entry.record; }
      ELSE { record := .owner->.buckets[.bucket].records[.position]; }
      RETURN map_const_item_ref#[INDEX:VALUE](@key record->.key, @value record->.value);
    }

  }

  PRIVATE(MODULE, RUNTIME_MODULE)
  {
    ::reverse_hash DOC <$ Reverses all 64 hash bits to order incremental bucket ranges. $>
      FUNCTION(@ARG:value U64): U64
    {
      VAR result U64 := value;
      LOOP INIT { VAR shift SZ := 1; } WHILE (shift < 64) STEP { shift *= 2; } DO
      {
        VAR mask U64 := ((0 AS U64) #!!) / (((1 AS U64) #++ shift) + 1);
        result := ((result #&& mask) #++ shift) #|| ((result #-- shift) #&& mask);
      }
      RETURN result;
    }

    .buckets VAR geometric_array#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket);
    .entries VAR SZ;
    .bucket_mask DOC <$ Stores the next-power-of-two directory mask. Empty storage uses zero. $>
      VAR SZ;
    .hasher VAR hasher_type;

    .bucket_index DOC <$ Folds low hash bits into the current incremental bucket directory. $>
      FUNCTION(@ARG:hash U64) CONST: SZ
    {
      VAR count SZ := .buckets.size();
      VAR truncated SZ;
      STATIC_IF (SAME_TYPES(SZ, U64)) { truncated := hash; }
      STATIC_ELSE { truncated := hash AS PARTIAL SZ; }
      VAR candidate SZ := truncated #&& .bucket_mask;
      IF (candidate < count) { RETURN candidate; }
      RETURN candidate #&& (.bucket_mask #-- 1);
    }

    .split_bucket DOC <$ Appends one bucket, then partitions its partner without allocating or moving records. $>
      FUNCTION() MUT
    {
      VAR index SZ := .buckets.size();
      .buckets.emplace_back();
      IF (index == 0) { RETURN; }
      IF ((index #&& (index - 1)) == 0) { .bucket_mask := index #|| (index - 1); }
      VAR partner SZ := index - ((1 AS SZ) #++ (bit_width(index) - 1));
      VAR boundary hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::boundary;
      boundary.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(index AS U64);
      VAR left MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[partner];
      VAR right MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[index];
      VAR retained SZ := 0;
      LOOP VALUE(position) FROM(0 AS SZ) UNTIL(left.used) DO
      {
        IF (left.hashes[position] < boundary.hash)
        {
          left.hashes[retained] := left.hashes[position];
          left.records[retained] := left.records[position];
          retained++;
        }
        ELSE
        {
          right.hashes[right.used] := left.hashes[position];
          right.records[right.used] := left.records[position];
          right.used++;
        }
      }
      left.used := retained;
      right.overflow := left.overflow.split_off(left.overflow.lower_bound(boundary));
      left.fill_prefix();
      right.fill_prefix();
    }

    .join_bucket DOC <$ Stages overflow metadata before merging the final bucket into its partner. $>
      FUNCTION() MUT
    {
      VAR index SZ := .buckets.size() - 1;
      VAR partner SZ := index - ((1 AS SZ) #++ (bit_width(index) - 1));
      VAR left MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[partner];
      VAR right MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[index];
      VAR retained SZ := 15 - left.used;
      IF (retained > right.used) { retained := right.used; }
      VAR staged avl_tree#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index);
      LOOP VALUE(position) FROM(retained) UNTIL(right.used) DO
      {
        VAR entry hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index := right.at_rank(position);
        VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
        probe.hash := entry.hash;
        probe.key := entry.record->.key<-;
        staged.insert(@index staged.lower_bound(probe), @value entry);
      }
      VAR ranks [15]SZ;
      VAR position SZ := 0;
      LOOP ITEM(entry) IN(staged) DO
      {
        VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
        probe.hash := entry.hash;
        probe.key := entry.record->.key<-;
        ranks[position] := right.overflow.lower_bound(probe) + position;
        position++;
      }
      LOOP VALUE(position) FROM(0 AS SZ) UNTIL(retained) DO
      {
        left.hashes[left.used] := right.hashes[position];
        left.records[left.used] := right.records[position];
        left.used++;
      }
      position := 0;
      LOOP WHILE (staged.empty() == FALSE) DO
      {
        VAR node MUT->avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE);
        staged.root := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::detach_node(@root staged.root, @index 0, @removed node);
        right.overflow.root := avl_node#(@T hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index, @track_parent TRUE, @track_height TRUE, @track_subtree_size TRUE)::insert_node(@root right.overflow.root, @node node, @index ranks[position]);
        position++;
      }
      left.overflow.append(right.overflow);
      right.used := 0;
      left.fill_prefix();
      .buckets.pop_back();
      VAR count SZ := .buckets.size();
      IF ((count #&& (count - 1)) == 0) { .bucket_mask := count - 1; }
    }

    .insert_record DOC <$ Commits an owned record after bucket growth and index allocation succeed. $>
      FUNCTION(@record MUT& unique_ptr#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record), @hash U64) MUT: MUT& VALUE
    {
      IF UNLIKELY (.entries == ((0 AS SZ) #!!)) { THROW container_error::size_overflow; }
      VAR needed SZ := (.entries / 8) + 1;
      IF (.buckets.size() < needed) { .split_bucket(); }
      VAR bucket MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[.bucket_index(hash)];
      VAR entry hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::index;
      entry.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(hash);
      entry.record := record.get();
      bucket.insert(entry);
      .entries++;
      VAR inserted MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record := record.release();
      RETURN inserted->.value;
    }

    .find_record DOC <$ Returns the matching record or null. $>
      FUNCTION(@key CONST& INDEX, @hash U64) CONST: MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record
    {
      IF (.entries == 0) { RETURN NULL; }
      VAR bucket CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[.bucket_index(hash)];
      VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
      probe.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(hash);
      probe.key := key<-;
      VAR found hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result := bucket.search#(@compute_position FALSE)(probe);
      RETURN found.record;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an empty table with a default-constructed hasher. $> FUNCTION() { }
  .CONSTRUCTOR DOC <$ Creates an empty table with the supplied hash policy. $>
    FUNCTION(@hasher AUTO& hasher_type) :> .hasher:(@OTHER FORWARD(hasher)) { }
  .CONSTRUCTOR DOC <$ Copies all entries into independent stable records. $>
    FUNCTION(@OTHER CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)) :> .hasher:(@OTHER OTHER.hasher)
  {
    LOOP ITEM(bucket) IN(OTHER.buckets) DO
    {
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(bucket.used) DO
      { .insert(@key bucket.records[index]->.key, @value bucket.records[index]->.value); }
      LOOP ITEM(entry) IN(bucket.overflow) DO { .insert(@key entry.record->.key, @value entry.record->.value); }
    }
  }
  .OPERATOR:= DOC <$ Copies OTHER before replacing this table. $>
    FUNCTION(@OTHER CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)) MUT
  { VAR replacement hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) := OTHER; THIS <-> replacement; }
  .CONSTRUCTOR DOC <$ Copies the hash policy and transfers buckets and records, leaving OTHER empty. $>
    FUNCTION(@OTHER TEMP& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)) :> .hasher:(@OTHER OTHER.hasher AS CONST& hasher_type)
  { .buckets <-> OTHER.buckets; .entries <-> OTHER.entries; .bucket_mask <-> OTHER.bucket_mask; }
  .OPERATOR<-> DOC <$ Exchanges hash policies, bucket ownership, and entry counts. $>
    FUNCTION(@OTHER MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)) MUT
  { .hasher <-> OTHER.hasher; .buckets <-> OTHER.buckets; .entries <-> OTHER.entries; .bucket_mask <-> OTHER.bucket_mask; }
  .OPERATOR:= DOC <$ Transfers ownership after releasing the previous contents. Self-move preserves the contents. $>
    FUNCTION(@OTHER TEMP& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)) MUT
  {
    IF (THIS<- == OTHER<-) { RETURN; }
    VAR replacement hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) := MOVE(OTHER);
    THIS <-> replacement;
  }
  .size DOC <$ Returns the number of entries. $> FUNCTION() CONST: SZ { RETURN .entries; }
  .empty DOC <$ Reports whether the table contains no entries. $> FUNCTION() CONST: BOOL { RETURN .entries == 0; }
  .bucket_count DOC <$ Returns the current number of incremental hash buckets. $>
    FUNCTION() CONST: SZ { RETURN .buckets.size(); }
  .clear DOC <$ Destroys all records and indexing nodes. $>
    FUNCTION() MUT { .buckets.clear(); .entries := 0; .bucket_mask := 0; }
  .contains DOC <$ Reports whether key is present. $>
    FUNCTION(@ARG:key CONST& INDEX) CONST: BOOL { RETURN .find_record(@key key, @hash .hasher.hash(key))??; }
  .at DOC <$ Returns the mapped value. Throws container_error::missing_key when key is absent. $>
    FUNCTION(@ARG:key CONST& INDEX) MUT: MUT& VALUE
  {
    VAR record MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record := .find_record(@key key, @hash .hasher.hash(key));
    IF UNLIKELY (record!?) { THROW container_error::missing_key; }
    RETURN record->.value;
  }
  .at DOC <$ Returns the constant mapped value. Throws container_error::missing_key when key is absent. $>
    FUNCTION(@ARG:key CONST& INDEX) CONST: CONST& VALUE
  {
    VAR record MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record := .find_record(@key key, @hash .hasher.hash(key));
    IF UNLIKELY (record!?) { THROW container_error::missing_key; }
    RETURN record->.value;
  }
  .OPERATOR[] DOC <$ Finds a key or inserts it with a default-constructed mapped value. $>
    FUNCTION(%key AUTO& INDEX) MUT: MUT& VALUE
  {
    VAR hash U64 := .hasher.hash(key);
    VAR found MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record := .find_record(@key key, @hash hash);
    IF (found??) { RETURN found->.value; }
    VAR record unique_ptr#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record) := make_unique#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record)(@EXPLICIT FORWARD(key));
    RETURN .insert_record(@record record, @hash hash);
  }
  .insert DOC <$ Inserts a missing key and value. An existing key leaves the supplied temporaries unconsumed. $>
    FUNCTION(@key AUTO& INDEX, @value AUTO& VALUE) MUT: BOOL
  {
    VAR hash U64 := .hasher.hash(key);
    IF (.find_record(@key key, @hash hash)??) { RETURN FALSE; }
    VAR record unique_ptr#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record) := make_unique#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record)(@key FORWARD(key), @value FORWARD(value));
    .insert_record(@record record, @hash hash);
    RETURN TRUE;
  }
  .insert_or_assign DOC <$ Inserts a missing key or assigns its existing mapped value. Returns whether insertion occurred. $>
    FUNCTION(@key AUTO& INDEX, @value AUTO& VALUE) MUT: BOOL
  {
    VAR hash U64 := .hasher.hash(key);
    VAR found MUT->hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record := .find_record(@key key, @hash hash);
    IF (found??) { found->.value := FORWARD(value); RETURN FALSE; }
    VAR record unique_ptr#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record) := make_unique#(hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::record)(@key FORWARD(key), @value FORWARD(value));
    .insert_record(@record record, @hash hash);
    RETURN TRUE;
  }
  .erase DOC <$ Removes a matching key and joins at most one bucket pair when excess capacity exceeds hysteresis. $>
    FUNCTION(@ARG:key CONST& INDEX) MUT: BOOL
  {
    IF (.entries == 0) { RETURN FALSE; }
    VAR hash U64 := .hasher.hash(key);
    VAR bucket MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[.bucket_index(hash)];
    VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
    probe.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(hash);
    probe.key := key<-;
    VAR found hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result := bucket.search#(@compute_position TRUE)(probe);
    IF (found.record!?) { RETURN FALSE; }
    bucket.erase(found.position);
    .entries--;
    VAR needed SZ := .entries / 8;
    IF ((.entries % 8) != 0) { needed++; }
    IF (needed == 0) { needed := 1; }
    IF (.buckets.size() > needed + 2) { .join_bucket(); }
    RETURN TRUE;
  }

  .BEGIN DOC <$ Returns the first mut item iterator. $>
    FUNCTION() MUT: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator
  { RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator(@owner THIS<-, @bucket 0, @position 0); }
  .END DOC <$ Returns the mut past-the-end iterator. $>
    FUNCTION() MUT: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator
  { RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator(@owner THIS<-, @bucket .buckets.size(), @position 0); }
  .items DOC <$ Exposes mut item iteration with immutable keys. $>
    FUNCTION() MUT: MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) { RETURN THIS; }
  .IV_PAIRS DOC <$ Exposes key and value projections for INDEX/VALUE loops. $>
    FUNCTION() MUT: MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) { RETURN THIS; }
  .find DOC <$ Returns the iterator for key, or END if absent. $>
    FUNCTION(@ARG:key CONST& INDEX) MUT: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator
  {
    IF (.entries == 0) { RETURN .END(); }
    VAR hash U64 := .hasher.hash(key);
    VAR index SZ := .bucket_index(hash);
    VAR bucket MUT& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[index];
    VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
    probe.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(hash);
    probe.key := key<-;
    VAR found hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result := bucket.search#(@compute_position TRUE)(probe);
    IF (found.record!?) { RETURN .END(); }
    RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::iterator(@owner THIS<-, @bucket index, @position found.position);
  }

  .BEGIN DOC <$ Returns the first const item iterator. $>
    FUNCTION() CONST: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator
  { RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator(@owner THIS<-, @bucket 0, @position 0); }
  .END DOC <$ Returns the const past-the-end iterator. $>
    FUNCTION() CONST: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator
  { RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator(@owner THIS<-, @bucket .buckets.size(), @position 0); }
  .items DOC <$ Exposes const item iteration with immutable keys. $>
    FUNCTION() CONST: CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) { RETURN THIS; }
  .IV_PAIRS DOC <$ Exposes key and value projections for INDEX/VALUE loops. $>
    FUNCTION() CONST: CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type) { RETURN THIS; }
  .find DOC <$ Returns the iterator for key, or END if absent. $>
    FUNCTION(@ARG:key CONST& INDEX) CONST: hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator
  {
    IF (.entries == 0) { RETURN .END(); }
    VAR hash U64 := .hasher.hash(key);
    VAR index SZ := .bucket_index(hash);
    VAR bucket CONST& hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::bucket := .buckets[index];
    VAR probe hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::probe;
    probe.hash := hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::reverse_hash(hash);
    probe.key := key<-;
    VAR found hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::search_result := bucket.search#(@compute_position TRUE)(probe);
    IF (found.record!?) { RETURN .END(); }
    RETURN hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type)::const_iterator(@owner THIS<-, @bucket index, @position found.position);
  }
}

::hadix_map DOC <$ Owns a hash-radix map using the serialization-based default_hasher policy. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO)
  ALIAS hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type default_hasher);

::unordered_map DOC <$ Owns a hash-radix map using the selected hasher_type policy. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO, @hasher_type TYPE AUTO)
  ALIAS hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type hasher_type);

::unordered_map DOC <$ Owns a hash-radix map using the serialization-based default_hasher policy. $>
  TEMPLATE(@INDEX TYPE AUTO, @VALUE TYPE AUTO)
  ALIAS hadix_map#(@INDEX INDEX, @VALUE VALUE, @hasher_type default_hasher);
