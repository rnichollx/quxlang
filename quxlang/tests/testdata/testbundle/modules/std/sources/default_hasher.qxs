LANGUAGE QUXLANG EN 0.0;

::default_hasher DOC <$
  Hashes the SERIALIZE byte stream with a streaming 64-bit FNV-1a cycle and a
  final avalanche. No serialization buffer is allocated. Equal keys must have
  identical serialized bytes; types with different equality semantics require
  a custom hash policy. This deterministic hash is not cryptographic.
  $> STRUCT
{
  PRIVATE(MODULE, RUNTIME_MODULE)
  {
    ::output_slot DOC <$ Folds one serialized byte into a shared FNV-1a hash state. $> STRUCT
    {
      .state VAR MUT->U64;
      .OPERATOR:= DOC <$ Mixes one byte using unsigned wrapping multiplication. $>
        FUNCTION(@OTHER BYTE) MUT
      { .state-> := (.state-> #^^ ((OTHER AS U8) AS U64)) * 1099511628211; }
    }

    ::output_iterator DOC <$ Consumes serialized bytes directly without allocating an intermediate buffer. $> STRUCT
    {
      .slot VAR default_hasher::output_slot;
      .CONSTRUCTOR DOC <$ Binds an iterator to a live hash accumulator. $>
        FUNCTION(@EXPLICIT:state MUT->U64) { .slot.state := state; }
      .OPERATOR++ DOC <$ Returns an iterator sharing the accumulator; byte assignment advances the hash. $>
        FUNCTION() MUT: default_hasher::output_iterator { RETURN THIS; }
      .OPERATOR-> DOC <$ Returns the byte-assignment sink used by SERIALIZE. $>
        FUNCTION(): MUT& default_hasher::output_slot { RETURN .slot; }
    }
  }

  .hash DOC <$ Returns a hash of every byte emitted by value.SERIALIZE. $>
    FUNCTION(@ARG:value CONST& AUTO) CONST: U64
  {
    VAR state U64 := 14695981039346656037;
    VAR output default_hasher::output_iterator :(@EXPLICIT state<-);
    value.SERIALIZE(@OUTPUT_ITERATOR output);
    state := (state #^^ (state #-- 30)) * 13787848793156543929;
    state := (state #^^ (state #-- 27)) * 10723151780598845931;
    RETURN state #^^ (state #-- 31);
  }
}
