LANGUAGE QUXLANG EN 0.0;

DOC <$ Applies all_of to the borrowed range boundaries. $>
::all_of FUNCTION(@range AUTO& AUTO, @KWARGS:options ...): AUTO
{ RETURN APPLY COMPOSITE_JOIN(:{ .first = range.BEGIN(); .last = range.END(); }, COMPOSITE_FORWARD(options)) TO all_of; }

DOC <$ Rejects a temporary range whose storage may expire. $>
::all_of FUNCTION(@range TEMP& AUTO, @KWARGS ...): AUTO
{ COMPILATION_ERROR "Algorithm range arguments must be lvalues."; }

