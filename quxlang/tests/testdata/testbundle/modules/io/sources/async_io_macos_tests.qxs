LANGUAGE QUXLANG EN 0.0;

IMPORT std;
IMPORT syscall;

PRIVATE(MODULE)
{
  ::macos_async_abi_layout_test INCLUDE_IF(OS_MACOS) STATIC_TEST
  {
    TEST_ASSERT(SIZEOF(syscall::macos::signal_event) == 32);
    TEST_ASSERT(SIZEOF(syscall::macos::async_control_block) == 80);
    TEST_ASSERT(SIZEOF(syscall::macos::kernel_event) == 48);
  }
}
