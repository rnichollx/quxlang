LANGUAGE QUXLANG EN 0.0;

IMPORT std;

IMPORT syscall;


PRIVATE(MODULE)
{
  DOC <$
    Owns one kqueue receiving file completions, socket readiness, and worker stop events.
    $>
  ::macos_async_context_state INCLUDE_IF(OS_MACOS)
    STRUCT MOVE_ONLY
  {
    .queue_descriptor VAR I32;

    DOC <$ Creates empty state that owns no kqueue descriptor. $>
    .CONSTRUCTOR FUNCTION()
    {
      .queue_descriptor := 0 - 1;
    }
  }

  DOC <$
    Creates the kqueue that receives native I/O notifications.
    $>
  ::initialize_macos_async_context INCLUDE_IF(OS_MACOS)
    FUNCTION(@state MUT& macos_async_context_state): BOOL
  {
    state.queue_descriptor := syscall::macos::kqueue();
    RETURN state.queue_descriptor >= 0;
  }

  DOC <$
    Initializes one Darwin aiocb and directs its completion to the context's
    kqueue with the enclosing request as user data.
    $>
  ::prepare_macos_async_control INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @request MUT->async_request,
      @descriptor io_descriptor_ref,
      @buffer CONST& buffer_ref,
      @offset U64
    ): BOOL
  {
    IF (offset > 9223372036854775807)
    {
      RETURN FALSE;
    }
    VAR control MUT& syscall::macos::async_control_block := request->.macos_control;
    control.descriptor := descriptor.native_handle();
    control.offset := offset AS ASSUME I64;
    control.buffer := buffer.data;
    control.byte_count := async_transfer_size(@size buffer.size) AS SZ;
    control.request_priority := 0;
    control.signal_event.notification := 4;
    control.signal_event.signal_number :=
      request->.context_control->.macos.queue_descriptor;
    control.signal_event.value := async_request_address(@request request);
    VAR null_address ADDRESS;
    control.signal_event.notification_function := null_address;
    control.signal_event.notification_attributes := null_address;
    control.operation := 0;
    RETURN TRUE;
  }

  DOC <$
    Starts one positioned POSIX AIO read delivered through kqueue.
    $>
  ::submit_async_read INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @request MUT->async_request,
      @descriptor io_descriptor_ref,
      @buffer CONST& buffer_ref,
      @offset U64
    ): BOOL
  {
    IF (prepare_macos_async_control(
      @request request,
      @descriptor descriptor,
      @buffer buffer,
      @offset offset
    ) == FALSE)
    {
      RETURN FALSE;
    }
    RETURN syscall::macos::aio_read(@control request->.macos_control<-) == 0;
  }

  DOC <$
    Starts one positioned POSIX AIO write delivered through kqueue.
    $>
  ::submit_async_write INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @request MUT->async_request,
      @descriptor io_descriptor_ref,
      @buffer CONST& buffer_ref,
      @offset U64
    ): BOOL
  {
    IF (prepare_macos_async_control(
      @request request,
      @descriptor descriptor,
      @buffer buffer,
      @offset offset
    ) == FALSE)
    {
      RETURN FALSE;
    }
    RETURN syscall::macos::aio_write(@control request->.macos_control<-) == 0;
  }

  DOC <$
    Waits through signal interruption and returns one kqueue event.
    $>
  ::wait_for_macos_kernel_event INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @state MUT& macos_async_context_state,
      @event MUT& syscall::macos::kernel_event
    )
  {
    VAR changes CONST->syscall::macos::kernel_event;
    VAR timeout CONST->VOID;
    LOOP WHILE(TRUE) DO
    {
      VAR result I32 := syscall::macos::kevent64(
        @queue_descriptor state.queue_descriptor,
        @change_list changes,
        @change_count 0,
        @event_list event<-,
        @event_count 1,
        @flags 0,
        @timeout timeout
      );
      IF (result == 1)
      {
        RETURN;
      }
      VAR error_location MUT->I32 := syscall::macos::errno_location();
      IF (result < 0 && error_location-> == 4)
      {
        CONTINUE;
      }
      PANIC "kevent failed while waiting for an async completion.";
    };
  }

  DOC <$
    Removes one native I/O or user event, executes its callback, and returns false only
    for an explicit thread-pool stop event.
    $>
  ::wait_for_async_completion INCLUDE_IF(OS_MACOS)
    FUNCTION(@control MUT->async_context_control): BOOL
  {
    VAR event syscall::macos::kernel_event;
    wait_for_macos_kernel_event(
      @state control->.macos,
      @event event
    );
    IF ((event.user_data??) == FALSE)
    {
      RETURN FALSE;
    }
    VAR request MUT->async_request := async_request_at(@address event.user_data);
    IF (request->.native??)
    {
      VAR failure U32;
      IF ((event.flags #&& 16384) != 0) { failure := event.data AS CHECKED U32; }
      complete_native_operation(@request request, @size 0, @error failure);
      RETURN TRUE;
    }
    ASSERT(event.filter == -3, "Unexpected filter delivered to an async kqueue.");
    VAR operation_error U64 := event.extensions[0];
    VAR transferred U64 := event.extensions[1];
    IF (operation_error != 0)
    {
      complete_async_request(@request request, @succeeded FALSE, @size 0);
    }
    ELSE
    {
      ASSERT(transferred <= request->.buffer.size,
        "macOS AIO completion exceeded the submitted byte count.");
      complete_async_request(
        @request request,
        @succeeded TRUE,
        @size transferred
      );
    }
    RETURN TRUE;
  }

  DOC <$
    Adds and triggers one one-shot EVFILT_USER event with null user data.
    $>
  ::post_macos_worker_stop INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @state MUT& macos_async_context_state,
      @identifier UINTPTR
    )
  {
    VAR change syscall::macos::kernel_event;
    change.identifier := identifier;
    change.filter := 0 - 10;
    change.flags := 17;
    change.filter_flags := 16777216;
    change.data := 0;
    VAR null_user_data ADDRESS;
    change.user_data := null_user_data;
    VAR events MUT->syscall::macos::kernel_event;
    VAR timeout CONST->VOID;
    LOOP WHILE(TRUE) DO
    {
      VAR result I32 := syscall::macos::kevent64(
        @queue_descriptor state.queue_descriptor,
        @change_list change<-,
        @change_count 1,
        @event_list events,
        @event_count 0,
        @flags 0,
        @timeout timeout
      );
      IF (result == 0)
      {
        RETURN;
      }
      VAR error_location MUT->I32 := syscall::macos::errno_location();
      IF (result < 0 && error_location-> == 4)
      {
        CONTINUE;
      }
      THROW async_error::worker_stop_failed;
    };
  }

  DOC <$
    Posts one distinct kqueue user event for every worker that must stop.
    $>
  ::request_async_stop INCLUDE_IF(OS_MACOS)
    FUNCTION(
      @control MUT->async_context_control,
      @worker_count SZ
    )
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(worker_count) DO
    {
      post_macos_worker_stop(
        @state control->.macos,
        @identifier index + (1 AS SZ)
      );
    };
  }

  DOC <$
    Closes a drained macOS async kqueue.
    $>
  ::shutdown_async_context INCLUDE_IF(OS_MACOS)
    FUNCTION(@control MUT->async_context_control)
  {
    IF (syscall::macos::close(@fd control->.macos.queue_descriptor) != 0)
    {
      THROW async_error::resource_release_failed;
    }
    control->.macos.queue_descriptor := 0 - 1;
    control->.valid := FALSE;
  }
}
