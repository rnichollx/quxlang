LANGUAGE QUXLANG EN 0.0;

IMPORT std;

IMPORT syscall;

DOC <$
  Identifies asynchronous runtime initialization, resource release, and worker-stop failures.
  initialization_failed denotes an unavailable native completion queue.
  resource_release_failed denotes a failed native queue close or unmap.
  worker_stop_failed denotes a failed submission of a worker-stop notification.
  submission_failed denotes a rejected native operation registration.
  $>
::async_error ENUM [initialization_failed, resource_release_failed, worker_stop_failed, submission_failed];


PRIVATE(MODULE)
{
  ::async_completion INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    GENERIC MOVE_ONLY INCOMPARABLE
  {
    .OPERATOR() FUNCTION(@result transfer_result) MUT;
  }

  ::async_context_control INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    STRUCT ROOTED
  {
    .capacity VAR SZ;
    .outstanding VAR ATOMIC#SZ;
    .drain_mutex VAR std::ordering_mutex;
    .drain_condition VAR std::condition_variable;
    .pool_attached VAR BOOL;
    .manual_waiters VAR SZ;
    .valid VAR BOOL;
    .linux INCLUDE_IF(OS_LINUX) VAR linux_async_context_state;
    .windows INCLUDE_IF(OS_WINDOWS) VAR windows_async_context_state;
    .macos INCLUDE_IF(OS_MACOS) VAR macos_async_context_state;
  }

  ::async_file_control INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    STRUCT MOVE_ONLY
  {
    .owned_file VAR file;
    .context_identity VAR MUT->async_context_control;
    .pending VAR ATOMIC#SZ;

    DOC <$ Creates stable async-file state for one context and native file. $>
    .CONSTRUCTOR FUNCTION(%native_ref file_ref, %context_identity MUT->async_context_control)
      :> .owned_file:(@native_ref native_ref)
    {
      .context_identity := context_identity;
    }
  }

  ::async_request INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    STRUCT MOVE_ONLY
  {
    // OVERLAPPED must remain first so an IOCP completion pointer identifies
    // the enclosing request without storing a non-event value in hEvent.
    .windows_overlapped INCLUDE_IF(OS_WINDOWS) VAR syscall::windows::overlapped;
    .native_storage VAR TYPED_STORAGE(native_operation);
    .native VAR MUT->native_operation;
    .submission_mutex VAR std::ordering_mutex;
    .readiness_descriptor INCLUDE_IF(OS_LINUX && linux_use_io_uring == FALSE) VAR std::optional#I32;
    .callback_storage VAR TYPED_STORAGE(async_completion);
    .callback VAR MUT->async_completion;
    .file_control VAR MUT->async_file_control;
    .context_control VAR MUT->async_context_control;
    .buffer VAR buffer_ref;
    .completion_next INCLUDE_IF(OS_LINUX && linux_use_io_uring == FALSE) VAR MUT->async_request;
    .completion_result INCLUDE_IF(OS_LINUX && linux_use_io_uring == FALSE) VAR transfer_result;
    .macos_control INCLUDE_IF(OS_MACOS) VAR syscall::macos::async_control_block;
  }

  DOC <$
    Exposes one live request address to an operating-system queue.
    $>
  ::async_request_address INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    FUNCTION(@request MUT->async_request): ADDRESS
  {
    RETURN IBC_GETADDR(@PTR request);
  }

  DOC <$
    Recovers a live request previously exposed to an operating-system queue.
    $>
  ::async_request_at INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    FUNCTION(@address ADDRESS): MUT->async_request
  {
    RETURN IBC_PUN#(MUT->async_request)(@ADDR address);
  }

  DOC <$
    Caps one native asynchronous transfer at the maximum signed 32-bit byte count.
    $>
  ::async_transfer_size INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    FUNCTION(@size SZ): U32
  {
    VAR maximum U32 := 2147483647;
    IF (size > maximum AS SZ)
    {
      RETURN maximum;
    }
    STATIC_IF(BITS(SZ) == BITS(U32))
    {
      RETURN size;
    }
    STATIC_ELSE
    {
      RETURN size AS ASSUME U32;
    }
  }

  DOC <$
    Allocates stable request state and takes ownership of one completion callable.
    $>
  ::allocate_async_request INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    FUNCTION(
      @file_control MUT->async_file_control,
      @context_control MUT->async_context_control,
      @callback AUTO& AUTO(callback_type)
    ): MUT->async_request
  {
    VAR request MUT->async_request := NEW async_request;
    VAR initialized BOOL;
    DEFER { IF (initialized == FALSE) { DELETE request; } }
    request->.callback :=
      PLACE AT(request->.callback_storage) async_completion := FORWARD(callback);
    request->.file_control := file_control;
    request->.context_control := context_control;
    IF (file_control??) { file_control->.pending.ADD#ATOMIC_ACQREL(1); }
    context_control->.drain_mutex.lock();
    context_control->.outstanding.ADD#ATOMIC_ACQREL(1);
    context_control->.drain_mutex.unlock();
    initialized := TRUE;
    RETURN request;
  }

  DOC <$ Releases a completed request and wakes context drain waiters. $>
  ::retire_async_request FUNCTION(@request MUT->async_request)
  {
    VAR control MUT->async_context_control := request->.context_control;
    DELETE request;
    control->.drain_mutex.lock();
    VAR context_outstanding SZ := control->.outstanding.FETCH_SUBTRACT#ATOMIC_ACQREL(1);
    ASSERT(context_outstanding != 0, "Async context outstanding-operation count underflow.");
    IF (context_outstanding == 1) { control->.drain_condition.notify_all(); }
    control->.drain_mutex.unlock();
  }

  DOC <$
    Delivers one completion, releases its erased callable, and frees request state.
    $>
  ::complete_async_request INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
    FUNCTION(
      @request MUT->async_request,
      @succeeded BOOL,
      @size SZ
    )
  {
    IF (request->.file_control??)
    {
      VAR file_pending SZ := request->.file_control->.pending.FETCH_SUBTRACT#ATOMIC_ACQREL(1);
      ASSERT(file_pending != 0, "Async file pending-operation count underflow.");
    }

    VAR result transfer_result;
    result.size := size;
    result.succeeded := succeeded;
    (request->.callback->)(@result result);
    DESTROY AT(request->.callback_storage) async_completion;

    retire_async_request(@request request);
  }

}

DOC <$
  Binds one thread invocation to the stable state of an async context.
  $>
::async_worker_entry INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
  STRUCT MOVE_ONLY
{
  PRIVATE(MODULE)
  {
    .control VAR MUT->async_context_control;
  }

  DOC <$ Binds one worker entry to stable async-context state. $>
  .CONSTRUCTOR FUNCTION(@control MUT->async_context_control)
  {
    .control := control;
  }

  DOC <$ Processes completions until the context receives a stop packet. $>
  .OPERATOR() FUNCTION()
  {
    LOOP WHILE (wait_for_async_completion(@control .control)) DO
    {
    }
  }
}


DOC <$
  Owns one platform completion queue: io_uring on Linux, an I/O completion
  port on Windows, or kqueue on macOS. Callbacks run on threads that call
  wait_one, including workers owned by thread_pool.
  $>
::async_context INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
  STRUCT MOVE_ONLY
{
  PRIVATE(MODULE)
  {
    .control VAR MUT->async_context_control;

  }

  DOC <$ Creates a completion queue with room for entries in flight. $>
  .CONSTRUCTOR FUNCTION(@entries SZ)
  {
    ASSERT(entries != 0, "An async context requires at least one entry.");
    ASSERT(entries <= ((0 AS U32) #!!) AS SZ,
      "Async context capacity exceeds the native queue limit.");
    NEW TO(.control);
    VAR initialized BOOL := FALSE;
    DEFER { IF (initialized == FALSE) { DELETE FROM(.control); } }
    .control->.capacity := entries;
    STATIC_IF(OS_LINUX)
    {
      .control->.valid := initialize_linux_async_context(
        @state .control->.linux,
        @entries async_transfer_size(@size entries)
      );
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      .control->.valid := initialize_windows_async_context(
        @state .control->.windows,
        @concurrency async_transfer_size(@size entries)
      );
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      .control->.valid := initialize_macos_async_context(@state .control->.macos);
    }
    initialized := TRUE;
  }

  DOC <$ Transfers ownership of another context without moving native queue state. $>
  .CONSTRUCTOR FUNCTION(@OTHER TEMP& async_context)
  {
    VAR empty_control MUT->async_context_control;
    .control := empty_control;
    VAR other_control MUT& MUT->async_context_control :=
      OTHER.control AS MUT& MUT->async_context_control;
    .control <-> other_control;
  }

  DOC <$
    Releases the native queue after all requests have completed. Native release
    failures throw async_error::resource_release_failed.
    $>
  .DESTRUCTOR FUNCTION()
  {
    IF (.control??)
    {
      ASSERT(.outstanding() == 0,
        "An async context cannot be destroyed with outstanding operations.");
      ASSERT(.control->.pool_attached == FALSE,
        "An async context must outlive its attached completion worker pool.");
      ASSERT(.control->.manual_waiters == 0,
        "An async context cannot be destroyed while wait_one is active.");
      DEFER { DELETE FROM(.control); }
      IF (.control->.valid)
      {
        shutdown_async_context(@control .control);
      }
    }
  }

  DOC <$ Owns an operation at a stable address until its native completion. The operation supplies start, complete, result, and value_type. $>
  .submit FUNCTION(@operation AUTO& AUTO(operation_type)): std::future#(operation_type::value_type)
  {
    ASSERT(.valid(), "Cannot submit to an unavailable async context.");
    VAR invocation native_invocation#operation_type :(@operation FORWARD(operation));
    VAR result := invocation.producer.get_future();
    VAR request MUT->async_request := NEW async_request;
    VAR initialized BOOL;
    DEFER { IF (initialized == FALSE) { DELETE request; } }
    request->.native := PLACE AT(request->.native_storage) native_operation := MOVE(invocation);
    request->.context_control := .control;
    .control->.drain_mutex.lock();
    .control->.outstanding.ADD#ATOMIC_ACQREL(1);
    .control->.drain_mutex.unlock();
    initialized := TRUE;
    VAR submission async_submission_ref :(@request request);
    request->.submission_mutex.lock();
    VAR complete BOOL := request->.native->.start(@submission submission);
    request->.submission_mutex.unlock();
    IF (complete)
    {
      DESTROY AT(request->.native_storage) native_operation;
      retire_async_request(@request request);
    }
    RETURN MOVE(result);
  }

  DOC <$ Waits until every submitted operation and callback has finished. External submissions stop before this call. $>
  .drain FUNCTION()
  {
    .control->.drain_mutex.lock();
    LOOP WHILE (.control->.outstanding.LOAD#ATOMIC_ACQUIRE() != 0) DO
    {
      .control->.drain_condition.wait(@locked_mutex .control->.drain_mutex);
    }
    .control->.drain_mutex.unlock();
  }

  DOC <$ Submits a positioned read on a borrowed descriptor. The descriptor and buffer remain valid until callback returns. Windows descriptors must support overlapped I/O and belong to this completion port. $>
  .read FUNCTION(@descriptor io_descriptor_ref, @buffer CONST& buffer_ref, @offset U64, @callback AUTO& AUTO(callback_type))
  {
    ASSERT(.valid(), "Cannot submit to an unavailable async context.");
    VAR file_control MUT->async_file_control;
    VAR request MUT->async_request := allocate_async_request(
      @file_control file_control, @context_control .control, @callback FORWARD(callback));
    request->.buffer := buffer;
    STATIC_IF(OS_WINDOWS)
    {
      IF (associate_windows_async_file(@state .control->.windows, @descriptor descriptor) == FALSE)
      {
        complete_async_request(@request request, @succeeded FALSE, @size 0);
        RETURN;
      }
    }
    IF (submit_async_read(@request request, @descriptor descriptor, @buffer buffer, @offset offset) == FALSE)
    {
      complete_async_request(@request request, @succeeded FALSE, @size 0);
    }
  }

  DOC <$ Submits a positioned write on a borrowed descriptor. The descriptor and buffer remain valid until callback returns. Windows descriptors must support overlapped I/O and belong to this completion port. $>
  .write FUNCTION(@descriptor io_descriptor_ref, @buffer CONST& buffer_ref, @offset U64, @callback AUTO& AUTO(callback_type))
  {
    ASSERT(.valid(), "Cannot submit to an unavailable async context.");
    VAR file_control MUT->async_file_control;
    VAR request MUT->async_request := allocate_async_request(
      @file_control file_control, @context_control .control, @callback FORWARD(callback));
    request->.buffer := buffer;
    STATIC_IF(OS_WINDOWS)
    {
      IF (associate_windows_async_file(@state .control->.windows, @descriptor descriptor) == FALSE)
      {
        complete_async_request(@request request, @succeeded FALSE, @size 0);
        RETURN;
      }
    }
    IF (submit_async_write(@request request, @descriptor descriptor, @buffer buffer, @offset offset) == FALSE)
    {
      complete_async_request(@request request, @succeeded FALSE, @size 0);
    }
  }

  DOC <$ Reports whether the platform completion queue was created. $>
  .valid FUNCTION(): BOOL
  {
    IF ((.control??) == FALSE)
    {
      RETURN FALSE;
    }
    RETURN .control->.valid;
  }

  DOC <$ Returns the number of operations whose callbacks have not returned. $>
  .outstanding FUNCTION(): SZ
  {
    IF ((.control??) == FALSE)
    {
      RETURN 0;
    }
    RETURN .control->.outstanding.LOAD#ATOMIC_ACQUIRE();
  }

  DOC <$ Waits for one completion and executes its callback on this thread. $>
  .wait_one FUNCTION(): BOOL
  {
    ASSERT(.valid(), "Cannot wait on an unavailable async context.");
    .control->.drain_mutex.lock();
    ASSERT(.control->.pool_attached == FALSE,
      "wait_one cannot compete with an attached completion worker pool.");
    .control->.manual_waiters++;
    .control->.drain_mutex.unlock();
    VAR result BOOL := wait_for_async_completion(@control .control);
    .control->.drain_mutex.lock();
    ASSERT(.control->.manual_waiters != 0,
      "Async context manual-waiter count underflow.");
    .control->.manual_waiters--;
    .control->.drain_mutex.unlock();
    RETURN result;
  }
}


DOC <$
  Owns a native file used for positioned asynchronous transfers. The context,
  file object, buffer storage, and objects referenced by callback captures must
  remain alive through completion. Every operation requires the same
  async_context used at construction.
  $>
::async_file INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS)
  STRUCT MOVE_ONLY
{
  PRIVATE(MODULE)
  {
    .control VAR MUT->async_file_control;

    DOC <$ Rejects use with a context other than the construction context. $>
    .assert_context FUNCTION(@context MUT& async_context)
    {
      ASSERT(context.valid(), "Cannot use an unavailable async context.");
      ASSERT(.control??, "Cannot use a moved-from async file.");
      ASSERT(.control->.context_identity == context.control,
        "An async file cannot be used with a different async context.");
    }
  }

  DOC <$
    Takes ownership of native_ref and binds it to context. Windows handles must
    have been opened with FILE_FLAG_OVERLAPPED.
    $>
  .CONSTRUCTOR FUNCTION(@context MUT& async_context, @native_ref file_ref)
  {
    ASSERT(context.valid(), "Cannot create an async file for an unavailable context.");
    NEW TO(.control) :[
      native_ref,
      context.control
    ];
    STATIC_IF(OS_WINDOWS)
    {
      IF (associate_windows_async_file(
        @state context.control->.windows,
        @descriptor .control->.owned_file.reference().descriptor
      ) == FALSE)
      {
        PANIC "CreateIoCompletionPort failed while associating an async file.";
      }
    }
  }

  DOC <$ Transfers stable file state, including operations already in flight. $>
  .CONSTRUCTOR FUNCTION(@OTHER TEMP& async_file)
  {
    VAR empty_control MUT->async_file_control;
    .control := empty_control;
    VAR other_control MUT& MUT->async_file_control :=
      OTHER.control AS MUT& MUT->async_file_control;
    .control <-> other_control;
  }

  DOC <$ Closes and releases the file after every operation has completed. $>
  .DESTRUCTOR FUNCTION()
  {
    IF (.control??)
    {
      ASSERT(.control->.pending.LOAD#ATOMIC_ACQUIRE() == 0,
        "An async file cannot be destroyed with pending operations.");
      DELETE FROM(.control);
    }
  }

  DOC <$
    Starts a positioned read. Submission failures invoke callback immediately
    with succeeded set to false.
    $>
  .read FUNCTION(
      @context MUT& async_context,
      @buffer CONST& buffer_ref,
      @offset U64,
      @callback AUTO& AUTO(callback_type)
    )
  {
    .assert_context(@context context);
    ASSERT(.control->.owned_file.is_open(), "Cannot read from a closed async file.");
    VAR request MUT->async_request := allocate_async_request(
      @file_control .control,
      @context_control context.control,
      @callback FORWARD(callback)
    );
    request->.buffer := buffer;
    IF (submit_async_read(
      @request request,
      @descriptor .control->.owned_file.reference().descriptor,
      @buffer buffer,
      @offset offset
    ) == FALSE)
    {
      complete_async_request(@request request, @succeeded FALSE, @size 0);
    }
  }

  DOC <$
    Starts a positioned write. Submission failures invoke callback immediately
    with succeeded set to false.
    $>
  .write FUNCTION(
      @context MUT& async_context,
      @buffer CONST& buffer_ref,
      @offset U64,
      @callback AUTO& AUTO(callback_type)
    )
  {
    .assert_context(@context context);
    ASSERT(.control->.owned_file.is_open(), "Cannot write to a closed async file.");
    VAR request MUT->async_request := allocate_async_request(
      @file_control .control,
      @context_control context.control,
      @callback FORWARD(callback)
    );
    request->.buffer := buffer;
    IF (submit_async_write(
      @request request,
      @descriptor .control->.owned_file.reference().descriptor,
      @buffer buffer,
      @offset offset
    ) == FALSE)
    {
      complete_async_request(@request request, @succeeded FALSE, @size 0);
    }
  }

  DOC <$ Returns this file's number of unfinished transfers. $>
  .pending FUNCTION(@context MUT& async_context): SZ
  {
    .assert_context(@context context);
    RETURN .control->.pending.LOAD#ATOMIC_ACQUIRE();
  }

  DOC <$ Reports whether this object still owns its native file. $>
  .is_open FUNCTION(@context MUT& async_context): BOOL
  {
    .assert_context(@context context);
    RETURN .control->.owned_file.is_open();
  }

  DOC <$ Returns a non-owning native reference after validating context identity. $>
  .reference FUNCTION(@context MUT& async_context): file_ref
  {
    .assert_context(@context context);
    RETURN .control->.owned_file.reference();
  }

  DOC <$ Closes the file after all of its asynchronous transfers have completed. $>
  .close FUNCTION(@context MUT& async_context): BOOL
  {
    .assert_context(@context context);
    ASSERT(.control->.pending.LOAD#ATOMIC_ACQUIRE() == 0,
      "Cannot close an async file with pending operations.");
    RETURN .control->.owned_file.close();
  }
}


DOC <$
  Owns native worker threads that wait on one async_context and execute its
  completion callbacks. Destruction drains callbacks, posts stop packets, and
  joins every worker. The referenced context must outlive the pool.
  $>
::thread_pool INCLUDE_IF(OS_LINUX || OS_WINDOWS || OS_MACOS) STRUCT MOVE_ONLY
{
  PRIVATE(MODULE)
  {
    .workers VAR std::dynarr#std::thread;
    .context_control VAR MUT->async_context_control;
  }

  DOC <$ Starts worker_count completion workers for context. Partial construction stops and joins every worker already started. $>
  .CONSTRUCTOR FUNCTION(@context MUT& async_context, @worker_count SZ)
  {
    ASSERT(context.valid(), "Cannot start completion workers for an unavailable context.");
    ASSERT(worker_count > 0 && worker_count <= context.control->.capacity,
      "Completion worker count must be positive and within context capacity.");
    .workers.reserve(worker_count);
    context.control->.drain_mutex.lock();
    ASSERT(context.control->.pool_attached == FALSE && context.control->.manual_waiters == 0,
      "An async context supports one completion consumer pool.");
    context.control->.pool_attached := TRUE;
    context.control->.drain_mutex.unlock();
    .context_control := context.control;
    TRY
    {
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(worker_count) DO
      {
        .workers.push_back(std::thread(async_worker_entry(@control .context_control)));
      };
    }
    CATCH DEFAULT
    {
      IF (.workers.size() > 0)
      {
        request_async_stop(@control .context_control, @worker_count .workers.size());
        LOOP VALUE(index) FROM(0 AS SZ) UNTIL(.workers.size()) DO { .workers[index].join(); };
      }
      .context_control->.drain_mutex.lock();
      .context_control->.pool_attached := FALSE;
      .context_control->.drain_mutex.unlock();
      RETHROW;
    }
  }

  DOC <$ Transfers worker ownership while preserving the context's stable address. $>
  .CONSTRUCTOR FUNCTION(@OTHER TEMP& thread_pool)
  {
    .workers <-> OTHER.workers;
    .context_control <-> OTHER.context_control;
  }

  DOC <$ Drains callbacks and joins owned workers. $>
  .DESTRUCTOR FUNCTION() { IF (.joinable()) { .join(); } }

  DOC <$ Reports whether this object owns a completion consumer pool. $>
  .joinable FUNCTION() CONST: BOOL { RETURN .context_control??; }

  DOC <$ Drains callbacks, posts stop events, and joins workers. External submissions stop before joining, and callbacks cannot join their own pool. $>
  .join FUNCTION() MUT
  {
    ASSERT(.joinable(), "Cannot join an empty completion worker pool.");
    .context_control->.drain_mutex.lock();
    LOOP WHILE(.context_control->.outstanding.LOAD#ATOMIC_ACQUIRE() != 0) DO
    {
      .context_control->.drain_condition.wait(@locked_mutex .context_control->.drain_mutex);
    }
    .context_control->.drain_mutex.unlock();
    request_async_stop(@control .context_control, @worker_count .workers.size());
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(.workers.size()) DO { .workers[index].join(); };
    .workers.clear();
    .context_control->.drain_mutex.lock();
    .context_control->.pool_attached := FALSE;
    .context_control->.drain_mutex.unlock();
    .context_control := NULL;
  }
}
