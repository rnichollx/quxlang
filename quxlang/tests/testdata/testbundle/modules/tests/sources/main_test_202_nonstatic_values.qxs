LANGUAGE QUXLANG EN 0.0;

::nonstatic_value_tests NAMESPACE
{
  DOC <$ A scalar record excluded from static snapshot storage. $>
  ::item
    STRUCT NONSTATIC { .value VAR I32; }

  DOC <$ Contains a nonstatic member in an otherwise ordinary record. $>
  ::owner
    STRUCT { .member VAR item; }

  DOC <$ NONSTATIC permits ordinary default initialization, copying, movement, assignment and mutable aliases. $>
  ::local_operations
    DUAL_TEST
  {
    VAR original item;
    TEST_ASSERT(original.value == 0);
    original.value := 17;
    VAR copied item := original;
    copied.value := 29;
    TEST_ASSERT(original.value == 17);
    VAR moved item := MOVE(copied);
    TEST_ASSERT(moved.value == 29);
    moved := original;
    TEST_ASSERT(moved.value == 17);
    VAR alias MUT& item := moved;
    alias.value := 31;
    TEST_ASSERT(moved.value == 31);
    TEST_ASSERT(original.value == 17);
  }

  DOC <$ Local containing records preserve independent storage for nonstatic fields through generated copying and assignment. $>
  ::containing_local_values
    DUAL_TEST
  {
    VAR original owner;
    original.member.value := 37;
    VAR copied owner := original;
    TEST_ASSERT(copied.member.value == 37);
    copied.member.value := 41;
    TEST_ASSERT(original.member.value == 37);
    original := copied;
    TEST_ASSERT(original.member.value == 41);
    copied.member.value := 43;
    TEST_ASSERT(original.member.value == 41);
  }

  DOC <$ A function-local STATIC declaration rejects a directly tagged NONSTATIC type. $>
  ::static_local_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    STATIC object item;
    VAR value I32 := object.value;
  }

  DOC <$ An explicit initializer cannot make a NONSTATIC type eligible for STATIC storage. $>
  ::static_initializer_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    STATIC object item := item();
    VAR value I32 := object.value;
  }

}
