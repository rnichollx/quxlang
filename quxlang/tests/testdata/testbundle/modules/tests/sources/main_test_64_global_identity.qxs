LANGUAGE QUXLANG EN 0.0;
IMPORT std;

::global_identity_tests NAMESPACE
{
  DOC <$ Supplies immutable storage for value-copy tests. $>
  ::constant_number
    STATIC U64 := 17;

  DOC <$ Copies of a static value have independently mutable local storage without changing the static source. $>
  ::mutable_local_copies
    DUAL_TEST
  {
    VAR explicit_copy U64 := constant_number;
    AUTO inferred_copy := constant_number;
    TEST_ASSERT(explicit_copy == 17);
    TEST_ASSERT(inferred_copy == 17);
    explicit_copy := 41;
    inferred_copy := 73;
    TEST_ASSERT(explicit_copy == 41);
    TEST_ASSERT(inferred_copy == 73);
    TEST_ASSERT(constant_number == 17);
  }

  DOC <$ Names the same type used by the signed global instantiation. $>
  ::signed_alias
    ALIAS I32;

  DOC <$ Owns independent mutable text for each template type argument. $>
  ::text
    TEMPLATE(@T TYPE AUTO) VAR CONSTEXPR_OK std::string := "seed";

  DOC <$ Returns the persistent signed instantiation by reference. $>
  ::signed_text
    FUNCTION(): MUT& std::string
  {
    RETURN text#(I32);
  }

  DOC <$ Same-width distinct types have independent globals while aliases resolve to the same object. $>
  ::type_argument_storage
    DUAL_TEST
  {
    TEST_ASSERT(text#(I32) == "seed");
    TEST_ASSERT(text#(U32) == "seed");
    TEST_ASSERT(text#(signed_alias)<- == text#(I32)<-);
    text#(I32).push_back(65);
    TEST_ASSERT(text#(signed_alias) == "seedA");
    TEST_ASSERT(text#(U32) == "seed");
    text#(U32).push_back(66);
    TEST_ASSERT(text#(I32) == "seedA");
    TEST_ASSERT(text#(U32) == "seedB");
    text#(I32) := "seed";
    text#(U32) := "seed";
  }

  DOC <$ Calls returning a global reference preserve identity and mutations across subsequent calls. $>
  ::repeated_reference_access
    DUAL_TEST
  {
    TEST_ASSERT(signed_text() == "seed");
    VAR first MUT& std::string := signed_text();
    VAR second MUT& std::string := signed_text();
    TEST_ASSERT(first<- == second<-);
    TEST_ASSERT(first<- == text#(I32)<-);
    first.push_back(67);
    TEST_ASSERT(second == "seedC");
    TEST_ASSERT(signed_text() == "seedC");
    second := "seed";
    TEST_ASSERT(first == "seed");
  }

}
