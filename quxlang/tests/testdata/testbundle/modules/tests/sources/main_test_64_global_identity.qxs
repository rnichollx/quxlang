LANGUAGE QUXLANG EN 0.0;
IMPORT std;

::global_identity_tests NAMESPACE
{
  ::constant_number DOC <$ Supplies immutable storage for value-copy tests. $>
    STATIC U64 := 17;

  ::mutable_local_copies DOC <$ Copies of a static value have independently mutable local storage without changing the static source. $>
    DUAL_TEST
  {
    VAR explicit_copy U64 := constant_number;
    VAR inferred_copy AUTO := constant_number;
    ASSERT(explicit_copy == 17);
    ASSERT(inferred_copy == 17);
    explicit_copy := 41;
    inferred_copy := 73;
    ASSERT(explicit_copy == 41);
    ASSERT(inferred_copy == 73);
    ASSERT(constant_number == 17);
  }

  ::signed_alias DOC <$ Names the same type used by the signed global instantiation. $>
    ALIAS I32;

  ::text DOC <$ Owns independent mutable text for each template type argument. $>
    TEMPLATE(@T TYPE AUTO) VAR CONSTEXPR_OK std::string := "seed";

  ::signed_text DOC <$ Returns the persistent signed instantiation by reference. $>
    FUNCTION(): MUT& std::string
  {
    RETURN text#(I32);
  }

  ::type_argument_storage DOC <$ Same-width distinct types have independent globals while aliases resolve to the same object. $>
    DUAL_TEST
  {
    ASSERT(text#(I32) == "seed");
    ASSERT(text#(U32) == "seed");
    ASSERT(text#(signed_alias)<- == text#(I32)<-);
    text#(I32).push_back(@value 65);
    ASSERT(text#(signed_alias) == "seedA");
    ASSERT(text#(U32) == "seed");
    text#(U32).push_back(@value 66);
    ASSERT(text#(I32) == "seedA");
    ASSERT(text#(U32) == "seedB");
    text#(I32) := "seed";
    text#(U32) := "seed";
  }

  ::repeated_reference_access DOC <$ Calls returning a global reference preserve identity and mutations across subsequent calls. $>
    DUAL_TEST
  {
    ASSERT(signed_text() == "seed");
    VAR first MUT& std::string := signed_text();
    VAR second MUT& std::string := signed_text();
    ASSERT(first<- == second<-);
    ASSERT(first<- == text#(I32)<-);
    first.push_back(@value 67);
    ASSERT(second == "seedC");
    ASSERT(signed_text() == "seedC");
    second := "seed";
    ASSERT(first == "seed");
  }

}
