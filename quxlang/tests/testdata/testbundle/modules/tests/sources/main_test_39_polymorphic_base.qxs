LANGUAGE QUXLANG EN 0.0;

::polymorphic_builtin_tests NAMESPACE
{
  ::left STRUCT POLYMORPHIC
  {
    .dynamic_type FUNCTION() CONST NOEXCEPT: I32 { RETURN 17; }
  }
  ::right STRUCT POLYMORPHIC {}
  ::complete STRUCT POLYMORPHIC
  {
    .left BASE left;
    .right BASE right;
  }

  DOC <$ The built-in view shares complete-object identity while lowercase methods remain user-defined. $>
  ::canonical_builtin
  DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR object complete;
    VAR first MUT->POLYMORPHIC_BASE := object.left<-;
    VAR second MUT->POLYMORPHIC_BASE := object.right<-;
    TEST_ASSERT(first == second);
    TEST_ASSERT(first->.DYNAMIC_TYPE() == TYPE_INDEX_OF(complete));
    TEST_ASSERT(DYNAMIC_TYPE_OF(first) == first->.DYNAMIC_TYPE());
    TEST_ASSERT(DYNAMIC_TYPE_OF(first->) == TYPE_INDEX_OF(complete));
    TEST_ASSERT(DYNAMIC_TYPE_OF(object.left) == TYPE_INDEX_OF(complete));
    TEST_ASSERT(DYNAMIC_TYPE_OF(object.right) == TYPE_INDEX_OF(complete));
    TEST_ASSERT((first AS DYNAMIC MUT->complete) == object<-);
    TEST_ASSERT(object.left.dynamic_type() == 17);
    VAR empty CONST->complete;
    VAR empty_view CONST->POLYMORPHIC_BASE := empty;
    TEST_ASSERT((empty_view??) == FALSE);
  }

  DOC <$ The compiler view does not introduce a lowercase dynamic_type method. $>
  ::lowercase_is_not_builtin
  STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR object complete;
    VAR view CONST->POLYMORPHIC_BASE := object<-;
    view->.dynamic_type();
  }

  DOC <$ Counts evaluation of a polymorphic reference operand. $>
  ::read_reference
  FUNCTION(@object CONST& left, @calls MUT& I32): CONST& left
  {
    calls := calls + 1;
    RETURN object;
  }

  DOC <$ A reference expression is evaluated once and preserves the complete object identity. $>
  ::reference_evaluated_once
  DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR object complete;
    VAR calls I32 := 0;
    TEST_ASSERT(DYNAMIC_TYPE_OF(read_reference(@object object.left, @calls calls)) == TYPE_INDEX_OF(complete));
    TEST_ASSERT(calls == 1);
    TEST_ASSERT((-< = DYNAMIC_TYPE_OF(object.right))() == TYPE_INDEX_OF(complete));
  }

  DOC <$ Ordinary object references cannot report a dynamic type. $>
  ::nonpolymorphic_reference
  STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR object I32 := 1;
    DYNAMIC_TYPE_OF(object);
  }


}
