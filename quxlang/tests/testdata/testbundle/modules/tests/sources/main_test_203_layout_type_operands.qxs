LANGUAGE QUXLANG EN 0.0;

::layout_type_operand_tests NAMESPACE
{
  DOC <$ Fixed arrays retain element alignment and multiply element cell size at each dimension. $>
  ::check_array_layout
    TEMPLATE(@T TYPE AUTO)
    FUNCTION()
  {
    TEST_ASSERT(SIZEOF([1]T) == CELLSIZEOF(T));
    TEST_ASSERT(SIZEOF([3]T) == 3 * CELLSIZEOF(T));
    TEST_ASSERT(SIZEOF([2][3]T) == 6 * CELLSIZEOF(T));
    TEST_ASSERT(ALIGNOF([1]T) == ALIGNOF(T));
    TEST_ASSERT(ALIGNOF([3]T) == ALIGNOF(T));
    TEST_ASSERT(ALIGNOF([2][3]T) == ALIGNOF(T));
  }

  DOC <$ Array layout identities hold across scalar element sizes and nested dimensions without constructing array values. $>
  ::array_dimensions INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
    DUAL_TEST
  {
    check_array_layout#(@T BYTE)();
    check_array_layout#(@T I16)();
    check_array_layout#(@T I32)();
    check_array_layout#(@T U64)();
    check_array_layout#(@T F32)();
    check_array_layout#(@T F64)();
  }

  DOC <$ Layout queries through TYPEOF do not construct or destroy owned operands. $>
  ::unevaluated_construction INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    TEST_ASSERT(SIZEOF(TYPEOF(short_circuit_tests::temporary(
      @events events, @alive alive, @digit 1))) == SIZEOF(short_circuit_tests::temporary));
    TEST_ASSERT(ALIGNOF(TYPEOF(short_circuit_tests::temporary(
      @events events, @alive alive, @digit 2))) == ALIGNOF(short_circuit_tests::temporary));
    TEST_ASSERT(events == 0);
    TEST_ASSERT(alive == 0);
    TEST_ASSERT(SAME_TYPES(TYPEOF(SIZEOF(I32)), TYPEOF(4)));
    TEST_ASSERT(SAME_TYPES(TYPEOF(ALIGNOF(BYTE)), TYPEOF(1)));
  }
}
