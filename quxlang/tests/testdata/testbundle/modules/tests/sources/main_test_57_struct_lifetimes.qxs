LANGUAGE QUXLANG EN 0.0;

::struct_lifetime_tests NAMESPACE
{
  DOC <$ Three nontrivial fields expose the order of generated struct operations. $>
  ::record
    STRUCT
  {
    .first VAR array_lifetime_tests::element;
    .second VAR array_lifetime_tests::element;
    .third VAR array_lifetime_tests::element;

    DOC <$ Connects source fields to the shared copy and destruction counters. $>
    .configure
      FUNCTION(@attempts MUT& I32, @events MUT& I32, @failure I32)
    {
      .first.attempts := attempts<-;
      .second.attempts := attempts<-;
      .third.attempts := attempts<-;
      .first.events := events<-;
      .second.events := events<-;
      .third.events := events<-;
      .first.failure := failure;
      .second.failure := failure;
      .third.failure := failure;
      .first.number := 1;
      .second.number := 2;
      .third.number := 3;
    }
  }

  DOC <$ A failed generated copy destroys only completed fields, in reverse declaration order. $>
  ::copy_failure_at_each_field
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR failure I32 := 1;
    LOOP WHILE (failure <= 3) DO
    {
      VAR attempts I32 := 0;
      VAR events I32 := 0;
      VAR source record;
      source.configure(@attempts attempts, @events events, @failure failure);
      TEST_ASSERT(source.first.complete);
      TEST_ASSERT(source.second.complete);
      TEST_ASSERT(source.third.complete);
      VAR caught BOOL := FALSE;
      TRY
      {
        VAR copy record := source;
        TEST_ASSERT(FALSE);
      }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == failure);
        TEST_ASSERT(attempts == failure);
        caught := TRUE;
      }
      TEST_ASSERT(caught);
      IF (failure == 1) { TEST_ASSERT(events == 0); }
      ELSE IF (failure == 2) { TEST_ASSERT(events == 1); }
      ELSE { TEST_ASSERT(events == 21); }
      TEST_ASSERT(source.first.number == 1);
      TEST_ASSERT(source.second.number == 2);
      TEST_ASSERT(source.third.number == 3);
      failure++;
    }
  }

  DOC <$ Generated copies invoke each field copy constructor and own independently mutable fields. $>
  ::copy_independence_and_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source record;
    source.configure(@attempts attempts, @events events, @failure 0);
    {
      VAR copy record := source;
      TEST_ASSERT(attempts == 3);
      TEST_ASSERT(events == 0);
      TEST_ASSERT(copy.first.copied);
      TEST_ASSERT(copy.second.copied);
      TEST_ASSERT(copy.third.copied);
      copy.first.number := 4;
      TEST_ASSERT(source.first.number == 1);
      source.second.number := 5;
      TEST_ASSERT(copy.second.number == 2);
    }
    TEST_ASSERT(events == 324);
  }

  DOC <$ Generated moves invoke field move constructors without copying or duplicating destruction ownership. $>
  ::move_transfers_field_ownership
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source record;
    source.configure(@attempts attempts, @events events, @failure 0);
    {
      VAR copy record := source;
      {
        VAR moved record := MOVE(copy);
        TEST_ASSERT(attempts == 3);
        TEST_ASSERT(events == 0);
        TEST_ASSERT(moved.first.copied);
        TEST_ASSERT(moved.second.copied);
        TEST_ASSERT(moved.third.copied);
        TEST_ASSERT(moved.first.number == 1);
        TEST_ASSERT(moved.second.number == 2);
        TEST_ASSERT(moved.third.number == 3);
      }
      TEST_ASSERT(events == 321);
    }
    TEST_ASSERT(events == 321);
    TEST_ASSERT(attempts == 3);
  }

  DOC <$ Records field cleanup separately from the owning object's destructor body. $>
  ::body_failure_record
    STRUCT
  {
    .first VAR generated_destructor_field;
    .second VAR generated_destructor_field;
    .events VAR MUT->I32;

    DOC <$ Initializes both fields before optionally throwing from the constructor body. $>
    .CONSTRUCTOR
      FUNCTION(@events MUT& I32, @fail BOOL)
    {
      .events := events<-;
      .first.order := events<-;
      .first.digit := 1;
      .second.order := events<-;
      .second.digit := 2;
      IF (fail) { THROW I32(@OTHER 7); }
    }

    DOC <$ Records entry before generated field destruction starts. $>
    .DESTRUCTOR
      FUNCTION() { .events-> := .events-> * 10 + 9; }
  }

  DOC <$ Throwing from a constructor destroys initialized fields but does not invoke the incomplete owner's destructor body. $>
  ::constructor_body_failure_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR value body_failure_record :(@events events, @fail TRUE);
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 7);
      TEST_ASSERT(events == 21);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(events == 21);
  }

  DOC <$ Successful objects execute their destructor body before destroying fields in reverse order. $>
  ::destructor_body_precedes_fields
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    {
      VAR value body_failure_record :(@events events, @fail FALSE);
      TEST_ASSERT(events == 0);
    }
    TEST_ASSERT(events == 921);
  }
}
