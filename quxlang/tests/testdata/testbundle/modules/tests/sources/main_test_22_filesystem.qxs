LANGUAGE QUXLANG EN 0.0;

::filesystem_linux_read_write_test INCLUDE_IF(OS_LINUX) UNIT_TEST
{
  VAR path [10]BYTE;
  path[0] := 47;
  path[1] := 100;
  path[2] := 101;
  path[3] := 118;
  path[4] := 47;
  path[5] := 122;
  path[6] := 101;
  path[7] := 114;
  path[8] := 111;
  path[9] := 0;

  VAR descriptor I32 := syscall::linux::open(
    @path path[& 0],
    @mode syscall::linux::file_mode::rusr,
    @flags syscall::linux::open_flags::rdwr
  );
  TEST_ASSERT(descriptor >= 0);

  VAR bytes [4]BYTE;
  bytes[0] := 116;
  bytes[1] := 101;
  bytes[2] := 115;
  bytes[3] := 116;
  VAR buffer std::buffer_ref := std::buffer_ref(
    @data bytes[& 0],
    @size 4
  );
  VAR owned_file std::file := std::file(
    @native_ref std::file_ref(@descriptor descriptor)
  );

  VAR write_result std::transfer_result;
  owned_file.write(@buffer buffer, @result write_result);
  TEST_ASSERT(write_result.succeeded);
  TEST_ASSERT(write_result.size == 4);

  VAR read_result std::transfer_result;
  owned_file.read(@buffer buffer, @result read_result);
  TEST_ASSERT(read_result.succeeded);
  TEST_ASSERT(read_result.size == 4);
  TEST_ASSERT(bytes[0] == 0);
  TEST_ASSERT(bytes[1] == 0);
  TEST_ASSERT(bytes[2] == 0);
  TEST_ASSERT(bytes[3] == 0);
  TEST_ASSERT(owned_file.close());
  TEST_ASSERT(owned_file.is_open() == FALSE);

  VAR destructor_flags syscall::linux::open_flags := syscall::linux::rdonly;
  VAR destructor_descriptor I32 := syscall::linux::open(
    @path path[& 0],
    @flags destructor_flags,
    @mode syscall::linux::file_mode::rusr
  );
  TEST_ASSERT(destructor_descriptor >= 0);
  {
    VAR destructor_file std::file := std::file(
      @native_ref std::file_ref(@descriptor destructor_descriptor)
    );
    TEST_ASSERT(destructor_file.is_open());
  }
  TEST_ASSERT(syscall::linux::close(@fd destructor_descriptor) != 0);
}

::filesystem_windows_read_write_test INCLUDE_IF(OS_WINDOWS) UNIT_TEST
{
  VAR bytes [1]BYTE;
  VAR buffer std::buffer_ref := std::buffer_ref(
    @data bytes[& 0],
    @size 1
  );
  VAR handle ADDRESS;
  VAR reference std::file_ref := std::file_ref(@handle handle);
  VAR owned_file std::file := std::file(@native_ref reference);
  TEST_ASSERT(buffer.size == 1);
  TEST_ASSERT(reference.handle == handle);
  TEST_ASSERT(owned_file.is_open() == FALSE);

  VAR read_result std::transfer_result;
  owned_file.read(@buffer buffer, @result read_result);
  TEST_ASSERT(read_result.succeeded == FALSE);
  VAR write_result std::transfer_result;
  owned_file.write(@buffer buffer, @result write_result);
  TEST_ASSERT(write_result.succeeded == FALSE);
  TEST_ASSERT(owned_file.close());
  TEST_ASSERT(owned_file.is_open() == FALSE);
}

::filesystem_jvm_read_write_test INCLUDE_IF(ARCH_IS_JVM) UNIT_TEST
{
  VAR path std::string := std::create_temporary_path();
  VAR bytes [4]BYTE;
  bytes[0] := 113;
  bytes[1] := 117;
  bytes[2] := 120;
  bytes[3] := 33;
  VAR buffer std::buffer_ref := std::buffer_ref(
    @data bytes[& 0],
    @size 4
  );

  {
    VAR output_file std::file := std::open_read_write(@path path);
    VAR write_result std::transfer_result;
    output_file.write(@buffer buffer, @result write_result);
    TEST_ASSERT(write_result.succeeded);
    TEST_ASSERT(write_result.size == 4);
    TEST_ASSERT(output_file.close());
    TEST_ASSERT(output_file.is_open() == FALSE);
  }

  bytes[0] := 0;
  bytes[1] := 0;
  bytes[2] := 0;
  bytes[3] := 0;
  {
    VAR input_file std::file := std::open_read_write(@path path);
    VAR read_result std::transfer_result;
    input_file.read(@buffer buffer, @result read_result);
    TEST_ASSERT(read_result.succeeded);
    TEST_ASSERT(read_result.size == 4);
    TEST_ASSERT(bytes[0] == 113);
    TEST_ASSERT(bytes[1] == 117);
    TEST_ASSERT(bytes[2] == 120);
    TEST_ASSERT(bytes[3] == 33);
  }
}

::filesystem_posix_path_open_test INCLUDE_IF(OS_LINUX || OS_MACOS) UNIT_TEST
{
  VAR path std::string := "/dev/null";
  VAR bytes [1]BYTE;
  VAR buffer std::buffer_ref := std::buffer_ref(@data bytes[&0], @size 1);
  VAR transfer std::transfer_result;
  VAR writable std::file := std::open_read_write(@path path);
  writable.write(@buffer buffer, @result transfer);
  TEST_ASSERT(transfer.succeeded && transfer.size == 1);
  TEST_ASSERT(writable.close());
  VAR readable std::file := std::open_read(@path path);
  readable.read(@buffer buffer, @result transfer);
  TEST_ASSERT(transfer.succeeded && transfer.size == 0);
  readable.write(@buffer buffer, @result transfer);
  TEST_ASSERT(transfer.succeeded == FALSE);
  TEST_ASSERT(readable.close());
}

::filesystem_posix_embedded_null_test INCLUDE_IF(OS_LINUX || OS_MACOS) UNIT_TEST
{
  VAR path std::string := "/dev/null";
  path.push_back(@value 0);
  path.push_back(@value 120);
  VAR caught BOOL := FALSE;
  TRY { VAR file std::file := std::open_read(@path path); }
  CATCH DEFAULT { caught := TRUE; }
  TEST_ASSERT(caught);
}

::filesystem_empty_owner_test UNIT_TEST
{
  VAR file std::file;
  TEST_ASSERT(file.is_open() == FALSE);
  TEST_ASSERT(file.reference().is_valid() == FALSE);
  TEST_ASSERT(file.close());
  VAR moved std::file := MOVE(file);
  TEST_ASSERT(file.is_open() == FALSE);
  TEST_ASSERT(moved.is_open() == FALSE);
}

::filesystem_posix_ownership_test INCLUDE_IF(OS_LINUX || OS_MACOS) UNIT_TEST
{
  VAR path std::string := "/dev/null";
  VAR source std::file := std::open_read(@path path);
  VAR borrowed std::file_ref := source.reference();
  VAR moved std::file := MOVE(source);
  TEST_ASSERT(source.is_open() == FALSE);
  TEST_ASSERT(moved.is_open());
  TEST_ASSERT(source.close());
  VAR destination std::file := std::open_read(@path path);
  VAR replaced std::file_ref := destination.reference();
  destination := MOVE(moved);
  TEST_ASSERT(moved.is_open() == FALSE);
  TEST_ASSERT(destination.is_open());
  TEST_ASSERT(replaced.close() == FALSE);
  destination := MOVE(destination);
  TEST_ASSERT(destination.is_open());
  VAR released std::file_ref := destination.release();
  TEST_ASSERT(destination.is_open() == FALSE);
  TEST_ASSERT(destination.close());
  TEST_ASSERT(released.close());
  TEST_ASSERT(borrowed.close() == FALSE);
  VAR unwound std::file_ref;
  TRY
  {
    VAR scoped std::file := std::open_read(@path path);
    unwound := scoped.reference();
    THROW (1 AS I32);
  }
  CATCH DEFAULT { }
  TEST_ASSERT(unwound.close() == FALSE);
}
