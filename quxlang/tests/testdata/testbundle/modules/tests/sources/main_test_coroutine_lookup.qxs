LANGUAGE QUXLANG EN 0.0;

::coroutine_lookup_tests NAMESPACE
{
  ::unrelated_controller STRUCT {}

  ::select FUNCTION(@value I32): I32 { RETURN value + 1; }
  ::select COROUTINE(@value I32): I32 { RETURN value + 10; }

  ::argument FUNCTION(@count MUT& I32): I32 { count += 1; RETURN 7; }

  ::call_selected COROUTINE(@count MUT& I32, @result MUT& I32)
  {
    result := select(@value argument(@count count));
  }

  DOC <$ An ordinary invocation selects the FUNCTION overload from a mixed functum. $>
  ::ordinary_selection DUAL_TEST
  {
    TEST_ASSERT(select(@value 7) == 8);
  }

  DOC <$ The call hook specializes the mixed binding and receives each evaluated argument once. $>
  ::coroutine_selection DUAL_TEST
  {
    VAR observed coroutine_call_tests::observations;
    VAR adapted coroutine_call_tests::controller;
    adapted.observed := observed<-;
    VAR count I32;
    VAR result I32;
    VAR frame call_selected#(@count MUT& I32, @result MUT& I32, @CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
    frame.INITIALIZE(@count count, @result result);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(count == 1);
    TEST_ASSERT(result == 17);
    TEST_ASSERT(observed.calls == 1);
  }

  ::restricted FUNCTION(@value I32): I32 { RETURN value + 2; }
  ::restricted COROUTINE(@CONTROLLER unrelated_controller, @value I32): I32
  {
    RETURN missing_restricted_body(@value value);
  }

  ::call_restricted COROUTINE(@count MUT& I32, @result MUT& I32)
  {
    result := restricted(@value argument(@count count));
  }

  DOC <$ Selects ordinary functions from the complete binding supplied to the call hook. $>
  ::ordinary_policy STRUCT
  {
    .calls VAR I32;
    .CO_COROUTINE_CALL FUNCTION(@COROUTINE:child AUTO, @ARGUMENTS:arguments ...) MUT: coroutine_call_tests::completed_value
    {
      .calls += 1;
      VAR result coroutine_call_tests::completed_value;
      result.value := child(...FORWARD PACK(arguments));
      RETURN result;
    }
    .CO_AWAIT FUNCTION(@ARG AUTO& coroutine_call_tests::completed_value): MUT& coroutine_call_tests::completed_value
    {
      RETURN ARG AS MUT& coroutine_call_tests::completed_value;
    }
    .CO_AWAIT FUNCTION(@ARG BOOL): coroutine_call_tests::immediate_awaiter { RETURN coroutine_call_tests::immediate_awaiter(); }
    .CO_RETURN FUNCTION(): BOOL { RETURN TRUE; }
    .CO_EXCEPTION FUNCTION(@ARG CONST& EXCEPTION_PTR): BOOL { THROW_EXCEPTION_PTR(ARG); }
  }

  DOC <$ The hook selects an ordinary overload without instantiating an incompatible coroutine body. $>
  ::controller_selects_ordinary DUAL_TEST
  {
    VAR adapted ordinary_policy;
    VAR count I32;
    VAR result I32;
    VAR frame call_restricted#(@count MUT& I32, @result MUT& I32, @CONTROLLER ordinary_policy)::FRAME_TYPE;
    frame.INITIALIZE(@count count, @result result);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(count == 1);
    TEST_ASSERT(result == 9);
    TEST_ASSERT(adapted.calls == 1);
  }

  ::observe FUNCTION(@CONTROLLER MUT& coroutine_call_tests::controller)
  {
    CONTROLLER.observed->.integer_yields += 1;
  }

  ::named_count FUNCTION(@KWARGS ...): SZ { RETURN PACK_FIELD_COUNT(KWARGS); }

  ::call_controller_functions COROUTINE(@explicit MUT& coroutine_call_tests::controller)
  {
    observe();
    observe(@CONTROLLER explicit);
    TEST_ASSERT(named_count(@value 7) == 1);
  }

  DOC <$ Ordinary controller-taking functions receive the selected borrow while keyword packs capture ordinary named arguments. $>
  ::ordinary_controller_arguments DUAL_TEST
  {
    VAR current_observed coroutine_call_tests::observations;
    VAR supplied_observed coroutine_call_tests::observations;
    VAR adapted coroutine_call_tests::controller;
    VAR supplied coroutine_call_tests::controller;
    adapted.observed := current_observed<-;
    supplied.observed := supplied_observed<-;
    VAR frame call_controller_functions#(@explicit MUT& coroutine_call_tests::controller, @CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
    frame.INITIALIZE(@explicit supplied);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(current_observed.integer_yields == 1);
    TEST_ASSERT(supplied_observed.integer_yields == 1);
    TEST_ASSERT(current_observed.calls == 0);
  }

  ::ambiguous FUNCTION(): I32 { RETURN 1; }
  ::ambiguous COROUTINE() ENABLE_IF(TRUE): I32 { RETURN 2; }
  ::ambiguous COROUTINE() ENABLE_IF(1 == 1): I32 { RETURN 3; }
  ::call_ambiguous COROUTINE() { ambiguous(); }

  DOC <$ Ambiguity in specialization performed by the call hook is diagnosed. $>
  ::controller_ambiguity_rejected STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR frame call_ambiguous#(@CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
  }

  ::invalid_body FUNCTION(): I32 { RETURN 1; }
  ::invalid_body COROUTINE(): I32 { RETURN missing_selected_body(); }
  ::call_invalid_body COROUTINE() { invalid_body(); }

  DOC <$ An error in the selected coroutine body does not cause overload fallback. $>
  ::selected_body_error_rejected STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR frame call_invalid_body#(@CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
  }

  ::unselected_body FUNCTION(): I32 { RETURN missing_ordinary_body(); }
  ::unselected_body COROUTINE(): I32 { RETURN 31; }
  ::call_unselected_body COROUTINE(@result MUT& I32) { result := unselected_body(); }

  DOC <$ The ordinary alternative's body remains uninstantiated when controller lookup selects the coroutine. $>
  ::unselected_body_is_discarded DUAL_TEST
  {
    VAR observed coroutine_call_tests::observations;
    VAR adapted coroutine_call_tests::controller;
    adapted.observed := observed<-;
    VAR result I32;
    VAR frame call_unselected_body#(@result MUT& I32, @CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
    frame.INITIALIZE(@result result);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(result == 31);
    TEST_ASSERT(observed.calls == 1);
  }

  ::rank_ordinary FUNCTION(@CONTROLLER MUT& coroutine_call_tests::controller): I32 { RETURN 41; }
  ::rank_ordinary COROUTINE(): I32 { RETURN 42; }
  ::rank_coroutine FUNCTION(@CONTROLLER MUT& AUTO): I32 { RETURN 41; }
  ::rank_coroutine COROUTINE(@CONTROLLER coroutine_call_tests::controller): I32 { RETURN 42; }

  ::call_ranked COROUTINE(@result MUT& I32)
  {
    result := rank_ordinary() + rank_coroutine();
  }

  DOC <$ The call hook supplies a controller type when specializing each mixed binding. $>
  ::controller_overload_ranking DUAL_TEST
  {
    VAR observed coroutine_call_tests::observations;
    VAR adapted coroutine_call_tests::controller;
    adapted.observed := observed<-;
    VAR result I32;
    VAR frame call_ranked#(@result MUT& I32, @CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
    frame.INITIALIZE(@result result);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(result == 84);
    TEST_ASSERT(observed.calls == 2);
  }

  ::destructor_choice STRUCT
  {
    .events VAR MUT->I32;
    .DESTRUCTOR FUNCTION() { .events-> += 100; }
    .DESTRUCTOR FUNCTION(@CONTROLLER MUT& coroutine_call_tests::controller) { .events-> += 1; }
    .DESTRUCTOR COROUTINE() { .events-> += 10; }
  }

  ::destroy_selected COROUTINE(@events MUT& I32)
  {
    VAR value destructor_choice;
    value.events := events<-;
  }

  DOC <$ Destructor overload ranking preserves ordinary execution when a concrete controller formal selects an ordinary body. $>
  ::ordinary_controller_destructor DUAL_TEST
  {
    VAR observed coroutine_call_tests::observations;
    VAR adapted coroutine_call_tests::controller;
    adapted.observed := observed<-;
    VAR events I32;
    VAR frame destroy_selected#(@events MUT& I32, @CONTROLLER coroutine_call_tests::controller)::FRAME_TYPE;
    frame.INITIALIZE(@events events);
    TEST_ASSERT(frame.RESUME(@CONTROLLER adapted));
    TEST_ASSERT(events == 1);
  }
}
