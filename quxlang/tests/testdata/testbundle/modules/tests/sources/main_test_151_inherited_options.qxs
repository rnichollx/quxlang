LANGUAGE QUXLANG EN 0.0;

::inherited_option_tests NAMESPACE
{
  DOC <$ Inherits through a forward-declared intermediate option. $>
  ::leaf
    OPTION NUMBER DEFAULT_FROM(middle);
  DOC <$ Shares the numeric source without creating mutable storage. $>
  ::middle
    OPTION NUMBER DEFAULT_FROM(base);
  DOC <$ Supplies the terminal numeric default. $>
  ::base
    OPTION NUMBER DEFAULT(17);
  DOC <$ Inherits the existing target override instead of its source default of 42. $>
  ::configured
    OPTION NUMBER DEFAULT_FROM(::option_num);

  DOC <$ Forward references and repeated option resolution preserve defaults and configured source values. $>
  ::numeric_chain_and_override
    DUAL_TEST
  {
    TEST_ASSERT(leaf == 17);
    TEST_ASSERT(middle == 17);
    TEST_ASSERT(base == 17);
    TEST_ASSERT(leaf + middle == 34);
    TEST_ASSERT(configured == 5);
    TEST_ASSERT(SAME_TYPES([leaf]I32, [17]I32));
    TEST_ASSERT(SAME_TYPES([configured]BYTE, [5]BYTE));
  }

  DOC <$ Allows a target override without changing the inherited source. $>
  ::independent
    OPTION NUMBER DEFAULT_FROM(base);
  DOC <$ Supplies the expected value for configuration-isolation validation. $>
  ::expected_independent
    OPTION NUMBER DEFAULT(17);

  DOC <$ Resolving a configured derived option never modifies its source or sibling defaults. $>
  ::derived_override_is_independent
    DUAL_TEST
  {
    TEST_ASSERT(independent == expected_independent);
    TEST_ASSERT(base == 17);
    TEST_ASSERT(leaf == 17);
    TEST_ASSERT(middle == 17);
  }

  DOC <$ Supplies an inherited Boolean default. $>
  ::truth OPTION BOOL DEFAULT(TRUE);
  DOC <$ Retains the Boolean kind through inheritance. $>
  ::inherited_truth OPTION BOOL DEFAULT_FROM(truth);
  DOC <$ Inherited Boolean values select static branches. $>
  ::boolean_selection
    DUAL_TEST
  {
    TEST_ASSERT(inherited_truth);
    STATIC_IF(inherited_truth) { TEST_ASSERT(TRUE); }
    STATIC_ELSE { TEST_ASSERT(FALSE); }
  }

  DOC <$ Gives an inherited default a distinct lexical source. $>
  ::nested NAMESPACE
  {
    DOC <$ Shadows the enclosing numeric option. $>
    ::base OPTION NUMBER DEFAULT(29);
    DOC <$ Resolves its source relative to the declaration. $>
    ::value OPTION NUMBER DEFAULT_FROM(base);
  }

  DOC <$ Caller locals cannot shadow the source of an inherited default. $>
  ::declaration_context
    DUAL_TEST
  {
    VAR base I32 := 91;
    TEST_ASSERT(nested::value == 29);
    TEST_ASSERT(leaf == 17);
    TEST_ASSERT(base == 91);
  }

  DOC <$ Forms a direct default cycle for semantic rejection. $>
  ::self_cycle OPTION NUMBER DEFAULT_FROM(self_cycle);
  DOC <$ Forms the first edge of an indirect cycle. $>
  ::cycle_first OPTION NUMBER DEFAULT_FROM(cycle_second);
  DOC <$ Closes an indirect default cycle. $>
  ::cycle_second OPTION NUMBER DEFAULT_FROM(cycle_first);
  DOC <$ Refers to a Boolean option from a numeric option. $>
  ::wrong_kind OPTION NUMBER DEFAULT_FROM(truth);
  DOC <$ Supplies a non-option symbol for default validation. $>
  ::ordinary STATIC I32 := 7;
  DOC <$ Refers to a constant instead of an option. $>
  ::non_option OPTION NUMBER DEFAULT_FROM(ordinary);
  DOC <$ Refers to an absent declaration. $>
  ::missing OPTION NUMBER DEFAULT_FROM(absent_option);
  DOC <$ Has no source default or configured value. $>
  ::required OPTION NUMBER;
  DOC <$ Reaches a source without a resolvable value. $>
  ::inherited_required OPTION NUMBER DEFAULT_FROM(required);

  DOC <$ Direct default cycles are invalid. $>
  ::reject_self_cycle
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := self_cycle; }
  DOC <$ Indirect default cycles are invalid. $>
  ::reject_indirect_cycle
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := cycle_first; }
  DOC <$ Default inheritance preserves the declared option kind. $>
  ::reject_kind_mismatch
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := wrong_kind; }
  DOC <$ Ordinary constants cannot supply DEFAULT_FROM declarations. $>
  ::reject_non_option
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := non_option; }
  DOC <$ Unresolved inherited default sources are invalid. $>
  ::reject_missing_source
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := missing; }
  DOC <$ A chain ending at an unconfigured required option cannot supply a value. $>
  ::reject_missing_value
    STATIC_TEST EXPECT_COMPILATION_FAILURE { VAR value I32 := inherited_required; }
}
