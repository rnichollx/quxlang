LANGUAGE QUXLANG EN 0.0;

::unary_postfix_exception_tests NAMESPACE
{
  DOC <$ An owned receiver throws from each custom unary operator. $>
  ::throwing_probe
    STRUCT MOVE_ONLY
  {
    .state VAR custom_unary_postfix_tests::probe;
    DOC <$ Starts the shared lifetime recorder before operator dispatch. $>
    .CONSTRUCTOR
      FUNCTION(@events MUT& I32, @alive MUT& I32)
      :> .state:(@events events, @alive alive, @truth TRUE)
    {
    }
    DOC <$ Throws from presence testing while the receiver remains alive. $>
    .OPERATOR??
      FUNCTION() CONST: BOOL
    {
      TEST_ASSERT(.state.alive-> == 1);
      .state.events-> := .state.events-> * 10 + 2;
      THROW I32(@OTHER 42);
    }
    DOC <$ Throws from logical negation while the receiver remains alive. $>
    .OPERATOR!!
      FUNCTION() CONST: BOOL
    {
      TEST_ASSERT(.state.alive-> == 1);
      .state.events-> := .state.events-> * 10 + 4;
      THROW I32(@OTHER 42);
    }
    DOC <$ Throws from bitwise negation while the receiver remains alive. $>
    .OPERATOR#!!
      FUNCTION() CONST: U8
    {
      TEST_ASSERT(.state.alive-> == 1);
      .state.events-> := .state.events-> * 10 + 5;
      THROW I32(@OTHER 42);
    }
  }

  DOC <$ Each throwing unary operator destroys its temporary receiver before enclosing scope cleanup and handler entry. $>
  ::receiver_unwinding
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR mode I32 := 0;
    LOOP WHILE (mode < 4) DO
    {
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR caught BOOL := FALSE;
      TRY
      {
        VAR outer control_flow_tests::exit_record :(@events events, @digit 8);
        IF (mode == 0)
        {
          throwing_probe(@events events, @alive alive) ??;
        }
        ELSE IF (mode == 1)
        {
          throwing_probe(@events events, @alive alive) !?;
        }
        ELSE IF (mode == 2)
        {
          throwing_probe(@events events, @alive alive) !!;
        }
        ELSE
        {
          throwing_probe(@events events, @alive alive) #!!;
        }
        TEST_ASSERT(FALSE);
      }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == 42);
        TEST_ASSERT(alive == 0);
        IF (mode == 1)
        {
          TEST_ASSERT(events == 1298);
        }
        ELSE
        {
          TEST_ASSERT(events == (12 + mode) * 100 + 98);
        }
        caught := TRUE;
      }
      TEST_ASSERT(caught);
      TEST_ASSERT(alive == 0);
      mode++;
    }
  }
}
