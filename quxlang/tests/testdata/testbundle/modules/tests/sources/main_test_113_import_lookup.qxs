LANGUAGE QUXLANG EN 0.0;
IMPORT foolib AS first_library;
IMPORT std AS containers;
IMPORT foolib AS second_library;

::import_lookup_tests NAMESPACE
{
  DOC <$ Resolves an imported module alias from within a namespace. $>
  ::read_imported
    FUNCTION(): I32 { RETURN first_library::imported_function(); }

  DOC <$ Two imports of one module retain declaration and global storage identity through aliases. $>
  ::renamed_module_identity
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(first_library::alias_exports::public_type, second_library::alias_exports::public_type));
    TEST_ASSERT(first_library::imported_function() == 42);
    TEST_ASSERT(second_library::alias_exports::iterator::read_private_member() == 53);
    VAR left MUT& I32 := first_library::import_identity::value;
    VAR right MUT& I32 := second_library::import_identity::value;
    TEST_ASSERT(left<- == right<-);
    TEST_ASSERT(left == 17);
    left := 29;
    TEST_ASSERT(second_library::import_identity::read() == 29);
    right := 41;
    TEST_ASSERT(first_library::import_identity::read() == 41);
    left := 17;
    VAR text containers::string := "renamed";
    TEST_ASSERT(text == "renamed");
  }

  DOC <$ Supplies the enclosing namespace value for lexical lookup. $>
  ::value
    STATIC I32 := 7;
  DOC <$ Resolves its name at the function declaration instead of at the caller. $>
  ::read_outer
    FUNCTION(): I32 { RETURN value; }

  ::nested NAMESPACE
  {
    DOC <$ Shadows the enclosing value inside the nested namespace. $>
    ::value
      STATIC I32 := 13;
    DOC <$ Combines nearest-scope lookup with a call to an enclosing declaration. $>
    ::read_inner
      FUNCTION(): I32 { RETURN value * 10 + read_outer(); }
    DOC <$ Retains the original function declaration through a local alias. $>
    ::outer_function
      ALIAS read_outer;
  }

  DOC <$ Caller locals and nested namespace names do not alter a function's lexical lookup. $>
  ::declaration_scope_lookup
    DUAL_TEST
  {
    VAR value I32 := 99;
    TEST_ASSERT(read_outer() == 7);
    TEST_ASSERT(nested::read_inner() == 137);
    TEST_ASSERT(nested::outer_function() == 7);
    TEST_ASSERT(value == 99);
  }
}

::import_declaration_tests NAMESPACE
{
  ::named IMPORT foolib;
  IMPORT foolib;
  ::foolib IMPORT foolib;
  IMPORT foolib AS renamed;
  ::renamed IMPORT foolib;
  ::import_enabled STATIC BOOL := TRUE;
  IMPORT_IF(import_enabled) foolib AS enabled;
  IMPORT_IF(TRUE) foolib AS enabled;
  ::named_enabled IMPORT_IF(TRUE) foolib;
  ::included INCLUDE_IF(TRUE) IMPORT foolib;
  IMPORT_IF(FALSE) foolib AS disabled;
  IMPORT_IF(FALSE) missing_import_test_module AS unavailable;
  ::named_disabled IMPORT_IF(FALSE) foolib;
  ::excluded INCLUDE_IF(FALSE) IMPORT foolib;
  IMPORT_IF(FALSE) std AS selected;
  IMPORT_IF(TRUE) foolib AS selected;

  DOC <$ Explicit, implicit, renamed, repeated and conditional imports share module identity. $>
  ::spellings
    DUAL_TEST
  {
    TEST_ASSERT(named::imported_function() == 42);
    TEST_ASSERT(foolib::imported_function() == 42);
    TEST_ASSERT(renamed::imported_function() == 42);
    TEST_ASSERT(enabled::imported_function() == 42);
    TEST_ASSERT(named_enabled::imported_function() == 42);
    TEST_ASSERT(included::imported_function() == 42);
    TEST_ASSERT(selected::imported_function() == 42);
    TEST_ASSERT(SAME_TYPES(named::alias_exports::public_type, renamed::alias_exports::public_type));
  }

  DOC <$ A false import condition excludes its declared name. $>
  ::disabled_lookup
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { disabled::imported_function(); }

  DOC <$ A false condition also excludes an explicitly named import. $>
  ::named_disabled_lookup
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { named_disabled::imported_function(); }

  DOC <$ INCLUDE_IF uses the same import inclusion field. $>
  ::excluded_lookup
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { excluded::imported_function(); }

  ::conflicting NAMESPACE
  {
    IMPORT foolib AS library;
    ::library IMPORT std;
  }

  DOC <$ Different modules cannot occupy the same active import name. $>
  ::conflicting_lookup
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { conflicting::library::imported_function(); }

  PRIVATE(MODULE) ::private_library IMPORT foolib;

  DOC <$ A module import follows ordinary alias privacy rules. $>
  ::private_access
    DUAL_TEST
  { TEST_ASSERT(private_library::imported_function() == 42); }
}

DOC <$ Imports remain accessible from other namespaces in the declaring module. $>
::private_import_lookup
  DUAL_TEST
{ TEST_ASSERT(import_declaration_tests::private_library::imported_function() == 42); }

::import_privacy_tests NAMESPACE
{
  ::shorthand_private STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR text first_library::import_identity::std::string; }

  ::renamed_private STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR text first_library::import_identity::renamed_std::string; }

  ::named_private STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR text first_library::import_identity::named_std::string; }

  ::conditional_private STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR text first_library::import_identity::conditional_std::string; }

  DOC <$ Public aliases re-expose imported modules and their types across module boundaries. $>
  ::public_alias
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(first_library::import_identity::exported_std::string, containers::string));
    TEST_ASSERT(SAME_TYPES(first_library::import_identity::exported_string, containers::string));
    VAR text first_library::import_identity::exported_std::string := "exported";
    TEST_ASSERT(text == "exported");
    TEST_ASSERT(first_library::import_identity::internal_import_access());
  }
}
