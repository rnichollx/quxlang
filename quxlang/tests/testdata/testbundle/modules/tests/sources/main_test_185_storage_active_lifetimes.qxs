LANGUAGE QUXLANG EN 0.0;

::storage_active_lifetime_tests NAMESPACE
{
  DOC <$ Constexpr cannot project an object from storage whose first lifetime has not begun. $>
  ::pun_before_construction
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    VAR value I32 := PUN slot AS I32;
  }

  DOC <$ Starting an allowed alternative requires ending the previous active lifetime first. $>
  ::construction_over_live_object
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    PLACE AT(slot) I32 := 17;
    PLACE AT(slot) U32 := 29;
  }

  DOC <$ Destruction cannot begin in empty storage even when its nominal type is allowed. $>
  ::destroy_before_construction
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    DESTROY AT(slot) I32;
  }

  DOC <$ An allowed storage alternative cannot be destroyed while a different type is active. $>
  ::destroy_inactive_alternative
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    PLACE AT(slot) I32 := 17;
    DESTROY AT(slot) U32;
  }

  DOC <$ An allowed equal-width alternative cannot be read through PUN while another type is active. $>
  ::pun_inactive_alternative
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    PLACE AT(slot) I32 := 17;
    VAR value U32 := PUN slot AS U32;
  }

  DOC <$ A second destruction cannot reuse a lifetime that has already ended. $>
  ::double_destruction
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    PLACE AT(slot) I32 := 17;
    DESTROY AT(slot) I32;
    DESTROY AT(slot) I32;
  }

  DOC <$ The original storage becomes empty after explicit destruction and cannot still project the old object. $>
  ::pun_after_destruction
    STATIC_TEST EXPECT_FAIL
  {
    VAR slot TYPED_STORAGE(I32, U32);
    PLACE AT(slot) I32 := 17;
    DESTROY AT(slot) I32;
    VAR value I32 := PUN slot AS I32;
  }
  ::unreleased_storage_owner STRUCT
  {
    .slot VAR TYPED_STORAGE(I32);
    .CONSTRUCTOR FUNCTION() { PLACE AT(.slot) I32 := 7; }
  }

  DOC <$ Ending a storage field's owning object still requires destruction of its active payload. $>
  ::active_member_storage_destruction
    STATIC_TEST EXPECT_FAIL
  {
    VAR owner unreleased_storage_owner;
  }
}
