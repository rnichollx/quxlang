LANGUAGE QUXLANG EN 0.0;

::nominal_associated_declaration_tests NAMESPACE
{
  DOC <$ Defines associated declarations in the owning enum scope. $>
  ::phase
    ENUM BITS(8) [idle DEFAULT = 0, running = 1, complete = 2]
  {
    DOC <$ Refers to the complete enclosing nominal type. $>
    ::self ALIAS phase;
    DOC <$ Constructs the selected initial state through its associated scope. $>
    ::initial
      FUNCTION(): self { RETURN idle; }
    DOC <$ Returns the following state without mutating the receiver. $>
    .next
      FUNCTION() CONST: phase
    {
      IF (THIS == idle) { RETURN running; }
      RETURN complete;
    }
    DOC <$ Mutates the original enum receiver using its associated method. $>
    .advance
      FUNCTION() { THIS := .next(); }
  }

  DOC <$ Defines methods alongside generated flag membership fields. $>
  ::permissions
    FLAGSET BITS(3) [read = 1, write = 2, execute = 4]
  {
    DOC <$ Names the enclosing flagset type from its associated body. $>
    ::self ALIAS permissions;
    DOC <$ Adds flags to the original receiver. $>
    .grant
      FUNCTION(@value self) { THIS #||= value; }
    DOC <$ Observes a generated membership field through a constant receiver. $>
    .can_read
      FUNCTION() CONST: BOOL { RETURN .read; }
  }

  DOC <$ Associated enum aliases, factory lookup and methods retain nominal identity and writable receiver state. $>
  ::enum_methods
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(phase::self, phase));
    VAR value phase := phase::initial();
    TEST_ASSERT(value == phase::idle);
    TEST_ASSERT(value.next() == phase::running);
    TEST_ASSERT(value == phase::idle);
    value.advance();
    TEST_ASSERT(value == phase::running);
    value.advance();
    TEST_ASSERT(value == phase::complete);
  }

  DOC <$ Associated flagset methods coexist with generated membership and preserve mutation through a constant observing reference. $>
  ::flagset_methods
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(permissions::self, permissions));
    VAR value permissions;
    VAR view CONST& permissions := value;
    TEST_ASSERT(view.can_read() == FALSE);
    value.grant(@value permissions::read);
    TEST_ASSERT(view.can_read());
    value.grant(@value permissions::write);
    TEST_ASSERT(value.read);
    TEST_ASSERT(value.write);
    TEST_ASSERT(value.execute == FALSE);
  }
}
