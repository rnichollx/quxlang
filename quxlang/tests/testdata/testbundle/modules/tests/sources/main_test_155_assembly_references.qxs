LANGUAGE QUXLANG EN 0.0;

::assembly_reference_tests INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) NAMESPACE
{
  DOC <$ Supplies global storage reached through a structured assembly relocation. $>
  ::storage VAR U64;

  DOC <$ Returns the address formed by paired page and page-offset relocations. $>
  ::storage_address
    ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(; RETURN MUT->U64)
  {
    ADRP X0, OBJECT_REF(storage)@PAGE
    ADD X0, X0, OBJECT_REF(storage)@PAGEOFF
    RET
  }

  DOC <$ Mutates pointed-to storage through a concrete Quxlang function reached from assembly. $>
  ::update
    FUNCTION(%value MUT->U64, %amount U64)
  { value-> += amount * 3; }

  DOC <$ Tail-branches to a concrete Quxlang function with an explicit C calling convention. $>
  ::tail_update
    ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@value MUT->U64, @amount U64)
  {
    B PROCEDURE_REF("CCALL", update!$[0])
  }

  DOC <$ Structured object references preserve global address identity and bidirectional visibility of writes. $>
  ::global_address_and_mutation
    UNIT_TEST
  {
    storage := 17;
    VAR pointer MUT->U64 := storage_address();
    TEST_ASSERT(pointer == storage<-);
    TEST_ASSERT(pointer-> == 17);
    pointer-> := 4294967313;
    TEST_ASSERT(storage == 4294967313);
    storage := 29;
    TEST_ASSERT(pointer-> == 29);
    TEST_ASSERT(storage_address() == pointer);
    storage := 0;
  }

  DOC <$ Structured procedure relocations reach the intended Quxlang body with pointer and scalar arguments intact. $>
  ::concrete_procedure_call
    UNIT_TEST
  {
    VAR value U64 := 17;
    VAR guard U64 := 4294967313;
    tail_update(@value value<-, @amount 9);
    TEST_ASSERT(value == 44);
    tail_update(@amount 7, @value value<-);
    TEST_ASSERT(value == 65);
    TEST_ASSERT(guard == 4294967313);
  }
}
