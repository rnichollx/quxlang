LANGUAGE QUXLANG EN 0.0;

::literal_type_tests NAMESPACE
{
  DOC <$ Matches the exact numeric literal type for seventeen. $>
  ::numeric
    FUNCTION(@value NUMERIC_LITERAL_TYPE("17")): I32 { RETURN 1; }
  DOC <$ Matches the exact numeric literal type for twenty-nine. $>
  ::numeric
    FUNCTION(@value NUMERIC_LITERAL_TYPE("29")): I32 { RETURN 2; }
  DOC <$ Matches a literal containing an embedded zero byte. $>
  ::text
    FUNCTION(@value STRING_LITERAL_TYPE("a\0b")): I32 { RETURN 3; }
  DOC <$ Distinguishes a shorter string literal from the embedded-zero spelling. $>
  ::text
    FUNCTION(@value STRING_LITERAL_TYPE("a")): I32 { RETURN 4; }

  DOC <$ Literal types preserve exact values and bytes during overload selection. $>
  ::exact_literal_selection
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(TYPEOF(17), NUMERIC_LITERAL_TYPE("17")));
    TEST_ASSERT(SAME_TYPES(TYPEOF("a\0b"), STRING_LITERAL_TYPE("a\0b")));
    TEST_ASSERT(numeric(@value 17) == 1);
    TEST_ASSERT(numeric(@value 29) == 2);
    TEST_ASSERT(text(@value "a\0b") == 3);
    TEST_ASSERT(text(@value "a") == 4);
  }

  DOC <$ Captures a numeric literal type and converts its bound argument to an integer. $>
  ::capture_number
    FUNCTION(@value NUMERIC_LITERAL_ANY(literal_type)): I32
  {
    TEST_ASSERT(SAME_TYPES(TYPEOF(value), literal_type));
    RETURN value AS I32;
  }
  DOC <$ Captures a string literal type and retains its string-constant contents. $>
  ::capture_text
    FUNCTION(@value STRING_LITERAL_ANY(literal_type)): STRING_CONSTANT
  {
    TEST_ASSERT(SAME_TYPES(TYPEOF(value), literal_type));
    RETURN value AS STRING_CONSTANT;
  }

  DOC <$ Repeated numeric literal captures preserve independent values. $>
  ::numeric_capture_values
    DUAL_TEST
  {
    TEST_ASSERT(capture_number(@value 17) == 17);
    TEST_ASSERT(capture_number(@value 429) == 429);
    TEST_ASSERT(capture_number(@value 17) == 17);
  }

  DOC <$ String literal captures preserve empty and embedded-zero contents. $>
  ::string_capture_values
    DUAL_TEST
  {
    VAR empty STRING_CONSTANT := capture_text(@value "");
    TEST_ASSERT(empty.BEGIN() == empty.END());
    VAR bytes STRING_CONSTANT := capture_text(@value "a\0b");
    VAR cursor CONST=>>BYTE := bytes.BEGIN();
    TEST_ASSERT((cursor++)-> == 97);
    TEST_ASSERT((cursor++)-> == 0);
    TEST_ASSERT((cursor++)-> == 98);
    TEST_ASSERT(cursor == bytes.END());
    VAR escaped STRING_CONSTANT := capture_text(@value "a\\0b");
    VAR escaped_cursor CONST=>>BYTE := escaped.BEGIN();
    TEST_ASSERT((escaped_cursor++)-> == 97);
    TEST_ASSERT((escaped_cursor++)-> == 92);
    TEST_ASSERT((escaped_cursor++)-> == 48);
    TEST_ASSERT((escaped_cursor++)-> == 98);
    TEST_ASSERT(escaped_cursor == escaped.END());
  }

}
