LANGUAGE QUXLANG EN 0.0;

::short_circuit_tests NAMESPACE
{
  DOC <$ Records operand evaluation and returns its supplied truth value. $>
  ::record
    FUNCTION(@events MUT& I32, @digit I32, @value BOOL): BOOL
  {
    events := events * 10 + digit;
    RETURN value;
  }

  DOC <$ Tracks construction and reverse destruction of expression temporaries. $>
  ::temporary
    STRUCT MOVE_ONLY
  {
    .events VAR MUT->I32;
    .alive VAR MUT->I32;
    .digit VAR I32;

    DOC <$ Records construction and increments the number of live temporaries. $>
    .CONSTRUCTOR
      FUNCTION(@events MUT& I32, @alive MUT& I32, @digit I32)
    {
      .events := events<-;
      .alive := alive<-;
      .digit := digit;
      events := events * 10 + digit;
      alive++;
    }

    DOC <$ Records destruction and decrements the number of live temporaries. $>
    .DESTRUCTOR
      FUNCTION()
    {
      .events-> := .events-> * 10 + .digit + 4;
      .alive-> --;
    }

    DOC <$ Evaluates a Boolean while this temporary remains alive. $>
    .test
      FUNCTION(@value BOOL) CONST: BOOL
    {
      TEST_ASSERT(.alive-> > 0);
      RETURN value;
    }
  }

  DOC <$ Checks that operand temporaries are gone before the enclosing call begins. $>
  ::observe_clean
    FUNCTION(@value BOOL, @alive CONST& I32): BOOL
  {
    TEST_ASSERT(alive == 0);
    RETURN value;
  }

  DOC <$ Reads two live operand temporaries without taking their ownership. $>
  ::pair_value
    FUNCTION(@first CONST& temporary, @second CONST& temporary, @value BOOL): BOOL
  {
    TEST_ASSERT(first.alive-> == 2);
    TEST_ASSERT(second.alive-> == 2);
    RETURN value;
  }

  DOC <$ Throws after observing a live right-hand-side temporary. $>
  ::throw_value
    FUNCTION(@object CONST& temporary): BOOL
  {
    TEST_ASSERT(object.alive-> == 1);
    THROW I32(@OTHER 42);
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::and_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) &&
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index == 3));
      IF (left) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::or_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) ||
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index != 0));
      IF (left == FALSE) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::nand_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) !&
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index != 3));
      IF (left) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::nor_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) !|
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index == 0));
      IF (left == FALSE) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::implies_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) ^>
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index != 2));
      IF (left) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$
    Checks every truth-table entry, left-to-right single evaluation, skipped
    right operands, and right-operand cleanup before the enclosing call.
    $>
  ::implied_truth_table_and_rhs_lifetime
    DUAL_TEST
  {
    VAR index I32 := 0;
    LOOP WHILE (index < 4) DO
    {
      VAR left BOOL := index >= 2;
      VAR right BOOL := (index % 2) == 1;
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR result BOOL := observe_clean(
        @value record(@events events, @digit 1, @value left) ^<
          temporary(@events events, @alive alive, @digit 2).test(@value right),
        @alive alive
      );
      TEST_ASSERT(result == (index != 1));
      IF (left == FALSE) { TEST_ASSERT(events == 126); }
      ELSE { TEST_ASSERT(events == 1); }
      TEST_ASSERT(alive == 0);
      index++;
    }
  }

  DOC <$ Destroys right-operand temporaries once, in reverse construction order. $>
  ::multiple_rhs_temporaries
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR result BOOL := observe_clean(@value TRUE && pair_value(
      @first temporary(@events events, @alive alive, @digit 2),
      @second temporary(@events events, @alive alive, @digit 3),
      @value TRUE
    ), @alive alive);
    TEST_ASSERT(result);
    TEST_ASSERT(events == 2376);
    TEST_ASSERT(alive == 0);
  }

  DOC <$ Cleans both operands on evaluated and skipped right-hand-side paths. $>
  ::both_operands_own_temporaries
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR result BOOL := observe_clean(@value
      temporary(@events events, @alive alive, @digit 1).test(@value TRUE) &&
      temporary(@events events, @alive alive, @digit 2).test(@value FALSE),
      @alive alive);
    TEST_ASSERT(result == FALSE);
    TEST_ASSERT(events == 1265);
    events := 0;
    result := observe_clean(@value
      temporary(@events events, @alive alive, @digit 1).test(@value TRUE) ||
      temporary(@events events, @alive alive, @digit 2).test(@value FALSE),
      @alive alive);
    TEST_ASSERT(result);
    TEST_ASSERT(events == 15);
  }

  DOC <$ Completes inner right-operand cleanup before evaluating an outer right operand. $>
  ::nested_rhs_cleanup
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR result BOOL := (TRUE &&
      temporary(@events events, @alive alive, @digit 2).test(@value TRUE)) &&
      observe_clean(@value record(@events events, @digit 3, @value TRUE), @alive alive);
    TEST_ASSERT(result);
    TEST_ASSERT(events == 263);
    events := 0;
    result := (FALSE ||
      temporary(@events events, @alive alive, @digit 2).test(@value FALSE)) ||
      observe_clean(@value record(@events events, @digit 3, @value TRUE), @alive alive);
    TEST_ASSERT(result);
    TEST_ASSERT(events == 263);
  }

  DOC <$ Unwinds evaluated right operands and never constructs skipped throwing operands. $>
  ::rhs_exception_and_skipped_throw
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result BOOL := TRUE && throw_value(
        @object temporary(@events events, @alive alive, @digit 2));
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 42);
      TEST_ASSERT(alive == 0);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(events == 26);
    events := 0;
    VAR result BOOL := FALSE && throw_value(
      @object temporary(@events events, @alive alive, @digit 2));
    TEST_ASSERT(result == FALSE);
    result := TRUE || throw_value(
      @object temporary(@events events, @alive alive, @digit 2));
    TEST_ASSERT(result);
    TEST_ASSERT(events == 0);
    TEST_ASSERT(alive == 0);
  }

  DOC <$ Cleans each evaluated right operand before entering the loop body. $>
  ::loop_condition_cleanup
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR iterations I32 := 0;
    LOOP WHILE (iterations < 3 &&
      temporary(@events events, @alive alive, @digit 2).test(@value TRUE)) DO
    {
      TEST_ASSERT(alive == 0);
      iterations++;
    }
    TEST_ASSERT(iterations == 3);
    TEST_ASSERT(events == 262626);
    TEST_ASSERT(alive == 0);
  }

  DOC <$ Returns a short-circuit result after cleaning its right operand. $>
  ::return_condition
    FUNCTION(@events MUT& I32, @alive MUT& I32): BOOL
  {
    RETURN FALSE || temporary(@events events, @alive alive, @digit 2).test(@value TRUE);
  }

  DOC <$ Destroys right-operand temporaries before returning to the caller. $>
  ::return_cleanup
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    TEST_ASSERT(return_condition(@events events, @alive alive));
    TEST_ASSERT(events == 26);
    TEST_ASSERT(alive == 0);
  }

  DOC <$ Changes the source Boolean during cleanup after its result has been evaluated. $>
  ::branch_mutator
    STRUCT MOVE_ONLY
  {
    .source VAR MUT->BOOL;
    .destroyed VAR MUT->I32;
    DOC <$ Retains the source Boolean and destruction counter. $>
    .CONSTRUCTOR
      FUNCTION(@source MUT& BOOL, @destroyed MUT& I32)
    {
      .source := source<-;
      .destroyed := destroyed<-;
    }
    DOC <$ Reads the source before cleanup changes it. $>
    .read
      FUNCTION() CONST: BOOL { RETURN .source->; }
    DOC <$ Flips the source and records exactly one destruction. $>
    .DESTRUCTOR
      FUNCTION()
    {
      .source-> := .source-> == FALSE;
      .destroyed-> ++;
    }
  }

  DOC <$ Preserves both true and false branch decisions when destructors mutate their source. $>
  ::branch_selection_survives_cleanup
    DUAL_TEST
  {
    VAR source BOOL := TRUE;
    VAR destroyed I32 := 0;
    VAR result BOOL := TRUE && branch_mutator(@source source, @destroyed destroyed).read();
    TEST_ASSERT(result);
    TEST_ASSERT(source == FALSE);
    TEST_ASSERT(destroyed == 1);
    result := FALSE || branch_mutator(@source source, @destroyed destroyed).read();
    TEST_ASSERT(result == FALSE);
    TEST_ASSERT(source);
    TEST_ASSERT(destroyed == 2);
  }

  DOC <$ Evaluates another short-circuit expression while a destructor is running. $>
  ::nested_cleanup
    STRUCT MOVE_ONLY
  {
    .events VAR MUT->I32;
    .alive VAR MUT->I32;
    DOC <$ Retains the event log and temporary count. $>
    .CONSTRUCTOR
      FUNCTION(@events MUT& I32, @alive MUT& I32)
    {
      .events := events<-;
      .alive := alive<-;
    }
    DOC <$ Supplies a true operand with nontrivial cleanup. $>
    .read
      FUNCTION() CONST: BOOL { RETURN TRUE; }
    DOC <$ Completes a nested branch and its temporary destruction before returning. $>
    .DESTRUCTOR
      FUNCTION()
    {
      VAR result BOOL := TRUE && temporary(@events .events->, @alive .alive->, @digit 2).test(@value TRUE);
      TEST_ASSERT(result);
      TEST_ASSERT(.alive-> == 0);
      .events-> := .events-> * 10 + 3;
    }
  }

  DOC <$ Keeps suspended branch destinations independent across destructor frames. $>
  ::nested_destructor_frames
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR result BOOL := FALSE || nested_cleanup(@events events, @alive alive).read();
    TEST_ASSERT(result);
    TEST_ASSERT(events == 263);
    TEST_ASSERT(alive == 0);
  }

  DOC <$ Observes an enclosing temporary after the nested right operand has been cleaned up. $>
  ::outer_value
    FUNCTION(@object CONST& temporary, @value BOOL): BOOL
  {
    TEST_ASSERT(object.alive-> == 1);
    RETURN value;
  }

  DOC <$ Keeps enclosing-expression temporaries alive while discarding only the nested operand temporaries. $>
  ::enclosing_temporary_survives
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR result BOOL := outer_value(
      @object temporary(@events events, @alive alive, @digit 1),
      @value TRUE && temporary(@events events, @alive alive, @digit 2).test(@value TRUE));
    TEST_ASSERT(result);
    TEST_ASSERT(events == 1265);
    TEST_ASSERT(alive == 0);
  }
}
