LANGUAGE QUXLANG EN 0.0;

::storage_constraint_tests NAMESPACE
{
  DOC <$ Placement statements require storage rather than an ordinary live scalar. $>
  ::nonstorage_statement
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR value I32; PLACE AT(value) I32 := 17; }

  DOC <$ Placement expressions reject ordinary scalar destinations before producing an object pointer. $>
  ::nonstorage_expression
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR value I32; VAR pointer ->I32 := PLACE AT(value) I32 := 17; }

  DOC <$ Equal-width scalar types remain distinct in typed storage. $>
  ::wrong_nominal_type
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR slot TYPED_STORAGE(I32); PLACE AT(slot) U32 := 17; }

  DOC <$ Explicit destruction must select a type permitted by the storage declaration. $>
  ::wrong_destroy_type
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR slot TYPED_STORAGE(I32); PLACE AT(slot) I32 := 17; DESTROY AT(slot) U32; }

  DOC <$ A constant storage view cannot initialize an object. $>
  ::const_initialization
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR slot TYPED_STORAGE(I32);
    VAR view CONST& TYPED_STORAGE(I32) := slot;
    PLACE AT(view) I32 := 17;
  }

  DOC <$ A constant storage view cannot end a live object's lifetime. $>
  ::const_destruction
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR slot TYPED_STORAGE(I32);
    PLACE AT(slot) I32 := 17;
    VAR view CONST& TYPED_STORAGE(I32) := slot;
    DESTROY AT(view) I32;
  }

  DOC <$ Aligned storage must have sufficient extent even when its alignment satisfies the object. $>
  ::insufficient_size INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR slot ALIGNED_STORAGE(8, 8); PLACE AT(slot) [3]I32; }

  DOC <$ Sufficient byte extent does not permit a type whose alignment exceeds the storage alignment. $>
  ::insufficient_alignment INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR slot ALIGNED_STORAGE(16, 1); PLACE AT(slot) I32 := 17; }

  DOC <$ WRITE storage references permit beginning an object lifetime in caller-owned storage. $>
  ::initialize_output
    FUNCTION(@slot WRITE& TYPED_STORAGE(I32)): MUT->I32
  { RETURN PLACE AT(slot) I32 := 29; }

  DOC <$ Initialization through WRITE storage returns a live object that can be mutated and destroyed through the original slot. $>
  ::write_initialization
    DUAL_TEST
  {
    VAR slot TYPED_STORAGE(I32);
    VAR value MUT->I32 := initialize_output(@slot slot);
    TEST_ASSERT(value-> == 29);
    value-> := 41;
    TEST_ASSERT((PUN slot AS I32) == 41);
    DESTROY AT(slot) I32;
  }
}
