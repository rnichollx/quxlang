LANGUAGE QUXLANG EN 0.0;

::member_incdec_tests NAMESPACE
{
  ::number DOC <$ Custom mutations return deliberately transformed scalar results independently of the updated receiver. $>
    STRUCT
  {
    .value VAR I32;
    .calls VAR MUT->I32;
    .OPERATOR++ DOC <$ Advances by two and returns ten times the previous value. $>
      FUNCTION(): I32
    {
      .calls-> ++;
      VAR previous I32 := .value;
      .value += 2;
      RETURN previous * 10;
    }
    .OPERATOR-- DOC <$ Retreats by three and returns one hundred times the previous value. $>
      FUNCTION(): I32
    {
      .calls-> ++;
      VAR previous I32 := .value;
      .value -= 3;
      RETURN previous * 100;
    }
  }

  ::receiver DOC <$ Counts evaluations of the expression that yields a mutable receiver. $>
    FUNCTION(@value MUT& number, @evaluations MUT& I32): MUT& number
  {
    evaluations++;
    RETURN value;
  }

  ::returned_member_results DOC <$ Postfix syntax forwards custom return values and combines both calls in written order. $>
    DUAL_TEST
  {
    VAR calls I32 := 0;
    VAR value number;
    value.value := 4;
    value.calls := calls<-;
    VAR result I32 := value++ + value--;
    TEST_ASSERT(result == 640);
    TEST_ASSERT(value.value == 3);
    TEST_ASSERT(calls == 2);
    TEST_ASSERT(value++ == 30);
    TEST_ASSERT(value.value == 5);
    TEST_ASSERT(value-- == 500);
    TEST_ASSERT(value.value == 2);
    TEST_ASSERT(calls == 4);
  }

  ::receiver_once DOC <$ Value-used and discarded postfix calls each evaluate their receiver once and invoke the selected member once. $>
    DUAL_TEST
  {
    VAR calls I32 := 0;
    VAR evaluations I32 := 0;
    VAR value number;
    value.value := 4;
    value.calls := calls<-;
    VAR result I32 := receiver(@value value, @evaluations evaluations)++;
    TEST_ASSERT(result == 40);
    TEST_ASSERT(value.value == 6);
    TEST_ASSERT(calls == 1);
    TEST_ASSERT(evaluations == 1);
    receiver(@value value, @evaluations evaluations)--;
    TEST_ASSERT(value.value == 3);
    TEST_ASSERT(calls == 2);
    TEST_ASSERT(evaluations == 2);
  }
}
