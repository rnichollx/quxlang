LANGUAGE QUXLANG EN 0.0;

::iterator_lifetime_tests NAMESPACE
{
  ::filtered_mutation DOC <$ Filter temporaries expire before the body, mutable items alias array storage, and CONTINUE advances rejected and accepted iterations. $>
    DUAL_TEST
  {
    VAR values [4]I32 :[1, 2, 3, 4];
    VAR events I32 := 0;
    VAR cleanup I32 := 0;
    VAR alive I32 := 0;
    VAR count I32 := 0;
    LOOP ITER(iter) ITEM(item) IN(values)
      FILTER(short_circuit_tests::temporary(@events events, @alive alive, @digit 1).test(@value (item % 2) == 1)) DO
    {
      TEST_ASSERT(alive == 0);
      TEST_ASSERT((iter->)<- == item<-);
      VAR local control_flow_tests::exit_record :(@events cleanup, @digit 7);
      item += 10;
      count++;
      CONTINUE;
      TEST_ASSERT(FALSE);
    };
    TEST_ASSERT(count == 2);
    TEST_ASSERT(events == 15151515);
    TEST_ASSERT(cleanup == 77);
    TEST_ASSERT(alive == 0);
    TEST_ASSERT(values[0] == 11);
    TEST_ASSERT(values[1] == 2);
    TEST_ASSERT(values[2] == 13);
    TEST_ASSERT(values[3] == 4);
  }

  ::explicit_step_and_break DOC <$ An explicit iterator step runs once after CONTINUE and is skipped after BREAK. $>
    DUAL_TEST
  {
    VAR values [4]I32 :[1, 2, 3, 4];
    VAR steps I32 := 0;
    VAR visits I32 := 0;
    VAR cleanup I32 := 0;
    LOOP ITER(iter) ITEM(item) START(values.BEGIN()) END(values.END()) STEP
    {
      TEST_ASSERT(cleanup == visits);
      steps++;
      iter++;
    } DO
    {
      DEFER cleanup++;
      visits++;
      TEST_ASSERT(item == visits);
      item += 10;
      IF (visits == 2) { BREAK; }
      CONTINUE;
    };
    TEST_ASSERT(visits == 2);
    TEST_ASSERT(steps == 1);
    TEST_ASSERT(cleanup == 2);
    TEST_ASSERT(values[0] == 11);
    TEST_ASSERT(values[1] == 12);
    TEST_ASSERT(values[2] == 3);
    TEST_ASSERT(values[3] == 4);
  }

  ::indexed_value_aliases DOC <$ Indexed container projections refer to the same element, including filtered mutations. $>
    DUAL_TEST
  {
    VAR values std::dynarr#(I32);
    values.push_back(@value 4);
    values.push_back(@value 5);
    values.push_back(@value 6);
    values.push_back(@value 7);
    VAR count I32 := 0;
    LOOP INDEX(index) VALUE(value) IN(values) FILTER((index % 2) == 0) DO
    {
      TEST_ASSERT(value<- == values[index]<-);
      value *= 3;
      count++;
    };
    TEST_ASSERT(count == 2);
    TEST_ASSERT(values[0] == 12);
    TEST_ASSERT(values[1] == 5);
    TEST_ASSERT(values[2] == 18);
    TEST_ASSERT(values[3] == 7);
  }
}
