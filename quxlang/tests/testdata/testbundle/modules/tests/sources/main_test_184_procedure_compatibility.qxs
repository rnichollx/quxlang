LANGUAGE QUXLANG EN 0.0;

::procedure_compatibility_tests NAMESPACE
{
  DOC <$ Handles a local exception before returning through a nonthrowing callable boundary. $>
  ::nonthrowing
    FUNCTION(@value I32) NOEXCEPT: I32
  {
    TRY { THROW I32(@OTHER value); }
    CATCH error CONST& I32 { RETURN error + 1; }
    RETURN 0;
  }
  DOC <$ Supplies a callable without a nonthrowing guarantee. $>
  ::potentially_throwing
    FUNCTION(@value I32): I32 { RETURN value; }
  DOC <$ Uses asymmetric positional types whose order is part of the callable signature. $>
  ::ordered
    FUNCTION(%first I32, %second I64): I64 { RETURN (first AS I64) + second; }

  DOC <$ Exact NOEXCEPT procedure pointers retain their target through copying and allow exceptions handled within the callable. $>
  ::nonthrowing_indirect_call
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR pointer CONST->PROCEDURE NOEXCEPT(@value I32: I32) := nonthrowing<-;
    VAR copied CONST->PROCEDURE NOEXCEPT(@value I32: I32) := pointer;
    TEST_ASSERT(copied(@value 17) == 18);
    TEST_ASSERT(pointer(@value 29) == 30);
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
  }

  DOC <$ Callable pointer conversion cannot silently rename a public named parameter. $>
  ::named_parameter_mismatch
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR pointer CONST->PROCEDURE(@different I32: I32) := potentially_throwing<-;
  }

  DOC <$ Positional parameter types must match in order when taking a callable address. $>
  ::positional_order_mismatch
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR pointer CONST->PROCEDURE(I64, I32: I64) := ordered<-;
  }

  DOC <$ A potentially throwing callable cannot initialize a procedure pointer promising no escaping exceptions. $>
  ::noexcept_strengthening
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR pointer CONST->PROCEDURE NOEXCEPT(@value I32: I32) := potentially_throwing<-;
  }

  DOC <$ A value-returning callable cannot initialize a procedure pointer returning a mutable reference. $>
  ::return_category_mismatch
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR pointer CONST->PROCEDURE(@value I32: MUT& I32) := potentially_throwing<-;
  }
}
