LANGUAGE QUXLANG EN 0.0;

::aligned_storage_alignment_tests INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) NAMESPACE
{
  ::zero_is_one DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(ALIGNED_STORAGE(16, 0), ALIGNED_STORAGE(16, 1)));
    TEST_ASSERT(ALIGNOF(ALIGNED_STORAGE(16, 0)) == 1);
    TEST_ASSERT(SIZEOF(ALIGNED_STORAGE(16, 0)) == 16);
    VAR slot ALIGNED_STORAGE(1, 0);
    PLACE AT(slot) BYTE := 7;
    TEST_ASSERT((PUN slot AS BYTE) == 7);
    DESTROY AT(slot) BYTE;
  }

  ::powers_of_two STATIC_TEST
  {
    TEST_ASSERT(ALIGNOF(ALIGNED_STORAGE(16, 1)) == 1);
    TEST_ASSERT(ALIGNOF(ALIGNED_STORAGE(16, 2)) == 2);
    TEST_ASSERT(ALIGNOF(ALIGNED_STORAGE(16, 8)) == 8);
    TEST_ASSERT(ALIGNOF(ALIGNED_STORAGE(16, 65536)) == 65536);
  }

  ::three STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR slot ALIGNED_STORAGE(16, 3);
  }

  ::six STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR size AUTO := SIZEOF(ALIGNED_STORAGE(16, 6));
  }

  ::empty_storage STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR alignment AUTO := ALIGNOF(ALIGNED_STORAGE(0, 3));
  }

  ::large_non_power STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR size AUTO := SIZEOF(ALIGNED_STORAGE(16, 9223372036854775809));
  }
}
