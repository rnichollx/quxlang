LANGUAGE QUXLANG EN 0.0;

::expression_grouping_tests NAMESPACE
{
  DOC <$ Multiplication binds above addition, which binds above division; parentheses override these levels. $>
  ::arithmetic_levels
    DUAL_TEST
  {
    VAR a I32 := 20;
    VAR b I32 := 2;
    VAR c I32 := 3;
    TEST_ASSERT((a / b + c) == 4);
    TEST_ASSERT(((a / b) + c) == 13);
    TEST_ASSERT((a + b / c) == 7);
    TEST_ASSERT((a + (b / c)) == 20);
    TEST_ASSERT((a / b * c) == 3);
    TEST_ASSERT(((a / b) * c) == 30);
    TEST_ASSERT((a - b * c) == 14);
    TEST_ASSERT(((a - b) * c) == 54);
    TEST_ASSERT((a - b - c) == 15);
    TEST_ASSERT((a - (b - c)) == 21);
    TEST_ASSERT((a / b / c) == 3);
    TEST_ASSERT((a % b + c) == 0);
    TEST_ASSERT(((a % b) + c) == 3);
  }

  DOC <$ Bitwise operators and shifts share a left-associative level above arithmetic addition. $>
  ::bitwise_shared_level
    DUAL_TEST
  {
    VAR a U32 := 1;
    VAR b U32 := 2;
    VAR c U32 := 2;
    TEST_ASSERT((a #|| b #&& c) == 2);
    TEST_ASSERT((a #|| (b #&& c)) == 3);
    TEST_ASSERT((a #|| b #++ c) == 12);
    TEST_ASSERT((a #|| (b #++ c)) == 9);
    TEST_ASSERT((a + b #++ c) == 9);
    TEST_ASSERT(((a + b) #++ c) == 12);
    TEST_ASSERT((a #^^ b #|| c) == 3);
    TEST_ASSERT((a #++ b #++ c) == 16);
  }
}
