LANGUAGE QUXLANG EN 0.0;

::checked_arithmetic_tests NAMESPACE
{
  DOC <$ Overflow exceptions retain ordinary object identity across saved handles and rethrows. $>
  ::exception_ownership
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR saved EXCEPTION_PTR;
    TRY { VAR value U8 := 255; value +=? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW
    {
      saved := CURRENT_EXCEPTION();
      TEST_ASSERT(saved??);
      TEST_ASSERT(saved.IS_OUT_OF_MEMORY() == FALSE);
    }
    VAR caught BOOL := FALSE;
    TRY { THROW_EXCEPTION_PTR(saved); }
    CATCH error CONST& ARITHMETIC_OVERFLOW
    {
      caught := TRUE;
      TEST_ASSERT(CURRENT_EXCEPTION() == saved);
    }
    TEST_ASSERT(caught);
  }
  DOC <$ Counts at and above the logical width produce zero before count narrowing. $>
  ::oversized_shift
    TEMPLATE(@T TYPE AUTO) FUNCTION(@count SZ)
  {
    VAR value T := 1;
    TEST_ASSERT((value #++ count) == 0);
    TEST_ASSERT((value #-- count) == 0);
    VAR up T := value;
    VAR down T := value;
    up #++= count;
    down #--= count;
    TEST_ASSERT(up == 0);
    TEST_ASSERT(down == 0);
  }

  DOC <$ Ordinary shifts handle boundaries, odd widths, and counts exceeding the operand representation. $>
  ::ordinary_shift_counts
    DUAL_TEST
  {
    oversized_shift#U5(@count 5);
    oversized_shift#U8(@count 8);
    oversized_shift#I8(@count 8);
    oversized_shift#U8(@count 256);
    oversized_shift#U32(@count 32);
    oversized_shift#U64(@count 64);
    oversized_shift#U128(@count 128);
    oversized_shift#U8(@count (0 AS SZ) #!!);
  }
  DOC <$ Checked and assumed operations agree with ordinary arithmetic inside the permitted range. $>
  ::valid_operations
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR a I32 := 24;
    VAR b I32 := 3;
    TEST_ASSERT((a +? b) == 27);
    TEST_ASSERT((a +! b) == 27);
    TEST_ASSERT((a -? b) == 21);
    TEST_ASSERT((a -! b) == 21);
    TEST_ASSERT((a *? b) == 72);
    TEST_ASSERT((a *! b) == 72);
    TEST_ASSERT((a /? b) == 8);
    TEST_ASSERT((a /! b) == 8);
    TEST_ASSERT((a #++? 3) == 192);
    TEST_ASSERT((a #++! 3) == 192);
    TEST_ASSERT((a #--? 3) == 3);
    TEST_ASSERT((a #--! 3) == 3);
    TEST_ASSERT((a #+%? 3) == 192);
    TEST_ASSERT((a #+%! 3) == 192);
    TEST_ASSERT((a #-%? 3) == 3);
    TEST_ASSERT((a #-%! 3) == 3);
  }

  DOC <$ Checked addition of two operands throws the arithmetic overflow exception. $>
  ::addition_overflow
    TEMPLATE(@T TYPE AUTO) FUNCTION(@a T, @b T)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result T := a +? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    caught := FALSE;
    VAR value T := a;
    TRY
    {
      value +=? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == a);
  }

  DOC <$ Signed, unsigned, and non-byte additions propagate typed range failures. $>
  ::addition_overflow_operands
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    addition_overflow#I8(@a 127, @b 1);
    addition_overflow#I8(@a -128, @b -1);
    addition_overflow#U8(@a 255, @b 1);
    addition_overflow#I5(@a 15, @b 1);
    addition_overflow#I5(@a -16, @b -1);
    addition_overflow#U5(@a 31, @b 1);
  }

  DOC <$ Checked subtraction of two operands throws the arithmetic overflow exception. $>
  ::subtraction_overflow
    TEMPLATE(@T TYPE AUTO) FUNCTION(@a T, @b T)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result T := a -? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    caught := FALSE;
    VAR value T := a;
    TRY
    {
      value -=? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == a);
  }

  DOC <$ Checked multiplication of two operands throws the arithmetic overflow exception. $>
  ::multiplication_overflow
    TEMPLATE(@T TYPE AUTO) FUNCTION(@a T, @b T)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result T := a *? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    caught := FALSE;
    VAR value T := a;
    TRY
    {
      value *=? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == a);
  }

  DOC <$ Checked division of two operands throws the arithmetic overflow exception. $>
  ::division_overflow
    TEMPLATE(@T TYPE AUTO) FUNCTION(@a T, @b T)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result T := a /? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    caught := FALSE;
    VAR value T := a;
    TRY
    {
      value /=? b;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == a);
  }

  DOC <$ Signed bounds and unsigned underflow produce typed subtraction failures. $>
  ::subtraction_overflow_operands
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    subtraction_overflow#I8(@a -128, @b 1);
    subtraction_overflow#I8(@a 127, @b -1);
    subtraction_overflow#U8(@a 0, @b 1);
    subtraction_overflow#I5(@a -16, @b 1);
    subtraction_overflow#I5(@a 15, @b -1);
    subtraction_overflow#U5(@a 0, @b 1);
  }

  DOC <$ Signed and unsigned products outside the destination range produce typed failures. $>
  ::multiplication_overflow_operands
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    multiplication_overflow#I8(@a 64, @b 2);
    multiplication_overflow#I8(@a -65, @b 2);
    multiplication_overflow#I8(@a -128, @b -1);
    multiplication_overflow#U8(@a 128, @b 2);
    multiplication_overflow#I5(@a 8, @b 2);
    multiplication_overflow#I5(@a -9, @b 2);
    multiplication_overflow#U5(@a 16, @b 2);
  }

  DOC <$ Dividing the minimum signed value by negative one produces a typed failure. $>
  ::division_overflow_operands
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    division_overflow#I8(@a -128, @b -1);
    division_overflow#I5(@a -16, @b -1);
  }

  DOC <$ Checked division by zero throws arithmetic overflow for signed and unsigned operands. $>
  ::division_by_zero
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    division_overflow#I8(@a 0, @b 0);
    division_overflow#I8(@a 1, @b 0);
    division_overflow#I8(@a -1, @b 0);
    division_overflow#U8(@a 0, @b 0);
    division_overflow#U8(@a 1, @b 0);
    division_overflow#I5(@a 0, @b 0);
    division_overflow#I5(@a 1, @b 0);
    division_overflow#I5(@a -1, @b 0);
    division_overflow#U5(@a 0, @b 0);
    division_overflow#U5(@a 1, @b 0);
  }

  DOC <$ Range failures propagate as typed exceptions for signed and unsigned arithmetic. $>
  ::overflow_exceptions
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught U32 := 0;
    TRY { AUTO result := (127 AS I8) +? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (-128 AS I8) -? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (64 AS I8) *? 2; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (-128 AS I8) /? -1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (255 AS U8) +? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (0 AS U8) -? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (128 AS U8) *? 2; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := (1 AS U8) /? 0; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(caught == 8);
  }

  DOC <$ Checked shifts and rotations reject counts equal to or larger than the bit width. $>
  ::invalid_counts
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught U32 := 0;
    VAR value U8 := 1;
    TRY { AUTO result := value #++? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #++? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #++? ((0 AS SZ) #!!); TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #--? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #--? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #--? ((0 AS SZ) #!!); TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #+%? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #+%? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #+%? ((0 AS SZ) #!!); TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #-%? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #-%? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := value #-%? ((0 AS SZ) #!!); TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(caught == 12);
  }
  DOC <$ Negative literals preserve signed minima and participate in ordinary literal arithmetic. $>
  ::negative_literals
    DUAL_TEST
  {
    TEST_ASSERT(-128 == 0 - 128);
    TEST_ASSERT(-0 == 0);
    TEST_ASSERT(5 + -3 == 2);
    TEST_ASSERT(5 - -3 == 8);
    TEST_ASSERT(-3 * -4 == 12);
    VAR minimum I8 := -128;
    VAR wide_minimum I64 := -9223372036854775808;
    TEST_ASSERT(minimum == -128);
    TEST_ASSERT(wide_minimum == -9223372036854775808);
  }
  DOC <$ Checks signed and unsigned limits independently of their storage width. $>
  ::integer_boundaries
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR a T := 6;
    VAR b T := 2;
    TEST_ASSERT((a +? b) == 8);
    TEST_ASSERT((a -? b) == 4);
    TEST_ASSERT((a *? b) == 12);
    STATIC_IF(BITS(T) <= 64) { TEST_ASSERT((a /? b) == 3); }
    TEST_ASSERT((a +! b) == 8);
    TEST_ASSERT((a -! b) == 4);
    TEST_ASSERT((a *! b) == 12);
    STATIC_IF(BITS(T) <= 64) { TEST_ASSERT((a /! b) == 3); }
    VAR minimum T := 0;
    VAR maximum T := (0 AS T) #!!;
    STATIC_IF(IS_SIGNED(T))
    {
      minimum := (1 AS T) #++ (BITS(T) - 1);
      maximum := minimum #!!;
    }
    VAR caught U32 := 0;
    TRY { AUTO result := maximum +? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := minimum -? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TRY { AUTO result := maximum *? 2; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(caught == 3);
    STATIC_IF(IS_SIGNED(T) && BITS(T) <= 64)
    {
      TRY { AUTO result := minimum /? -1; TEST_ASSERT(FALSE); }
      CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
      TEST_ASSERT(caught == 4);
    }
  }

  DOC <$ Range contracts cover odd widths and integers wider than a machine register. $>
  ::integer_widths
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    integer_boundaries#U5();
    integer_boundaries#I5();
    integer_boundaries#U16();
    integer_boundaries#I16();
    integer_boundaries#U64();
    integer_boundaries#I64();
    integer_boundaries#U128();
    integer_boundaries#I128();
  }
  DOC <$ Mutating range operators store the successful result for each arithmetic and bit operation. $>
  ::mutating_valid_operations
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value I32 := 24;
    value := 24; value +=? 3; TEST_ASSERT(value == 27);
    value := 24; value +=! 3; TEST_ASSERT(value == 27);
    value := 24; value -=? 3; TEST_ASSERT(value == 21);
    value := 24; value -=! 3; TEST_ASSERT(value == 21);
    value := 24; value *=? 3; TEST_ASSERT(value == 72);
    value := 24; value *=! 3; TEST_ASSERT(value == 72);
    value := 24; value /=? 3; TEST_ASSERT(value == 8);
    value := 24; value /=! 3; TEST_ASSERT(value == 8);
    value := 24; value #++=? 3; TEST_ASSERT(value == 192);
    value := 24; value #++=! 3; TEST_ASSERT(value == 192);
    value := 24; value #--=? 3; TEST_ASSERT(value == 3);
    value := 24; value #--=! 3; TEST_ASSERT(value == 3);
    value := 24; value #+%=? 3; TEST_ASSERT(value == 192);
    value := 24; value #+%=! 3; TEST_ASSERT(value == 192);
    value := 24; value #-%=? 3; TEST_ASSERT(value == 3);
    value := 24; value #-%=! 3; TEST_ASSERT(value == 3);
  }

  DOC <$ Overflow leaves each destination unchanged and propagates the typed exception. $>
  ::mutating_failures
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value U8 := 0;
    VAR caught U32 := 0;
    value := 255;
    TRY { value +=? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 255);
    value := 0;
    TRY { value -=? 1; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 0);
    value := 128;
    TRY { value *=? 2; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 128);
    value := 1;
    TRY { value /=? 0; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 1);
    value := 1;
    TRY { value #++=? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 1);
    value := 1;
    TRY { value #--=? 8; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 1);
    value := 1;
    TRY { value #+%=? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 1);
    value := 1;
    TRY { value #-%=? 256; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught++; }
    TEST_ASSERT(value == 1);
    TEST_ASSERT(caught == 8);
  }

  DOC <$ Arithmetic failure unwinds deferred actions before entering the enclosing handler. $>
  ::overflow_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR cleaned U32 := 0;
    VAR caught BOOL := FALSE;
    TRY
    {
      DEFER { cleaned++; }
      VAR value U8 := 255;
      value +=? 1;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& ARITHMETIC_OVERFLOW
    {
      caught := TRUE;
      TEST_ASSERT(cleaned == 1);
      TEST_ASSERT(CURRENT_EXCEPTION().IS_OUT_OF_MEMORY() == FALSE);
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(cleaned == 1);
  }

  DOC <$ Byte arithmetic uses unsigned range checks and division for high bit patterns. $>
  ::byte_arithmetic
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value BYTE := 240;
    TEST_ASSERT((value /? 2) == 120);
    TEST_ASSERT((value % 100) == 40);
    TEST_ASSERT((value +! 1) == 241);
    value /=? 2;
    TEST_ASSERT(value == 120);
    value *=! 2;
    TEST_ASSERT(value == 240);
    VAR caught BOOL := FALSE;
    TRY { value +=? 16; TEST_ASSERT(FALSE); }
    CATCH error CONST& ARITHMETIC_OVERFLOW { caught := TRUE; }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == 240);
  }

  DOC <$ Ordinary rotations reduce the full count, including counts larger than a narrow operand can hold. $>
  ::rotation_counts
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value U5 := 17;
    TEST_ASSERT((value #+% 5) == value);
    TEST_ASSERT((value #-% 5) == value);
    TEST_ASSERT((value #+% 256) == 3);
    TEST_ASSERT((value #-% 256) == 24);
    value #+%= 256;
    TEST_ASSERT(value == 3);
    value #-%= 256;
    TEST_ASSERT(value == 17);
    TEST_ASSERT((value #++? 4) == 16);
    TEST_ASSERT((value #--! 4) == 1);
    TEST_ASSERT((value #+%? 0) == value);
    TEST_ASSERT((value #-%! 0) == value);
  }

}
