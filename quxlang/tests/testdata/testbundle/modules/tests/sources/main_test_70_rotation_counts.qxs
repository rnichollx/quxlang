LANGUAGE QUXLANG EN 0.0;

::rotation_count_tests NAMESPACE
{
  ::cycles DOC <$ Compares rotations to arithmetic powers of two over two complete cycles, including both assignment forms. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR width SZ := BITS(T);
    VAR high T := 1;
    VAR bit SZ := 1;
    WHILE (bit < width) { high *= 2; bit++; }
    VAR one T := 1;
    VAR expected_up T := 1;
    VAR position SZ := 0;
    VAR count SZ := 0;
    WHILE (count <= width * 2)
    {
      VAR expected_down T := 1;
      IF (position != 0) { expected_down := high / (expected_up / 2); }
      ASSERT((one #+% count) == expected_up);
      ASSERT((one #-% count) == expected_down);
      VAR up T := one;
      VAR down T := one;
      up #+%= count;
      down #-%= count;
      ASSERT(up == expected_up);
      ASSERT(down == expected_down);
      ASSERT((up #-% count) == one);
      ASSERT((down #+% count) == one);
      position++;
      IF (position == width) { position := 0; expected_up := 1; }
      ELSE { expected_up *= 2; }
      count++;
    }
  }

  ::complete_rotation_cycles DOC <$ Rotations use logical bit width for integer types up to 32 bits. $>
    DUAL_TEST
  {
    cycles#(U5)();
    cycles#(U8)();
    cycles#(U12)();
    cycles#(U16)();
    cycles#(U32)();
  }

  ::wide_rotation_cycles DOC <$ Rotations cover two complete 64-bit cycles using a division-based arithmetic oracle. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_X86)
  {
    cycles#(U64)();
  }

  ::signed_pattern DOC <$ Interprets a bounded bit pattern as the selected signed or unsigned integer. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@pattern U32, @modulus U32): T
  {
    VAR value I64 := pattern AS I64;
    STATIC_IF(IS_SIGNED(T))
    {
      IF (pattern >= modulus / 2) { value -= modulus AS I64; }
    }
    RETURN value AS CHECKED T;
  }

  ::pattern_rotation DOC <$ Checks both rotation directions and assignments against a one-bit arithmetic oracle. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@pattern U32, @count SZ)
  {
    VAR modulus U32 := 1;
    VAR bit SZ := 0;
    WHILE (bit < BITS(T)) { modulus *= 2; bit++; }
    VAR expected_up U32 := pattern;
    VAR expected_down U32 := pattern;
    VAR steps SZ := count % (BITS(T) AS SZ);
    WHILE (steps != 0)
    {
      expected_up := ((expected_up * 2) % modulus) + (expected_up / (modulus / 2));
      expected_down := (expected_down / 2) + ((expected_down % 2) * (modulus / 2));
      steps--;
    }
    VAR value T := signed_pattern#(T)(@pattern pattern, @modulus modulus);
    VAR up T := signed_pattern#(T)(@pattern expected_up, @modulus modulus);
    VAR down T := signed_pattern#(T)(@pattern expected_down, @modulus modulus);
    ASSERT((value #+% count) == up);
    ASSERT((value #-% count) == down);
    VAR mut_up T := value;
    VAR mut_down T := value;
    mut_up #+%= count;
    mut_down #-%= count;
    ASSERT(mut_up == up);
    ASSERT(mut_down == down);
  }

  ::five_bit_patterns DOC <$ Every signed and unsigned five-bit pattern rotates over in-range and out-of-range counts. $>
    DUAL_TEST
  {
    VAR pattern U32 := 0;
    WHILE (pattern < 32)
    {
      VAR count SZ := 0;
      WHILE (count <= 11)
      {
        pattern_rotation#(I5)(@pattern pattern, @count count);
        pattern_rotation#(U5)(@pattern pattern, @count count);
        count++;
      }
      pattern_rotation#(I5)(@pattern pattern, @count 32);
      pattern_rotation#(I5)(@pattern pattern, @count 65537);
      pattern_rotation#(U5)(@pattern pattern, @count ((0 AS SZ) #!!));
      pattern++;

    }
  }

  ::odd_width_high_bit_patterns DOC <$ Signed high bits and mixed patterns retain their full logical width at the maximum valid rotation count. $>
    DUAL_TEST
  {
    pattern_rotation#(I7)(@pattern 65, @count 6);
    pattern_rotation#(U7)(@pattern 65, @count 6);
    pattern_rotation#(I12)(@pattern 2049, @count 11);
    pattern_rotation#(U12)(@pattern 2049, @count 11);
    pattern_rotation#(I17)(@pattern 65537, @count 16);
    pattern_rotation#(U17)(@pattern 65537, @count 16);
  }

  ::large_rotation_counts DOC <$ Odd-width rotations preserve all count bits before modulo reduction, including both compound forms. $>
    DUAL_TEST
  {
    pattern_rotation#(I7)(@pattern 65, @count 65537);
    pattern_rotation#(U7)(@pattern 65, @count 65537);
    pattern_rotation#(I12)(@pattern 2049, @count 65537);
    pattern_rotation#(U12)(@pattern 2049, @count 65537);
    pattern_rotation#(I17)(@pattern 65537, @count ((0 AS SZ) #!!));
    pattern_rotation#(U17)(@pattern 65537, @count ((0 AS SZ) #!!));
    pattern_rotation#(I8)(@pattern 129, @count 8);
    pattern_rotation#(U16)(@pattern 32769, @count 65537);
  }

}
