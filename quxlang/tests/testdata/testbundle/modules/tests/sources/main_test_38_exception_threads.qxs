LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::exception_threads DOC <$ Handlers are thread-local while exception handles and the permanent sentinel share atomic ownership. $>
UNIT_TEST KNOWN_BROKEN_IF((OS_MACOS || OS_LINUX || OS_WINDOWS) == FALSE)
{
  VAR shared EXCEPTION_PTR;
  TRY { THROW UNWIND_OUT_OF_MEMORY; }
  CATCH UNWIND_OUT_OF_MEMORY { shared := CURRENT_EXCEPTION(); }
  VAR completed ATOMIC#I32;
  VAR action AUTO := -<
  {
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
    VAR index SZ := 0;
    LOOP WHILE (index < 100) DO
    {
      TRY { THROW_EXCEPTION_PTR(shared); }
      CATCH UNWIND_OUT_OF_MEMORY
      {
        TEST_ASSERT(CURRENT_EXCEPTION() == shared);
        TRY { THROW U32(@OTHER 17); }
        CATCH inner CONST& U32
        {
          TEST_ASSERT(inner == 17);
          TEST_ASSERT((CURRENT_EXCEPTION() == shared) == FALSE);
        }
        TEST_ASSERT(CURRENT_EXCEPTION() == shared);
      }
      TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
      index += 1;
    }
    completed.FETCH_ADD#ATOMIC_ACQREL(1);
  };
  VAR first std::thread := std::thread(action);
  VAR second std::thread := std::thread(action);
  TRY { THROW I32(@OTHER 42); }
  CATCH outer CONST& I32
  {
    VAR current EXCEPTION_PTR := CURRENT_EXCEPTION();
    first.join();
    second.join();
    TEST_ASSERT(CURRENT_EXCEPTION() == current);
    TEST_ASSERT(outer == 42);
  }
  TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
  TEST_ASSERT(completed.LOAD#ATOMIC_ACQUIRE() == 2);
  TEST_ASSERT(shared.IS_OUT_OF_MEMORY());
}
