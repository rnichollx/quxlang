LANGUAGE QUXLANG EN 0.0;

::union_selection_tests NAMESPACE
{
  DOC <$ A boxed union distinguishes named alternatives with identical payload types. $>
  ::boxed
    UNION
  {
    .empty OPTION DEFAULT VOID;
    .first OPTION I32;
    .second OPTION I32;
  }

  DOC <$ An inline union distinguishes named alternatives with identical payload types. $>
  ::inlined
    INLINE_UNION
  {
    .empty OPTION DEFAULT VOID;
    .first OPTION I32;
    .second OPTION I32;
  }

  DOC <$ Assignment changes named tags, match bindings mutate stored payloads, and copies retain independent state. $>
  ::transitions
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR value T;
    TEST_ASSERT(value IS empty);
    VAR iteration I32 := 0;
    LOOP WHILE (iteration < 6) DO
    {
      IF ((iteration % 2) == 0) { value := T(@first iteration); }
      ELSE { value := T(@second iteration); }
      VAR copy T := value;
      VAR selected I32 := 0;
      MATCH value AS payload
      {
        CASE first { payload += 10; selected := 1; }
        CASE second AS number { number += 20; selected := 2; }
        CASE empty { TEST_ASSERT(FALSE); }
      }
      TEST_ASSERT(selected == (iteration % 2) + 1);
      MATCH value AS payload
      {
        CASE first { TEST_ASSERT(payload == iteration + 10); }
        CASE second { TEST_ASSERT(payload == iteration + 20); }
        DEFAULT { TEST_ASSERT(FALSE); }
      }
      MATCH copy AS payload
      {
        CASE first { TEST_ASSERT(payload == iteration); TEST_ASSERT(value IS first); }
        CASE second { TEST_ASSERT(payload == iteration); TEST_ASSERT(value IS second); }
        DEFAULT { TEST_ASSERT(FALSE); }
      }
      value := T();
      TEST_ASSERT(value IS empty);
      TEST_ASSERT(value??);
      TEST_ASSERT((value IS first) == FALSE);
      TEST_ASSERT((value IS second) == FALSE);
      iteration++;
    }
  }

  DOC <$ Only matching named alternatives evaluate guards, and rejected guards reach OTHERWISE or DEFAULT exactly once. $>
  ::guards
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR value T :(@second (7 AS I32));
    VAR mode I32 := 0;
    LOOP WHILE (mode < 3) DO
    {
      VAR events I32 := 0;
      VAR selected I32 := 0;
      MATCH value AS payload
      {
        CASE first WHERE short_circuit_tests::record(@events events, @digit 9, @value TRUE) { TEST_ASSERT(FALSE); }
        CASE second WHERE short_circuit_tests::record(@events events, @digit 1, @value mode == 0) { selected := 1; TEST_ASSERT(payload == 7); }
        CASE second WHERE short_circuit_tests::record(@events events, @digit 2, @value mode == 1) { selected := 2; TEST_ASSERT(payload == 7); }
        CASE second OTHERWISE { selected := 3; TEST_ASSERT(payload == 7); }
        DEFAULT { TEST_ASSERT(FALSE); }
      }
      TEST_ASSERT(selected == mode + 1);
      IF (mode == 0) { TEST_ASSERT(events == 1); }
      ELSE { TEST_ASSERT(events == 12); }
      events := 0;
      selected := 0;
      MATCH value
      {
        CASE first WHERE short_circuit_tests::record(@events events, @digit 9, @value TRUE) { TEST_ASSERT(FALSE); }
        CASE second WHERE short_circuit_tests::record(@events events, @digit 1, @value FALSE) { TEST_ASSERT(FALSE); }
        DEFAULT { selected++; }
      }
      TEST_ASSERT(events == 1);
      TEST_ASSERT(selected == 1);
      mode++;
    }
  }

  DOC <$ Boxed union copies and repeated tag changes preserve named identity and independent payload storage. $>
  ::boxed_transitions
    DUAL_TEST
  {
    transitions#(boxed)();
  }

  DOC <$ Inline union copies and repeated tag changes preserve named identity and independent payload storage. $>
  ::inline_transitions
    DUAL_TEST
  {
    transitions#(inlined)();
  }

  DOC <$ Boxed union matching respects named guard order and both fallback forms. $>
  ::boxed_guards
    DUAL_TEST
  {
    guards#(boxed)();
  }

  DOC <$ Inline union matching respects named guard order and both fallback forms. $>
  ::inline_guards
    DUAL_TEST
  {
    guards#(inlined)();
  }
}
