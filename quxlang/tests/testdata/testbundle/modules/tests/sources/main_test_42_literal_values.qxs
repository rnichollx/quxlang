LANGUAGE QUXLANG EN 0.0;

::literal_value_tests NAMESPACE
{
  ::string_escape_bytes DOC <$ Decodes each supported escape and preserves embedded zero bytes. $>
    DUAL_TEST
  {
    VAR value STRING_CONSTANT := "A\n\t\r\0\\\"Z";
    ASSERT((value.END() - value.BEGIN()) == 8);
    ASSERT(value.BEGIN()[0] == 65);
    ASSERT(value.BEGIN()[1] == 10);
    ASSERT(value.BEGIN()[2] == 9);
    ASSERT(value.BEGIN()[3] == 13);
    ASSERT(value.BEGIN()[4] == 0);
    ASSERT(value.BEGIN()[5] == 92);
    ASSERT(value.BEGIN()[6] == 34);
    ASSERT(value.BEGIN()[7] == 90);
  }

  ::character_escape_bytes DOC <$ Gives character escapes the same byte values as the corresponding string escapes. $>
    DUAL_TEST
  {
    ASSERT(('A' AS BYTE) == 65);
    ASSERT(('\n' AS BYTE) == 10);
    ASSERT(('\t' AS BYTE) == 9);
    ASSERT(('\r' AS BYTE) == 13);
    ASSERT(('\0' AS BYTE) == 0);
    ASSERT(('\\' AS BYTE) == 92);
    ASSERT(('\'' AS BYTE) == 39);
    ASSERT(('"' AS BYTE) == 34);
  }

  ::decimal_width_boundaries DOC <$ Preserves exact decimal values at unsigned and signed width boundaries. $>
    DUAL_TEST
  {
    VAR small U8 := 255;
    VAR medium U16 := 65535;
    VAR large U32 := 4294967295;
    VAR largest U64 := 18446744073709551615;
    ASSERT(small == ((0 AS U8) #!!));
    ASSERT(medium == ((0 AS U16) #!!));
    ASSERT(large == ((0 AS U32) #!!));
    ASSERT(largest == ((0 AS U64) #!!));
    VAR positive I64 := 9223372036854775807;
    VAR negative I64 := (0 AS I64) - positive - 1;
    ASSERT((negative + positive) == ((0 AS I64) - 1));
    ASSERT((largest #-- 1) == (positive AS ASSUME U64));
  }

  ::exact_fractional_values DOC <$ Keeps exactly representable binary fractions unchanged through arithmetic. $>
    DUAL_TEST
  {
    VAR small F32 := 0.125;
    VAR large F64 := 0.0625;
    ASSERT((small * 8.0) == 1.0);
    ASSERT((large * 16.0) == 1.0);
    ASSERT((small + 0.0625) == 0.1875);
    ASSERT((large + 0.125) == 0.1875);
    ASSERT((small / 0.5) == 0.25);
    ASSERT((large / 0.5) == 0.125);
  }

  ::string_constant_copy_boundaries DOC <$ Copies the exact length and byte range of empty and zero-containing constants. $>
    DUAL_TEST
  {
    VAR empty STRING_CONSTANT := "";
    VAR empty_copy STRING_CONSTANT := empty;
    ASSERT(empty_copy.BEGIN() == empty_copy.END());
    VAR original STRING_CONSTANT := "\0x\0";
    VAR copy STRING_CONSTANT := original;
    ASSERT((copy.END() - copy.BEGIN()) == 3);
    ASSERT(copy.BEGIN()[0] == 0);
    ASSERT(copy.BEGIN()[1] == 120);
    ASSERT(copy.BEGIN()[2] == 0);
  }
}
