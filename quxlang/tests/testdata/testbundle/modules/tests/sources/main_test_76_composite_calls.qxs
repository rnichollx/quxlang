LANGUAGE QUXLANG EN 0.0;

::composite_call_tests NAMESPACE
{
  DOC <$ Mutates a forwarded reference and returns a reference to the same storage. $>
  ::mutate
    FUNCTION(@value MUT& I32, @amount I32): MUT& I32
  {
    value += amount;
    RETURN value;
  }

  DOC <$ APPLY preserves aliases across split, join, forwarding, and a reference-valued result. $>
  ::reference_result
    DUAL_TEST
  {
    VAR number I32 := 7;
    AUTO arguments := :{ .value = number; .amount = 5 AS I32; };
    AUTO parts := COMPOSITE_SPLIT(COMPOSITE_TIE(arguments), "value");
    AUTO joined := COMPOSITE_JOIN(parts.remainder, parts.selected);
    VAR result MUT& I32 := APPLY COMPOSITE_FORWARD(joined) TO mutate;
    TEST_ASSERT(number == 12);
    TEST_ASSERT(result<- == number<-);
    result := 31;
    TEST_ASSERT(arguments.value == 31);
    TEST_ASSERT(parts.selected.value == 31);
    TEST_ASSERT(joined.value == 31);
  }

  DOC <$ Consumes an owned argument before either returning or throwing. $>
  ::consume
    FUNCTION(@value array_lifetime_tests::element, @events CONST& I32, @fail BOOL): I32
  {
    TEST_ASSERT(value.copied);
    TEST_ASSERT(value.complete);
    TEST_ASSERT(events == 0);
    TEST_ASSERT(value.number == 4);
    IF (fail) { THROW I32(@OTHER 73); }
    RETURN value.number;
  }

  DOC <$ Forwarding a composite moves its owned field into a value parameter without copying or duplicate cleanup. $>
  ::owned_call
    FUNCTION(@fail BOOL)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source array_lifetime_tests::element;
    source.attempts := attempts<-;
    source.events := events<-;
    source.number := 4;
    VAR caught BOOL := FALSE;
    {
      AUTO arguments := :{ .value = array_lifetime_tests::element(@OTHER source); .events = events; .fail = fail; };
      TEST_ASSERT(attempts == 1);
      TRY
      {
        VAR result I32 := APPLY COMPOSITE_FORWARD(arguments) TO consume;
        TEST_ASSERT(fail == FALSE);
        TEST_ASSERT(result == 4);
      }
      CATCH error CONST& I32
      {
        TEST_ASSERT(fail);
        TEST_ASSERT(error == 73);
        caught := TRUE;
      }
      TEST_ASSERT(caught == fail);
      TEST_ASSERT(arguments.value.copied == FALSE);
      TEST_ASSERT(attempts == 1);
      TEST_ASSERT(events == 4);
    }
    TEST_ASSERT(events == 4);
  }

  DOC <$ An applied call destroys its moved value parameter on normal return. $>
  ::owned_normal_return
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    owned_call(@fail FALSE);
  }

  DOC <$ An applied call destroys its moved value parameter before transferring to an exception handler. $>
  ::owned_exception_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    owned_call(@fail TRUE);
  }
}
