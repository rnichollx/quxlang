LANGUAGE QUXLANG EN 0.0;

::float_subnormal_tests NAMESPACE
{
  ::boundaries DOC <$ Exact powers of two reach the normal and subnormal boundaries without decimal-literal rounding. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@normal_steps I32, @fraction_steps I32)
  {
    VAR zero T := 0;
    VAR one T := 1;
    VAR two T := 2;
    VAR normal T := one;
    VAR step I32 := 0;
    LOOP WHILE (step < normal_steps) DO
    {
      normal /= two;
      TEST_ASSERT(normal > zero);
      step++;
    }
    VAR tiny T := normal;
    step := 0;
    LOOP WHILE (step < fraction_steps) DO
    {
      VAR previous T := tiny;
      tiny /= two;
      TEST_ASSERT(tiny > zero);
      TEST_ASSERT(tiny < previous);
      TEST_ASSERT(tiny * two == previous);
      step++;
    }
    VAR largest_subnormal T := normal - tiny;
    TEST_ASSERT(largest_subnormal > zero);
    TEST_ASSERT(largest_subnormal < normal);
    TEST_ASSERT(largest_subnormal + tiny == normal);
    TEST_ASSERT(normal - largest_subnormal == tiny);
    TEST_ASSERT(tiny + tiny == tiny * two);
    TEST_ASSERT(tiny / two == zero);
    VAR negative_one T := zero - one;
    VAR negative_tiny T := zero - tiny;
    VAR negative_zero T := zero * negative_one;
    TEST_ASSERT(negative_tiny < negative_zero);
    TEST_ASSERT(negative_tiny / two == negative_zero);
    TEST_ASSERT(IEEE_EQUALS(negative_tiny / two, zero));
    TEST_ASSERT(IEEE_LESS(negative_tiny, zero));
    TEST_ASSERT(IEEE_GREATER(tiny, zero));
    TEST_ASSERT(tiny + negative_tiny == zero);
  }

  ::single_precision DOC <$ F32 preserves all 23 subnormal halvings and rounds the final half to signed zero. $>
    DUAL_TEST
  {
    boundaries#(F32)(@normal_steps 126, @fraction_steps 23);
  }

  ::double_precision DOC <$ F64 preserves all 52 subnormal halvings and rounds the final half to signed zero. $>
    DUAL_TEST
  {
    boundaries#(F64)(@normal_steps 1022, @fraction_steps 52);
  }
}
