LANGUAGE QUXLANG EN 0.0;

::overload_selector_tests NAMESPACE
{
  ::select DOC <$ Supplies the first declared overload with a narrow result. $>
    FUNCTION(@value I32): I32 { RETURN value + 17; }
  ::select DOC <$ Supplies the second declared overload with a wide result. $>
    FUNCTION(@value I64): I64 { RETURN value + 29; }
  ::unique DOC <$ Supplies a single candidate for empty-bracket selection. $>
    FUNCTION(@value I32): I32 { RETURN value * 3; }
}
