LANGUAGE QUXLANG EN 0.0;

::body_lookup_tests NAMESPACE
{
  ::mutate_both FUNCTION(@first MUT& SZ, @second MUT& SZ): VOID
  {
    first += 1;
    second += 2;
  }

  ::batched_mutations DOC <$ A single static evaluation publishes both changed array extents. $>
    DUAL_TEST
  {
    STATIC_VAR first SZ := 1;
    STATIC_VAR second SZ := 2;
    STATIC_EVAL mutate_both(@first first, @second second);
    VAR left [SNAPSHOT(first)]I32;
    VAR right [SNAPSHOT(second)]I32;
    ASSERT(SIZEOF(DECLTYPE(left)) == 2 * SIZEOF(I32));
    ASSERT(SIZEOF(DECLTYPE(right)) == 4 * SIZEOF(I32));
    STATIC_EVAL mutate_both(@first first, @second second);
    VAR later [SNAPSHOT(first) + SNAPSHOT(second)]I32;
    ASSERT(SIZEOF(DECLTYPE(later)) == 9 * SIZEOF(I32));
  }

  ::scope_restoration DOC <$ Nested publications preserve shadowing and surviving outer mutations. $>
    DUAL_TEST
  {
    STATIC_VAR extent SZ := 1;
    STATIC_VAR outer SZ := 2;
    STATIC_IF (TRUE)
    {
      STATIC_VAR extent SZ := 7;
      STATIC_EVAL outer++;
      VAR inner [SNAPSHOT(extent)]I32;
      ASSERT(SIZEOF(DECLTYPE(inner)) == 7 * SIZEOF(I32));
    }
    VAR restored [SNAPSHOT(extent) + SNAPSHOT(outer)]I32;
    ASSERT(SIZEOF(DECLTYPE(restored)) == 4 * SIZEOF(I32));
  }

  ::side_effect FUNCTION(@value MUT& I32): I32
  {
    value++;
    RETURN value;
  }

  ::no_result FUNCTION(@value MUT& I32): VOID
  {
    value++;
  }

  ::complete_expression_types DOC <$ Inferred complete types preserve reference qualifiers without invoking operands. $>
    DUAL_TEST
  {
    VAR value I32 := 3;
    VAR constant CONST& I32 := value;
    VAR qualified IBC MUT& I32 := value AS IBC MUT& I32;
    ASSERT(SAME_TYPES(TYPEOF(qualified), IBC MUT& I32));
    ASSERT(SAME_TYPES(TYPEOF(value), MUT& I32));
    ASSERT(SAME_TYPES(TYPEOF(constant), CONST& I32));
    ASSERT(SAME_TYPES(TYPEOF(MOVE(value)), TEMP& I32));
    ASSERT(SAME_TYPES(TYPEOF(side_effect(@value value)), I32));
    ASSERT(SAME_TYPES(TYPEOF(no_result(@value value)), VOID));
    ASSERT(SAME_TYPES(TYPEOF(7), TYPEOF(7)));
    ASSERT(SAME_TYPES(TYPEOF(7), TYPEOF(9)) == FALSE);
    ASSERT(SAME_TYPES(TYPEOF(I32(@OTHER 7)), I32));
    ASSERT(SAME_TYPES(TYPEOF(DECLTYPE(value)(@OTHER 8)), I32));
    ASSERT(value == 3);
  }

  ::creation_context DOC <$ Lambdas retain the static values visible at creation across mutations and iterations. $>
    DUAL_TEST
  {
    STATIC_VAR count I32 := 1;
    VAR before AUTO := -< = SNAPSHOT(count);
    STATIC_EVAL count++;
    VAR after AUTO := -< = SNAPSHOT(count);
    ASSERT(before() == 1);
    ASSERT(after() == 2);
    STATIC_WHILE (count < 5)
    {
      VAR current AUTO := -< = (-< = SNAPSHOT(count))();
      ASSERT(current() == SNAPSHOT(count));
      STATIC_EVAL count++;
    }
    ASSERT(before() == 1);
    ASSERT(after() == 2);
    ASSERT(SAME_TYPES(TYPEOF((-< = (-< = 3)())()), TYPEOF(3)));
  }

  ::pointer_aliases DOC <$ Aliases retain storage identity while snapshots freeze their reachable objects. $>
    DUAL_TEST
  {
    STATIC_VAR extent SZ := 1;
    STATIC_VAR pointer -> SZ := extent<-;
    VAR frozen CONST->SZ := SNAPSHOT(pointer);
    STATIC_EVAL pointer-> += 2;
    VAR values [SNAPSHOT(extent)]I32;
    ASSERT(SIZEOF(DECLTYPE(values)) == 3 * SIZEOF(I32));
    ASSERT(frozen-> == 1);
    ASSERT(SNAPSHOT(pointer)-> == 3);
  }

  ::nested_type_operands DOC <$ Nested unevaluated operands and local type bindings use the same lexical publications. $>
    DUAL_TEST
  {
    VAR value I32 := 4;
    VAR element AUTO := I32;
    ASSERT(SAME_TYPES(element, I32));
    VAR values [2]element;
    ASSERT(SAME_TYPES(DECLTYPE(values), [2]I32));
    ASSERT(SAME_TYPES(TYPEOF(TYPEOF(value)(@OTHER value)), MUT& I32));
    ASSERT(SAME_TYPES(TYPEOF(SIZEOF(TYPEOF(value))), TYPEOF(SIZEOF(MUT& I32))));
    ASSERT(value == 4);
  }

  ::missing_name DOC <$ Missing-name lookup completes while the generating procedure is still active. $>
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    STATIC_VAR value SZ := 1;
    VAR values [missing_body_name]I32;
  }

  ::runtime_extent DOC <$ A runtime value cannot provide a constexpr array extent. $>
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR extent SZ := 2;
    VAR values [extent]I32;
  }

  ::pack_types FUNCTION(%...values I32): I32
  {
    STATIC_VAR index SZ := 0;
    VAR sum I32 := 0;
    STATIC_WHILE (index < PACK_SIZE(values))
    {
      ASSERT(SAME_TYPES(PACK_ARG_TYPE(values, SNAPSHOT(index)), I32));
      ASSERT(SAME_TYPES(TYPEOF(PACK_ARG(values, SNAPSHOT(index))), MUT& I32));
      VAR get AUTO := -< = PACK_ARG(values, SNAPSHOT(index));
      sum += get();
      STATIC_EVAL index++;
    }
    RETURN sum;
  }

  ::pack_iteration DOC <$ Pack indices and captured elements follow each expansion's body context. $>
    DUAL_TEST
  {
    ASSERT(pack_types(% [2, 3, 4]) == 9);
  }

  ::lambda_static_loop DOC <$ Capture analysis and lambda generation both resolve statics declared inside a lambda. $>
    DUAL_TEST
  {
    VAR callable AUTO := -<
    {
      STATIC_VAR iteration SZ := 0;
      STATIC_WHILE (iteration < 2)
      {
        STATIC_EVAL iteration++;
      }
      RETURN SNAPSHOT(iteration);
    };
    ASSERT(callable() == 2);
  }

  ::shadowed_pointer_target DOC <$ Mutation through an alias updates a hidden outer object without changing the visible declaration. $>
    DUAL_TEST
  {
    STATIC_VAR value SZ := 1;
    STATIC_VAR pointer ->SZ := value<-;
    {
      STATIC_VAR value SZ := 5;
      STATIC_EVAL pointer-> += 1;
      ASSERT(SNAPSHOT(value) == 5);
      ASSERT(SNAPSHOT(pointer)-> == 2);
      STATIC_EVAL pointer-> += 1;
    }
    ASSERT(SNAPSHOT(value) == 3);
  }

  ::receiver STRUCT
  {
    .number VAR I32;
    .check FUNCTION(@THIS MUT& THISTYPE): BOOL
    {
      RETURN SAME_TYPES(TYPEOF(.number), MUT& I32);
    }
  }

  ::receiver_type DOC <$ Unevaluated field lookup preserves the enclosing receiver. $>
    DUAL_TEST
  {
    VAR object receiver;
    ASSERT(object.check());
  }

  ::parameter_shadowing DOC <$ A lambda parameter's declared type takes precedence over its creation-time statics. $>
    DUAL_TEST
  {
    STATIC_VAR value I32 := 1;
    VAR callable AUTO := -< [] (@value BOOL): DECLTYPE(value) = value;
    ASSERT(callable(@value TRUE));
  }
}
