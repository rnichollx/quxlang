LANGUAGE QUXLANG EN 0.0;
IMPORT std;

::native_sqrt_tests NAMESPACE
{
  ::decode FUNCTION(@ARG:bits U64): F64
  {
    VAR bytes [8]BYTE;
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(8) DO { bytes[index] := (bits #-- (index * 8)) AS PARTIAL U8 AS BYTE; }
    VAR result F64;
    result.DESERIALIZE(@INPUT_ITERATOR bytes[& 0]);
    RETURN result;
  }
  ::encode FUNCTION(@ARG:value F64): U64
  {
    VAR bytes [8]BYTE;
    value.SERIALIZE(@OUTPUT_ITERATOR bytes[& 0]);
    VAR result U64 := 0;
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(8) DO { result := result #|| (((bytes[index] AS U8) AS U64) #++ (index * 8)); }
    RETURN result;
  }
  ::exact_and_special DUAL_TEST
  {
    TEST_ASSERT(std::sqrt(0.0) == 0.0);
    TEST_ASSERT(std::sqrt(1.0) == 1.0);
    TEST_ASSERT(std::sqrt(4.0) == 2.0);
    TEST_ASSERT(std::sqrt(144.0) == 12.0);
    TEST_ASSERT(encode(std::sqrt(decode(9218868437227405312))) == 9218868437227405312);
    TEST_ASSERT(encode(std::sqrt(-1.0)) == 9221120237041090560);
    TEST_ASSERT(encode(std::sqrt(decode(9221120237041090561))) == 9221120237041090560);
  }
  ::rounding_and_extremes DUAL_TEST
  {
    TEST_ASSERT(encode(std::sqrt(decode(1))) == 2188749418902061056);
    TEST_ASSERT(encode(std::sqrt(decode(2))) == 2190614870947216333);
    TEST_ASSERT(encode(std::sqrt(decode(3))) == 2192046282646244522);
    TEST_ASSERT(encode(std::sqrt(decode(4503599627370495))) == 2305843009213693951);
    TEST_ASSERT(encode(std::sqrt(decode(4503599627370496))) == 2305843009213693952);
    TEST_ASSERT(encode(std::sqrt(decode(4503599627370497))) == 2305843009213693952);
    TEST_ASSERT(encode(std::sqrt(decode(9218868437227405311))) == 6913025428013711359);
