LANGUAGE QUXLANG EN 0.0;

::interface_integer INTERFACE DEFAULTABLE
{
    .value FUNCTION(@ARG I32): I32;
    .default_value FUNCTION(@ARG:x I32): I32 { RETURN x + 100; }
}

::interface_integer_impl IMPLEMENTATION(interface_integer)
{
    ::value FUNCTION(@ARG:x I32): I32 { RETURN x + 7; }
    ::default_value FUNCTION(@ARG:implementation_value I32): I32 { RETURN implementation_value + 1; }
}

::static_interface_integer STATIC interface_integer := interface_integer_impl;

::interface_overloaded INTERFACE
{
    .pick FUNCTION(@ARG I32): I32;
    .pick FUNCTION(@ARG I64): I64;
}

::interface_overloaded_impl IMPLEMENTATION(interface_overloaded)
{
    ::pick FUNCTION(@ARG:x I32): I32 { RETURN x + 1; }
    ::pick FUNCTION(@ARG:x I64): I64 { RETURN x + 2; }
}

::interface_dispatch_and_default_test DUAL_TEST
{
    VAR handle interface_integer := interface_integer_impl;
    TEST_ASSERT(handle??);
    TEST_ASSERT(handle.value(5) == 12);
    TEST_ASSERT(handle.default_value(5) == 6);

    VAR copied interface_integer := handle;
    TEST_ASSERT(copied.value(3) == 10);

    VAR assigned interface_integer;
    TEST_ASSERT((assigned??) == FALSE);
    assigned := handle;
    TEST_ASSERT(assigned??);
    TEST_ASSERT(assigned.value(4) == 11);

    VAR defaulted interface_integer;
    TEST_ASSERT((defaulted??) == FALSE);
    TEST_ASSERT(defaulted.default_value(4) == 104);
}

::interface_null_test DUAL_TEST
{
    VAR handle interface_integer := NULL;
    TEST_ASSERT((handle??) == FALSE);
    TEST_ASSERT(handle.default_value(4) == 104);

    handle := interface_integer_impl;
    TEST_ASSERT(handle??);
    TEST_ASSERT(handle.value(5) == 12);

    handle := NULL;
    TEST_ASSERT((handle??) == FALSE);
}



::interface_argument_dispatch_helper FUNCTION(@handle interface_integer, @value:x I32): I32
{
    RETURN handle.value(x);
}

::interface_argument_passing_test DUAL_TEST
{
    TEST_ASSERT(interface_argument_dispatch_helper(@handle interface_integer_impl, @value 8) == 15);
}



::interface_static_handle_dispatch_test DUAL_TEST
{
    TEST_ASSERT(static_interface_integer??);
    TEST_ASSERT(static_interface_integer.value(6) == 13);
}



::interface_overloaded_dispatch_test DUAL_TEST
{
    VAR handle interface_overloaded := interface_overloaded_impl;
    TEST_ASSERT(handle.pick(4 AS I32) == 5);
    TEST_ASSERT(handle.pick(7 AS I64) == 9);
}



::interface_not_defaultable INTERFACE
{
    .value FUNCTION(): I32;
}

::interface_missing_impl IMPLEMENTATION(interface_not_defaultable)
{
}

::interface_non_defaultable_default_ctor_fails STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR handle interface_not_defaultable;
}

::interface_non_defaultable_null_fails STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR handle interface_not_defaultable := NULL;
}

::interface_missing_implementation_fails STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR handle interface_not_defaultable := interface_missing_impl;
}



::generic_counter STRUCT
{
    .value VAR I32;

    .CONSTRUCTOR FUNCTION(@OTHER I32)
    {
        .value := OTHER;
    }

    .add FUNCTION(@ARG:amount I32): I32
    {
        .value := .value + amount;
        RETURN .value;
    }

    .read FUNCTION(): I32
    {
        RETURN .value;
    }

}

::other_generic_counter STRUCT
{
    .value VAR I32;

    .CONSTRUCTOR FUNCTION(@OTHER I32)
    {
        .value := OTHER;
    }

    .add FUNCTION(@ARG:amount I32): I32
    {
        .value := .value + amount;
        RETURN .value;
    }

    .read FUNCTION(): I32
    {
        RETURN .value;
    }




}

::counter_generic_ref GENERIC_REF
{
    .add FUNCTION(@ARG I32) MUT: I32;
    .read FUNCTION() CONST: I32;
}

::implemented_counter_generic_ref GENERIC_REF
{
    IMPLEMENTS counter_generic_ref;
}

::counter_generic_const_ref GENERIC_REF CONST
{
    .read FUNCTION() CONST: I32;
}

::counter_generic GENERIC
{
    .add FUNCTION(@ARG I32) MUT: I32;
    .read FUNCTION() CONST: I32;
}

::implemented_counter_generic GENERIC
{
    IMPLEMENTS counter_generic_ref;
}

::implemented_counter_generic_from_generic GENERIC
{
    IMPLEMENTS counter_generic;
}

::move_only_counter_generic GENERIC MOVE_ONLY
{
    .read FUNCTION(@THIS CONST& THISTYPE): I32;
}

::incomparable_counter_generic GENERIC INCOMPARABLE
{
    .read FUNCTION(@THIS CONST& THISTYPE): I32;
}

::generic_a_reference_dispatch_test DUAL_TEST
{
    VAR counter generic_counter := 4;
    VAR mutable_ref counter_generic_ref := counter;
    mutable_ref.add(@ARG 3);
    TEST_ASSERT(counter.value == 7);

    VAR implemented_ref implemented_counter_generic_ref := counter;
    TEST_ASSERT(implemented_ref.add(@ARG 1) == 8);

    VAR constant_ref counter_generic_const_ref := counter;
    TEST_ASSERT(constant_ref.read() == 8);
}

::generic_owning_lifecycle_test DUAL_TEST
{
    VAR source generic_counter := 10;
    VAR first counter_generic := source;
    TEST_ASSERT(first.read() == 10);
    TEST_ASSERT(first.add(2) == 12);
    TEST_ASSERT(source.value == 10);

    VAR implemented_from_ref implemented_counter_generic := source;
    TEST_ASSERT(implemented_from_ref.read() == 10);
    TEST_ASSERT(implemented_from_ref.add(3) == 13);

    VAR implemented_from_generic implemented_counter_generic_from_generic := source;
    TEST_ASSERT(implemented_from_generic.read() == 10);
    TEST_ASSERT(implemented_from_generic.add(@ARG 4) == 14);
}




::generic_owning_copy_test DUAL_TEST
{
    VAR source generic_counter := 12;
    VAR first counter_generic := source;
    VAR copied counter_generic := first;
    TEST_ASSERT(copied.read() == first.read());
    TEST_ASSERT(copied == first);
    TEST_ASSERT((copied <=> first) == ORDER::EQUAL);
    TEST_ASSERT(copied.add(@ARG 1) == 13);
    TEST_ASSERT(first.read() == 12);
}

::generic_owning_type_order_test DUAL_TEST
{
    VAR source generic_counter := 12;
    VAR first counter_generic := source;
    VAR other_source other_generic_counter := 12;
    VAR other counter_generic := other_source;
    TEST_ASSERT((first == other) == FALSE);
    TEST_ASSERT((first <=> other) != ORDER::EQUAL);
}

::generic_reference_copy_and_rebind DOC <$ Copies of a generic reference retain their referent when another handle is rebound. $>
  DUAL_TEST
{
    VAR left generic_counter := 3;
    VAR right generic_counter := 7;
    VAR first counter_generic_ref := left;
    VAR copied counter_generic_ref := first;
    first := right;
    TEST_ASSERT(first.add(@ARG 2) == 9);
    TEST_ASSERT(copied.add(@ARG 1) == 4);
    TEST_ASSERT(left.value == 4);
    TEST_ASSERT(right.value == 9);
    TEST_ASSERT(first.read() == 9);
    TEST_ASSERT(copied.read() == 4);
}

::interface_copy_and_null_swap DOC <$ Copying and swapping interface handles preserves implementation dispatch and null-handle default methods. $>
  DUAL_TEST
{
    VAR first interface_integer := interface_integer_impl;
    VAR copied interface_integer := first;
    first := NULL;
    TEST_ASSERT((first??) == FALSE);
    TEST_ASSERT(copied??);
    TEST_ASSERT(first.default_value(4) == 104);
    TEST_ASSERT(copied.default_value(4) == 5);
    first <-> copied;
    TEST_ASSERT(first??);
    TEST_ASSERT((copied??) == FALSE);
    TEST_ASSERT(first.value(4) == 11);
    TEST_ASSERT(copied.default_value(4) == 104);
}

::generic_move_only_copy_fails STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR source generic_counter := 12;
    VAR first move_only_counter_generic := source;
    VAR copied move_only_counter_generic := first;
}

::generic_incomparable_compare_fails STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR source generic_counter := 12;
    VAR first incomparable_counter_generic := source;
    VAR second incomparable_counter_generic := source;
    TEST_ASSERT(first == second);
}

::foogeneric GENERIC
{
   .get FUNCTION() CONST: I64;
   .set FUNCTION(@ARG I64) MUT: VOID;
   .something FUNCTION(@ARG I64) MUT: VOID;
}

::foo1 STRUCT
{
   .data VAR I64;


   .CONSTRUCTOR FUNCTION(@OTHER CONST& foo1)
   {
     .data := OTHER.data;
   }

   .CONSTRUCTOR FUNCTION(@EXPLICIT:arg I64)
   {
      .data := arg;
   }

   .get FUNCTION() CONST: I64
   {
      RETURN .data;
   }

   .set FUNCTION(@ARG:arg I64)
   {
      .data := arg;
   }

   .something FUNCTION(@ARG:x I64)
   {
      .data += x;
   }
}

::foogeneric_accepting_function FUNCTION(@ARG:x foogeneric): I64
{
  RETURN x.get();
}

::foo_generic_test DUAL_TEST
{
  VAR myfoo foogeneric := foo1(10);
  VAR myfoo2 foogeneric := myfoo;
  TEST_ASSERT(myfoo.get() == 10);
  myfoo.something(20);
  TEST_ASSERT(myfoo.get() == 30);
  TEST_ASSERT(myfoo2.get() == 10);
}
