LANGUAGE QUXLANG EN 0.0;

::method_binding_tests NAMESPACE
{
  DOC <$ A mutable receiver exposes overloaded methods through a retained binding. $>
  ::counter
    STRUCT
  {
    .value VAR I32;
    DOC <$ Adds the signed argument and returns updated receiver state. $>
    .add
      FUNCTION(@amount I32): I32 { .value += amount; RETURN .value; }
    DOC <$ Adds an unsigned argument with a distinguishing offset. $>
    .add
      FUNCTION(@amount U32): I32 { .value += (amount AS ASSUME I32) + 100; RETURN .value; }
  }

  DOC <$ Copies of a bound method share its original receiver and observe later mutations of that object. $>
  ::copy_retains_receiver
    DUAL_TEST
  {
    VAR first counter;
    VAR second counter;
    first.value := 1;
    second.value := 20;
    AUTO bound := first.add;
    AUTO copied := bound;
    TEST_ASSERT(bound(@amount (2 AS I32)) == 3);
    TEST_ASSERT(copied(@amount (4 AS I32)) == 7);
    TEST_ASSERT(first.value == 7);
    first <-> second;
    TEST_ASSERT(bound(@amount (1 AS I32)) == 21);
    TEST_ASSERT(first.value == 21);
    TEST_ASSERT(second.value == 7);
    TEST_ASSERT(copied(@amount (2 AS I32)) == 23);
    TEST_ASSERT(first.value == 23);
  }

  DOC <$ A retained method binding selects overloads from each later argument type without changing receivers. $>
  ::overload_selection_after_binding
    DUAL_TEST
  {
    VAR value counter;
    value.value := 1;
    AUTO bound := value.add;
    TEST_ASSERT(bound(@amount (2 AS I32)) == 3);
    TEST_ASSERT(bound(@amount (4 AS U32)) == 107);
    TEST_ASSERT(bound(@amount (3 AS I32)) == 110);
    TEST_ASSERT(value.value == 110);
  }

  DOC <$ Copies retain the bound receiver through a chain of local declarations. $>
  ::copy_chain_retains_receiver
    DUAL_TEST
  {
    VAR value counter;
    value.value := 1;
    AUTO original := value.add;
    AUTO copy_0 := original;
    AUTO copy_1 := copy_0;
    AUTO copy_2 := copy_1;
    AUTO copy_3 := copy_2;
    AUTO copy_4 := copy_3;
    AUTO copy_5 := copy_4;
    AUTO copy_6 := copy_5;
    AUTO copy_7 := copy_6;
    AUTO copy_8 := copy_7;
    AUTO copy_9 := copy_8;
    AUTO copy_10 := copy_9;
    AUTO copy_11 := copy_10;
    AUTO copy_12 := copy_11;
    AUTO copy_13 := copy_12;
    AUTO copy_14 := copy_13;
    AUTO copy_15 := copy_14;
    TEST_ASSERT(copy_15(@amount (2 AS I32)) == 3);
    TEST_ASSERT(original(@amount (4 AS U32)) == 107);
    TEST_ASSERT(copy_0(@amount (3 AS I32)) == 110);
    TEST_ASSERT(value.value == 110);
  }
}
