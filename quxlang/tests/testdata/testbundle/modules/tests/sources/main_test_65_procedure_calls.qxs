LANGUAGE QUXLANG EN 0.0;

::procedure_call_tests NAMESPACE
{
  DOC <$ Describes a procedure pointer with distinct named integer parameters. $>
  ::binary
    ALIAS CONST->PROCEDURE(@left I32, @right I32: I32);

  DOC <$ Places the left operand in the tens position. $>
  ::encode
    FUNCTION(@left I32, @right I32): I32 { RETURN left * 10 + right; }

  DOC <$ Places the right operand in the tens position. $>
  ::reverse_encode
    FUNCTION(@left I32, @right I32): I32 { RETURN right * 10 + left; }

  DOC <$ Returns either callable using the same named procedure signature. $>
  ::select_binary
    FUNCTION(@reverse BOOL): binary
  {
    IF (reverse) { RETURN reverse_encode<-; }
    RETURN encode<-;
  }

  DOC <$ Indirect calls preserve selected targets, named binding and source-order argument evaluation. $>
  ::selected_target_and_argument_order
    DUAL_TEST
  {
    VAR mode I32 := 0;
    LOOP WHILE (mode < 2) DO
    {
      VAR selected binary := select_binary(@reverse mode == 1);
      VAR events I32 := 0;
      VAR result I32 := selected(
        @right call_binding_tests::record(@events events, @digit 1),
        @left call_binding_tests::record(@events events, @digit 2)
      );
      TEST_ASSERT(events == 12);
      IF (mode == 0) { TEST_ASSERT(result == 21); }
      ELSE { TEST_ASSERT(result == 12); }
      mode++;
    }
  }

  DOC <$ Mutates a reference parameter and returns its previous value. $>
  ::increment
    FUNCTION(@value MUT& I32, @amount I32): I32
  {
    VAR previous I32 := value;
    value += amount;
    RETURN previous;
  }

  DOC <$ Procedure-pointer calls write to the caller's storage and preserve scalar return values. $>
  ::reference_parameter
    DUAL_TEST
  {
    VAR pointer CONST->PROCEDURE(@value MUT& I32, @amount I32: I32) := increment<-;
    VAR value I32 := 11;
    TEST_ASSERT(pointer(@value value, @amount 5) == 11);
    TEST_ASSERT(value == 16);
    TEST_ASSERT(pointer(@amount 7, @value value) == 16);
    TEST_ASSERT(value == 23);
  }

  DOC <$ Returns a mutable reference to the supplied integer. $>
  ::identity
    FUNCTION(@value MUT& I32): MUT& I32 { RETURN value; }

  DOC <$ An indirect reference return preserves storage identity and can be used for mutation. $>
  ::reference_return
    DUAL_TEST
  {
    VAR pointer CONST->PROCEDURE(@value MUT& I32: MUT& I32) := identity<-;
    VAR value I32 := 17;
    VAR returned MUT& I32 := pointer(@value value);
    TEST_ASSERT(returned<- == value<-);
    returned := 29;
    TEST_ASSERT(value == 29);
    pointer(@value value) := 41;
    TEST_ASSERT(returned == 41);
  }

  DOC <$ Throws the supplied integer through a procedure-call boundary. $>
  ::throw_number
    FUNCTION(@value I32): I32 { THROW I32(@OTHER value); }

  DOC <$ Exceptions from indirect calls preserve the payload and unwind the caller's completed locals. $>
  ::indirect_exception_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR pointer CONST->PROCEDURE(@value I32: I32) := throw_number<-;
    VAR events I32 := 0;
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR local control_flow_tests::exit_record :(@events events, @digit 3);
      VAR result I32 := pointer(@value 73);
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 73);
      TEST_ASSERT(events == 3);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(events == 3);
  }

  DOC <$ Describes a procedure pointer taking two positional integer operands. $>
  ::positional_binary
    ALIAS CONST->PROCEDURE(I32, I32: I32);

  DOC <$ Encodes positional operands in their declared order. $>
  ::positional_encode
    FUNCTION(%left I32, %right I32): I32 { RETURN left * 10 + right; }

  DOC <$ Encodes positional operands with reversed significance. $>
  ::positional_reverse
    FUNCTION(%left I32, %right I32): I32 { RETURN right * 10 + left; }

  DOC <$ Indexed procedure-pointer calls evaluate positional arguments in source order and preserve each array entry's target. $>
  ::positional_pointer_array
    DUAL_TEST
  {
    VAR targets [2]positional_binary;
    targets[0] := positional_encode<-;
    targets[1] := positional_reverse<-;
    VAR index SZ := 0;
    LOOP WHILE (index < 2) DO
    {
      VAR events I32 := 0;
      VAR result I32 := targets[index](% [
        call_binding_tests::record(@events events, @digit 3),
        call_binding_tests::record(@events events, @digit 7)
      ]);
      TEST_ASSERT(events == 37);
      IF (index == 0) { TEST_ASSERT(result == 37); }
      ELSE { TEST_ASSERT(result == 73); }
      index++;
    }
    targets[0] := positional_reverse<-;
    TEST_ASSERT(targets[0](% [2, 9]) == 92);
    TEST_ASSERT(targets[1](% [2, 9]) == 92);
  }

  DOC <$ Reassigning or swapping procedure pointers does not retroactively change independent copies. $>
  ::copied_pointer_retains_target
    DUAL_TEST
  {
    VAR original positional_binary := positional_encode<-;
    VAR copy positional_binary := original;
    original := positional_reverse<-;
    TEST_ASSERT(original(% [4, 8]) == 84);
    TEST_ASSERT(copy(% [4, 8]) == 48);
    original <-> copy;
    TEST_ASSERT(original(% [4, 8]) == 48);
    TEST_ASSERT(copy(% [4, 8]) == 84);
  }
}
