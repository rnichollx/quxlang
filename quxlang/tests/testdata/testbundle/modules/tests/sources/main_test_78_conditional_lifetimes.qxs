LANGUAGE QUXLANG EN 0.0;

::conditional_lifetime_tests NAMESPACE
{
  ::nested_selection DOC <$ Condition temporaries are destroyed before branch entry or the next condition, including nested IF and ELSE UNLESS. $>
    DUAL_TEST
  {
    VAR mode I32 := 0;
    LOOP WHILE (mode < 3) DO
    {
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR selected I32 := 0;
      IF (short_circuit_tests::temporary(@events events, @alive alive, @digit 1).test(@value mode == 0))
      {
        TEST_ASSERT(alive == 0);
        TEST_ASSERT(events == 15);
        VAR outer control_flow_tests::exit_record :(@events events, @digit 9);
        IF (short_circuit_tests::temporary(@events events, @alive alive, @digit 3).test(@value TRUE))
        {
          TEST_ASSERT(alive == 0);
          TEST_ASSERT(events == 1537);
          VAR inner control_flow_tests::exit_record :(@events events, @digit 8);
          selected := 1;
        }
        ELSE { TEST_ASSERT(FALSE); }
        TEST_ASSERT(events == 15378);
      }
      ELSE UNLESS (short_circuit_tests::temporary(@events events, @alive alive, @digit 2).test(@value mode != 1))
      {
        TEST_ASSERT(alive == 0);
        TEST_ASSERT(events == 1526);
        VAR outer control_flow_tests::exit_record :(@events events, @digit 9);
        UNLESS (short_circuit_tests::temporary(@events events, @alive alive, @digit 3).test(@value FALSE))
        {
          TEST_ASSERT(alive == 0);
          TEST_ASSERT(events == 152637);
          VAR inner control_flow_tests::exit_record :(@events events, @digit 8);
          selected := 2;
        }
        ELSE { TEST_ASSERT(FALSE); }
        TEST_ASSERT(events == 1526378);
      }
      ELSE
      {
        TEST_ASSERT(alive == 0);
        TEST_ASSERT(events == 1526);
        selected := 3;
      }
      TEST_ASSERT(selected == mode + 1);
      TEST_ASSERT(alive == 0);
      IF (mode == 0) { TEST_ASSERT(events == 153789); }
      ELSE IF (mode == 1) { TEST_ASSERT(events == 15263789); }
      ELSE { TEST_ASSERT(events == 1526); }
      mode++;
    }
  }

  ::throwing_nested_condition DOC <$ A throwing nested condition destroys its temporary before enclosing branch locals and never enters either nested arm. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_LAYOUTLESS)
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR caught BOOL := FALSE;
    TRY
    {
      IF (short_circuit_tests::temporary(@events events, @alive alive, @digit 1).test(@value TRUE))
      {
        TEST_ASSERT(alive == 0);
        VAR outer control_flow_tests::exit_record :(@events events, @digit 9);
        IF (short_circuit_tests::throw_value(@object short_circuit_tests::temporary(@events events, @alive alive, @digit 2)))
        {
          TEST_ASSERT(FALSE);
        }
        ELSE { TEST_ASSERT(FALSE); }
      }
      ELSE { TEST_ASSERT(FALSE); }
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 42);
      TEST_ASSERT(alive == 0);
      TEST_ASSERT(events == 15269);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(events == 15269);
  }
}
