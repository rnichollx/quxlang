LANGUAGE QUXLANG EN 0.0;

::pointer_value_tests NAMESPACE
{
  ::array_offsets DOC <$ Pointer arithmetic counts elements, including one-past endpoints and signed differences within an array. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR values [4]T;
    values[0] := 2;
    values[1] := 4;
    values[2] := 6;
    values[3] := 8;
    VAR first =>>T := values[& 0];
    VAR middle =>>T := first + 2;
    VAR end =>>T := first + 4;
    TEST_ASSERT(middle-> == 6);
    TEST_ASSERT((middle - first) == 2);
    TEST_ASSERT((end - first) == 4);
    TEST_ASSERT((first - first) == 0);
    TEST_ASSERT((first - middle) == (0 - 2));
    TEST_ASSERT(first < middle);
    TEST_ASSERT(middle < end);
    TEST_ASSERT(first <= first);
    TEST_ASSERT(end >= middle);
    TEST_ASSERT((end - 1)-> == 8);
    TEST_ASSERT((middle - 2) == first);
    middle-> := 9;
    TEST_ASSERT(values[2] == 9);
    TEST_ASSERT(values[0] == 2);
    TEST_ASSERT(values[3] == 8);
  }

  ::element_scaled_arithmetic DOC <$ Checks array offsets and differences for element sizes of one, four, and eight bytes. $>
    DUAL_TEST
  {
    array_offsets#(U8)();
    array_offsets#(I32)();
    array_offsets#(U64)();
  }

  ::multibyte_offsets DOC <$ Pointer offsets preserve distinct magnitude bytes in both directions. $>
    DUAL_TEST
  {
    VAR values [514]U8;
    values[513] := 7;
    VAR first =>>U8 := values[& 0];
    VAR last =>>U8 := first + 513;
    TEST_ASSERT(last == values[& 513]);
    TEST_ASSERT(last-> == 7);
    TEST_ASSERT((last - 513) == first);
    TEST_ASSERT((last + (0 - 513)) == first);
  }

  ::reverse_iteration_from_endpoint DOC <$ Decrementing a one-past pointer returns its previous position before visiting the last live element. $>
    DUAL_TEST
  {
    VAR values [3]I32;
    values[0] := 2;
    values[1] := 4;
    values[2] := 6;
    VAR first =>>I32 := values[& 0];
    VAR cursor =>>I32 := first + 3;
    VAR end =>>I32 := cursor--;
    TEST_ASSERT(end == first + 3);
    TEST_ASSERT(cursor == first + 2);
    TEST_ASSERT(cursor-> == 6);
    VAR digits I32 := 0;
    VAR iterations I32 := 0;
    LOOP WHILE (cursor != first) DO
    {
      TEST_ASSERT(iterations < 2);
      digits := digits * 10 + cursor->;
      cursor--;
      iterations++;
    }
    digits := digits * 10 + cursor->;
    TEST_ASSERT(digits == 642);
    TEST_ASSERT(iterations == 2);
    TEST_ASSERT(cursor == first);
  }

  ::reference_survives_pointer_reassignment DOC <$ Binding a reference through a pointer retains the original referent after the pointer is reassigned. $>
    DUAL_TEST
  {
    VAR first I32 := 3;
    VAR second I32 := 7;
    VAR pointer MUT->I32 := first<-;
    VAR reference MUT& I32 := pointer->;
    pointer := second<-;
    reference := 11;
    TEST_ASSERT(first == 11);
    TEST_ASSERT(second == 7);
    pointer-> := 13;
    TEST_ASSERT(second == 13);
    TEST_ASSERT(reference == 11);
    TEST_ASSERT(reference<- == first<-);
    TEST_ASSERT(pointer == second<-);
  }

  ::pointer_slot_and_null_referent DOC <$ A pointer to a pointer slot remains non-null while the slot changes between null and a live object. $>
    DUAL_TEST
  {
    VAR value I32 := 5;
    VAR pointer MUT->I32;
    VAR slot MUT->MUT->I32 := pointer<-;
    TEST_ASSERT(slot??);
    TEST_ASSERT((slot->)!?);
    slot-> := value<-;
    TEST_ASSERT(pointer??);
    TEST_ASSERT(slot-> -> == 5);
    slot-> -> := 9;
    TEST_ASSERT(value == 9);
    pointer := NULL;
    TEST_ASSERT(slot??);
    TEST_ASSERT((slot->)!?);
    TEST_ASSERT(value == 9);
  }
}
