LANGUAGE QUXLANG EN 0.0;

::wide_flagset_tests NAMESPACE
{
  DOC <$ Implicit allocation reaches bit sixty-two after skipping a reserved range. $>
  ::flags63
    FLAGSET BITS(63) [low = 1, RESERVED = 4611686018427387902, high];

  DOC <$ Named bits occupy both ends of a full machine word. $>
  ::flags64
    FLAGSET BITS(64) [low = 1, high = 9223372036854775808];

  DOC <$ An implicit flag skips the reserved low word. $>
  ::flags65
    FLAGSET BITS(65) [low = 1, RESERVED = 18446744073709551614, high];

  DOC <$ Flags occupy both ends of a sixteen-byte representation. $>
  ::flags128
    FLAGSET BITS(128) [low = 1, high = 170141183460469231731687303715884105728];

  DOC <$ Implicit allocation skips a reserved range wider than a machine word. $>
  ::flags129
    FLAGSET BITS(129) [low = 1, RESERVED = 340282366920938463463374607431768211454, high];

  DOC <$ The width is inferred from a computed mask spanning four machine words. $>
  ::flags256
    FLAGSET [low = 1, high = (1 AS U256) #++ 255];

  DOC <$ High and unnamed bits survive integer conversion, bitwise operations and guarded serialization. $>
  ::wide_values
    TEMPLATE(@T TYPE AUTO, @integer_type TYPE AUTO, @count VALUE SZ)
    FUNCTION(@high integer_type, @last_byte BYTE)
  {
    TEST_ASSERT((T::high AS integer_type) == high);
    VAR raw [6]integer_type;
    raw[0] := 0;
    raw[1] := 1;
    raw[2] := 2;
    raw[3] := high;
    raw[4] := high #|| 1;
    raw[5] := (raw[0] #!!);
    VAR left SZ := 0;
    LOOP WHILE (left < 6) DO
    {
      VAR a T := raw[left] AS T;
      TEST_ASSERT((a AS integer_type) == raw[left]);
      TEST_ASSERT(a.low == ((raw[left] #&& 1) != 0));
      TEST_ASSERT(a.high == ((raw[left] #&& high) != 0));
      TEST_ASSERT((a??) == (raw[left] != 0));
      VAR bytes [count + 2]BYTE;
      bytes[0] := 165;
      bytes[count + 1] := 90;
      VAR end =>>BYTE := a.SERIALIZE(@OUTPUT_ITERATOR bytes[& 1]);
      TEST_ASSERT(end == bytes[& (count + 1)]);
      TEST_ASSERT(bytes[0] == 165);
      TEST_ASSERT(bytes[count + 1] == 90);
      VAR decoded T;
      VAR consumed =>>BYTE := decoded.DESERIALIZE(@INPUT_ITERATOR bytes[& 1]);
      TEST_ASSERT(consumed == end);
      TEST_ASSERT(decoded == a);
      IF (left == 3)
      {
        VAR index SZ := 1;
        LOOP WHILE (index < count) DO { TEST_ASSERT(bytes[index] == 0); index++; }
        TEST_ASSERT(bytes[count] == last_byte);
      }
      VAR right SZ := 0;
      LOOP WHILE (right < 6) DO
      {
        VAR b T := raw[right] AS T;
        TEST_ASSERT(((a #&& b) AS integer_type) == (raw[left] #&& raw[right]));
        TEST_ASSERT(((a #|| b) AS integer_type) == (raw[left] #|| raw[right]));
        TEST_ASSERT(((a #^^ b) AS integer_type) == (raw[left] #^^ raw[right]));
        TEST_ASSERT(((a #!& b) AS integer_type) == (raw[left] #!& raw[right]));
        TEST_ASSERT(((a #!| b) AS integer_type) == (raw[left] #!| raw[right]));
        TEST_ASSERT(((a #!^ b) AS integer_type) == (raw[left] #!^ raw[right]));
        TEST_ASSERT(((a #^> b) AS integer_type) == (raw[left] #^> raw[right]));
        TEST_ASSERT(((a #^< b) AS integer_type) == (raw[left] #^< raw[right]));
        VAR updated T := a;
        updated #^^= b;
        TEST_ASSERT((updated AS integer_type) == (raw[left] #^^ raw[right]));
        TEST_ASSERT((a AS integer_type) == raw[left]);
        right++;
      }
      left++;
    }
  }

  DOC <$ A sixty-three-bit flagset preserves reserved bits and clears serialized padding. $>
  ::nonbyte_machine_word
    DUAL_TEST
  {
    wide_values#(@T flags63, @integer_type U63, @count 8)(@high 4611686018427387904, @last_byte 64);
  }

  DOC <$ A sixty-four-bit flagset treats the top bit as an unsigned mask. $>
  ::full_machine_word
    DUAL_TEST
  {
    wide_values#(@T flags64, @integer_type U64, @count 8)(@high 9223372036854775808, @last_byte 128);
  }

  DOC <$ A sixty-five-bit flagset retains its top bit and unnamed reserved bits. $>
  ::nonbyte_word_boundary
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    wide_values#(@T flags65, @integer_type U65, @count 9)(@high 18446744073709551616, @last_byte 1);
  }

  DOC <$ A 128-bit flagset preserves the top bit through every binary bitwise operation. $>
  ::full_double_word
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    wide_values#(@T flags128, @integer_type U128, @count 16)(@high 170141183460469231731687303715884105728, @last_byte 128);
  }
  DOC <$ A 129-bit flagset preserves implicit flags, reserved bits and byte padding. $>
  ::beyond_double_word
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    wide_values#(@T flags129, @integer_type U129, @count 17)(@high 340282366920938463463374607431768211456, @last_byte 1);
  }

  DOC <$ A computed mask determines a 256-bit representation. $>
  ::inferred_four_words
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    wide_values#(@T flags256, @integer_type U256, @count 32)(@high (1 AS U256) #++ 255, @last_byte 128);
  }

  DOC <$ Deserialization rejects nonzero padding beyond bit 128. $>
  ::wide_padding_rejected
    STATIC_TEST EXPECT_FAIL
  {
    VAR bytes [17]BYTE;
    bytes[16] := 2;
    VAR flags flags129;
    flags.DESERIALIZE(@INPUT_ITERATOR bytes[& 0]);
  }
}
