LANGUAGE QUXLANG EN 0.0;

::region_phase_tests NAMESPACE
{
  ::escape_rejected_in_constexpr DOC <$ Escaping a pointer into a raw address is unavailable during constexpr execution. $>
    STATIC_TEST EXPECT_FAIL
  {
    VAR object I32 := 17;
    VAR address ADDRESS := ADDRESS_LAUNDER_ESCAPE_ALLOC_REGION object<-;
  }

  ::discovery_rejected_in_constexpr DOC <$ Raw-address pointer discovery is unavailable during constexpr execution. $>
    STATIC_TEST EXPECT_FAIL
  {
    VAR address ADDRESS;
    VAR pointer MUT->I32 := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO MUT->I32;
  }

  ::region_end_rejected_in_constexpr DOC <$ Ending a storage allocation region is a native-only operation even when no objects are live. $>
    STATIC_TEST EXPECT_FAIL KNOWN_BROKEN
  {
    VAR storage ->TYPED_STORAGE(I32) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::ALLOC();
    VAR address ADDRESS := END_ALLOC_REGION storage;
    storage := BEGIN_ALLOC_REGION address TO ->TYPED_STORAGE(I32);
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::DEALLOC(@PTR storage);
  }
}
