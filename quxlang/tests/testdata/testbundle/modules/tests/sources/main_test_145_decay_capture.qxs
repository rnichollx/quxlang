LANGUAGE QUXLANG EN 0.0;

::decay_capture_tests NAMESPACE
{
  DOC <$ Supplies a concrete value for temporary and reference capture. $>
  ::record
    STRUCT { .number VAR I32; }
  DOC <$ Produces an independent record temporary. $>
  ::create
    FUNCTION(@number I32): record
  {
    VAR result record;
    result.number := number;
    RETURN result;
  }
  DOC <$ Captures the deduced value parameter type and returns an independent value. $>
  ::forward_value
    FUNCTION(@value DECAY(captured_type)): captured_type
  { RETURN value; }

  DOC <$ Returning a decayed temporary produces independent owned records rather than dangling temporary references. $>
  ::temporary_becomes_value
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(TYPEOF(forward_value(@value create(@number 17))), record));
    VAR first record := forward_value(@value create(@number 17));
    VAR second record := forward_value(@value create(@number 29));
    TEST_ASSERT(first.number == 17);
    TEST_ASSERT(second.number == 29);
    first.number := 41;
    TEST_ASSERT(second.number == 29);
  }

  DOC <$ A value parameter remains independent of mutable and const lvalue arguments. $>
  ::lvalue_value_parameter
    DUAL_TEST
  {
    VAR source record;
    source.number := 17;
    VAR copied record := forward_value(@value source);
    copied.number := 29;
    TEST_ASSERT(source.number == 17);
    VAR view CONST& record := source;
    VAR second record := forward_value(@value view);
    source.number := 41;
    TEST_ASSERT(second.number == 17);
  }

  DOC <$ Bare DECAY return deduction copies an lvalue into an owned result. $>
  ::deduced_copy
    FUNCTION(@value CONST& record): DECAY { RETURN value; }
  DOC <$ Explicit mutable reference qualification preserves the captured receiver. $>
  ::mutable_result
    FUNCTION(@value MUT& DECAY(captured_type)): MUT& captured_type { RETURN value; }
  DOC <$ Explicit const reference qualification preserves the captured receiver. $>
  ::const_result
    FUNCTION(@value CONST& DECAY(captured_type)): CONST& captured_type { RETURN value; }

  DOC <$ A bare DECAY result is independent of the referenced source. $>
  ::deduced_value_result
    DUAL_TEST
  {
    VAR source record;
    source.number := 17;
    VAR copied record := deduced_copy(@value source);
    source.number := 29;
    TEST_ASSERT(copied.number == 17);
    copied.number := 41;
    TEST_ASSERT(source.number == 29);
  }

  DOC <$ Reference-qualified DECAY captures preserve identity and const observations of later writes. $>
  ::qualified_reference_capture
    DUAL_TEST
  {
    VAR source record;
    source.number := 17;
    VAR mutable MUT& record := mutable_result(@value source);
    TEST_ASSERT(mutable<- == source<-);
    mutable.number := 29;
    TEST_ASSERT(source.number == 29);
    VAR readable CONST& record := const_result(@value source);
    source.number := 41;
    TEST_ASSERT(readable.number == 41);
  }
}
