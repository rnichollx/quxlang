LANGUAGE QUXLANG EN 0.0;

::exception_tests NAMESPACE
{
  DOC <$ Reads the active handler from a separately called function. $>
  ::read_current
    FUNCTION() NOEXCEPT: EXCEPTION_PTR
  {
    RETURN CURRENT_EXCEPTION();
  }

  DOC <$ A saved handle retains the original object beyond its handler and permits later propagation. $>
  ::saved_exception
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR saved EXCEPTION_PTR;
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
    TRY { THROW I32(@OTHER 42); }
    CATCH error MUT& I32
    {
      saved := read_current();
      error := 73;
      TEST_ASSERT(saved == CURRENT_EXCEPTION());
    }
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
    VAR caught BOOL := FALSE;
    TRY { THROW_EXCEPTION_PTR(saved); }
    CATCH error CONST& I32 { caught := error == 73; }
    TEST_ASSERT(caught);
  }

  DOC <$ Nested handlers restore the previous current exception after their local cleanup. $>
  ::current_exception_nesting
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    TRY { THROW I32(@OTHER 42); }
    CATCH outer CONST& I32
    {
      VAR original EXCEPTION_PTR := CURRENT_EXCEPTION();
      TRY { THROW I32(@OTHER 17); }
      CATCH inner CONST& I32
      {
        TEST_ASSERT(inner == 17);
        TEST_ASSERT((CURRENT_EXCEPTION() == original) == FALSE);
      }
      TEST_ASSERT(CURRENT_EXCEPTION() == original);
      TEST_ASSERT(outer == 42);
    }
  }

  DOC <$ A propagating exception becomes current only after its handler is entered. $>
  ::current_during_unwind
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR observed BOOL := FALSE;
    TRY
    {
      DEFER
      {
        TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
        TRY { THROW U32(@OTHER 17); }
        CATCH inner CONST& U32
        {
          TEST_ASSERT((CURRENT_EXCEPTION()??));
          observed := inner == 17;
        }
        TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
      }
      THROW I32(@OTHER 42);
    }
    CATCH outer CONST& I32
    {
      TEST_ASSERT(outer == 42);
      TEST_ASSERT(observed);
    }
  }

  DOC <$ The permanent sentinel reference survives ordinary handle ownership and repeated throws. $>
  ::saved_out_of_memory
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR saved EXCEPTION_PTR;
    TRY { THROW UNWIND_OUT_OF_MEMORY; }
    CATCH UNWIND_OUT_OF_MEMORY { saved := CURRENT_EXCEPTION(); }
    TEST_ASSERT(saved.IS_OUT_OF_MEMORY());
    TEST_ASSERT(saved??);
    TRY { THROW_EXCEPTION_PTR(saved); }
    CATCH UNWIND_OUT_OF_MEMORY
    {
      TEST_ASSERT(CURRENT_EXCEPTION() == saved);
    }
    TEST_ASSERT(saved??);
  }

  DOC <$ Propagates an integer through an ordinary function call. $>
  ::raise_integer
    FUNCTION()
  {
    THROW I32(@OTHER 42);
  }

  DOC <$ Binds an exception by its explicit reference type. $>
  ::exact_reference
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY { THROW I32(@OTHER 42); }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 42);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
  }

  DOC <$ Finds a caller handler before unwinding a callee. $>
  ::call_propagation
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY { raise_integer(); }
    CATCH error CONST& I32 { caught := error == 42; }
    TEST_ASSERT(caught);
  }

  DOC <$ Rethrow preserves changes to the original exception payload. $>
  ::mutable_rethrow
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value I32 := 0;
    TRY
    {
      TRY { raise_integer(); }
      CATCH error MUT& I32
      {
        error := 17;
        RETHROW;
      }
    }
    CATCH error CONST& I32 { value := error; }
    TEST_ASSERT(value == 17);
  }

  DOC <$ Ordinary objects bypass the sentinel handler and reach the default. $>
  ::default_and_sentinel
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY { raise_integer(); }
    CATCH error CONST& U32 { TEST_ASSERT(FALSE); }
    CATCH UNWIND_OUT_OF_MEMORY { TEST_ASSERT(FALSE); }
    CATCH DEFAULT { caught := TRUE; }
    TEST_ASSERT(caught);
  }

  DOC <$ Exceptional scope exit executes deferred actions before entering a handler. $>
  ::deferred_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    TRY
    {
      DEFER events := events * 10 + 1;
      DEFER events := events * 10 + 2;
      raise_integer();
    }
    CATCH error CONST& I32 { TEST_ASSERT(events == 21); }
    TEST_ASSERT(events == 21);
  }

  DOC <$ NOEXCEPT permits exceptions that are handled inside the callable. $>
  ::nonthrowing_body
    FUNCTION() NOEXCEPT: I32
  {
    TRY { raise_integer(); }
    CATCH error CONST& I32 { RETURN error; }
    RETURN 0;
  }

  DOC <$ An internal handler satisfies the callable's nonthrowing contract. $>
  ::caught_inside_noexcept
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    TEST_ASSERT(nonthrowing_body() == 42);
  }

  DOC <$ The allocation-failure sentinel has no ordinary object or typed binding. $>
  ::sentinel_rethrow
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      TRY { THROW UNWIND_OUT_OF_MEMORY; }
      CATCH error CONST& I32 { TEST_ASSERT(FALSE); }
      CATCH UNWIND_OUT_OF_MEMORY { RETHROW; }
      CATCH DEFAULT { TEST_ASSERT(FALSE); }
    }
    CATCH DEFAULT { caught := TRUE; }
    TEST_ASSERT(caught);
  }

  DOC <$ Handling another exception does not replace the lexical rethrow payload. $>
  ::nested_handler
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      TRY { THROW I32(@OTHER 42); }
      CATCH original CONST& I32
      {
        TRY { THROW I32(@OTHER 17); }
        CATCH nested CONST& I32 { TEST_ASSERT(nested == 17); }
        TEST_ASSERT(original == 42);
        RETHROW;
      }
      CATCH DEFAULT { TEST_ASSERT(FALSE); }
    }
    CATCH result CONST& I32 { caught := result == 42; }
    TEST_ASSERT(caught);
  }

  DOC <$ Records destruction of both the source and owned exception objects. $>
  ::recorded_exception
    STRUCT
  {
    .count VAR MUT->I32;
    .DESTRUCTOR FUNCTION() { .count-> += 1; }
  }

  DOC <$ The caught payload survives cleanup and is destroyed on handler exit. $>
  ::payload_lifetime
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR count I32 := 0;
    TRY
    {
      VAR original recorded_exception;
      original.count := count<-;
      THROW original;
    }
    CATCH error CONST& recorded_exception { TEST_ASSERT(count == 1); }
    TEST_ASSERT(count == 2);
  }

  DOC <$ A deferred action can handle the sentinel while another exception propagates. $>
  ::sentinel_during_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      DEFER
      {
        TRY { THROW UNWIND_OUT_OF_MEMORY; }
        CATCH UNWIND_OUT_OF_MEMORY { caught := TRUE; }
      }
      raise_integer();
    }
    CATCH error CONST& I32 { TEST_ASSERT(caught); }
  }

  DOC <$ Typed catch bindings must be references. $>
  ::value_catch_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    TRY { raise_integer(); }
    CATCH error I32 {}
  }

  DOC <$ A pointer value does not provide a catch reference binding. $>
  ::pointer_catch_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    TRY { raise_integer(); }
    CATCH error CONST->I32 {}
  }

  DOC <$ RETHROW is only valid in a lexical catch. $>
  ::rethrow_without_handler_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    RETHROW;
  }

  DOC <$ A lambda cannot rethrow its enclosing callable's exception. $>
  ::cross_callable_rethrow_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    TRY { raise_integer(); }
    CATCH error CONST& I32
    {
      AUTO action := -< { RETHROW; };
      action();
    }
  }

  DOC <$ Uncaught exceptions are constant-evaluation errors. $>
  ::uncaught_rejected
    STATIC_TEST EXPECT_FAIL
  {
    raise_integer();
  }

  DOC <$ A caller cannot catch an exception that escapes a nonthrowing callable. $>
  ::noexcept_escape_rejected
    STATIC_TEST EXPECT_FAIL
  {
    AUTO action := -< NOEXCEPT { raise_integer(); };
    TRY { action(); }
    CATCH DEFAULT {}
  }

  DOC <$ Deferred actions are implicitly nonthrowing. $>
  ::defer_escape_rejected
    STATIC_TEST EXPECT_FAIL
  {
    TRY { DEFER raise_integer(); }
    CATCH DEFAULT {}
  }

  ::escaping_subobject STRUCT
  {
    .DESTRUCTOR FUNCTION() { raise_integer(); }
  }
  ::subobject_owner STRUCT { .member VAR escaping_subobject; }

  DOC <$ A subobject exception cannot escape an implicit destructor boundary. $>
  ::subobject_destructor_escape
    STATIC_TEST EXPECT_FAIL
  {
    TRY { VAR owner subobject_owner; }
    CATCH DEFAULT {}
  }

  ::catching_destructor STRUCT
  {
    .observed VAR MUT->BOOL;
    .DESTRUCTOR FUNCTION()
    {
      TRY { raise_integer(); }
      CATCH error CONST& I32 { .observed-> := error == 42; }
    }
  }

  DOC <$ A destructor may handle a local exception while the original exception continues outward. $>
  ::destructor_nested_exception
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR observed BOOL := FALSE;
    TRY
    {
      VAR object catching_destructor;
      object.observed := observed<-;
      THROW U32(@OTHER 17);
    }
    CATCH error CONST& U32
    {
      TEST_ASSERT(error == 17);
      TEST_ASSERT(observed);
    }
  }

  DOC <$ Catch bodies do not bypass deferred-action return restrictions. $>
  ::defer_catch_return_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    DEFER
    {
      TRY { raise_integer(); }
      CATCH DEFAULT { RETURN; }
    }
  }

  DOC <$ GOTO cannot enter a protected region from outside it. $>
  ::enter_try_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    GOTO :inside;
    TRY { LABEL :inside; }
    CATCH DEFAULT {}
  }

  ::base_exception STRUCT POLYMORPHIC { .value VAR I32; }
  ::derived_exception STRUCT POLYMORPHIC { .parent BASE base_exception; }
  ::repeated_exception STRUCT POLYMORPHIC
  {
    .left BASE base_exception;
    .right BASE base_exception;
  }

  ::throwing_virtual STRUCT POLYMORPHIC
  {
    .raise FUNCTION() CONST VIRTUAL { THROW I32(@OTHER 42); }
  }

  ::throwing_interface INTERFACE { .raise FUNCTION(); }
  ::throwing_implementation IMPLEMENTATION(throwing_interface)
  {
    ::raise FUNCTION() { THROW I32(@OTHER 42); }
  }

  DOC <$ Procedure, virtual, and interface calls propagate through ordinary catcher boundaries. $>
  ::indirect_exception_calls
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught I32 := 0;
    VAR procedure CONST->PROCEDURE() := raise_integer<-;
    TRY { procedure(); }
    CATCH error CONST& I32 { TEST_ASSERT(error == 42); caught += 1; }
    VAR object throwing_virtual;
    TRY { object.raise(); }
    CATCH error CONST& I32 { TEST_ASSERT(error == 42); caught += 1; }
    VAR operations throwing_interface := throwing_implementation;
    TRY { operations.raise(); }
    CATCH error CONST& I32 { TEST_ASSERT(error == 42); caught += 1; }
    TEST_ASSERT(caught == 3);
  }

  ::universal_delete_probe STRUCT POLYMORPHIC
  {
    .parent BASE base_exception;
    .destroyed VAR MUT->BOOL;
    .DESTRUCTOR FUNCTION() { .destroyed-> := TRUE; }
  }

  DOC <$ All polymorphic subobjects share one canonical interface with dynamic type and virtual destruction. $>
  ::universal_polymorphic_view
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR destroyed BOOL := FALSE;
    VAR object MUT->universal_delete_probe := NEW universal_delete_probe;
    object->.destroyed := destroyed<-;
    VAR parent MUT->base_exception := object->.parent<-;
    VAR first MUT->POLYMORPHIC_BASE := object;
    VAR second MUT->POLYMORPHIC_BASE := parent;
    TEST_ASSERT(first == second);
    TEST_ASSERT(first->.DYNAMIC_TYPE() == TYPE_INDEX_OF(universal_delete_probe));
    TEST_ASSERT((first AS DYNAMIC MUT->universal_delete_probe) == object);
    VAR empty MUT->base_exception;
    VAR empty_view MUT->POLYMORPHIC_BASE := empty;
    TEST_ASSERT((empty_view??) == FALSE);
    DELETE first;
    TEST_ASSERT(destroyed);
  }

  DOC <$ A unique polymorphic base binds to the corresponding subobject. $>
  ::polymorphic_base
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR error derived_exception;
      error.value := 42;
      THROW error;
    }
    CATCH error CONST& base_exception { caught := error.value == 42; }
    TEST_ASSERT(caught);
  }

  DOC <$ Repeated base subobjects do not match a typed base handler. $>
  ::ambiguous_base
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY { THROW repeated_exception(); }
    CATCH error CONST& base_exception { TEST_ASSERT(FALSE); }
    CATCH DEFAULT { caught := TRUE; }
    TEST_ASSERT(caught);
  }

  DOC <$ Fails after constructing one field of a partial object. $>
  ::throwing_constructor
    STRUCT
  {
    .member VAR recorded_exception;
    .CONSTRUCTOR FUNCTION(@count MUT->I32)
    {
      .member.count := count;
      raise_integer();
    }
  }

  DOC <$ A failed constructor destroys completed fields without destroying the complete object. $>
  ::partial_object_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR count I32 := 0;
    TRY { VAR object throwing_constructor := throwing_constructor(@count count<-); }
    CATCH error CONST& I32 { TEST_ASSERT(count == 1); }
    TEST_ASSERT(count == 1);
  }

  DOC <$ A catch cannot jump into a sibling handler. $>
  ::sibling_catch_jump_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    TRY { THROW UNWIND_OUT_OF_MEMORY; }
    CATCH UNWIND_OUT_OF_MEMORY { GOTO :sibling; }
    CATCH DEFAULT { LABEL :sibling; }
  }

  DOC <$ A constant catch reference cannot modify the payload. $>
  ::const_catch_mutation_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    TRY { raise_integer(); }
    CATCH error CONST& I32 { error := 7; }
  }

  DOC <$ Leaving a handler by GOTO destroys its exception payload. $>
  ::handler_exit_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR count I32 := 0;
    TRY
    {
      VAR error recorded_exception;
      error.count := count<-;
      THROW error;
    }
    CATCH error CONST& recorded_exception { GOTO :done; }
    LABEL :done;
    TEST_ASSERT(count == 2);
  }

  DOC <$ Counts completed copies and fails during the second copy. $>
  ::array_exception_element
    STRUCT
  {
    .attempts VAR MUT->I32;
    .destroyed VAR MUT->I32;
    .is_copy VAR BOOL;
    .CONSTRUCTOR FUNCTION() {}
    .CONSTRUCTOR FUNCTION(@OTHER CONST& array_exception_element)
    {
      .attempts := OTHER.attempts;
      .destroyed := OTHER.destroyed;
      .attempts-> += 1;
      IF (.attempts-> == 2) { raise_integer(); }
      .is_copy := TRUE;
    }
    .DESTRUCTOR FUNCTION()
    {
      IF (.is_copy) { .destroyed-> += 1; }
    }
  }

  DOC <$ A failed array copy destroys only its completed prefix. $>
  ::partial_array_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR attempts I32 := 0;
    VAR destroyed I32 := 0;
    VAR original [3]array_exception_element;
    original[0].attempts := attempts<-;
    original[0].destroyed := destroyed<-;
    original[1].attempts := attempts<-;
    original[1].destroyed := destroyed<-;
    original[2].attempts := attempts<-;
    original[2].destroyed := destroyed<-;
    TRY { VAR copy [3]array_exception_element := original; }
    CATCH error CONST& I32
    {
      TEST_ASSERT(attempts == 2);
      TEST_ASSERT(destroyed == 1);
    }
    TEST_ASSERT(destroyed == 1);
  }
}

DOC <$ Keeps private element types resolved across compiler-generated array operations. $>
PRIVATE(MODULE) ::exception_private_array_value
STRUCT { .value VAR I32; }

DOC <$ Array indexing and assignment retain access to their already-resolved private element type. $>
::exception_private_arrays
DUAL_TEST
{
  VAR first [2]exception_private_array_value;
  first[0].value := 7;
  VAR second [2]exception_private_array_value;
  second := first;
  TEST_ASSERT(second[0].value == 7);
}

DOC <$ Repeated loop tests reevaluate both short-circuit operands, including after CONTINUE. $>
::exception_unwind_loop_conditions
DUAL_TEST
{
  VAR index SZ := 0;
  LOOP WHILE (index < 2 && TRUE) DO
  {
    index += 1;
    IF (index > 3) { BREAK; }
    CONTINUE;
  }
  TEST_ASSERT(index == 2);
  index := 0;
  LOOP WHILE (index < 2 || FALSE) DO
  {
    index += 1;
    IF (index > 3) { BREAK; }
  }
  TEST_ASSERT(index == 2);
}

DOC <$ User code cannot invoke the runtime's frame propagation intrinsic. $>
::exception_propagate_is_runtime_only
STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR frame MUT->RUNTIME_MODULE::EXCEPTION_FRAME;
  EXCEPTION_PROPAGATE(@FRAME frame);
}

DOC <$ Array copies preserve distinct register words, including on 32-bit native targets. $>
::exception_register_array_copy
DUAL_TEST
{
  VAR original [256]UINTPTR;
  VAR index SZ := 0;
  LOOP WHILE (index < 256) DO
  {
    original[index] := (index AS UINTPTR) + 17;
    index += 1;
  }
  VAR copied [256]UINTPTR := original;
  VAR assigned [256]UINTPTR;
  assigned := copied;
  index := 0;
  LOOP WHILE (index < 256) DO
  {
    TEST_ASSERT(copied[index] == (index AS UINTPTR) + 17);
    TEST_ASSERT(assigned[index] == (index AS UINTPTR) + 17);
    index += 1;
  }
}
