LANGUAGE QUXLANG EN 0.0;

::return_lifetime_tests NAMESPACE
{
  ::select_owned DOC <$ Moves one of two local objects into the return value and destroys the unselected local before returning. $>
    FUNCTION(@source CONST& array_lifetime_tests::element, @first BOOL): array_lifetime_tests::element
  {
    VAR one array_lifetime_tests::element := source;
    one.number := 1;
    VAR two array_lifetime_tests::element := source;
    two.number := 2;
    IF (first) { RETURN MOVE(one); }
    RETURN MOVE(two);
  }

  ::selected_return DOC <$ Both early and trailing returns retain one owner until the caller destroys the result. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_LAYOUTLESS)
  {
    VAR mode I32 := 0;
    LOOP WHILE (mode < 2) DO
    {
      VAR attempts I32 := 0;
      VAR events I32 := 0;
      VAR source array_lifetime_tests::element;
      source.attempts := attempts<-;
      source.events := events<-;
      source.number := 9;
      {
        VAR result array_lifetime_tests::element := select_owned(@source source, @first mode == 0);
        TEST_ASSERT(attempts == 2);
        TEST_ASSERT(result.copied);
        TEST_ASSERT(result.complete);
        IF (mode == 0) { TEST_ASSERT(result.number == 1); TEST_ASSERT(events == 2); }
        ELSE { TEST_ASSERT(result.number == 2); TEST_ASSERT(events == 1); }
        TEST_ASSERT(source.number == 9);
      }
      IF (mode == 0) { TEST_ASSERT(events == 21); }
      ELSE { TEST_ASSERT(events == 12); }
      mode++;
    }
  }

  ::copy_return DOC <$ Constructs a return value from a local while two owned locals remain live. $>
    FUNCTION(@source CONST& array_lifetime_tests::element): array_lifetime_tests::element
  {
    VAR one array_lifetime_tests::element := source;
    one.number := 1;
    VAR two array_lifetime_tests::element := source;
    two.number := 2;
    RETURN array_lifetime_tests::element(@OTHER one);
  }

  ::copied_return_cleanup DOC <$ Successful return construction precedes reverse local cleanup and gives the caller independent ownership. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_LAYOUTLESS)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source array_lifetime_tests::element;
    source.attempts := attempts<-;
    source.events := events<-;
    source.number := 9;
    {
      VAR result array_lifetime_tests::element := copy_return(@source source);
      TEST_ASSERT(attempts == 3);
      TEST_ASSERT(events == 21);
      TEST_ASSERT(result.number == 1);
      TEST_ASSERT(result.copied);
      result.number := 3;
    }
    TEST_ASSERT(events == 213);
  }

  ::failed_return_cleanup DOC <$ Failure while constructing the return value destroys both completed locals and never destroys the incomplete result. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_LAYOUTLESS)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source array_lifetime_tests::element;
    source.attempts := attempts<-;
    source.events := events<-;
    source.number := 9;
    source.failure := 3;
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR result array_lifetime_tests::element := copy_return(@source source);
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 1);
      TEST_ASSERT(attempts == 3);
      TEST_ASSERT(events == 21);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(source.complete);
    TEST_ASSERT(source.number == 9);
    TEST_ASSERT(events == 21);
  }
}
