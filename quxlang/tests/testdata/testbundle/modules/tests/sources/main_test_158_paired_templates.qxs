LANGUAGE QUXLANG EN 0.0;

::paired_template_tests NAMESPACE
{
  DOC <$ Declares the public template names in reverse order to verify named shorthand binding. $>
  ::pair
    TEMPLATE(@VALUE:value_type TYPE, @INDEX:index_type TYPE) STRUCT
  {
    DOC <$ Exposes the bound INDEX type. $>
    ::index ALIAS index_type;
    DOC <$ Exposes the bound VALUE type. $>
    ::value ALIAS value_type;
  }

  DOC <$ Paired shorthand is identical to explicit named arguments and preserves asymmetric and nested type roles. $>
  ::type_identity
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(pair#[I32:I64], pair#(@VALUE I64, @INDEX I32)));
    TEST_ASSERT(SAME_TYPES(pair#[I32:I64]::index, I32));
    TEST_ASSERT(SAME_TYPES(pair#[I32:I64]::value, I64));
    TEST_ASSERT(SAME_TYPES(pair#[I32:I64], pair#[I64:I32]) == FALSE);
    TEST_ASSERT(SAME_TYPES(pair#[pair#[I32:I64] : [3]BYTE]::index, pair#[I32:I64]));
    TEST_ASSERT(SAME_TYPES(pair#[pair#[I32:I64] : [3]BYTE]::value, [3]BYTE));
  }

  DOC <$ Shorthand preserves complete reference and pointer qualifiers on both sides. $>
  ::qualified_types
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(pair#[MUT& I32:CONST->I64]::index, MUT& I32));
    TEST_ASSERT(SAME_TYPES(pair#[MUT& I32:CONST->I64]::value, CONST->I64));
    TEST_ASSERT(SAME_TYPES(pair#[CONST& [2]I32:MUT=>>BYTE],
      pair#(@INDEX CONST& [2]I32, @VALUE MUT=>>BYTE)));
  }

  DOC <$ Returns the INDEX argument through a free function with paired template bindings. $>
  ::first
    TEMPLATE(@VALUE:value_type TYPE, @INDEX:index_type TYPE)
    FUNCTION(@index index_type, @value value_type): index_type { RETURN index; }

  DOC <$ Exercises paired template arguments through member-expression parsing. $>
  ::receiver STRUCT
  {
    .calls VAR I32;
    DOC <$ Records a member invocation and returns the INDEX argument unchanged. $>
    .first
      TEMPLATE(@VALUE:value_type TYPE, @INDEX:index_type TYPE)
      FUNCTION(@index index_type, @value value_type): index_type
    { .calls++; RETURN index; }
  }

  DOC <$ Free paired calls agree with named template application and preserve mutable reference identity. $>
  ::free_calls
    DUAL_TEST
  {
    TEST_ASSERT(first#[I32:I64](@index 17, @value 4294967313) == 17);
    TEST_ASSERT(first#(@INDEX I64, @VALUE I32)(@index 4294967313, @value 19) == 4294967313);
    VAR number I32 := 29;
    VAR reference MUT& I32 := first#[MUT& I32:I64](@index number, @value 4294967313);
    TEST_ASSERT(reference<- == number<-);
    reference := 41;
    TEST_ASSERT(number == 41);
  }

  DOC <$ Member paired calls agree with explicit named templates and preserve mutable reference returns. $>
  ::member_calls
    DUAL_TEST
  {
    VAR object receiver;
    TEST_ASSERT(object.first#[I64:I32](@value 19, @index 4294967313) == 4294967313);
    TEST_ASSERT(object.first#(@INDEX I32, @VALUE I64)(@index 23, @value 4294967313) == 23);
    VAR number I32 := 29;
    VAR reference MUT& I32 := object.first#[MUT& I32:I64](@index number, @value 4294967313);
    TEST_ASSERT(reference<- == number<-);
    reference := 41;
    TEST_ASSERT(number == 41);
    TEST_ASSERT(object.calls == 3);
  }
}
