LANGUAGE QUXLANG EN 0.0;

::ibc_value_tests NAMESPACE
{
  ::record DOC <$ Declares fields in an order different from their lexical names. $>
    IBC_STRUCT
  {
    .z VAR U8;
    .a VAR U64;
    .middle VAR U16;
  }

  ::transform DOC <$ Returns an independently modified IBC record passed by value. $>
    FUNCTION(@value record): record
  {
    value.z += 1;
    value.a += 3;
    value.middle += 5;
    RETURN value;
  }

  ::copy_assignment_and_call DOC <$ IBC records preserve values through copying, assignment, swap and indirect calls. $>
    DUAL_TEST
  {
    VAR original record;
    original.z := 7;
    original.a := 4294967297;
    original.middle := 4660;
    VAR copied record := original;
    copied.a := 8589934595;
    TEST_ASSERT(original.a == 4294967297);
    VAR assigned record;
    assigned := copied;
    copied.middle := 99;
    TEST_ASSERT(assigned.middle == 4660);
    original <-> assigned;
    TEST_ASSERT(original.a == 8589934595);
    TEST_ASSERT(assigned.a == 4294967297);
    VAR pointer CONST->PROCEDURE(@value record: record) := transform<-;
    VAR result record := pointer(@value assigned);
    TEST_ASSERT(result.z == 8);
    TEST_ASSERT(result.a == 4294967300);
    TEST_ASSERT(result.middle == 4665);
    TEST_ASSERT(assigned.z == 7);
    TEST_ASSERT(assigned.a == 4294967297);
    TEST_ASSERT(assigned.middle == 4660);
    TEST_ASSERT(PUBLIC_FIELD_COUNT(record) == 3);
    TEST_ASSERT(SAME_TYPES(TYPEOF(PUBLIC_FIELD_NAME(record, 0)), TYPEOF("z")));
    TEST_ASSERT(SAME_TYPES(TYPEOF(PUBLIC_FIELD_NAME(record, 1)), TYPEOF("a")));
    TEST_ASSERT(SAME_TYPES(TYPEOF(PUBLIC_FIELD_NAME(record, 2)), TYPEOF("middle")));
  }

  ::native_layout INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) DOC <$ The native IBC layout retains declaration order and natural alignment. $>
    DUAL_TEST
  {
    TEST_ASSERT(SIZEOF(record) == 24);
    TEST_ASSERT(ALIGNOF(record) == 8);
  }
}
