LANGUAGE QUXLANG EN 0.0;

::polymorphic_type_operand_tests NAMESPACE
{
  DOC <$ An ordinary record contains a polymorphic object without being polymorphic itself. $>
  ::holder
    STRUCT { .member VAR inheritance_tests::dispatch_base; }

  DOC <$ A second containing level preserves the ordinary record category. $>
  ::nested_holder
    STRUCT { .member VAR holder; }

  DOC <$ An alias preserves the ordinary containing record's identity. $>
  ::holder_alias
    ALIAS holder;

  DOC <$ A polymorphic constructor records execution for unevaluated type-operand checks. $>
  ::probe
    STRUCT POLYMORPHIC
  {
    DOC <$ Records construction through caller-owned state. $>
    .CONSTRUCTOR
      FUNCTION(@calls MUT& I32) { calls ++; }
  }

  DOC <$ Polymorphism classifies the exact record type without propagating through ordinary fields or storage wrappers. $>
  ::containment
    DUAL_TEST
  {
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(inheritance_tests::dispatch_base));
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(holder) == FALSE);
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(nested_holder) == FALSE);
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(holder_alias) == FALSE);
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(TYPED_STORAGE(inheritance_tests::dispatch_base)) == FALSE);
  }

  DOC <$ TYPE_IS_POLYMORPHIC resolves TYPEOF of construction without executing the constructor or changing caller state. $>
  ::unevaluated_constructor
    DUAL_TEST
  {
    VAR calls I32 := 0;
    TEST_ASSERT(TYPE_IS_POLYMORPHIC(TYPEOF(probe(@calls calls))));
    TEST_ASSERT(calls == 0);
    TEST_ASSERT(SAME_TYPES(TYPEOF(TYPE_IS_POLYMORPHIC(probe)), BOOL));
    TEST_ASSERT(SAME_TYPES(TYPEOF(TYPE_IS_POLYMORPHIC(holder)), BOOL));
  }
}
