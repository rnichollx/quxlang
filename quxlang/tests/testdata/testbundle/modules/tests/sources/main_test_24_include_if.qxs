LANGUAGE QUXLANG EN 0.0;

::include3 STATIC BOOL := TRUE;

::include2 INCLUDE_IF(include3) STATIC BOOL := include3;

::include1 INCLUDE_IF(include2) STATIC BOOL := TRUE;

::include_if_test DUAL_TEST
{
  TEST_ASSERT(include1);
}

::conditional_field_struct STRUCT
{
  .included INCLUDE_IF(TRUE) VAR BYTE;
  .excluded INCLUDE_IF(FALSE) VAR U64;
}

::conditional_field_layout_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
{
  TEST_ASSERT(SIZEOF(conditional_field_struct) == 1);

  VAR value conditional_field_struct;
  value.included := 7;
  TEST_ASSERT(value.included == 7);
}

::conditional_field_lookup_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR value conditional_field_struct;
  value.excluded := 1;
}

::conditional_declaration_tests NAMESPACE
{
  DOC <$ Supplies an enabled Boolean option when the bundle does not override it. $>
  ::enabled
    OPTION BOOL DEFAULT_VALUE(TRUE);
  DOC <$ Supplies a disabled Boolean option when the bundle does not override it. $>
  ::disabled
    OPTION BOOL DEFAULT_VALUE(FALSE);
  DOC <$ Supplies a numeric option used in declaration conditions. $>
  ::amount
    OPTION NUMBER DEFAULT_VALUE(17);

  DOC <$ An inactive overload must not compete with the active declaration. $>
  ::selected INCLUDE_IF(disabled)
    FUNCTION(@value I32): I32 { RETURN 99; }
  DOC <$ The enabled narrow overload adds one to its argument. $>
  ::selected INCLUDE_IF(enabled)
    FUNCTION(@value I32): I32 { RETURN value + 1; }
  DOC <$ The enabled wide overload retains its distinct argument type. $>
  ::selected INCLUDE_IF(amount == 17)
    FUNCTION(@value I64): I64 { RETURN value + 2; }

  DOC <$ Default option values control overload participation without creating an ambiguity with inactive declarations. $>
  ::option_defaults_and_overloads
    DUAL_TEST
  {
    TEST_ASSERT(enabled);
    TEST_ASSERT(disabled == FALSE);
    TEST_ASSERT(amount == 17);
    TEST_ASSERT(selected(@value (4 AS I32)) == 5);
    TEST_ASSERT(selected(@value (4 AS I64)) == 6);
  }

  DOC <$ Selects field storage, a nested alias, and a member function per template instantiation. $>
  ::record
    TEMPLATE(@wide VALUE BOOL) STRUCT
  {
    .small INCLUDE_IF(wide == FALSE) VAR BYTE;
    .large INCLUDE_IF(wide) VAR U64;
    ::element INCLUDE_IF(wide == FALSE) ALIAS BYTE;
    ::element INCLUDE_IF(wide) ALIAS U64;
    DOC <$ Identifies the narrow instantiation. $>
    .kind INCLUDE_IF(wide == FALSE)
      FUNCTION() CONST: I32 { RETURN 1; }
    DOC <$ Identifies the wide instantiation. $>
    .kind INCLUDE_IF(wide)
      FUNCTION() CONST: I32 { RETURN 8; }
  }

  DOC <$ Different Boolean template arguments select separate fields, aliases, and same-named member functions. $>
  ::template_conditions_are_independent
    DUAL_TEST
  {
    VAR narrow record#(@wide FALSE);
    VAR wide record#(@wide TRUE);
    narrow.small := 3;
    wide.large := 19;
    TEST_ASSERT(narrow.small == 3);
    TEST_ASSERT(wide.large == 19);
    TEST_ASSERT(narrow.kind() == 1);
    TEST_ASSERT(wide.kind() == 8);
    TEST_ASSERT(SAME_TYPES(record#(@wide FALSE)::element, BYTE));
    TEST_ASSERT(SAME_TYPES(record#(@wide TRUE)::element, U64));
  }

  DOC <$ Excluded fields contribute neither size nor alignment to either instantiation. $>
  ::template_conditional_layout INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
    DUAL_TEST
  {
    TEST_ASSERT(SIZEOF(record#(@wide FALSE)) == 1);
    TEST_ASSERT(SIZEOF(record#(@wide TRUE)) == 8);
    TEST_ASSERT(ALIGNOF(record#(@wide FALSE)) == ALIGNOF(BYTE));
    TEST_ASSERT(ALIGNOF(record#(@wide TRUE)) == ALIGNOF(U64));
  }

  DOC <$ This inactive namespace must not contribute its declaration to lookup. $>
  ::branch INCLUDE_IF(disabled)
    NAMESPACE { ::number STATIC I32 := 99; }
  DOC <$ The enabled namespace supplies the selected declaration. $>
  ::branch INCLUDE_IF(enabled)
    NAMESPACE { ::number STATIC I32 := 23; }

  DOC <$ Namespace lookup resolves the enabled declaration without merging members from the disabled namespace. $>
  ::conditional_namespace_lookup
    DUAL_TEST
  {
    TEST_ASSERT(branch::number == 23);
  }
}
