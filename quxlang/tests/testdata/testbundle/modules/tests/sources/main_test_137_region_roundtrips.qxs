LANGUAGE QUXLANG EN 0.0;

::region_roundtrip_tests NAMESPACE
{
  ::single_storage_lifetimes DOC <$ Ending and reopening a region between object lifetimes preserves reusable storage and initialized values. $>
    UNIT_TEST
  {
    VAR storage ->TYPED_STORAGE(I32) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::ALLOC();
    VAR round I32 := 1;
    WHILE (round <= 3)
    {
      VAR address ADDRESS := END_ALLOC_REGION storage;
      storage := BEGIN_ALLOC_REGION address TO ->TYPED_STORAGE(I32);
      VAR object MUT->I32 := PLACE AT(storage->) I32 := round * 17;
      ASSERT(object-> == round * 17);
      object-> += 1;
      ASSERT(object-> == round * 17 + 1);
      DESTROY AT(storage->) I32;
      round++;
    }
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::DEALLOC(@PTR storage);
  }

  ::multi_storage_lifetimes DOC <$ Explicit-count and implicit-count region ends preserve both elements when reopening allocated array storage. $>
    UNIT_TEST
  {
    VAR storage =>>TYPED_STORAGE(I32) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::MULTI_ALLOC(@COUNT 2);
    VAR address ADDRESS := END_MULTI_ALLOC_REGION storage SIZE 2;
    storage := BEGIN_MULTI_ALLOC_REGION address SIZE 2 TO =>>TYPED_STORAGE(I32);
    VAR first MUT->I32 := PLACE AT(storage[0]) I32 := 23;
    VAR second MUT->I32 := PLACE AT(storage[1]) I32 := 47;
    ASSERT(first-> == 23);
    ASSERT(second-> == 47);
    DESTROY AT(storage[1]) I32;
    DESTROY AT(storage[0]) I32;
    address := END_MULTI_ALLOC_REGION storage;
    storage := BEGIN_MULTI_ALLOC_REGION address SIZE 2 TO =>>TYPED_STORAGE(I32);
    VAR restarted MUT->I32 := PLACE AT(storage[1]) I32 := 71;
    ASSERT(restarted-> == 71);
    DESTROY AT(storage[1]) I32;
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I32)::MULTI_DEALLOC(@PTR storage, @COUNT 2);
  }

  ::discover_live_interior INCLUDE_IF(OS_MACOS) DOC <$ Address escape and discovery preserve an interior pointer's identity, const view and writes to the original array. $>
    UNIT_TEST
  {
    VAR values [3]I32 :[11, 29, 53];
    VAR address ADDRESS := ADDRESS_LAUNDER_ESCAPE_ALLOC_REGION values[&1];
    VAR mutable MUT=>>I32 := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO MUT=>>I32;
    VAR readable CONST=>>I32 := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO CONST=>>I32;
    ASSERT(mutable == values[&1]);
    ASSERT(readable[0] == 29);
    mutable[0] := 71;
    ASSERT(readable[0] == 71);
    ASSERT(values[0] == 11);
    ASSERT(values[1] == 71);
    ASSERT(values[2] == 53);
  }
}
