LANGUAGE QUXLANG EN 0.0;
IMPORT std;

DOC <$ Selects one of two declarations and can be overridden by the target configuration. $>
::audit_option_enabled
  OPTION BOOL DEFAULT_VALUE(FALSE);

DOC <$ Supplies a string value from a default or target override. $>
::audit_option_text
  OPTION STRING DEFAULT_VALUE("default text");

::option_selection_tests NAMESPACE
{
  DOC <$ Computes a numeric constant from the configured module option. $>
  ::derived
    STATIC SZ := option_num + 2;
  DOC <$ Computes a Boolean constant from the configured numeric value. $>
  ::configured
    STATIC BOOL := option_num == 5;

  DOC <$ Selects the type associated with the configured value. $>
  ::element INCLUDE_IF(configured)
    ALIAS I32;
  DOC <$ Selects a different type when the default is not overridden. $>
  ::element INCLUDE_IF(configured == FALSE)
    ALIAS I64;

  DOC <$ Supplies the enabled declaration. $>
  ::selected INCLUDE_IF(audit_option_enabled)
    FUNCTION(): I32 { RETURN 31; }
  DOC <$ Supplies the disabled declaration. $>
  ::selected INCLUDE_IF(audit_option_enabled == FALSE)
    FUNCTION(): I32 { RETURN 47; }

  DOC <$ Configured numeric options propagate into dependent constants, aliases and array extents. $>
  ::configured_numeric_dependencies
    DUAL_TEST
  {
    TEST_ASSERT(option_num == 5);
    TEST_ASSERT(derived == 7);
    TEST_ASSERT(configured);
    TEST_ASSERT(SAME_TYPES(element, I32));
    TEST_ASSERT(SAME_TYPES([option_num]element, [5]I32));
    VAR values [derived]I32;
    values[6] := 19;
    TEST_ASSERT(values[6] == 19);
  }

  DOC <$ Uses the configured numeric value to form a Boolean option default. $>
  ::dependent_default
    OPTION BOOL DEFAULT_VALUE(option_num == 5);

  DOC <$ An option default can be a constant expression with the declared result kind. $>
  ::expression_option_default
    DUAL_TEST
  {
    TEST_ASSERT(dependent_default);
  }

  DOC <$ A string option initializes owned text without changing its contents. $>
  ::string_option_value
    DUAL_TEST
  {
    VAR text std::string := audit_option_text;
    TEST_ASSERT(text == audit_option_text);
  }

  DOC <$ Boolean configuration selects one same-signature declaration consistently with static branching. $>
  ::boolean_declaration_selection
    DUAL_TEST
  {
    STATIC_IF (audit_option_enabled) { TEST_ASSERT(selected() == 31); }
    STATIC_ELSE { TEST_ASSERT(selected() == 47); }
  }
}
