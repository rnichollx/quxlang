LANGUAGE QUXLANG EN 0.0;

::have_x64_avx2_matches_detected_flag INCLUDE_IF(ARCH_IS_X64) UNIT_TEST
{
  ASSERT(HAVE_X64_FEATURE_AVX2 == X64_FEATURE_AVX2_ENABLED);
}

::have_x64_v1_aggregate INCLUDE_IF(ARCH_IS_X64) UNIT_TEST
{
  ASSERT(HAVE_X64_FEATURES_V1);
}

::have_foreign_cpu_attribute_is_false INCLUDE_IF(ARCH_IS_X64 == FALSE) UNIT_TEST
{
  ASSERT(HAVE_X64_FEATURE_AVX2 == FALSE);
}
