LANGUAGE QUXLANG EN 0.0;

::ibc_enum_value_tests NAMESPACE
{
  DOC <$ Declares byte-sized interoperation values in a different order from their numeric ordering. $>
  ::code
    IBC_ENUM BITS(8) [high = 255, zero DEFAULT = 0, low = 1];
  DOC <$ Permits unnamed byte representations for interoperation round trips. $>
  ::open_code
    IBC_ENUM BITS(8) [zero DEFAULT = 0, high = 255] ALLOW_UNKNOWN;
  DOC <$ Uses the implicit enum width without declaring a default value. $>
  ::default_width
    IBC_ENUM [zero = 0, one = 1, two = 2];
  DOC <$ Provides an ordinary nominal enum with the same declared values. $>
  ::ordinary
    ENUM BITS(8) [high = 255, zero DEFAULT = 0, low = 1];

  DOC <$ IBC_ENUM retains default selection, numeric ordering, byte representation and nominal distinction. $>
  ::declared_values
    DUAL_TEST
  {
    VAR value code;
    TEST_ASSERT(value == code::zero);
    TEST_ASSERT(code::zero < code::low);
    TEST_ASSERT(code::low < code::high);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value code::zero) == 0);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value code::low) == 1);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value code::high) == 255);
    TEST_ASSERT(SAME_TYPES(code, ordinary) == FALSE);
    TEST_ASSERT(SAME_TYPES(code, U8) == FALSE);
    VAR implicit_width default_width := default_width::zero;
    TEST_ASSERT(implicit_width == default_width::zero);
    implicit_width := default_width::two;
    TEST_ASSERT(implicit_width > default_width::one);
  }

  DOC <$ Every byte representation survives IBC_ENUM deserialization and serialization when unknown values are allowed. $>
  ::unknown_representations
    DUAL_TEST
  {
    VAR raw U16 := 0;
    LOOP WHILE (raw < 256) DO
    {
      VAR bytes [1]BYTE;
      bytes[0] := (raw AS ASSUME U8) AS BYTE;
      VAR value open_code;
      value.DESERIALIZE(@INPUT_ITERATOR bytes[& 0]);
      TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value value) == bytes[0]);
      TEST_ASSERT((value == open_code::zero) == (raw == 0));
      TEST_ASSERT((value == open_code::high) == (raw == 255));
      raw ++;
    }
  }

  DOC <$ An IBC_ENUM without a declared default requires explicit initialization. $>
  ::missing_default
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR value default_width; }
}
