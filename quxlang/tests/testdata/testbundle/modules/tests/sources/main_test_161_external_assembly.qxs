LANGUAGE QUXLANG EN 0.0;

::external_assembly_tests INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) NAMESPACE
{
  ::c_magnitude DOC <$ Branches to the C symbol spelling of the system integer absolute-value function. $>
    ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@value I32; RETURN I32)
  {
    B EXTERNAL("C", "abs")
  }

  ::linker_magnitude DOC <$ Branches to the explicit Mach-O linker spelling of the same system function. $>
    ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@value I32; RETURN I32)
  {
    B EXTERNAL("LINKER", "_abs")
  }

  ::external_symbol_spellings DOC <$ C and raw linker operands reach the same declared external function and preserve scalar call results. $>
    UNIT_TEST KNOWN_BROKEN
  {
    ASSERT(optional_external_tests::magnitude(@value 0 - 17) == 17);
    ASSERT(c_magnitude(@value 0 - 37) == 37);
    ASSERT(linker_magnitude(@value 0 - 53) == 53);
    ASSERT(c_magnitude(@value 19) == 19);
    ASSERT(linker_magnitude(@value 0) == 0);
  }
}
