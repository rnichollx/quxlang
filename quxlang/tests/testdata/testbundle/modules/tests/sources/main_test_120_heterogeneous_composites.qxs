LANGUAGE QUXLANG EN 0.0;
IMPORT std;

::heterogeneous_composite_tests NAMESPACE
{
  DOC <$ Mutates named string and array references while consuming scalar arguments by value. $>
  ::update
    FUNCTION(@text MUT& std::string, @numbers MUT& [2]I32, @amount I32, @enabled BOOL): I32
  {
    TEST_ASSERT(enabled);
    text.push_back(90);
    numbers[0] += amount;
    numbers[1] += amount * 2;
    RETURN numbers[0] + numbers[1];
  }

  DOC <$ Splitting and rejoining heterogeneous references preserves named binding, mutability and storage identity. $>
  ::partition_join_apply
    DUAL_TEST
  {
    VAR numbers [2]I32;
    numbers[0] := 3;
    numbers[1] := 7;
    AUTO arguments := :{ .text = std::string(@OTHER "xy"); .numbers = numbers; .amount = 5 AS I32; .enabled = TRUE; };
    AUTO parts := COMPOSITE_SPLIT(COMPOSITE_TIE(arguments), "text", "numbers");
    TEST_ASSERT(COMPOSITE_FIELD_COUNT(TYPEOF(parts.selected)) == 2);
    TEST_ASSERT(COMPOSITE_FIELD_COUNT(TYPEOF(parts.remainder)) == 2);
    AUTO joined := COMPOSITE_JOIN(parts.remainder, parts.selected);
    TEST_ASSERT(joined.text<- == arguments.text<-);
    TEST_ASSERT(joined.numbers<- == numbers<-);
    TEST_ASSERT(SAME_TYPES(COMPOSITE_FIELD_TYPE(DECLTYPE(joined), "text"), MUT& std::string));
    TEST_ASSERT(SAME_TYPES(COMPOSITE_FIELD_TYPE(DECLTYPE(joined), "numbers"), MUT& [2]I32));
    TEST_ASSERT((APPLY COMPOSITE_FORWARD(joined) TO update) == 25);
    TEST_ASSERT(arguments.text == "xyZ");
    TEST_ASSERT(numbers[0] == 8);
    TEST_ASSERT(numbers[1] == 17);
    parts.remainder.amount := 2;
    TEST_ASSERT(arguments.amount == 2);
    TEST_ASSERT((APPLY COMPOSITE_TIE(arguments) TO update) == 31);
    TEST_ASSERT(arguments.text == "xyZZ");
    TEST_ASSERT(numbers[0] == 10);
    TEST_ASSERT(numbers[1] == 21);
  }

  DOC <$ Selected owned fields are copied while borrowed fields retain their external referents. $>
  ::selected_owned_fields
    DUAL_TEST
  {
    VAR number I32 := 11;
    AUTO original := :{ .text = std::string(@OTHER "source"); .amount = 7 AS I32; .borrowed = number; };
    AUTO selected := COMPOSITE_SELECT(original, "borrowed", "text");
    TEST_ASSERT(COMPOSITE_FIELD_COUNT(DECLTYPE(selected)) == 2);
    TEST_ASSERT(COMPOSITE_CONTAINS(DECLTYPE(selected), "amount") == FALSE);
    selected.text.push_back(65);
    selected.borrowed := 29;
    TEST_ASSERT(selected.text == "sourceA");
    TEST_ASSERT(original.text == "source");
    TEST_ASSERT(number == 29);
    TEST_ASSERT(original.borrowed == 29);
    TEST_ASSERT(selected.borrowed<- == number<-);
    original.text.push_back(66);
    TEST_ASSERT(original.text == "sourceB");
    TEST_ASSERT(selected.text == "sourceA");
    TEST_ASSERT(original.amount == 7);
  }
}
