LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::initguard_wait_tests INCLUDE_IF(OS_MACOS || OS_LINUX || OS_WINDOWS) NAMESPACE
{
  DOC <$ Counts workers about to access the shared global. $>
  ::completion_ready
    VAR ATOMIC#I32;
  DOC <$ Counts calls to the shared global's initializer. $>
  ::completion_attempts
    VAR ATOMIC#I32;
  DOC <$ Holds initialization until all three contenders arrive. $>
  ::initialize_shared
    FUNCTION(): I32
  {
    completion_attempts.FETCH_ADD#ATOMIC_RELAXED(1);
    LOOP WHILE (completion_ready.LOAD#ATOMIC_ACQUIRE() != 3) DO { }
    RETURN 42;
  }
  DOC <$ Publishes the initialized value to every waiting reader. $>
  ::shared_value
    VAR I32 := initialize_shared();

  DOC <$ Three contending readers observe one completed initialization. $>
  ::completion_wakes_all
    UNIT_TEST
  {
    AUTO action := -<
    {
      completion_ready.FETCH_ADD#ATOMIC_ACQREL(1);
      TEST_ASSERT(shared_value == 42);
    };
    VAR first std::thread := std::thread(action);
    VAR second std::thread := std::thread(action);
    VAR third std::thread := std::thread(action);
    first.join();
    second.join();
    third.join();
    TEST_ASSERT(shared_value == 42);
    TEST_ASSERT(completion_attempts.LOAD#ATOMIC_RELAXED() == 1);
  }

  DOC <$ Counts workers about to contend for the retrying global. $>
  ::retry_ready
    VAR ATOMIC#I32;
  DOC <$ Counts initialization attempts across abort and completion. $>
  ::retry_attempts
    VAR ATOMIC#I32;
  DOC <$ Counts workers receiving the first initialization failure. $>
  ::retry_caught
    VAR ATOMIC#I32;
  DOC <$ Throws once with readers contending and then initializes successfully. $>
  ::initialize_retry
    FUNCTION(): I32
  {
    VAR attempt I32 := retry_attempts.FETCH_ADD#ATOMIC_RELAXED(1);
    IF (attempt == 0)
    {
      LOOP WHILE (retry_ready.LOAD#ATOMIC_ACQUIRE() != 3) DO { }
      THROW 17 AS I32;
    }
    RETURN 73;
  }
  DOC <$ Retries its initializer after the first attempt aborts. $>
  ::retry_value
    VAR I32 := initialize_retry();

  DOC <$ An aborted initialization wakes contenders and exactly one completes the retry. $>
  ::abort_allows_retry
    UNIT_TEST
  {
    AUTO action := -<
    {
      retry_ready.FETCH_ADD#ATOMIC_ACQREL(1);
      TRY { TEST_ASSERT(retry_value == 73); }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == 17);
        retry_caught.FETCH_ADD#ATOMIC_RELAXED(1);
      }
    };
    VAR first std::thread := std::thread(action);
    VAR second std::thread := std::thread(action);
    VAR third std::thread := std::thread(action);
    first.join();
    second.join();
    third.join();
    TEST_ASSERT(retry_value == 73);
    TEST_ASSERT(retry_attempts.LOAD#ATOMIC_RELAXED() == 2);
    TEST_ASSERT(retry_caught.LOAD#ATOMIC_RELAXED() == 1);
  }
}
