LANGUAGE QUXLANG EN 0.0;

::macos_aggregate_return_tests INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) NAMESPACE
{
  DOC <$ Matches the macOS div_t field order and integer widths. $>
  ::division32
    IBC_STRUCT TRIVIALLY_RELOCATABLE
  {
    .quotient VAR I32;
    .remainder VAR I32;
  }
  DOC <$ Matches the macOS lldiv_t field order and long-long widths. $>
  ::division64
    IBC_STRUCT TRIVIALLY_RELOCATABLE
  {
    .quotient VAR I64;
    .remainder VAR I64;
  }
  DOC <$ Returns the system quotient/remainder pair in a C aggregate. $>
  ::divide32
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"div"]
    CALLABLE CALLCONV CCALL(@numerator I32, @denominator I32; RETURN division32);
  DOC <$ Returns a two-register system quotient/remainder aggregate. $>
  ::divide64
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"lldiv"]
    CALLABLE CALLCONV CCALL(@numerator I64, @denominator I64; RETURN division64);

  DOC <$ Both halves of an eight-byte C aggregate survive positive and negative quotient/remainder returns. $>
  ::packed_integer_return
    UNIT_TEST
  {
    TEST_ASSERT(SIZEOF(division32) == 8);
    VAR positive division32 := divide32(@denominator 7, @numerator 100);
    TEST_ASSERT(positive.quotient == 14);
    TEST_ASSERT(positive.remainder == 2);
    VAR negative division32 := divide32(@numerator 0 - 100, @denominator 7);
    TEST_ASSERT(negative.quotient == 0 - 14);
    TEST_ASSERT(negative.remainder == 0 - 2);
    TEST_ASSERT(positive.quotient == 14);
    TEST_ASSERT(positive.remainder == 2);
    VAR negative_denominator division32 := divide32(@denominator 0 - 7, @numerator 100);
    TEST_ASSERT(negative_denominator.quotient == 0 - 14);
    TEST_ASSERT(negative_denominator.remainder == 2);
  }

  DOC <$ A sixteen-byte C aggregate preserves full-width quotient and remainder values in both returned registers. $>
  ::two_register_return
    UNIT_TEST
  {
    TEST_ASSERT(SIZEOF(division64) == 16);
    VAR numerator I64 := (1073741825 AS I64) * 4294967296 + 17;
    VAR positive division64 := divide64(@numerator numerator, @denominator 1073741825);
    TEST_ASSERT(positive.quotient == 4294967296);
    TEST_ASSERT(positive.remainder == 17);
    VAR negative division64 := divide64(@numerator 0 - numerator, @denominator 1073741825);
    TEST_ASSERT(negative.quotient == 0 - 4294967296);
    TEST_ASSERT(negative.remainder == 0 - 17);
    VAR wide_remainder division64 := divide64(@numerator 30064771092, @denominator 8589934593);
    TEST_ASSERT(wide_remainder.quotient == 3);
    TEST_ASSERT(wide_remainder.remainder == 4294967313);
    TEST_ASSERT(positive.quotient == 4294967296);
    TEST_ASSERT(positive.remainder == 17);
  }

  DOC <$ Exposes a eight-byte trivially relocatable integer wrapper. $>
  ::signed_value
    IBC_STRUCT TRIVIALLY_RELOCATABLE { .value VAR I64; }
  DOC <$ Passes and returns the integer wrapper through the system C ABI. $>
  ::absolute
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"labs"]
    CALLABLE CALLCONV CCALL(@value signed_value; RETURN signed_value);
  DOC <$ A user struct crosses an external parameter and return boundary in an integer register. $>
  ::integer_wrapper_argument
    UNIT_TEST
  {
    VAR input signed_value;
    input.value := 0 - 37;
    VAR output signed_value := absolute(@value input);
    TEST_ASSERT(output.value == 37);
    TEST_ASSERT(input.value == 0 - 37);
  }

}
