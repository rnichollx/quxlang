LANGUAGE QUXLANG EN 0.0;

::arithmetic_boundary_tests NAMESPACE
{
  ::signed_endpoints DOC <$ Signed extrema support representable neighboring operations and exact minimum division without overflow. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@maximum T)
  {
    VAR zero T := 0;
    VAR one T := 1;
    VAR two T := 2;
    VAR minimum T := zero - maximum - one;
    TEST_ASSERT(minimum / one == minimum);
    VAR half T := minimum / two;
    TEST_ASSERT(half * two == minimum);
    VAR value T := minimum;
    value /= two;
    TEST_ASSERT(value == half);
    value *= two;
    TEST_ASSERT(value == minimum);
    value += one;
    TEST_ASSERT(value == zero - maximum);
    value -= one;
    TEST_ASSERT(value == minimum);
    value := maximum;
    value -= one;
    value += one;
    TEST_ASSERT(value == maximum);
    TEST_ASSERT(maximum % two == one);
    TEST_ASSERT((maximum / two) * two == maximum - one);
  }

  ::unsigned_endpoints DOC <$ Unsigned maximum division and reconstruction retain the high bit without intermediate overflow. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@maximum T)
  {
    VAR one T := 1;
    VAR two T := 2;
    VAR half T := maximum / two;
    TEST_ASSERT(maximum % two == one);
    TEST_ASSERT(half * two + one == maximum);
    VAR value T := maximum;
    value /= two;
    TEST_ASSERT(value == half);
    value *= two;
    value += one;
    TEST_ASSERT(value == maximum);
    value %= two;
    TEST_ASSERT(value == one);
    value := maximum;
    value -= one;
    value += one;
    TEST_ASSERT(value == maximum);
  }

  ::signed_widths DOC <$ Standard and non-byte signed widths exercise both representable endpoints. $>
    DUAL_TEST
  {
    signed_endpoints#(I5)(@maximum 15);
    signed_endpoints#(I8)(@maximum 127);
    signed_endpoints#(I12)(@maximum 2047);
    signed_endpoints#(I16)(@maximum 32767);
    signed_endpoints#(I32)(@maximum 2147483647);
    signed_endpoints#(I64)(@maximum 9223372036854775807);
  }

  ::unsigned_widths DOC <$ Standard and non-byte unsigned widths preserve their maximum through compound arithmetic. $>
    DUAL_TEST
  {
    unsigned_endpoints#(U5)(@maximum 31);
    unsigned_endpoints#(U8)(@maximum 255);
    unsigned_endpoints#(U12)(@maximum 4095);
    unsigned_endpoints#(U16)(@maximum 65535);
    unsigned_endpoints#(U32)(@maximum 4294967295);
    unsigned_endpoints#(U64)(@maximum 18446744073709551615);
  }
  ::minimum_remainder DOC <$ An even signed minimum has zero remainder on division by two. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION(@maximum T)
  {
    VAR minimum T := (0 AS T) - maximum - 1;
    TEST_ASSERT((minimum % 2) == 0);
  }

  ::signed_minimum_remainder DOC <$ Signed minimum remainder is zero across standard and non-byte widths. $>
    DUAL_TEST
  {
    minimum_remainder#(I5)(@maximum 15);
    minimum_remainder#(I8)(@maximum 127);
    minimum_remainder#(I12)(@maximum 2047);
    minimum_remainder#(I16)(@maximum 32767);
    minimum_remainder#(I32)(@maximum 2147483647);
    minimum_remainder#(I64)(@maximum 9223372036854775807);
  }
}
