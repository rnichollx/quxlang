LANGUAGE QUXLANG EN 0.0;

::member_template_binding_tests NAMESPACE
{
  DOC <$ Stores receiver state observed by explicitly and implicitly generic methods. $>
  ::receiver STRUCT
  {
    .calls VAR I32;
    DOC <$ Uses a named type-template argument while mutating the receiver. $>
    .explicit_value
      TEMPLATE(@T:element_type TYPE)
      FUNCTION(@value element_type): element_type
    { .calls++; RETURN value; }
    DOC <$ Deduces the argument type while retaining receiver identity. $>
    .deduced_value
      FUNCTION(@value DECAY(element_type)): element_type
    { .calls++; RETURN value; }
  }

  DOC <$ Ordinary named template arguments preserve the member receiver across distinct instantiations. $>
  ::explicit_named_type
    DUAL_TEST
  {
    VAR object receiver;
    TEST_ASSERT(object.explicit_value#(@T I32)(@value 17) == 17);
    TEST_ASSERT(object.explicit_value#(@T I64)(@value 4294967313) == 4294967313);
    TEST_ASSERT(object.calls == 2);
  }

  DOC <$ Implicit generic member calls deduce distinct scalar types without copying the receiver. $>
  ::deduced_type
    DUAL_TEST
  {
    VAR object receiver;
    AUTO first := object.deduced_value(@value 17 AS I32);
    AUTO second := object.deduced_value(@value 4294967313 AS I64);
    TEST_ASSERT(SAME_TYPES(DECLTYPE(first), I32));
    TEST_ASSERT(SAME_TYPES(DECLTYPE(second), I64));
    TEST_ASSERT(first == 17);
    TEST_ASSERT(second == 4294967313);
    TEST_ASSERT(object.calls == 2);
  }
}
