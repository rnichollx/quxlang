LANGUAGE QUXLANG EN 0.0;

::pointer_incdec_tests NAMESPACE
{
  ::walk DOC <$ Postfix pointer results retain the previous position while each mutation advances exactly one element, including the one-past endpoint. $>
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    VAR values [4]T;
    values[0] := 2;
    values[1] := 4;
    values[2] := 6;
    values[3] := 8;
    VAR first =>>T := values[& 0];
    VAR end =>>T := first + 4;
    VAR cursor =>>T := first;
    VAR index SZ := 0;
    VAR expected T := 3;
    LOOP WHILE (index < 4) DO
    {
      VAR old =>>T := cursor++;
      TEST_ASSERT(old == values[& index]);
      TEST_ASSERT(old-> == values[index]);
      old-> += 1;
      TEST_ASSERT(values[index] == expected);
      expected += 2;
      index++;
      TEST_ASSERT(cursor == first + index);
    }
    TEST_ASSERT(cursor == end);
    index := 4;
    LOOP WHILE (index > 0) DO
    {
      VAR old =>>T := cursor--;
      TEST_ASSERT(old == first + index);
      index--;
      TEST_ASSERT(cursor == values[& index]);
      TEST_ASSERT(cursor-> == values[index]);
    }
    TEST_ASSERT(cursor == first);
    TEST_ASSERT(values[0] == 3);
    TEST_ASSERT(values[1] == 5);
    TEST_ASSERT(values[2] == 7);
    TEST_ASSERT(values[3] == 9);
  }

  ::element_width_boundaries DOC <$ One-, four-, and eight-byte pointees exercise forward and reverse postfix results without dereferencing the endpoint. $>
    DUAL_TEST
  {
    walk#(U8)();
    walk#(I32)();
    walk#(U64)();
  }
}
