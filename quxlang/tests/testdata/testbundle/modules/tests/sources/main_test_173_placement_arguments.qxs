LANGUAGE QUXLANG EN 0.0;

::placement_argument_tests NAMESPACE
{
  DOC <$ Records completed construction and explicit destruction in the shared evaluation sequence. $>
  ::record
    STRUCT
  {
    .events VAR MUT->I32;
    .value VAR I32;
    DOC <$ Initializes the value after all call arguments have been evaluated. $>
    .CONSTRUCTOR
      FUNCTION(@value I32, @events MUT& I32)
    {
      .events := events<-;
      .value := value;
      events := events * 10 + 3;
    }
    DOC <$ Records destruction of a successfully constructed object. $>
    .DESTRUCTOR
      FUNCTION() { .events-> := .events-> * 10 + 4; }
  }

  DOC <$ Records destination evaluation and returns the original storage reference. $>
  ::destination
    FUNCTION(@slot MUT& TYPED_STORAGE(record), @events MUT& I32): MUT& TYPED_STORAGE(record)
  {
    events := events * 10 + 1;
    RETURN slot;
  }

  DOC <$ Records an argument evaluation and optionally throws before construction begins. $>
  ::argument
    FUNCTION(@events MUT& I32, @fail BOOL): I32
  {
    events := events * 10 + 2;
    IF (fail) { THROW I32(@OTHER 42); }
    RETURN 17;
  }

  DOC <$ Placement expressions evaluate the destination once before named arguments and retain the object until explicit destruction. $>
  ::expression_order
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    VAR slot TYPED_STORAGE(record);
    VAR placed ->record := PLACE AT(destination(@slot slot, @events events)) record
      :(@value argument(@events events, @fail FALSE), @events events);
    TEST_ASSERT(events == 123);
    TEST_ASSERT(placed->.value == 17);
    DESTROY AT(destination(@slot slot, @events events)) record;
    TEST_ASSERT(events == 12314);
  }

  DOC <$ A throwing placement argument leaves storage reusable without constructing or destroying the target object. $>
  ::statement_argument_failure
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    VAR slot TYPED_STORAGE(record);
    VAR caught BOOL := FALSE;
    TRY
    {
      PLACE AT(destination(@slot slot, @events events)) record
        :(@value argument(@events events, @fail TRUE), @events events);
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 42);
      TEST_ASSERT(events == 12);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    events := 0;
    PLACE AT(destination(@slot slot, @events events)) record
      :(@value argument(@events events, @fail FALSE), @events events);
    TEST_ASSERT(events == 123);
    DESTROY AT(slot) record;
    TEST_ASSERT(events == 1234);
  }
}
