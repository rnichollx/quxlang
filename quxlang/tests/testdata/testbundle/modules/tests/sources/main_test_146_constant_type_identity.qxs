LANGUAGE QUXLANG EN 0.0;

::constant_type_identity_tests NAMESPACE
{
  DOC <$ Names the same type as CSTRING_CONSTANT. $>
  ::cstring_alias
    ALIAS CSTRING_CONSTANT;
  DOC <$ Names the same type as DATA_CONSTANT. $>
  ::data_alias
    ALIAS DATA_CONSTANT;

  DOC <$ Identifies a pointer to a C string constant without dereferencing it. $>
  ::kind
    FUNCTION(@value CONST->CSTRING_CONSTANT): I32 { TEST_ASSERT(value?? == FALSE); RETURN 1; }
  DOC <$ Identifies a pointer to a data constant without dereferencing it. $>
  ::kind
    FUNCTION(@value CONST->DATA_CONSTANT): I32 { TEST_ASSERT(value?? == FALSE); RETURN 2; }
  DOC <$ Identifies a pointer to a string constant without dereferencing it. $>
  ::kind
    FUNCTION(@value CONST->STRING_CONSTANT): I32 { TEST_ASSERT(value?? == FALSE); RETURN 3; }
  DOC <$ Identifies a pointer to a numeric constant without dereferencing it. $>
  ::kind
    FUNCTION(@value CONST->NUMERIC_CONSTANT): I32 { TEST_ASSERT(value?? == FALSE); RETURN 4; }

  DOC <$ Constant families remain distinct in type queries and overload selection while aliases preserve canonical identity. $>
  ::nominal_identity_and_aliases
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(CSTRING_CONSTANT, cstring_alias));
    TEST_ASSERT(SAME_TYPES(DATA_CONSTANT, data_alias));
    TEST_ASSERT(SAME_TYPES(CSTRING_CONSTANT, DATA_CONSTANT) == FALSE);
    TEST_ASSERT(SAME_TYPES(CSTRING_CONSTANT, STRING_CONSTANT) == FALSE);
    TEST_ASSERT(SAME_TYPES(CSTRING_CONSTANT, NUMERIC_CONSTANT) == FALSE);
    TEST_ASSERT(SAME_TYPES(DATA_CONSTANT, STRING_CONSTANT) == FALSE);
    TEST_ASSERT(SAME_TYPES(DATA_CONSTANT, NUMERIC_CONSTANT) == FALSE);
    VAR cstring_pointer CONST->CSTRING_CONSTANT;
    VAR data_pointer CONST->DATA_CONSTANT;
    VAR string_pointer CONST->STRING_CONSTANT;
    VAR numeric_pointer CONST->NUMERIC_CONSTANT;
    VAR aliased_cstring CONST->cstring_alias := cstring_pointer;
    VAR aliased_data CONST->data_alias := data_pointer;
    TEST_ASSERT(kind(@value cstring_pointer) == 1);
    TEST_ASSERT(kind(@value data_pointer) == 2);
    TEST_ASSERT(kind(@value string_pointer) == 3);
    TEST_ASSERT(kind(@value numeric_pointer) == 4);
    TEST_ASSERT(kind(@value aliased_cstring) == 1);
    TEST_ASSERT(kind(@value aliased_data) == 2);
  }
}
