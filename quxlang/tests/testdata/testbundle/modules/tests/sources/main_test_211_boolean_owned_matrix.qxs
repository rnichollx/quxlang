        expected_order[1] := 1; expected_value[1] := TRUE;
        expected_order[2] := 1; expected_value[2] := TRUE;
        expected_order[3] := 1; expected_value[3] := TRUE;
        expected_order[4] := 126; expected_value[4] := TRUE;
        expected_order[5] := 126; expected_value[5] := TRUE;
        expected_order[6] := 12637; expected_value[6] := TRUE;
        expected_order[7] := 12637; expected_value[7] := FALSE;
        VAR events I32 := 0;
        VAR alive I32 := 0;
        VAR result BOOL := short_circuit_tests::record(@events events, @digit 1, @value a) && short_circuit_tests::temporary(@events events, @alive alive, @digit 2).test(@value b) &! short_circuit_tests::temporary(@events events, @alive alive, @digit 3).test(@value c);
        ASSERT(result == expected_value[index]);
        ASSERT(events == expected_order[index]);
        ASSERT(alive == 0);
      }
      index ++;
    }
  }

