LANGUAGE QUXLANG EN 0.0;

::boolean_owned_matrix_tests NAMESPACE
{
  ::and_then_and DOC <$ Owned right operands in && followed by && preserve selected evaluation, immediate short-circuit cleanup and reverse remaining cleanup for all truth inputs. $>
    DUAL_TEST
  {
    VAR index SZ := 0;
    WHILE (index < 8)
    {
      VAR a BOOL := index >= 4;
      VAR b BOOL := (index % 4) >= 2;
      VAR c BOOL := (index % 2) == 1;
      {
        VAR expected_order [8]I32;
        VAR expected_value [8]BOOL;
        expected_order[0] := 1; expected_value[0] := FALSE;
        expected_order[1] := 1; expected_value[1] := FALSE;
        expected_order[2] := 1; expected_value[2] := FALSE;
        expected_order[3] := 1; expected_value[3] := FALSE;
        expected_order[4] := 126; expected_value[4] := FALSE;
        expected_order[5] := 126; expected_value[5] := FALSE;
        expected_order[6] := 12637; expected_value[6] := FALSE;
        expected_order[7] := 12637; expected_value[7] := TRUE;
        VAR events I32 := 0;
        VAR alive I32 := 0;
        VAR result BOOL := short_circuit_tests::record(@events events, @digit 1, @value a) && short_circuit_tests::temporary(@events events, @alive alive, @digit 2).test(@value b) && short_circuit_tests::temporary(@events events, @alive alive, @digit 3).test(@value c);
        ASSERT(result == expected_value[index]);
        ASSERT(events == expected_order[index]);
        ASSERT(alive == 0);
      }
      index ++;
    }
  }

  ::and_then_nand DOC <$ Owned right operands in && followed by &! preserve selected evaluation, immediate short-circuit cleanup and reverse remaining cleanup for all truth inputs. $>
