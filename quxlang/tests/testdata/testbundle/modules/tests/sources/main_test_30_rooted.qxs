LANGUAGE QUXLANG EN 0.0;


DOC <$ Stores mutable state at a stable object address. $>
::rooted_value
  STRUCT ROOTED
{
  .value VAR I32;

  DOC <$ Initializes the stored value without relocating another rooted object. $>
  .CONSTRUCTOR
    FUNCTION(@value I32)
  {
    .value := value;
  }
}


DOC <$ Mutates a rooted object through a reference. $>
::set_rooted_value
  FUNCTION(@object MUT& rooted_value, @value I32)
{
  object.value := value;
}


DOC <$ Reads a rooted object through a constant reference. $>
::read_rooted_value
  FUNCTION(@object CONST& rooted_value): I32
{
  RETURN object.value;
}


::rooted_reference_access_test DUAL_TEST
{
  VAR object rooted_value :(@value 7);
  set_rooted_value(@object object, @value 11);
  TEST_ASSERT(read_rooted_value(@object object) == 11);
}


::rooted_copy_construction_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_value :(@value 13);
  VAR copied rooted_value := source;
}


::rooted_move_construction_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_value :(@value 17);
  VAR moved rooted_value := MOVE(source);
}


::rooted_assignment_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR destination rooted_value :(@value 19);
  destination := rooted_value(@value 23);
}


::rooted_swap_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR left rooted_value :(@value 29);
  VAR right rooted_value :(@value 31);
  left <-> right;
}


DOC <$ Provides a by-value call surface used to verify copy rejection. $>
::accept_rooted_value
  FUNCTION(@object rooted_value): I32
{
  RETURN object.value;
}


::rooted_by_value_argument_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR object rooted_value :(@value 37);
  VAR result I32 := accept_rooted_value(@object object);
}


DOC <$ Provides a named-local return path used to verify move rejection. $>
::return_named_rooted_value
  FUNCTION(): rooted_value
{
  VAR object rooted_value :(@value 41);
  RETURN MOVE(object);
}


::rooted_named_return_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR object rooted_value := return_named_rooted_value();
}


DOC <$ Stores a rooted object inline. $>
::rooted_wrapper
  STRUCT
{
  .object VAR rooted_value;
}


::rooted_wrapper_move_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_wrapper;
  VAR moved rooted_wrapper := MOVE(source);
}


::rooted_wrapper_swap_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR left rooted_wrapper;
  VAR right rooted_wrapper;
  left <-> right;
}


DOC <$ Preserves ROOTED lifecycle constraints through template instantiation. $>
::rooted_template
  TEMPLATE(@T TYPE AUTO) STRUCT ROOTED
{
  .value VAR T;
}


::rooted_template_move_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_template#(I32);
  VAR moved rooted_template#(I32) := MOVE(source);
}


DOC <$ Declares a forbidden copy constructor for validation. $>
::rooted_with_copy_constructor
  STRUCT ROOTED
{
  .value VAR I32;

  .CONSTRUCTOR FUNCTION(@OTHER CONST& rooted_with_copy_constructor)
  {
    .value := OTHER.value;
  }
}


::rooted_user_copy_constructor_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_with_copy_constructor;
  VAR copied rooted_with_copy_constructor := source;
}


DOC <$ Declares a forbidden move constructor for validation. $>
::rooted_with_move_constructor
  STRUCT ROOTED
{
  .value VAR I32;

  .CONSTRUCTOR FUNCTION(@OTHER TEMP& rooted_with_move_constructor)
  {
    .value := OTHER.value;
  }
}


::rooted_user_move_constructor_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR source rooted_with_move_constructor;
  VAR moved rooted_with_move_constructor := MOVE(source);
}


DOC <$ Declares a forbidden swap operator for validation. $>
::rooted_with_swap_operator
  STRUCT ROOTED
{
  .value VAR I32;

  .OPERATOR<-> FUNCTION(@OTHER MUT& rooted_with_swap_operator)
  {
    .value <-> OTHER.value;
  }
}


::rooted_user_swap_operator_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR left rooted_with_swap_operator;
  VAR right rooted_with_swap_operator;
  left <-> right;
}


DOC <$ Declares a forbidden reverse swap operator for validation. $>
::rooted_with_rhs_swap_operator
  STRUCT ROOTED
{
  .value VAR I32;

  .OPERATOR<->RHS FUNCTION(@OTHER MUT& rooted_with_rhs_swap_operator)
  {
    .value <-> OTHER.value;
  }
}


::rooted_user_rhs_swap_operator_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR left rooted_with_rhs_swap_operator;
  VAR right rooted_with_rhs_swap_operator;
  left <-> right;
}
