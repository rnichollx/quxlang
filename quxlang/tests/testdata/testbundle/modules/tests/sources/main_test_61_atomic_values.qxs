LANGUAGE QUXLANG EN 0.0;

::atomic_value_tests NAMESPACE
{
  DOC <$ Atomic integers do not support the swap operator. $>
  ::integer_swap_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    left <-> right;
  }

  DOC <$ Atomic booleans do not support the swap operator. $>
  ::boolean_swap_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#BOOL;
    VAR right ATOMIC#BOOL;
    left <-> right;
  }

  DOC <$ Atomic pointers do not support the swap operator. $>
  ::pointer_swap_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#(MUT->I32);
    VAR right ATOMIC#(MUT->I32);
    left <-> right;
  }

  DOC <$ Atomic values require named member operations for assignment. $>
  ::assignment_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    left := right;
  }

  DOC <$ Atomic values require named member operations for value assignment. $>
  ::value_assignment_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    left := 7;
  }

  DOC <$ Atomic values require named member operations for compound assignment. $>
  ::compound_assignment_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    left += 7;
  }

  DOC <$ Atomic values require named member operations for increment. $>
  ::increment_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    left++;
  }

  DOC <$ Atomic values require named member operations for arithmetic. $>
  ::arithmetic_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    AUTO result := left + right;
  }

  DOC <$ Atomic values require named member operations for equality. $>
  ::equality_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    VAR result BOOL := left == right;
  }

  DOC <$ Atomic values require named member operations for comparison. $>
  ::comparison_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    AUTO result := left <=> right;
  }

  DOC <$ Atomic values require named member operations for implicit load. $>
  ::implicit_load_rejected
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR left ATOMIC#I32;
    VAR right ATOMIC#I32;
    VAR result I32 := left;
  }

  DOC <$ Each named operation preserves its fetch result and stores the expected eight-bit value. $>
  ::extended_rmw_values
    TEMPLATE(@mode TYPE AUTO) FUNCTION()
  {
    VAR value ATOMIC#U8;
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_ADD#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    value.ADD#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_SUBTRACT#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 9);
    value.STORE#NONATOMIC(12);
    value.SUBTRACT#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 9);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_MULTIPLY#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 36);
    value.STORE#NONATOMIC(12);
    value.MULTIPLY#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 36);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_DIVIDE#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 4);
    value.STORE#NONATOMIC(12);
    value.DIVIDE#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 4);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_MODULO#mode(5) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 2);
    value.STORE#NONATOMIC(12);
    value.MODULO#mode(5);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 2);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_AND#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 0);
    value.STORE#NONATOMIC(12);
    value.BIT_AND#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 0);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_OR#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    value.BIT_OR#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_XOR#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    value.BIT_XOR#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_NAND#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 255);
    value.STORE#NONATOMIC(12);
    value.BIT_NAND#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 255);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_NOR#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 240);
    value.STORE#NONATOMIC(12);
    value.BIT_NOR#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 240);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_NXOR#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 240);
    value.STORE#NONATOMIC(12);
    value.BIT_NXOR#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 240);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_IMPLIES#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 243);
    value.STORE#NONATOMIC(12);
    value.BIT_IMPLIES#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 243);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_IMPLIED#mode(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 252);
    value.STORE#NONATOMIC(12);
    value.BIT_IMPLIED#mode(3);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 252);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_SHIFT_UP#mode(2) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 48);
    value.STORE#NONATOMIC(12);
    value.BIT_SHIFT_UP#mode(2);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 48);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_SHIFT_DOWN#mode(2) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 3);
    value.STORE#NONATOMIC(12);
    value.BIT_SHIFT_DOWN#mode(2);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 3);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_ROTATE_UP#mode(2) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 48);
    value.STORE#NONATOMIC(12);
    value.BIT_ROTATE_UP#mode(2);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 48);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_ROTATE_DOWN#mode(2) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 3);
    value.STORE#NONATOMIC(12);
    value.BIT_ROTATE_DOWN#mode(2);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 3);
  }

  DOC <$ Named operations agree during constant evaluation and native execution. $>
  ::extended_rmw_constant_values
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    extended_rmw_values#(@mode NONATOMIC)();
    extended_rmw_values#(@mode ATOMIC_SEQCST)();
    VAR value ATOMIC#I24;
    value.STORE#NONATOMIC(-21);
    TEST_ASSERT(value.FETCH_MULTIPLY#ATOMIC_ACQREL(3) == -21);
    TEST_ASSERT(value.FETCH_DIVIDE#ATOMIC_RELEASE(7) == -63);
    TEST_ASSERT(value.LOAD#NONATOMIC() == -9);
    value.STORE#NONATOMIC(12);
    TEST_ASSERT(value.FETCH_BIT_NOR#ATOMIC_RELAXED(3) == 12);
    TEST_ASSERT(value.LOAD#NONATOMIC() == -16);
    TEST_ASSERT(value.FETCH_BIT_SHIFT_DOWN#ATOMIC_ACQUIRE(20) == -16);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 15);
    VAR narrow ATOMIC#U8;
    narrow.STORE#NONATOMIC(200);
    TEST_ASSERT(narrow.FETCH_MULTIPLY#ATOMIC_SEQCST(3) == 200);
    TEST_ASSERT(narrow.LOAD#NONATOMIC() == 88);
    narrow.STORE#NONATOMIC(129);
    TEST_ASSERT(narrow.FETCH_BIT_ROTATE_UP#ATOMIC_SEQCST(1) == 129);
    TEST_ASSERT(narrow.FETCH_BIT_ROTATE_DOWN#ATOMIC_SEQCST(1) == 3);
    TEST_ASSERT(narrow.LOAD#NONATOMIC() == 129);
    TEST_ASSERT(narrow.FETCH_BIT_ROTATE_UP#ATOMIC_SEQCST(9) == 129);
    TEST_ASSERT(narrow.LOAD#NONATOMIC() == 3);
    TEST_ASSERT(narrow.FETCH_BIT_SHIFT_UP#ATOMIC_SEQCST(8) == 3);
    TEST_ASSERT(narrow.LOAD#NONATOMIC() == 0);
    value.STORE#NONATOMIC(1);
    TEST_ASSERT(value.FETCH_BIT_ROTATE_DOWN#ATOMIC_SEQCST(1) == 1);
    TEST_ASSERT(value.LOAD#NONATOMIC() == -8388608);
    TEST_ASSERT(value.FETCH_BIT_ROTATE_UP#ATOMIC_SEQCST(25) == -8388608);
    TEST_ASSERT(value.LOAD#NONATOMIC() == 1);
  }

  DOC <$ Named RMW operations accept every supported atomic ordering. $>
  ::extended_rmw_orderings
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    extended_rmw_values#(@mode ATOMIC_RELAXED)();
    extended_rmw_values#(@mode ATOMIC_ACQUIRE)();
    extended_rmw_values#(@mode ATOMIC_RELEASE)();
    extended_rmw_values#(@mode ATOMIC_ACQREL)();
  }

  DOC <$ Checks the previous value returned by each fetch operation and the resulting atomic state. $>
  ::rmw_values
    TEMPLATE(@T TYPE AUTO, @mode TYPE AUTO) FUNCTION()
  {
    VAR value ATOMIC#T;
    value.STORE#ATOMIC_RELEASE(7);
    TEST_ASSERT(value.EXCHANGE#mode(12) == 7);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 12);
    TEST_ASSERT(value.FETCH_ADD#mode(3) == 12);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 15);
    TEST_ASSERT(value.FETCH_SUBTRACT#mode(5) == 15);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 10);
    TEST_ASSERT(value.FETCH_BIT_AND#mode(6) == 10);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 2);
    TEST_ASSERT(value.FETCH_BIT_OR#mode(9) == 2);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 11);
    TEST_ASSERT(value.FETCH_BIT_XOR#mode(3) == 11);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 8);
    value.ADD#mode(4);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 12);
    value.SUBTRACT#mode(2);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 10);
    value.BIT_AND#mode(6);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 2);
    value.BIT_OR#mode(9);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 11);
    value.BIT_XOR#mode(3);
    TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 8);
  }

  DOC <$ Applies value assertions to every supported read-modify-write ordering mode. $>
  ::rmw_modes
    TEMPLATE(@T TYPE AUTO) FUNCTION()
  {
    rmw_values#(@T T, @mode ATOMIC_RELAXED)();
    rmw_values#(@T T, @mode ATOMIC_ACQUIRE)();
    rmw_values#(@T T, @mode ATOMIC_RELEASE)();
    rmw_values#(@T T, @mode ATOMIC_ACQREL)();
    rmw_values#(@T T, @mode ATOMIC_SEQCST)();
  }

  DOC <$ Native atomic operations preserve return and stored values for signed and unsigned 32-bit operands. $>
  ::read_modify_write_widths
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    rmw_modes#(I32)();
    rmw_modes#(U32)();
  }

  DOC <$ Atomic operations preserve return and stored values for signed and unsigned 64-bit operands. $>
  ::read_modify_write_wide_widths
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_X86 || ARCH_IS_JVM)
  {
    rmw_modes#(I64)();
    rmw_modes#(U64)();
  }

  DOC <$ Failed compare-exchange updates expected, while success preserves expected and replaces the stored value. $>
  ::compare_exchange_values
    TEMPLATE(@success TYPE AUTO, @failure TYPE AUTO) FUNCTION()
  {
    VAR value ATOMIC#I32;
    value.STORE#ATOMIC_RELAXED(17);
    VAR expected I32 := 3;
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED 29) == FALSE);
    TEST_ASSERT(expected == 17);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == 17);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@DESIRED 29, @EXPECTED expected));
    TEST_ASSERT(expected == 17);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == 29);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED 41) == FALSE);
    TEST_ASSERT(expected == 29);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == 29);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED 29));
    TEST_ASSERT(expected == 29);
  }

  DOC <$ Exercises success and failure for every supported pairing of atomic comparison orderings. $>
  ::compare_exchange_modes
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    compare_exchange_values#(@success ATOMIC_RELAXED, @failure ATOMIC_RELAXED)();
    compare_exchange_values#(@success ATOMIC_ACQUIRE, @failure ATOMIC_RELAXED)();
    compare_exchange_values#(@success ATOMIC_ACQUIRE, @failure ATOMIC_ACQUIRE)();
    compare_exchange_values#(@success ATOMIC_RELEASE, @failure ATOMIC_RELAXED)();
    compare_exchange_values#(@success ATOMIC_ACQREL, @failure ATOMIC_RELAXED)();
    compare_exchange_values#(@success ATOMIC_ACQREL, @failure ATOMIC_ACQUIRE)();
    compare_exchange_values#(@success ATOMIC_SEQCST, @failure ATOMIC_RELAXED)();
    compare_exchange_values#(@success ATOMIC_SEQCST, @failure ATOMIC_ACQUIRE)();
    compare_exchange_values#(@success ATOMIC_SEQCST, @failure ATOMIC_SEQCST)();
  }

  DOC <$ Boolean compare-exchange writes back observed false and true values and preserves expected on success. $>
  ::boolean_compare_exchange
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value ATOMIC#BOOL;
    value.STORE#ATOMIC_SEQCST(FALSE);
    VAR expected BOOL := TRUE;
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_SEQCST)(@EXPECTED expected, @DESIRED TRUE) == FALSE);
    TEST_ASSERT(expected == FALSE);
    TEST_ASSERT(value.LOAD#ATOMIC_SEQCST() == FALSE);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_SEQCST)(@EXPECTED expected, @DESIRED TRUE));
    TEST_ASSERT(expected == FALSE);
    TEST_ASSERT(value.LOAD#ATOMIC_SEQCST());
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_SEQCST)(@EXPECTED expected, @DESIRED FALSE) == FALSE);
    TEST_ASSERT(expected);
    TEST_ASSERT(value.LOAD#ATOMIC_SEQCST());
  }
  DOC <$ Exchange returns the previous value and updates integer and boolean storage during constant evaluation and native execution. $>
  ::exchange_constant_values
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value ATOMIC#I24;
    value.STORE#NONATOMIC(-7);
    TEST_ASSERT(value.EXCHANGE#NONATOMIC(29) == -7);
    TEST_ASSERT(value.EXCHANGE#ATOMIC_SEQCST(-13) == 29);
    TEST_ASSERT(value.LOAD#NONATOMIC() == -13);
    VAR flag ATOMIC#BOOL;
    flag.STORE#NONATOMIC(FALSE);
    TEST_ASSERT(flag.EXCHANGE#ATOMIC_ACQREL(TRUE) == FALSE);
    TEST_ASSERT(flag.EXCHANGE#ATOMIC_RELEASE(FALSE));
    TEST_ASSERT(flag.LOAD#NONATOMIC() == FALSE);
  }
  DOC <$ Compare-exchange rejects positional expected and desired operands. $>
  ::compare_exchange_requires_names
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR value ATOMIC#I32;
    VAR expected I32 := 0;
    value.COMPARE_EXCHANGE#(@SUCCESS NONATOMIC, @FAILURE NONATOMIC)(% [expected, 1]);
  }
}
