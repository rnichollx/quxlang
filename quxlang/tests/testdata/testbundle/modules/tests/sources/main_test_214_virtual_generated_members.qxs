LANGUAGE QUXLANG EN 0.0;

::virtual_generated_member_tests NAMESPACE
{
  DOC <$ Counts destruction of the containing virtual base. $>
  ::lifetime_counter
    STRUCT
  {
    .deaths VAR MUT->I32;
    DOC <$ Records destruction when a counter has been attached. $>
    .DESTRUCTOR
      FUNCTION()
    {
      IF (.deaths??) { .deaths-> := .deaths-> + 1; }
    }
  }

  DOC <$ Stores owned text in the shared virtual base. $>
  ::root
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .text VAR std::string;
    .lifetime VAR lifetime_counter;
  }

  DOC <$ Adds an ordinary field beside the shared virtual base. $>
  ::left
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .shared VIRTUAL_BASE root;
    .value VAR I32;
  }

  DOC <$ Reaches the same virtual base through a second branch. $>
  ::right
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .shared VIRTUAL_BASE root;
    .value VAR I32;
  }

  DOC <$ Uses generated lifetime and value operations for both branches. $>
  ::diamond
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .left BASE left;
    .right BASE right;
  }

  DOC <$ Owns a complete virtual diamond as an ordinary field. $>
  ::envelope
    STRUCT
  {
    .value VAR diamond;
    .tail VAR I32;
  }

  DOC <$ Generated operations on an ordinary wrapper preserve the lifetime and identity of its virtual polymorphic field. $>
  ::contained_complete_object
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR source envelope;
    source.value.left.shared.text := "contained";
    source.tail := 79;
    VAR copied envelope := source;
    TEST_ASSERT(copied.value.right.shared.text == "contained");
    TEST_ASSERT(copied.tail == 79);
    TEST_ASSERT((copied.value.left.shared<- AS DYNAMIC MUT->diamond) == copied.value<-);
    VAR moved envelope := MOVE(copied);
    TEST_ASSERT(moved.value.right.shared.text == "contained");
    source.value.left.shared.text := "assigned";
    moved := source;
    TEST_ASSERT(moved.value.right.shared.text == "assigned");
    TEST_ASSERT((moved.value.right.shared<- AS DYNAMIC MUT->diamond) == moved.value<-);
  }

  DOC <$ Throws after copying a complete virtual diamond into an ordinary field. $>
  ::failing_envelope
    STRUCT
  {
    .value VAR diamond;
    DOC <$ Completes field construction before throwing from the enclosing constructor body. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER CONST& diamond) :> .value:(@OTHER OTHER)
    {
      THROW I32(@OTHER 42);
    }
  }

  DOC <$ A failed enclosing constructor destroys its completed virtual polymorphic field once before entering the handler. $>
  ::contained_construction_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR deaths I32 := 0;
    {
      VAR source diamond;
      source.left.shared.text := "retained";
      source.left.shared.lifetime.deaths := deaths<-;
      VAR caught BOOL := FALSE;
      TRY
      {
        VAR failed failing_envelope := source;
        TEST_ASSERT(FALSE);
      }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == 42);
        TEST_ASSERT(deaths == 1);
        TEST_ASSERT(source.right.shared.text == "retained");
        caught := TRUE;
      }
      TEST_ASSERT(caught);
    }
    TEST_ASSERT(deaths == 2);
  }

  DOC <$ Default construction initializes the virtual base once and copying preserves owned values and complete-object identity. $>
  ::default_and_copy
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR source diamond;
    TEST_ASSERT(source.left.shared.text.size() == 0);
    TEST_ASSERT(source.left.value == 0);
    TEST_ASSERT(source.right.value == 0);
    source.left.shared.text := "shared text";
    source.left.value := 17;
    source.right.value := 29;
    VAR copied diamond := source;
    TEST_ASSERT(copied.left.shared.text == "shared text");
    TEST_ASSERT(copied.left.value == 17);
    TEST_ASSERT(copied.right.value == 29);
    TEST_ASSERT(copied.left.shared<- == copied.right.shared<-);
    TEST_ASSERT(copied.left.shared<- != source.left.shared<-);
    TEST_ASSERT((copied.right.shared<- AS DYNAMIC MUT->diamond) == copied<-);
    copied.right.shared.text := "independent";
    TEST_ASSERT(source.left.shared.text == "shared text");
  }

  DOC <$ Moving a diamond transfers owned text once while retaining distinct complete-object identities. $>
  ::move_construction
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR source diamond;
    source.left.shared.text := "moved text";
    source.left.value := 31;
    source.right.value := 47;
    VAR moved diamond := MOVE(source);
    TEST_ASSERT(moved.right.shared.text == "moved text");
    TEST_ASSERT(moved.left.value == 31);
    TEST_ASSERT(moved.right.value == 47);
    TEST_ASSERT((moved.left.shared<- AS DYNAMIC MUT->diamond) == moved<-);
    TEST_ASSERT((source.right.shared<- AS DYNAMIC MUT->diamond) == source<-);
    source.right.shared.text := "reused";
    TEST_ASSERT(moved.left.shared.text == "moved text");
  }

  DOC <$ Generated assignment and swap update each shared virtual base once without exchanging object identity. $>
  ::assignment_and_swap
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR first diamond;
    VAR second diamond;
    first.left.shared.text := "first";
    first.left.value := 11;
    first.right.value := 13;
    second.left.shared.text := "second";
    second.left.value := 23;
    second.right.value := 27;
    first <-> second;
    TEST_ASSERT(first.right.shared.text == "second");
    TEST_ASSERT(second.right.shared.text == "first");
    TEST_ASSERT(first.left.value == 23);
    TEST_ASSERT(first.right.value == 27);
    TEST_ASSERT(second.left.value == 11);
    TEST_ASSERT(second.right.value == 13);
    TEST_ASSERT((first.right.shared<- AS DYNAMIC MUT->diamond) == first<-);
    TEST_ASSERT((second.left.shared<- AS DYNAMIC MUT->diamond) == second<-);
    first := second;
    TEST_ASSERT(first.right.shared.text == "first");
    TEST_ASSERT(first.left.value == 11);
    TEST_ASSERT(first.right.value == 13);
    second.left.shared.text := "replacement";
    first := MOVE(second);
    TEST_ASSERT(first.left.shared.text == "replacement");
    TEST_ASSERT((first.left.shared<- AS DYNAMIC MUT->diamond) == first<-);
    TEST_ASSERT((second.right.shared<- AS DYNAMIC MUT->diamond) == second<-);
    first <-> first;
    TEST_ASSERT(first.left.shared.text == "replacement");
  }

  DOC <$ Makes user-declared constructors distinguishable from generated constructors. $>
  ::explicit_value
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .value VAR I32;
    DOC <$ Supplies a visible default value. $>
    .CONSTRUCTOR
      FUNCTION() { .value := 10; }
    DOC <$ Makes copy constructor selection observable. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER CONST& explicit_value) { .value := OTHER.value + 1; }
    DOC <$ Makes move constructor selection observable. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER TEMP& explicit_value) { .value := OTHER.value + 2; }
  }

  DOC <$ Generated destructors release the shared virtual base exactly once for each original, copied, and moved object. $>
  ::virtual_base_destruction
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR deaths I32 := 0;
    {
      VAR source diamond;
      source.left.shared.lifetime.deaths := deaths<-;
      {
        VAR copied diamond := source;
        VAR moved diamond := MOVE(source);
        TEST_ASSERT(deaths == 0);
      }
      TEST_ASSERT(deaths == 2);
    }
    TEST_ASSERT(deaths == 3);
  }

  DOC <$ Requires user-declared constructors through their subobject entries. $>
  ::explicit_derived
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .base BASE explicit_value;
  }

  DOC <$ User constructors suppress corresponding implicit overloads in both complete objects and base subobjects. $>
  ::user_constructors
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR source explicit_value;
    TEST_ASSERT(source.value == 10);
    VAR copied explicit_value := source;
    TEST_ASSERT(copied.value == 11);
    VAR moved explicit_value := MOVE(source);
    TEST_ASSERT(moved.value == 12);
    VAR derived explicit_derived;
    TEST_ASSERT(derived.base.value == 10);
    VAR derived_copy explicit_derived := derived;
    TEST_ASSERT(derived_copy.base.value == 11);
    VAR derived_move explicit_derived := MOVE(derived);
    TEST_ASSERT(derived_move.base.value == 12);
  }

  DOC <$ Disables implicit default construction even with no user constructors. $>
  ::no_default
    STRUCT VIRTUAL_POLYMORPHIC NO_IMPLICIT_DEFAULT_CONSTRUCTOR
  {
    .value VAR I32;
  }

  DOC <$ Combines a conversion constructor with generated default and copy constructors. $>
  ::converted_value
    STRUCT VIRTUAL_POLYMORPHIC
  {
    .value VAR I32;
    DOC <$ Initializes from an integer supplied through argument conversion. $>
    .CONSTRUCTOR
      FUNCTION(@OTHER I32) { .value := OTHER; }
  }

  DOC <$ Receives a complete virtual polymorphic object by value. $>
  ::read_value
    FUNCTION(@value converted_value): I32 { RETURN value.value; }

  DOC <$ By-value arguments use complete-object constructors for copying and conversion, while an unrelated explicit constructor permits generated default construction. $>
  ::argument_construction
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value converted_value;
    TEST_ASSERT(value.value == 0);
    value.value := 53;
    TEST_ASSERT(read_value(@value value) == 53);
    TEST_ASSERT(read_value(@value I32(@OTHER 71)) == 71);
  }

  DOC <$ Virtual polymorphic classes honor the default-constructor suppression tag. $>
  ::default_suppression
    STATIC_TEST EXPECT_COMPILATION_FAILURE KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR value no_default;
  }
}
