LANGUAGE QUXLANG EN 0.0;

::atomic_pointer_tests NAMESPACE
{
  DOC <$ Pointer compare-exchange compares addresses and writes back the observed pointer after failure. $>
  ::compare_exchange_identity
    TEMPLATE(@success TYPE AUTO, @failure TYPE AUTO) FUNCTION()
  {
    VAR first I32 := 17;
    VAR second I32 := 17;
    VAR value ATOMIC#(MUT->I32);
    VAR empty MUT->I32;
    value.STORE#ATOMIC_RELAXED(first<-);
    VAR expected MUT->I32 := second<-;
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED empty) == FALSE);
    TEST_ASSERT(expected == first<-);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == first<-);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED (second<-)));
    TEST_ASSERT(expected == first<-);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == second<-);
    VAR loaded MUT->I32 := value.LOAD#ATOMIC_ACQUIRE();
    loaded-> := 29;
    TEST_ASSERT(first == 17);
    TEST_ASSERT(second == 29);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED empty) == FALSE);
    TEST_ASSERT(expected == second<-);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED empty));
    TEST_ASSERT(expected == second<-);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == empty);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED (first<-)) == FALSE);
    TEST_ASSERT(expected == empty);
    TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS success, @FAILURE failure)(@EXPECTED expected, @DESIRED (first<-)));
    TEST_ASSERT(expected == empty);
    TEST_ASSERT(value.LOAD#ATOMIC_RELAXED() == first<-);
  }

  DOC <$ Null and live pointer transitions obey the expected-value contract for all supported ordering pairs. $>
  ::comparison_modes
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    compare_exchange_identity#(@success ATOMIC_RELAXED, @failure ATOMIC_RELAXED)();
    compare_exchange_identity#(@success ATOMIC_ACQUIRE, @failure ATOMIC_RELAXED)();
    compare_exchange_identity#(@success ATOMIC_ACQUIRE, @failure ATOMIC_ACQUIRE)();
    compare_exchange_identity#(@success ATOMIC_RELEASE, @failure ATOMIC_RELAXED)();
    compare_exchange_identity#(@success ATOMIC_ACQREL, @failure ATOMIC_RELAXED)();
    compare_exchange_identity#(@success ATOMIC_ACQREL, @failure ATOMIC_ACQUIRE)();
    compare_exchange_identity#(@success ATOMIC_SEQCST, @failure ATOMIC_RELAXED)();
    compare_exchange_identity#(@success ATOMIC_SEQCST, @failure ATOMIC_ACQUIRE)();
    compare_exchange_identity#(@success ATOMIC_SEQCST, @failure ATOMIC_SEQCST)();
  }

  DOC <$ Keeps two independent atomic counters in one record. $>
  ::pair
    STRUCT { .left VAR ATOMIC#I32; .right VAR ATOMIC#I32; }

  DOC <$ Operations on atomic fields in adjacent array elements affect only the selected storage. $>
  ::nested_atomic_storage
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR values [2]pair;
    values[0].left.STORE#ATOMIC_RELAXED(11);
    values[0].right.STORE#ATOMIC_RELAXED(22);
    values[1].left.STORE#ATOMIC_RELAXED(33);
    values[1].right.STORE#ATOMIC_RELAXED(44);
    VAR selected MUT& ATOMIC#I32 := values[1].left;
    TEST_ASSERT(selected.FETCH_ADD#ATOMIC_ACQREL(5) == 33);
    VAR expected I32 := 33;
    TEST_ASSERT(selected.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_ACQUIRE)(@EXPECTED expected, @DESIRED 49) == FALSE);
    TEST_ASSERT(expected == 38);
    TEST_ASSERT(selected.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_ACQUIRE)(@EXPECTED expected, @DESIRED 49));
    TEST_ASSERT(expected == 38);
    TEST_ASSERT(values[0].left.LOAD#ATOMIC_ACQUIRE() == 11);
    TEST_ASSERT(values[0].right.LOAD#ATOMIC_ACQUIRE() == 22);
    TEST_ASSERT(values[1].left.LOAD#ATOMIC_ACQUIRE() == 49);
    TEST_ASSERT(values[1].right.LOAD#ATOMIC_ACQUIRE() == 44);
    values[0].right.SUBTRACT#ATOMIC_RELEASE(2);
    TEST_ASSERT(values[0].right.LOAD#ATOMIC_ACQUIRE() == 20);
    TEST_ASSERT(selected.LOAD#ATOMIC_ACQUIRE() == 49);
  }
  DOC <$ Exchange returns the previous pointer and supports transitions to and from null. $>
  ::exchange_identity
    UNIT_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR first I32 := 17;
    VAR value ATOMIC#(MUT->I32);
    VAR empty MUT->I32;
    value.STORE#NONATOMIC(empty);
    TEST_ASSERT(value.EXCHANGE#ATOMIC_ACQUIRE(first<-) == empty);
    TEST_ASSERT(value.EXCHANGE#ATOMIC_RELEASE(empty) == first<-);
    TEST_ASSERT(value.LOAD#NONATOMIC() == empty);
  }
}
