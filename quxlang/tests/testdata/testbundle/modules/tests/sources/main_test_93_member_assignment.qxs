LANGUAGE QUXLANG EN 0.0;

::member_assignment_tests NAMESPACE
{
  DOC <$ Observable user assignment and swap distinguish member dispatch from generated field operations. $>
  ::number
    STRUCT
  {
    .value VAR I32;
    .assignments VAR MUT->I32;
    .swaps VAR MUT->I32;
    DOC <$ Stores one more than the source value and records every invocation, including self-assignment. $>
    .OPERATOR:=
      FUNCTION(@OTHER CONST& number)
    {
      .assignments-> ++;
      .value := OTHER.value + 1;
    }
    DOC <$ Swaps payloads and records invocation even when both operands identify the same object. $>
    .OPERATOR<->
      FUNCTION(@OTHER MUT& number)
    {
      .swaps-> ++;
      .value <-> OTHER.value;
    }
  }

  DOC <$ Returns a mutable operand while recording its source position. $>
  ::receiver
    FUNCTION(@value MUT& number, @events MUT& I32, @digit I32): MUT& number
  {
    events := events * 10 + digit;
    RETURN value;
  }

  DOC <$ Assignment evaluates both operands once, calls the custom member, and preserves self-assignment effects. $>
  ::assignment_dispatch
    DUAL_TEST
  {
    VAR calls I32 := 0;
    VAR events I32 := 0;
    VAR left number;
    VAR right number;
    left.assignments := calls<-;
    right.assignments := calls<-;
    left.value := 3;
    right.value := 7;
    receiver(@value left, @events events, @digit 1) := receiver(@value right, @events events, @digit 2);
    TEST_ASSERT(events == 12);
    TEST_ASSERT(calls == 1);
    TEST_ASSERT(left.value == 8);
    TEST_ASSERT(right.value == 7);
    left := left;
    TEST_ASSERT(calls == 2);
    TEST_ASSERT(left.value == 9);
  }

  DOC <$ Swap evaluates both operands once and invokes custom behavior for distinct and identical receivers. $>
  ::swap_dispatch
    DUAL_TEST
  {
    VAR calls I32 := 0;
    VAR events I32 := 0;
    VAR left number;
    VAR right number;
    left.swaps := calls<-;
    right.swaps := calls<-;
    left.value := 3;
    right.value := 7;
    receiver(@value left, @events events, @digit 1) <-> receiver(@value right, @events events, @digit 2);
    TEST_ASSERT(events == 12);
    TEST_ASSERT(calls == 1);
    TEST_ASSERT(left.value == 7);
    TEST_ASSERT(right.value == 3);
    left <-> left;
    TEST_ASSERT(calls == 2);
    TEST_ASSERT(left.value == 7);
    TEST_ASSERT(right.value == 3);
  }
}
