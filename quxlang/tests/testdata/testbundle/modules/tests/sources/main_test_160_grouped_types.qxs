LANGUAGE QUXLANG EN 0.0;

::grouped_type_tests NAMESPACE
{
  DOC <$ Preserves identity through nested type parentheses. $>
  ::integer ALIAS ((I32));
  DOC <$ Groups a complete fixed-array type as a pointer target. $>
  ::array_pointer ALIAS MUT-> ([3]I32);
  DOC <$ Groups pointer element types inside a fixed array. $>
  ::pointer_array ALIAS [3](MUT->I32);

  DOC <$ Type grouping preserves nominal identity and permits subsequent qualified-name lookup. $>
  ::identity_and_postfix_names
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(integer, I32));
    TEST_ASSERT(SAME_TYPES((CONST& I32), CONST& I32));
    TEST_ASSERT(SAME_TYPES(array_pointer, MUT-> [3]I32));
    TEST_ASSERT(SAME_TYPES(pointer_array, [3]MUT->I32));
    TEST_ASSERT(SAME_TYPES(array_pointer, pointer_array) == FALSE);
    TEST_ASSERT(SAME_TYPES((paired_template_tests::pair#[I32:I64])::index, I32));
    TEST_ASSERT(SAME_TYPES((paired_template_tests::pair)#[I32:I64]::value, I64));
  }

  DOC <$ Grouped array and pointer types preserve the original storage and element identities. $>
  ::array_pointer_storage
    DUAL_TEST
  {
    VAR values ([3]I32) :[17, 29, 41];
    VAR pointer array_pointer := values<-;
    TEST_ASSERT(pointer-> [1] == 29);
    pointer-> [1] := 53;
    TEST_ASSERT(values[1] == 53);
    VAR pointers pointer_array;
    pointers[0] := values[0]<-;
    pointers[1] := values[1]<-;
    pointers[2] := values[2]<-;
    TEST_ASSERT(pointers[0]-> == 17);
    TEST_ASSERT(pointers[1]-> == 53);
    TEST_ASSERT(pointers[2]-> == 41);
    TEST_ASSERT(pointers[1] == (pointer->)[1]<-);
  }

  DOC <$ Supplies a concrete function for a parenthesized procedure type. $>
  ::increment
    FUNCTION(@value I32): I32 { RETURN value + 7; }

  DOC <$ Groups a callable type without changing its parameter or return signature. $>
  ::procedure_pointer
    ALIAS CONST-> (PROCEDURE(@value I32: I32));

  DOC <$ Grouped procedure types remain callable after aliasing and copying. $>
  ::grouped_callable
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(procedure_pointer, CONST->PROCEDURE(@value I32: I32)));
    VAR pointer procedure_pointer := increment<-;
    VAR copied (procedure_pointer) := pointer;
    TEST_ASSERT(copied(@value 17) == 24);
    TEST_ASSERT(copied == pointer);
  }
}
