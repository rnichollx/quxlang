LANGUAGE QUXLANG EN 0.0;

::function_specialization_unpack_tests NAMESPACE
{
  ::increment FUNCTION(@value I32): I32 { RETURN value + 1; }
  ::sum FUNCTION(%left I32, %right I32): I32 { RETURN left + right; }

  DOC <$ Selects a callable from parameter types while retaining ordinary function side effects. $>
  ::select FUNCTION(@count MUT& I32, @arguments AUTO& AUTO): AUTO
  {
    count += 1;
    RETURN increment#(COMPOSITE_UNPACK(TYPEOF(arguments)));
  }

  DOC <$ A returned binding carries its selection in its type and the selecting function executes once. $>
  ::returned_binding DUAL_TEST
  {
    VAR count I32;
    VAR arguments := :{ .value = I32(@OTHER 41); };
    VAR selected := select(@count count, @arguments arguments);
    TEST_ASSERT(count == 1);
    TEST_ASSERT(selected(COMPOSITE_UNPACK(COMPOSITE_FORWARD(arguments))) == 42);
  }

  DOC <$ Specialization unpack preserves the positional ordering of composite fields. $>
  ::positional_types DUAL_TEST
  {
    VAR arguments := :{ [0] = I32(@OTHER 19); [1] = I32(@OTHER 23); };
    VAR selected := sum#(COMPOSITE_UNPACK(TYPEOF(arguments)));
    TEST_ASSERT(selected(COMPOSITE_UNPACK(COMPOSITE_FORWARD(arguments))) == 42);
  }

  ::missing_binding FUNCTION(): TYPEOF(increment#(@value I32)) { RETURN; }

  DOC <$ A function returning a static binding must supply a return expression. $>
  ::missing_return_value STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    missing_binding();
  }

  DOC <$ Explicit invocation rejects arguments outside the selected specialization. $>
  ::extra_argument STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR selected := increment#(@value I32);
    selected(@value 41, @extra 1);
  }

  DOC <$ Specialization rejects duplicate named arguments introduced by unpacking. $>
  ::duplicate_named_type STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR arguments := :{ .value = I32(@OTHER 41); };
    VAR selected := increment#(@value I32, COMPOSITE_UNPACK(TYPEOF(arguments)));
  }

  DOC <$ Function specialization requires a composite type as the unpack operand. $>
  ::non_composite_type STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR selected := increment#(COMPOSITE_UNPACK(I32));
  }
}
