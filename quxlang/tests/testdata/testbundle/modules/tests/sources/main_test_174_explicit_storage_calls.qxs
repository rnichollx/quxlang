LANGUAGE QUXLANG EN 0.0;

::explicit_storage_call_tests NAMESPACE
{
  DOC <$ Records positional construction and the selected explicit destructor argument. $>
  ::record
    STRUCT
  {
    .events VAR MUT->I32;
    .value VAR I32;
    DOC <$ Preserves positional value binding and records completed initialization. $>
    .CONSTRUCTOR
      FUNCTION(%value I32, %events MUT& I32)
    {
      .value := value;
      .events := events<-;
      events := events * 10 + 3;
    }
    DOC <$ Records ordinary destruction. $>
    .DESTRUCTOR
      FUNCTION() { .events-> := .events-> * 10 + 4; }
    DOC <$ Records the caller-supplied destruction event. $>
    .DESTRUCTOR
      FUNCTION(@digit I32) { .events-> := .events-> * 10 + digit; }
  }

  DOC <$ Positional placement expression and statement arguments execute once and initialize reusable storage. $>
  ::positional_placement
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    VAR slot TYPED_STORAGE(record);
    VAR placed ->record := PLACE AT(slot) record
      :[placement_argument_tests::argument(@events events, @fail FALSE), events];
    TEST_ASSERT(events == 23);
    TEST_ASSERT(placed->.value == 17);
    DESTROY AT(slot) record;
    TEST_ASSERT(events == 234);
    events := 0;
    PLACE AT(slot) record
      :[placement_argument_tests::argument(@events events, @fail FALSE), events];
    TEST_ASSERT(events == 23);
    DESTROY AT(slot) record;
    TEST_ASSERT(events == 234);
  }

  DOC <$ Explicit destructor arguments select the matching overload and end the placed object's lifetime before storage reuse. $>
  ::named_destruction
    DUAL_TEST KNOWN_BROKEN
  {
    VAR events I32 := 0;
    VAR slot TYPED_STORAGE(record);
    PLACE AT(slot) record :[17, events];
    TEST_ASSERT(events == 3);
    DESTROY AT(slot) record :(@digit 5);
    TEST_ASSERT(events == 35);
    PLACE AT(slot) record :[29, events];
    TEST_ASSERT(events == 353);
    DESTROY AT(slot) record :(@digit 6);
    TEST_ASSERT(events == 3536);
  }
}
