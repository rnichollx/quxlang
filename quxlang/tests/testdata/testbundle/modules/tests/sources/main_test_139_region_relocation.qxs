LANGUAGE QUXLANG EN 0.0;

::region_relocation_tests NAMESPACE
{
  ::region_operand DOC <$ Records a selected storage-region operand and preserves its pointer. $>
    FUNCTION(@events MUT& I32, @digit I32, @storage ->TYPED_STORAGE(I64)): ->TYPED_STORAGE(I64)
  { events := events * 10 + digit; RETURN storage; }
  ::extent_operand DOC <$ Records the byte-count operand after both region operands. $>
    FUNCTION(@events MUT& I32): SZ
  { events := events * 10 + 3; RETURN 8; }

  ::empty_region_operand_order DOC <$ Relocation evaluates source, destination and extent once in written order even when neither region contains live objects. $>
    UNIT_TEST
  {
    VAR source ->TYPED_STORAGE(I64) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::ALLOC();
    VAR destination ->TYPED_STORAGE(I64) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::ALLOC();
    VAR events I32 := 0;
    RELOCATE_REGION_OBJECTS
      FROM region_operand(@events events, @digit 1, @storage source)
      TO region_operand(@events events, @digit 2, @storage destination)
      SIZE extent_operand(@events events);
    ASSERT(events == 123);
    VAR placed MUT->I64 := PLACE AT(destination->) I64 := 71;
    ASSERT(placed-> == 71);
    DESTROY AT(destination->) I64;
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::DEALLOC(@PTR destination);
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::DEALLOC(@PTR source);
  }

  ::live_integer_moves INCLUDE_IF(OS_MACOS) DOC <$ Relocating a live trivially relocatable integer transfers its value into destination storage without a live destination object. $>
    UNIT_TEST KNOWN_BROKEN
  {
    VAR source ->TYPED_STORAGE(I64) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::ALLOC();
    VAR destination ->TYPED_STORAGE(I64) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::ALLOC();
    VAR previous MUT->I64 := PLACE AT(destination->) I64 := 11;
    ASSERT(previous-> == 11);
    DESTROY AT(destination->) I64;
    VAR original MUT->I64 := PLACE AT(source->) I64 := 4294967313;
    ASSERT(original-> == 4294967313);
    RELOCATE_REGION_OBJECTS FROM source TO destination SIZE 8;
    VAR address ADDRESS := ADDRESS_LAUNDER_ESCAPE_ALLOC_REGION destination;
    VAR relocated MUT->I64 := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO MUT->I64;
    ASSERT(relocated-> == 4294967313);
    DESTROY AT(destination->) I64;
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::DEALLOC(@PTR destination);
    RUNTIME_MODULE::DEFAULT_ALLOCATOR#(I64)::DEALLOC(@PTR source);
  }
}
