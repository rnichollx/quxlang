LANGUAGE QUXLANG EN 0.0;

::label_lifetime_tests NAMESPACE
{
  DOC <$ Breaking an outer labelled block unwinds nested deferred actions and locals while retaining enclosing storage. $>
  ::break_outer_block
    DUAL_TEST
  {
    VAR events I32 := 0;
    {
      VAR enclosing control_flow_tests::exit_record :(@events events, @digit 9);
      LABEL :outer
      {
        VAR first control_flow_tests::exit_record :(@events events, @digit 1);
        DEFER events := events * 10 + 2;
        LABEL :inner
        {
          VAR second control_flow_tests::exit_record :(@events events, @digit 3);
          DEFER events := events * 10 + 4;
          BREAK :outer;
          TEST_ASSERT(FALSE);
        }
        TEST_ASSERT(FALSE);
      }
      TEST_ASSERT(events == 4321);
    }
    TEST_ASSERT(events == 43219);
  }

  DOC <$ Breaking an inner label preserves outer locals until a later outer exit. $>
  ::break_inner_block
    DUAL_TEST
  {
    VAR events I32 := 0;
    LABEL :outer
    {
      VAR first control_flow_tests::exit_record :(@events events, @digit 1);
      DEFER events := events * 10 + 2;
      LABEL :inner
      {
        VAR second control_flow_tests::exit_record :(@events events, @digit 3);
        DEFER events := events * 10 + 4;
        BREAK :inner;
        TEST_ASSERT(FALSE);
      }
      TEST_ASSERT(events == 43);
      events := events * 10 + 5;
      BREAK :outer;
      TEST_ASSERT(FALSE);
    }
    TEST_ASSERT(events == 43521);
  }

  DOC <$ Leaving a catch handler by GOTO performs deferred cleanup and restores the previous exception state. $>
  ::goto_from_handler
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR events I32 := 0;
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
    {
      VAR enclosing control_flow_tests::exit_record :(@events events, @digit 9);
      TRY { THROW I32(@OTHER 73); }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == 73);
        TEST_ASSERT(CURRENT_EXCEPTION()??);
        VAR local control_flow_tests::exit_record :(@events events, @digit 1);
        DEFER events := events * 10 + 2;
        GOTO :done;
      }
      TEST_ASSERT(FALSE);
    }
    LABEL :done;
    TEST_ASSERT(events == 219);
    TEST_ASSERT((CURRENT_EXCEPTION()??) == FALSE);
  }
}
