LANGUAGE QUXLANG EN 0.0;

::atomic_u64_tests NAMESPACE
{
    ::operations DUAL_TEST
    {
        VAR value ATOMIC#U64;
        value.STORE#ATOMIC_RELEASE(4294967296);
        TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 4294967296);
        TEST_ASSERT(value.FETCH_ADD#ATOMIC_ACQREL(7) == 4294967296);
        VAR expected U64 := 0;
        TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_ACQUIRE)(@EXPECTED expected, @DESIRED 9) == FALSE);
        TEST_ASSERT(expected == 4294967303);
        TEST_ASSERT(value.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_SEQCST, @FAILURE ATOMIC_ACQUIRE)(@EXPECTED expected, @DESIRED 9));
        TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 9);
        TEST_ASSERT(value.EXCHANGE#ATOMIC_SEQCST(4294967300) == 9);
        TEST_ASSERT(value.LOAD#ATOMIC_ACQUIRE() == 4294967300);
    }
}
