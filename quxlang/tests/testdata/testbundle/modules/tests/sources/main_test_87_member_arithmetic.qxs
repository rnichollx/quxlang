LANGUAGE QUXLANG EN 0.0;

::member_arithmetic_tests NAMESPACE
{
  DOC <$ Distinct operator results expose normal and right-hand-side dispatch. $>
  ::number
    STRUCT
  {
    .value VAR I32;
    DOC <$ Encodes this operand before the other operand. $>
    .OPERATOR+
      FUNCTION(@OTHER I32) CONST: I32 { RETURN .value * 10 + OTHER; }
    DOC <$ Encodes the left operand before this right-hand operand. $>
    .OPERATOR+RHS
      FUNCTION(@OTHER I32) CONST: I32 { RETURN OTHER * 10 + .value; }
    DOC <$ Mutates the receiver and returns its original storage. $>
    .OPERATOR+=
      FUNCTION(@OTHER I32): MUT& number { .value += OTHER; RETURN THIS; }
  }

  DOC <$ Records evaluation of a reference-valued operator receiver. $>
  ::receiver
    FUNCTION(@value MUT& number, @events MUT& I32): MUT& number
  {
    events := events * 10 + 1;
    RETURN value;
  }

  DOC <$ Records evaluation of the scalar operand. $>
  ::operand
    FUNCTION(@events MUT& I32): I32
  {
    events := events * 10 + 2;
    RETURN 3;
  }

  DOC <$ Normal and RHS operator dispatch preserve written operand order and evaluate each expression once. $>
  ::binary_dispatch
    DUAL_TEST
  {
    VAR value number;
    value.value := 4;
    VAR events I32 := 0;
    TEST_ASSERT((receiver(@value value, @events events) + operand(@events events)) == 43);
    TEST_ASSERT(events == 12);
    TEST_ASSERT(value.value == 4);
    events := 0;
    TEST_ASSERT((operand(@events events) + receiver(@value value, @events events)) == 34);
    TEST_ASSERT(events == 21);
    TEST_ASSERT(value.value == 4);
  }

  DOC <$ Compound assignment invokes the user member on the original receiver after one evaluation of each operand. $>
  ::compound_receiver
    DUAL_TEST
  {
    VAR value number;
    value.value := 4;
    VAR events I32 := 0;
    receiver(@value value, @events events) += operand(@events events);
    TEST_ASSERT(events == 12);
    TEST_ASSERT(value.value == 7);
    value += 5;
    TEST_ASSERT(value.value == 12);
  }
}
