LANGUAGE QUXLANG EN 0.0;

::keyword_argument_tests NAMESPACE
{
  DOC <$ Binds reserved public argument names to ordinary local names with distinct decimal positions. $>
  ::encode
    FUNCTION(@GENERIC_THIS:first I32, @GENERIC_OTHER:second I32, @LHS:third I32): I32
  { RETURN first * 100 + second * 10 + third; }

  DOC <$ Direct and indirect calls retain reserved argument names and evaluate explicitly reordered arguments in written order. $>
  ::reserved_name_binding
    DUAL_TEST
  {
    VAR events I32 := 0;
    TEST_ASSERT(encode(
      @LHS call_binding_tests::record(@events events, @digit 1),
      @GENERIC_OTHER call_binding_tests::record(@events events, @digit 2),
      @GENERIC_THIS call_binding_tests::record(@events events, @digit 3)) == 321);
    TEST_ASSERT(events == 123);
    VAR pointer CONST->PROCEDURE(@GENERIC_THIS I32, @GENERIC_OTHER I32, @LHS I32: I32) := encode<-;
    events := 0;
    TEST_ASSERT(pointer(
      @GENERIC_OTHER call_binding_tests::record(@events events, @digit 1),
      @GENERIC_THIS call_binding_tests::record(@events events, @digit 2),
      @LHS call_binding_tests::record(@events events, @digit 3)) == 213);
    TEST_ASSERT(events == 123);
  }

  DOC <$ Names a procedure signature carrying the explicit stdcall convention without invoking platform-specific code. $>
  ::stdcall_type
    ALIAS PROCEDURE STDCALL(I32: I32);
  DOC <$ Preserves the convention through an alias. $>
  ::stdcall_alias
    ALIAS stdcall_type;

  DOC <$ Procedure type identity preserves convention and exception modifiers independently of parameter and return types. $>
  ::calling_convention_identity
    DUAL_TEST
  {
    TEST_ASSERT(SAME_TYPES(stdcall_type, stdcall_alias));
    TEST_ASSERT(SAME_TYPES(stdcall_type, PROCEDURE STDCALL(I32: I32)));
    TEST_ASSERT(SAME_TYPES(stdcall_type, PROCEDURE CCALL(I32: I32)) == FALSE);
    TEST_ASSERT(SAME_TYPES(stdcall_type, PROCEDURE STDCALL NOEXCEPT(I32: I32)) == FALSE);
    TEST_ASSERT(SAME_TYPES(CONST->stdcall_type, CONST->stdcall_alias));
  }
}
