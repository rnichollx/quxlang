LANGUAGE QUXLANG EN 0.0;

::storage_reuse_tests NAMESPACE
{
  DOC <$ Pointer conversion preserves the address of typed storage across different payload lifetimes. $>
  ::alternative_pointer_identity DUAL_TEST
  {
    VAR slot TYPED_STORAGE(I32, U32);
    VAR first ->I32 := PLACE AT(slot) I32 := 17;
    VAR address ->VOID := first AS REINTERPRET ->VOID;
    DESTROY AT(slot) I32;
    VAR second ->U32 := PLACE AT(slot) U32 := 29;
    TEST_ASSERT(address == (second AS REINTERPRET ->VOID));
    TEST_ASSERT((address <=> (second AS REINTERPRET ->VOID)) == ORDER::EQUAL);
    DESTROY AT(slot) U32;
  }

  DOC <$ Array payloads reuse physical byte positions across element types with different strides. $>
  ::array_byte_offset_identity DUAL_TEST
  {
    VAR slot TYPED_STORAGE([4]U8, [2]U16);
    VAR first -> [4]U8 := PLACE AT(slot) [4]U8;
    VAR middle ->VOID := (first->)[2]<- AS REINTERPRET ->VOID;
    VAR earlier ->VOID := (first->)[1]<- AS REINTERPRET ->VOID;
    DESTROY AT(slot) [4]U8;
    VAR second -> [2]U16 := PLACE AT(slot) [2]U16;
    TEST_ASSERT(middle == ((second->)[1]<- AS REINTERPRET ->VOID));
    TEST_ASSERT(earlier != ((second->)[1]<- AS REINTERPRET ->VOID));
    DESTROY AT(slot) [2]U16;
  }

  DOC <$ Reusing typed storage starts a fresh owned lifetime each time and explicit destruction runs exactly once. $>
  ::repeated_owned_lifetimes DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source array_lifetime_tests::element;
    source.attempts := attempts<-;
    source.events := events<-;
    {
      VAR slot TYPED_STORAGE(array_lifetime_tests::element);
      VAR number I32 := 1;
      LOOP WHILE (number <= 3) DO
      {
        source.number := number;
        VAR pointer ->array_lifetime_tests::element := PLACE AT(slot) array_lifetime_tests::element := source;
        TEST_ASSERT(pointer->.complete);
        TEST_ASSERT(pointer->.copied);
        TEST_ASSERT(pointer->.number == number);
        TEST_ASSERT(attempts == number);
        DESTROY AT(slot) array_lifetime_tests::element;
        number++;
      }
      TEST_ASSERT(events == 123);
    }
    TEST_ASSERT(events == 123);
  }

  DOC <$ A failed placement constructor leaves storage reusable without destroying the incomplete object. $>
  ::retry_failed_placement DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR attempts I32 := 0;
    VAR events I32 := 0;
    VAR source array_lifetime_tests::element;
    source.attempts := attempts<-;
    source.events := events<-;
    source.number := 4;
    source.failure := 1;
    {
      VAR slot TYPED_STORAGE(array_lifetime_tests::element);
      VAR caught BOOL := FALSE;
      TRY
      {
        PLACE AT(slot) array_lifetime_tests::element := source;
        TEST_ASSERT(FALSE);
      }
      CATCH error CONST& I32 { TEST_ASSERT(error == 4); caught := TRUE; }
      TEST_ASSERT(caught);
      TEST_ASSERT(attempts == 1);
      TEST_ASSERT(events == 0);
      source.failure := 0;
      VAR pointer ->array_lifetime_tests::element := PLACE AT(slot) array_lifetime_tests::element := source;
      TEST_ASSERT(pointer->.complete);
      TEST_ASSERT(pointer->.number == 4);
      TEST_ASSERT(attempts == 2);
      TEST_ASSERT(events == 0);
      DESTROY AT(slot) array_lifetime_tests::element;
      TEST_ASSERT(events == 4);
    }
    TEST_ASSERT(events == 4);
  }
}
