LANGUAGE QUXLANG EN 0.0;

::reference_qualifier_tests NAMESPACE
{
  ::temporary_parameter FUNCTION(@value TEMP& I32): VOID
  {
    TEST_ASSERT(SAME_TYPES(DECLTYPE(value), TEMP& I32));
    TEST_ASSERT(SAME_TYPES(TYPEOF(value), MUT& I32));
    TEST_ASSERT(SAME_TYPES(TYPEOF(FORWARD(value)), TEMP& I32));
    value += 1;
    VAR alias MUT& I32 := value;
    alias += 2;
  }

  ::temporary_positional FUNCTION(%value TEMP& I32): VOID
  {
    TEST_ASSERT(SAME_TYPES(TYPEOF(value), MUT& I32));
    temporary_parameter(@value FORWARD(value));
  }

  ::temporary_pack FUNCTION(%...values TEMP& I32): VOID
  {
    STATIC_VAR index SZ := 0;
    STATIC_WHILE (index < PACK_SIZE(values))
    {
      TEST_ASSERT(SAME_TYPES(PACK_ARG_TYPE(values, SNAPSHOT(index)), TEMP& I32));
      TEST_ASSERT(SAME_TYPES(TYPEOF(PACK_ARG(values, SNAPSHOT(index))), MUT& I32));
      PACK_ARG(values, SNAPSHOT(index)) += 1;
      STATIC_EVAL index++;
    }
  }

  ::temporary_record STRUCT
  {
    .number VAR I32;
    .link VAR MUT->I32;
    .exchange FUNCTION(@THIS TEMP& THISTYPE, @other MUT& THISTYPE): VOID
    {
      TEST_ASSERT(SAME_TYPES(DECLTYPE(THIS), TEMP& temporary_record));
      TEST_ASSERT(SAME_TYPES(TYPEOF(THIS), MUT& temporary_record));
      TEST_ASSERT(SAME_TYPES(TYPEOF(.number), MUT& I32));
      .number <-> other.number;
      .link <-> other.link;
    }
  }

  ::temporary_parameter_access DOC <$ Temporary-reference parameters provide mutable access while explicit forwarding retains their declared qualification. $>
    DUAL_TEST
  {
    VAR value I32 := 4;
    temporary_positional(% [MOVE(value)]);
    TEST_ASSERT(value == 7);
    VAR first temporary_record;
    VAR second temporary_record;
    first.number := 11;
    first.link := value<-;
    second.number := 19;
    MOVE(first).exchange(@other second);
    TEST_ASSERT(first.number == 19);
    TEST_ASSERT(second.number == 11);
    TEST_ASSERT(first.link == NULL);
    TEST_ASSERT(second.link == value<-);
    VAR another I32 := 12;
    temporary_pack(% [MOVE(value), MOVE(another)]);
    TEST_ASSERT(value == 8);
    TEST_ASSERT(another == 13);
  }

  ::temporary_local_access DOC <$ Local temporary-reference bindings provide mutable access while retaining their declared qualification for forwarding. $>
    DUAL_TEST
  {
    VAR value I32 := 4;
    VAR foo TEMP& I32 := MOVE(value);
    TEST_ASSERT(SAME_TYPES(DECLTYPE(foo), TEMP& I32));
    TEST_ASSERT(SAME_TYPES(TYPEOF(foo), MUT& I32));
    TEST_ASSERT(SAME_TYPES(TYPEOF(FORWARD(foo)), TEMP& I32));
    VAR alias MUT& I32 := foo;
    alias += 2;
    foo += 1;
    TEST_ASSERT(value == 7);
    temporary_parameter(@value FORWARD(foo));
    TEST_ASSERT(value == 10);
  }

  ::auto_copies_referenced_objects DOC <$ AUTO variables copy referenced objects into independent mutable storage while preserving pointer values. $>
    DUAL_TEST
  {
    VAR source I32 := 7;
    VAR direct AUTO := source;
    VAR mutable_view MUT& I32 := source;
    VAR constant_view CONST& I32 := source;
    VAR from_mutable AUTO := mutable_view;
    VAR from_constant AUTO := constant_view;
    VAR from_call AUTO := deduced_const_ref_return(source);
    source := 11;
    TEST_ASSERT(direct == 7);
    TEST_ASSERT(from_mutable == 7);
    TEST_ASSERT(from_constant == 7);
    TEST_ASSERT(from_call == 7);
    direct := 13;
    from_mutable := 17;
    from_constant := 19;
    from_call := 23;
    TEST_ASSERT(source == 11);
    VAR pointer MUT->I32 := source<-;
    VAR copied_pointer AUTO := pointer;
    VAR other I32 := 29;
    pointer := other<-;
    TEST_ASSERT(copied_pointer == source<-);
    copied_pointer-> := 31;
    TEST_ASSERT(source == 31);
    TEST_ASSERT(other == 29);
  }

  ::auto_copies_record DOC <$ AUTO copies record state without aliasing the source record or deep-copying its pointer fields. $>
    DUAL_TEST
  {
    VAR external I32 := 7;
    VAR source record;
    source.number := 13;
    source.link := external<-;
    VAR view CONST& record := source;
    VAR copy AUTO := view;
    source.number := 17;
    TEST_ASSERT(copy.number == 13);
    copy.number := 19;
    TEST_ASSERT(source.number == 17);
    copy.link-> := 23;
    TEST_ASSERT(external == 23);
  }

  ::write_pair DOC <$ Writes both output parameters in source order without reading their previous values. $>
    FUNCTION(@first WRITE& I32, @second WRITE& I32)
  {
    first := 11;
    second := 29;
  }

  ::output_aliases DOC <$ Output references update their original storage and preserve write order when both arguments alias. $>
    DUAL_TEST
  {
    VAR first I32;
    VAR second I32;
    VAR observed CONST& I32 := first;
    write_pair(@second second, @first first);
    TEST_ASSERT(first == 11);
    TEST_ASSERT(second == 29);
    TEST_ASSERT(observed == 11);
    write_pair(@first first, @second first);
    TEST_ASSERT(first == 29);
    TEST_ASSERT(observed == 29);
    TEST_ASSERT(second == 29);
    VAR elements [2]I32;
    write_pair(@first elements[1], @second elements[0]);
    TEST_ASSERT(elements[0] == 29);
    TEST_ASSERT(elements[1] == 11);
  }

  ::record DOC <$ Holds scalar state and a pointer to separately owned mutable storage. $>
    STRUCT { .number VAR I32; .link VAR MUT->I32; }

  ::const_view_identity DOC <$ Const views observe later mutations while a stored mutable pointer retains its pointee access. $>
    DUAL_TEST
  {
    VAR external I32 := 7;
    VAR value record;
    value.number := 13;
    value.link := external<-;
    VAR view CONST& record := value;
    VAR number CONST& I32 := view.number;
    VAR pointer CONST->I32 := value.number<-;
    TEST_ASSERT(view.number == 13);
    TEST_ASSERT(number == 13);
    TEST_ASSERT(pointer-> == 13);
    value.number := 31;
    TEST_ASSERT(view.number == 31);
    TEST_ASSERT(number == 31);
    TEST_ASSERT(pointer-> == 31);
    view.link-> := 37;
    TEST_ASSERT(external == 37);
    TEST_ASSERT(value.link == external<-);
    VAR replacement I32 := 41;
    value.link := replacement<-;
    TEST_ASSERT(view.link-> == 41);
    TEST_ASSERT(external == 37);
  }
}
