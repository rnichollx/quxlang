LANGUAGE QUXLANG EN 0.0;

::numeric_loop_bound_tests NAMESPACE
{
  ::equal_and_reversed DOC <$ Inclusive and exclusive numeric loops distinguish equal endpoints and both skip reversed positive-step ranges. $>
    DUAL_TEST
  {
    VAR visits I32 := 0;
    LOOP VALUE(value) FROM(7 AS I32) TO(7) DO
    { TEST_ASSERT(value == 7); visits++; };
    TEST_ASSERT(visits == 1);
    LOOP VALUE(value) FROM(7 AS I32) UNTIL(7) DO { TEST_ASSERT(FALSE); };
    LOOP VALUE(value) FROM(8 AS I32) TO(7) DO { TEST_ASSERT(FALSE); };
    LOOP VALUE(value) FROM(8 AS I32) UNTIL(7) DO { TEST_ASSERT(FALSE); };
    TEST_ASSERT(visits == 1);
  }

  ::nondividing_steps DOC <$ Stepped ranges stop after crossing an endpoint and include only exactly reached inclusive endpoints. $>
    DUAL_TEST
  {
    VAR inclusive I32 := 0;
    VAR exclusive I32 := 0;
    LOOP VALUE(value) FROM(1 AS I32) TO(10) BY(4) DO
    { inclusive := inclusive * 10 + value; };
    LOOP VALUE(value) FROM(1 AS I32) UNTIL(10) BY(4) DO
    { exclusive := exclusive * 10 + value; };
    TEST_ASSERT(inclusive == 159);
    TEST_ASSERT(exclusive == 159);
    inclusive := 0;
    exclusive := 0;
    LOOP VALUE(value) FROM(1 AS I32) TO(9) BY(4) DO
    { inclusive := inclusive * 10 + value; };
    LOOP VALUE(value) FROM(1 AS I32) UNTIL(9) BY(4) DO
    { exclusive := exclusive * 10 + value; };
    TEST_ASSERT(inclusive == 159);
    TEST_ASSERT(exclusive == 15);
  }

  ::captured_bounds DOC <$ Numeric loops capture their start, endpoint and stride before body mutations of the original variables. $>
    DUAL_TEST
  {
    VAR start I32 := 1;
    VAR end I32 := 9;
    VAR step I32 := 4;
    VAR sequence I32 := 0;
    LOOP VALUE(value) FROM(start) TO(end) BY(step) DO
    {
      sequence := sequence * 10 + value;
      start := 41;
      end := 2;
      step := 1;
    };
    TEST_ASSERT(sequence == 159);
    TEST_ASSERT(start == 41);
    TEST_ASSERT(end == 2);
    TEST_ASSERT(step == 1);
  }
}
