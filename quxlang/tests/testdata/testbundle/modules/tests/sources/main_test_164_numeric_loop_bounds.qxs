LANGUAGE QUXLANG EN 0.0;

::numeric_loop_bound_tests NAMESPACE
{
  DOC <$ Inclusive and exclusive numeric loops distinguish equal endpoints and both skip reversed positive-step ranges. $>
  ::equal_and_reversed
    DUAL_TEST
  {
    VAR visits I32 := 0;
    LOOP VALUE(value) FROM(7 AS I32) TO(7) DO
    { TEST_ASSERT(value == 7); visits++; };
    TEST_ASSERT(visits == 1);
    LOOP VALUE(value) FROM(7 AS I32) UNTIL(7) DO { TEST_ASSERT(FALSE); };
    LOOP VALUE(value) FROM(8 AS I32) TO(7) DO { TEST_ASSERT(FALSE); };
    LOOP VALUE(value) FROM(8 AS I32) UNTIL(7) DO { TEST_ASSERT(FALSE); };
    TEST_ASSERT(visits == 1);
  }

  DOC <$ Stepped ranges stop after crossing an endpoint and include only exactly reached inclusive endpoints. $>
  ::nondividing_steps
    DUAL_TEST
  {
    VAR inclusive I32 := 0;
    VAR exclusive I32 := 0;
    LOOP VALUE(value) FROM(1 AS I32) TO(10) BY(4) DO
    { inclusive := inclusive * 10 + value; };
    LOOP VALUE(value) FROM(1 AS I32) UNTIL(10) BY(4) DO
    { exclusive := exclusive * 10 + value; };
    TEST_ASSERT(inclusive == 159);
    TEST_ASSERT(exclusive == 159);
    inclusive := 0;
    exclusive := 0;
    LOOP VALUE(value) FROM(1 AS I32) TO(9) BY(4) DO
    { inclusive := inclusive * 10 + value; };
    LOOP VALUE(value) FROM(1 AS I32) UNTIL(9) BY(4) DO
    { exclusive := exclusive * 10 + value; };
    TEST_ASSERT(inclusive == 159);
    TEST_ASSERT(exclusive == 15);
  }

  DOC <$ Numeric loops capture their start, endpoint and stride before body mutations of the original variables. $>
  ::captured_bounds
    DUAL_TEST
  {
    VAR start I32 := 1;
    VAR end I32 := 9;
    VAR step I32 := 4;
    VAR sequence I32 := 0;
    LOOP VALUE(value) FROM(start) TO(end) BY(step) DO
    {
      sequence := sequence * 10 + value;
      start := 41;
      end := 2;
      step := 1;
    };
    TEST_ASSERT(sequence == 159);
    TEST_ASSERT(start == 41);
    TEST_ASSERT(end == 2);
    TEST_ASSERT(step == 1);
  }
  DOC <$ Explicit binding types determine sequence arithmetic and iterator storage. $>
  ::typed_bindings
    DUAL_TEST
  {
    VAR count SZ := 4;
    VAR total SZ := 0;
    LOOP VALUE(index SZ) FROM(0) UNTIL(count) DO
    {
      TEST_ASSERT(SAME_TYPES(DECLTYPE(index), SZ));
      total += index;
    };
    TEST_ASSERT(total == 6);
    VAR digits I32 := 0;
    LOOP VALUE(value I32) FROM(1) TO(9) BY(4) DO
    { digits := digits * 10 + value; };
    TEST_ASSERT(digits == 159);
    digits := 0;
    LOOP ITER(cursor I32) START(1) LIMIT(10) BY(4) DO
    { digits := digits * 10 + cursor; };
    TEST_ASSERT(digits == 159);
  }

}
