LANGUAGE QUXLANG EN 0.0;

::nominal_template_tests NAMESPACE
{
  DOC <$ Preserves an integer while testing enclosing-scope lookup in enum expressions. $>
  ::identity
    FUNCTION(@value U32): U32 { RETURN value; }

  DOC <$ Parameterizes an enum's representation width and highest declared value. $>
  ::code
    TEMPLATE(@width VALUE U32, @maximum VALUE U32)
    ENUM BITS(identity(@value width)) [zero DEFAULT = 0, high = identity(@value maximum)];

  DOC <$ Parameterizes flag storage width while retaining the same three logical flags. $>
  ::permissions
    TEMPLATE(@width VALUE U32)
    FLAGSET BITS(width) [read = 1, write = 2, execute = 4];

  DOC <$ Selects a five-bit enum instantiation. $>
  ::narrow_code ALIAS code#(@width 5, @maximum 17);
  DOC <$ Selects a byte enum instantiation. $>
  ::broad_code ALIAS code#(@width 8, @maximum 255);
  DOC <$ Selects a three-bit flagset instantiation. $>
  ::narrow_flags ALIAS permissions#(@width 3);
  DOC <$ Selects a byte flagset instantiation. $>
  ::broad_flags ALIAS permissions#(@width 8);

  DOC <$ Enum templates retain value arguments in nominal identity and evaluate width and enumerator values in their instantiation context. $>
  ::enum_instantiations
    DUAL_TEST
  {
    VAR first narrow_code;
    VAR second broad_code;
    TEST_ASSERT(first == narrow_code::zero);
    TEST_ASSERT(second == broad_code::zero);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value narrow_code::high) == 17);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value broad_code::high) == 255);
    TEST_ASSERT(SAME_TYPES(narrow_code, code#(@maximum 17, @width 5)));
    TEST_ASSERT(SAME_TYPES(narrow_code, broad_code) == FALSE);
  }

  DOC <$ Flagset templates preserve generated operations and remain distinct across representation widths. $>
  ::flagset_instantiations
    DUAL_TEST
  {
    VAR first narrow_flags := narrow_flags::read #|| narrow_flags::execute;
    VAR second broad_flags := broad_flags::write;
    TEST_ASSERT(first.read);
    TEST_ASSERT(first.execute);
    TEST_ASSERT(first.write == FALSE);
    TEST_ASSERT(second.write);
    TEST_ASSERT(second.read == FALSE);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value first) == 5);
    TEST_ASSERT(enum_flagset_value_tests::serialized_byte(@value second) == 2);
    TEST_ASSERT(SAME_TYPES(narrow_flags, broad_flags) == FALSE);
  }

  DOC <$ Gives identical fixed enum values distinct nominal identities through a type parameter. $>
  ::tagged
    TEMPLATE(@T:tag_type TYPE) ENUM [zero DEFAULT = 0, one = 1];

  DOC <$ Enum type parameters distinguish instantiations even when no enumerator expression depends on them. $>
  ::type_parameter_identity
    DUAL_TEST
  {
    VAR first tagged#I32;
    VAR second tagged#I64;
    TEST_ASSERT(first == tagged#(I32)::zero);
    TEST_ASSERT(second == tagged#(I64)::zero);
    first := tagged#(I32)::one;
    TEST_ASSERT(first != tagged#(I32)::zero);
    TEST_ASSERT(second == tagged#(I64)::zero);
    TEST_ASSERT(SAME_TYPES(tagged#I32, tagged#I64) == FALSE);
  }
}
