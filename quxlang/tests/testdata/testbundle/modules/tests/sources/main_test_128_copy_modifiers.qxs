LANGUAGE QUXLANG EN 0.0;

::copy_modifier_tests NAMESPACE
{
  ::noncopyable DOC <$ Suppresses generated copy construction and assignment while permitting movement. $>
    STRUCT NOT_COPYABLE { .value VAR I32; }
  ::no_implicit_copy DOC <$ Requests suppression of an implicit copy constructor. $>
    STRUCT NO_IMPLICIT_COPY { .value VAR I32; }

  ::noncopyable_move DOC <$ A noncopyable value can transfer its scalar state through generated move construction. $>
    DUAL_TEST
  {
    VAR source noncopyable;
    source.value := 17;
    VAR moved noncopyable := MOVE(source);
    ASSERT(moved.value == 17);
    moved.value := 29;
    ASSERT(moved.value == 29);
  }

  ::noncopyable_rejects_copy DOC <$ A plain copy cannot bypass the structure's copy restriction. $>
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR source noncopyable;
    VAR copied noncopyable := source;
  }

  ::noncopyable_rejects_assignment DOC <$ Generated assignment cannot copy a noncopyable value. $>
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    VAR source noncopyable;
    VAR target noncopyable;
    target := source;
  }

  ::implicit_copy_rejected DOC <$ NO_IMPLICIT_COPY prevents ordinary copy initialization without a declared copy constructor. $>
    STATIC_TEST EXPECT_COMPILATION_FAILURE KNOWN_BROKEN
  {
    VAR source no_implicit_copy;
    VAR copied no_implicit_copy := source;
  }
}
