LANGUAGE QUXLANG EN 0.0;

::global_initialization_tests NAMESPACE
{
  DOC <$ Records the dependency order of three global initializers. $>
  ::events
    VAR CONSTEXPR_OK I32;

  DOC <$ Supplies the first dependency exactly once. $>
  ::initialize_base
    FUNCTION(): I32
  {
    events := events * 10 + 1;
    RETURN 7;
  }

  DOC <$ Reads the base before completing its own initialization. $>
  ::initialize_middle
    FUNCTION(): I32
  {
    VAR value I32 := base * 3;
    events := events * 10 + 2;
    RETURN value;
  }

  DOC <$ Reuses the initialized base through a second dependency path. $>
  ::initialize_final
    FUNCTION(): I32
  {
    VAR value I32 := middle + base;
    events := events * 10 + 3;
    RETURN value;
  }

  DOC <$ Depends on both the middle and base globals. $>
  ::final_value
    VAR CONSTEXPR_OK I32 := initialize_final();
  DOC <$ Depends on the later-declared base global. $>
  ::middle
    VAR CONSTEXPR_OK I32 := initialize_middle();
  DOC <$ Initializes through a function with an observable side effect. $>
  ::base
    VAR CONSTEXPR_OK I32 := initialize_base();

  DOC <$ Returns the same final global through repeated function calls. $>
  ::read_final
    FUNCTION(): MUT& I32 { RETURN final_value; }

  DOC <$ Dependencies initialize before their consumers, and repeated reads and mutation never rerun initializers. $>
  ::dependent_initialization_once
    DUAL_TEST
  {
    TEST_ASSERT(read_final() == 28);
    TEST_ASSERT(middle == 21);
    TEST_ASSERT(base == 7);
    TEST_ASSERT(events == 123);
    VAR first MUT& I32 := read_final();
    VAR second MUT& I32 := read_final();
    TEST_ASSERT(first<- == second<-);
    first := 99;
    TEST_ASSERT(read_final() == 99);
    base := 11;
    TEST_ASSERT(middle == 21);
    TEST_ASSERT(read_final() == 99);
    TEST_ASSERT(events == 123);
    base := 7;
    final_value := 28;
    TEST_ASSERT(read_final() == 28);
    TEST_ASSERT(events == 123);
  }
}

::global_retry_tests NAMESPACE
{
  DOC <$ Counts attempts to initialize a global whose first attempt throws. $>
  ::attempts
    VAR CONSTEXPR_OK I32;
  DOC <$ Records temporary cleanup during each initialization attempt. $>
  ::events
    VAR CONSTEXPR_OK I32;

  DOC <$ Fails once after constructing a local and succeeds on the next attempt. $>
  ::initialize
    FUNCTION(): I32
  {
    attempts++;
    VAR record control_flow_tests::exit_record :(@events events, @digit attempts);
    IF (attempts == 1) { THROW 17 AS I32; }
    RETURN 40;
  }

  DOC <$ Publishes its value only after successful initialization. $>
  ::value
    VAR CONSTEXPR_OK I32 := initialize();

  DOC <$ Failed initialization cleans up and releases its guard, while success suppresses later retries. $>
  ::retry_after_exception
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR first I32 := value;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 17);
      TEST_ASSERT(attempts == 1);
      TEST_ASSERT(events == 1);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == 40);
    TEST_ASSERT(attempts == 2);
    TEST_ASSERT(events == 12);
    value := 99;
    TEST_ASSERT(value == 99);
    TEST_ASSERT(attempts == 2);
    TEST_ASSERT(events == 12);
  }
}
