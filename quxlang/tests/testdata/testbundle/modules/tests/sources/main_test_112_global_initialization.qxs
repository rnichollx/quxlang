LANGUAGE QUXLANG EN 0.0;

::global_initialization_tests NAMESPACE
{
  ::events DOC <$ Records the dependency order of three global initializers. $>
    VAR CONSTEXPR_OK I32;

  ::initialize_base DOC <$ Supplies the first dependency exactly once. $>
    FUNCTION(): I32
  {
    events := events * 10 + 1;
    RETURN 7;
  }

  ::initialize_middle DOC <$ Reads the base before completing its own initialization. $>
    FUNCTION(): I32
  {
    VAR value I32 := base * 3;
    events := events * 10 + 2;
    RETURN value;
  }

  ::initialize_final DOC <$ Reuses the initialized base through a second dependency path. $>
    FUNCTION(): I32
  {
    VAR value I32 := middle + base;
    events := events * 10 + 3;
    RETURN value;
  }

  ::final_value DOC <$ Depends on both the middle and base globals. $>
    VAR CONSTEXPR_OK I32 := initialize_final();
  ::middle DOC <$ Depends on the later-declared base global. $>
    VAR CONSTEXPR_OK I32 := initialize_middle();
  ::base DOC <$ Initializes through a function with an observable side effect. $>
    VAR CONSTEXPR_OK I32 := initialize_base();

  ::read_final DOC <$ Returns the same final global through repeated function calls. $>
    FUNCTION(): MUT& I32 { RETURN final_value; }

  ::dependent_initialization_once DOC <$ Dependencies initialize before their consumers, and repeated reads and mutation never rerun initializers. $>
    DUAL_TEST
  {
    TEST_ASSERT(read_final() == 28);
    TEST_ASSERT(middle == 21);
    TEST_ASSERT(base == 7);
    TEST_ASSERT(events == 123);
    VAR first MUT& I32 := read_final();
    VAR second MUT& I32 := read_final();
    TEST_ASSERT(first<- == second<-);
    first := 99;
    TEST_ASSERT(read_final() == 99);
    base := 11;
    TEST_ASSERT(middle == 21);
    TEST_ASSERT(read_final() == 99);
    TEST_ASSERT(events == 123);
    base := 7;
    final_value := 28;
    TEST_ASSERT(read_final() == 28);
    TEST_ASSERT(events == 123);
  }
}

::global_retry_tests NAMESPACE
{
  ::attempts DOC <$ Counts attempts to initialize a global whose first attempt throws. $>
    VAR CONSTEXPR_OK I32;
  ::events DOC <$ Records temporary cleanup during each initialization attempt. $>
    VAR CONSTEXPR_OK I32;

  ::initialize DOC <$ Fails once after constructing a local and succeeds on the next attempt. $>
    FUNCTION(): I32
  {
    attempts++;
    VAR record control_flow_tests::exit_record :(@events events, @digit attempts);
    IF (attempts == 1) { THROW 17 AS I32; }
    RETURN 40;
  }

  ::value DOC <$ Publishes its value only after successful initialization. $>
    VAR CONSTEXPR_OK I32 := initialize();

  ::retry_after_exception DOC <$ Failed initialization cleans up and releases its guard, while success suppresses later retries. $>
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_LAYOUTLESS)
  {
    VAR caught BOOL := FALSE;
    TRY
    {
      VAR first I32 := value;
      TEST_ASSERT(FALSE);
    }
    CATCH error CONST& I32
    {
      TEST_ASSERT(error == 17);
      TEST_ASSERT(attempts == 1);
      TEST_ASSERT(events == 1);
      caught := TRUE;
    }
    TEST_ASSERT(caught);
    TEST_ASSERT(value == 40);
    TEST_ASSERT(attempts == 2);
    TEST_ASSERT(events == 12);
    value := 99;
    TEST_ASSERT(value == 99);
    TEST_ASSERT(attempts == 2);
    TEST_ASSERT(events == 12);
  }
}
