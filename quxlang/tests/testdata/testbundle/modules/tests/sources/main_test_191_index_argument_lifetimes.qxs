LANGUAGE QUXLANG EN 0.0;

::index_argument_lifetime_tests NAMESPACE
{
  DOC <$ Index operators observe owned argument lifetimes and distinguish value from address dispatch. $>
  ::indexed
    STRUCT
  {
    .value VAR SZ;
    .events VAR MUT->I32;
    DOC <$ Consumes an index while its owned predecessor remains alive. $>
    .OPERATOR[]
      FUNCTION(%first CONST& short_circuit_tests::temporary, %second SZ) MUT: SZ
    {
      TEST_ASSERT(first.alive-> == 1);
      .events-> := .events-> * 10 + 4;
      RETURN .value + second;
    }
    DOC <$ Returns storage only after observing both live index arguments. $>
    .OPERATOR[&]
      FUNCTION(%first CONST& short_circuit_tests::temporary, %second SZ) MUT: MUT->SZ
    {
      TEST_ASSERT(first.alive-> == 1);
      TEST_ASSERT(second == 7);
      .events-> := .events-> * 10 + 5;
      RETURN .value<-;
    }
  }

  DOC <$ Records evaluation of the indexed object before index arguments. $>
  ::receiver
    FUNCTION(@object MUT& indexed): MUT& indexed
  {
    object.events-> := object.events-> * 10 + 1;
    RETURN object;
  }

  DOC <$ Throws after recording the second index operand. $>
  ::throwing_index
    FUNCTION(@events MUT& I32): SZ
  {
    events := events * 10 + 3;
    THROW I32(@OTHER 42);
  }

  DOC <$ Owned index arguments survive operator invocation and expire before the next statement for both bracket spellings. $>
  ::normal_cleanup
    DUAL_TEST
  {
    VAR events I32 := 0;
    VAR alive I32 := 0;
    VAR object indexed;
    object.events := events<-;
    object.value := 11;
    VAR result SZ := receiver(@object object)[short_circuit_tests::temporary(@events events, @alive alive, @digit 2), multidimensional_index_tests::coordinate(@events events, @digit 3, @value 7)];
    TEST_ASSERT(result == 18);
    TEST_ASSERT(events == 12346);
    TEST_ASSERT(alive == 0);
    events := 0;
    VAR address MUT->SZ := receiver(@object object)[&short_circuit_tests::temporary(@events events, @alive alive, @digit 2), multidimensional_index_tests::coordinate(@events events, @digit 3, @value 7)];
    TEST_ASSERT(events == 12356);
    TEST_ASSERT(alive == 0);
    TEST_ASSERT(address == object.value<-);
    address-> := 29;
    TEST_ASSERT(object.value == 29);
  }

  DOC <$ Failure of the second index destroys its completed predecessor and skips either index operator body. $>
  ::throwing_cleanup
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR mode I32 := 0;
    LOOP WHILE (mode < 2) DO
    {
      VAR events I32 := 0;
      VAR alive I32 := 0;
      VAR object indexed;
      object.events := events<-;
      object.value := 11;
      VAR caught BOOL := FALSE;
      TRY
      {
        IF (mode == 0)
        {
          receiver(@object object)[short_circuit_tests::temporary(@events events, @alive alive, @digit 2), throwing_index(@events events)];
        }
        ELSE
        {
          receiver(@object object)[&short_circuit_tests::temporary(@events events, @alive alive, @digit 2), throwing_index(@events events)];
        }
        TEST_ASSERT(FALSE);
      }
      CATCH error CONST& I32
      {
        TEST_ASSERT(error == 42);
        TEST_ASSERT(events == 1236);
        TEST_ASSERT(alive == 0);
        caught := TRUE;
      }
      TEST_ASSERT(caught);
      TEST_ASSERT(object.value == 11);
      mode++;
    }
  }
}
