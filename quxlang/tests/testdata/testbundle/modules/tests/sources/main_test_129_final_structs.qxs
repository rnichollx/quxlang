LANGUAGE QUXLANG EN 0.0;

::final_struct_tests NAMESPACE
{
  DOC <$ A final scalar record retains ordinary value operations. $>
  ::value
    STRUCT FINAL { .number VAR I32; }
  DOC <$ Final records can be stored as ordinary fields. $>
  ::contained
    STRUCT { .element VAR value; }
  DOC <$ Direct inheritance cannot extend a final record. $>
  ::invalid_direct
    STRUCT { .base BASE value; }
  DOC <$ An alias preserves the final restriction of its target. $>
  ::value_alias
    ALIAS value;
  DOC <$ Aliasing a final base cannot bypass its restriction. $>
  ::invalid_alias
    STRUCT { .base BASE value_alias; }
  DOC <$ Virtual inheritance cannot extend a final record. $>
  ::invalid_virtual
    STRUCT { .base VIRTUAL_BASE value; }

  DOC <$ Copy, assignment, movement and containment preserve independent final values. $>
  ::ordinary_operations
    DUAL_TEST
  {
    VAR original value;
    original.number := 17;
    VAR copied value := original;
    original.number := 29;
    TEST_ASSERT(copied.number == 17);
    VAR assigned value;
    assigned := copied;
    copied.number := 41;
    TEST_ASSERT(assigned.number == 17);
    VAR moved value := MOVE(copied);
    TEST_ASSERT(moved.number == 41);
    original <-> moved;
    TEST_ASSERT(original.number == 41);
    TEST_ASSERT(moved.number == 29);
    VAR owner contained;
    owner.element := assigned;
    assigned.number := 53;
    TEST_ASSERT(owner.element.number == 17);
  }

  DOC <$ Instantiating a direct derived type rejects its final base. $>
  ::reject_direct
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR object invalid_direct; }

  DOC <$ Resolving an aliased base still enforces FINAL. $>
  ::reject_alias
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR object invalid_alias; }

  DOC <$ Final base rejection also applies to virtual inheritance. $>
  ::reject_virtual
    STATIC_TEST EXPECT_COMPILATION_FAILURE
  { VAR object invalid_virtual; }

  DOC <$ A final leaf may itself inherit and override virtual behavior. $>
  ::leaf
    STRUCT POLYMORPHIC FINAL
  {
    .base BASE inheritance_tests::dispatch_base;
    DOC <$ Dispatches to the stored value of the final leaf. $>
    .value
      FUNCTION() CONST VIRTUAL(OVERRIDE): I32
    { RETURN .stored_value; }
  }

  DOC <$ Final leaves preserve virtual dispatch and independent copies through base references. $>
  ::final_leaf_dispatch
    DUAL_TEST KNOWN_BROKEN_IF(ARCH_IS_JVM)
  {
    VAR original leaf;
    original.stored_value := 61;
    VAR copied leaf := original;
    original.stored_value := 73;
    TEST_ASSERT(inheritance_tests::call_virtual_value(@object original) == 73);
    TEST_ASSERT(inheritance_tests::call_virtual_value(@object copied) == 61);
    TEST_ASSERT(inheritance_tests::call_base_value_directly(@object original) == 1);
  }
}
