LANGUAGE QUXLANG EN 0.0;
IMPORT std;

::runtime_metadata_tests NAMESPACE
{
  ::test_names_and_skip_flags DOC <$ Runtime test names and known-broken flags describe the same entries, including enabled and conditionally skipped fixtures. $>
    UNIT_TEST
  {
    TEST_ASSERT(UNIT_TEST_COUNT > 0);
    TEST_ASSERT(UNIT_TEST_NAMES??);
    TEST_ASSERT(UNIT_TEST_KNOWN_BROKEN??);
    TEST_ASSERT(UNIT_TEST_PROC??);
    VAR index SZ := 0;
    VAR matched SZ := 0;
    LOOP WHILE (index < UNIT_TEST_COUNT) DO
    {
      VAR name STRING_CONSTANT := UNIT_TEST_NAMES[index];
      TEST_ASSERT(name.BEGIN() != name.END());
      VAR text std::string := name;
      IF (text == "MODULE(tests)::known_broken_tests::unconditional_unit")
      {
        TEST_ASSERT(UNIT_TEST_KNOWN_BROKEN[index]);
        matched++;
      }
      IF (text == "MODULE(tests)::known_broken_tests::unconditional_dual")
      {
        TEST_ASSERT(UNIT_TEST_KNOWN_BROKEN[index]);
        matched++;
      }
      IF (text == "MODULE(tests)::known_broken_tests::conditional_dual")
      {
        TEST_ASSERT(UNIT_TEST_KNOWN_BROKEN[index] == known_broken_tests::skip_condition);
        matched++;
      }
      IF (text == "MODULE(tests)::known_broken_tests::enabled_unit")
      {
        TEST_ASSERT(UNIT_TEST_KNOWN_BROKEN[index] == FALSE);
        matched++;
      }
      index++;
    }
    TEST_ASSERT(matched == 4);
  }

  ::selected_stepping_bounds DOC <$ Startup selects an existing stepping and exposes its executable dispatch tables. $>
    UNIT_TEST
  {
    TEST_ASSERT(STEPPING_COUNT > 0);
    TEST_ASSERT(ACTIVE_STEPPING < STEPPING_COUNT);
    TEST_ASSERT(MAIN_FUNCTION_ARRAY??);
    TEST_ASSERT(POST_DETECT_FUNCTION_ARRAY??);
  }
}
