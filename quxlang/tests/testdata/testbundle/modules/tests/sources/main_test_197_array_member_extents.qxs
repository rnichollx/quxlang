LANGUAGE QUXLANG EN 0.0;

::array_member_extent_tests NAMESPACE
{
  DOC <$ Places a fixed array before two scalar fields. $>
  ::array_first
    TEMPLATE(@count VALUE SZ) STRUCT
  {
    .cells VAR [count]I32;
    .before VAR I32;
    .after VAR I32;
  }

  DOC <$ Places a fixed array between two scalar fields. $>
  ::array_middle
    TEMPLATE(@count VALUE SZ) STRUCT
  {
    .before VAR I32;
    .cells VAR [count]I32;
    .after VAR I32;
  }

  DOC <$ Checks independent default initialization and subsequent mutation of array and scalar fields. $>
  ::check_fields
    TEMPLATE(@T TYPE AUTO, @count VALUE SZ) FUNCTION()
  {
    VAR object T;
    TEST_ASSERT(object.before == 0);
    TEST_ASSERT(object.after == 0);
    object.before := 11;
    object.after := 29;
    VAR index SZ := 0;
    LOOP WHILE (index < count) DO
    {
      TEST_ASSERT(object.cells[index] == 0);
      object.cells[index] := 17;
      index++;
    }
    TEST_ASSERT(object.before == 11);
    TEST_ASSERT(object.after == 29);
    index := 0;
    LOOP WHILE (index < count) DO
    {
      TEST_ASSERT(object.cells[index] == 17);
      index++;
    }
  }

  DOC <$ A 0-element array in the first field position has independent storage and default values. $>
  ::first_0
    DUAL_TEST
  {
    check_fields#(@T array_first#(@count 0), @count 0)();
  }

  DOC <$ A 1-element array in the first field position has independent storage and default values. $>
  ::first_1
    DUAL_TEST
  {
    check_fields#(@T array_first#(@count 1), @count 1)();
  }

  DOC <$ A 2-element array in the first field position has independent storage and default values. $>
  ::first_2
    DUAL_TEST
  {
    check_fields#(@T array_first#(@count 2), @count 2)();
  }

  DOC <$ A 6-element array in the first field position has independent storage and default values. $>
  ::first_6
    DUAL_TEST
  {
    check_fields#(@T array_first#(@count 6), @count 6)();
  }

  DOC <$ A 0-element array in the middle field position has independent storage and default values. $>
  ::middle_0
    DUAL_TEST
  {
    check_fields#(@T array_middle#(@count 0), @count 0)();
  }

  DOC <$ A 1-element array in the middle field position has independent storage and default values. $>
  ::middle_1
    DUAL_TEST
  {
    check_fields#(@T array_middle#(@count 1), @count 1)();
  }

  DOC <$ A 2-element array in the middle field position has independent storage and default values. $>
  ::middle_2
    DUAL_TEST
  {
    check_fields#(@T array_middle#(@count 2), @count 2)();
  }

  DOC <$ A 6-element array in the middle field position has independent storage and default values. $>
  ::middle_6
    DUAL_TEST
  {
    check_fields#(@T array_middle#(@count 6), @count 6)();
  }
}
