LANGUAGE QUXLANG EN 0.0;

::CHECK_STACK INCLUDE_IF(OS_WINDOWS) ASM_PROCEDURE X64
{
  PUSH RCX
  PUSH RAX
  CMP RAX, 4096
  LEA RCX, [RSP + 24]
  JB check_tail
LABEL check_page;
  SUB RCX, 4096
  TEST [RCX], RCX
  SUB RAX, 4096
  CMP RAX, 4096
  JA check_page
LABEL check_tail;
  SUB RCX, RAX
  TEST [RCX], RCX
  POP RAX
  POP RCX
  RET
}

::PROGRAM_START INCLUDE_IF(OS_WINDOWS) ASM_PROCEDURE X64
{
  SUB RSP, 40
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV R10, RAX
  MOVABS RAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [RAX], R10
  MOVABS RAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV RAX, [RAX]
  MOV RAX, [RAX + R10 * 8]
  CALL RAX
  MOV RAX, 127
  ADD RSP, 40
  RET
}
