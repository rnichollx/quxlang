LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

PRIVATE(MODULE) ::layer3_bitmap_word DOC <$
  Matches the target's native atomic integer width: 64 bits on 64-bit targets
  and 32 bits on 32-bit targets, using the target-sized unsigned integer type.
  $> ALIAS UINTPTR;
PRIVATE(MODULE) ::layer3_bitmap_word_bits STATIC SZ := SIZEOF(layer3_bitmap_word) * 8;

PRIVATE(MODULE) ::layer4_region_backing_limit STATIC SZ := 16;

PRIVATE(MODULE) ::layer3_region_exclusive STATIC U32 := 2147483648;
PRIVATE(MODULE) ::layer3_region_requested STATIC U32 := 1073741824;
PRIVATE(MODULE) ::layer3_region_readers STATIC U32 := 1073741823;

PRIVATE(MODULE) ::layer3_region_control DOC <$
  Retains stable identity after backing retirement. Region access requires shared
  or exclusive ownership. Intrusive links require the allocation-class mutex.
  The complete 32-bit semaphore is supported by every native address-wait API.
  $> STRUCT
{
  .semaphore VAR ATOMIC#U32;
  .region VAR MUT->layer3_region;
  .next VAR MUT->layer3_region_control;
  .prev VAR MUT->layer3_region_control;

  .try_shared DOC <$ Acquires one shared region use without waiting. $>
    FUNCTION(): BOOL
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE ((observed #&& layer3_region_exclusive) == 0
      && (observed #&& layer3_region_readers) != layer3_region_readers) DO
    {
      IF (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQUIRE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed + 1))
      { RETURN TRUE; }
    }
    RETURN FALSE;
  }

  .shared DOC <$ Acquires shared access, registering notification before sleeping. $>
    FUNCTION()
  {
    LOOP WHILE (.try_shared() == FALSE) DO
    {
      VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
      LOOP WHILE ((observed #&& layer3_region_exclusive) != 0) DO
      {
        VAR requested U32 := observed #|| layer3_region_requested;
        IF (observed == requested || .semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_RELAXED, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED requested))
        {
          wait_at_u32_address(@address IBC_GETADDR(@PTR .semaphore<-), @expected requested);
          BREAK;
        }
      }
    }
  }

  .release_shared DOC <$ Completes all region accesses before dropping the reader count. $>
    FUNCTION()
  { .semaphore.FETCH_SUBTRACT#ATOMIC_RELEASE(1); }

  .try_exclusive DOC <$ Requests exclusive ownership and drains existing readers. $>
    FUNCTION(): BOOL
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE ((observed #&& layer3_region_exclusive) == 0) DO
    {
      IF (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQUIRE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed #|| layer3_region_exclusive))
      {
        LOOP WHILE ((.semaphore.LOAD#ATOMIC_ACQUIRE() #&& layer3_region_readers) != 0) DO { yield_thread_execution(); }
        RETURN TRUE;
      }
    }
    RETURN FALSE;
  }

  .release_exclusive DOC <$ Clears ownership and fulfills registered notification obligations. $>
    FUNCTION()
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_RELEASE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED 0) == FALSE) DO { }
    IF ((observed #&& layer3_region_requested) != 0)
    { notify_all_at_address(@address IBC_GETADDR(@PTR .semaphore<-), @size SIZEOF(U32)); }
  }

  .unlink DOC <$ Removes a published control under its class mutex. $>
    FUNCTION()
  {
    .prev->.next := .next;
    .next->.prev := .prev;
  }
}

PRIVATE(MODULE) ::layer3_region DOC <$
  Stores metadata before aligned payload slots. Set bitmap bits include all
  pointers cached in plates and all live application allocations. Unused bits
  stay clear and are excluded from fullness checks.
  $> STRUCT
{
  .control VAR MUT->layer3_region_control;
  .class_control VAR MUT->layer3_region_class;
  .available VAR ATOMIC#U32;
  .bitmap VAR [allocator_region_bitmap_word_count]ATOMIC#layer3_bitmap_word;
  .mapping VAR ADDRESS;
  .next_free VAR MUT->layer3_region;
}

PRIVATE(MODULE) ::layer3_region_class DOC <$
  Owns circular available, fully issued, and detached control lists. Layout is
  initialized under the mutex before first publication and remains immutable.
  $> STRUCT
{
  .mtx VAR mutex;
  .available VAR layer3_region_control;
  .issued VAR layer3_region_control;
  .detached VAR layer3_region_control;
  .block_size VAR SZ;
  .payload_offset VAR SZ;
  .slot_count VAR SZ;

  .initialize DOC <$ Establishes sentinel links and immutable slot geometry once. $>
    FUNCTION(@size SZ, @align SZ)
  {
    IF (.block_size != 0) { RETURN; }
    .available.next := .available<-;
    .available.prev := .available<-;
    .issued.next := .issued<-;
    .issued.prev := .issued<-;
    .detached.next := .detached<-;
    .detached.prev := .detached<-;
    .block_size := size;
    .payload_offset := ((SIZEOF(layer3_region) + align - 1) / align) * align;
    .slot_count := (allocator_slab_region_size - .payload_offset) / size;
  }
}

PRIVATE(MODULE) ::layer3_region_insert DOC <$ Inserts a control before a circular-list position under its mutex. $>
  FUNCTION(@node MUT->layer3_region_control, @before MUT->layer3_region_control)
{
  node->.next := before;
  node->.prev := before->.prev;
  before->.prev->.next := node;
  before->.prev := node;
}

PRIVATE(MODULE) ::layer4_region_pool DOC <$ Retains a bounded cross-class stack of unassigned regions. $> STRUCT
{
  .mtx VAR mutex;
  .head VAR MUT->layer3_region;
  .count VAR SZ;
}
PRIVATE(MODULE) ::layer4_region_backing VAR layer4_region_pool;

PRIVATE(MODULE) ::layer4_region_acquire DOC <$
  Acquires reusable backing or maps an aligned region. The original mapping is
  retained for whole-mapping release on platforms that cannot unmap subranges.
  $> FUNCTION(): MUT->layer3_region
{
  layer4_region_backing.mtx.lock();
  VAR result MUT->layer3_region := layer4_region_backing.head;
  IF (result??)
  {
    layer4_region_backing.head := result->.next_free;
    layer4_region_backing.count--;
  }
  layer4_region_backing.mtx.unlock();
  IF (result??) { RETURN result; }
  VAR mapping ADDRESS := layer5_map_region(@bytes allocator_slab_region_size * 2);
  IF (mapping!?) { RETURN result; }
  VAR aligned ADDRESS := mapping;
  IF (aligned % allocator_slab_region_size != 0)
  { aligned := aligned + (allocator_slab_region_size - (aligned % allocator_slab_region_size)); }
  VAR storage MUT->TYPED_STORAGE(layer3_region) := ADDRESS_LAUNDER_DISCOVER_EXISTING aligned TO MUT->TYPED_STORAGE(layer3_region);
  result := PLACE AT(storage->) layer3_region;
  result->.mapping := mapping;
  RETURN result;
}

PRIVATE(MODULE) ::layer4_region_release DOC <$ Caches up to sixteen empty regions and unmaps excess backing outside the pool lock. $>
  FUNCTION(@region MUT->layer3_region)
{
  layer4_region_backing.mtx.lock();
  IF (layer4_region_backing.count < layer4_region_backing_limit)
  {
    region->.next_free := layer4_region_backing.head;
    layer4_region_backing.head := region;
    layer4_region_backing.count++;
    layer4_region_backing.mtx.unlock();
    RETURN;
  }
  layer4_region_backing.mtx.unlock();
  VAR mapping ADDRESS := region->.mapping;
  layer5_unmap_region(@address mapping, @bytes allocator_slab_region_size * 2);
}

PRIVATE(MODULE) ::layer3_region_controls DOC <$ Allocates a stable chunk of controls and publishes them on the detached list, returning false on allocation failure. $>
  FUNCTION(@root MUT& layer3_region_class): BOOL
{
  VAR mapping ADDRESS := layer5_map_region(@bytes allocator_slab_region_size);
  IF (mapping!?) { RETURN FALSE; }
  VAR count SZ := allocator_slab_region_size / CELLSIZEOF(layer3_region_control);
  // Construction precedes publication; mapping and initialization occur outside the list lock.
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
  {
    VAR storage MUT->TYPED_STORAGE(layer3_region_control) := ADDRESS_LAUNDER_DISCOVER_EXISTING
      (mapping + index * CELLSIZEOF(layer3_region_control)) TO MUT->TYPED_STORAGE(layer3_region_control);
    PLACE AT(storage->) layer3_region_control;
  }
  root.mtx.lock();
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
  {
    VAR node MUT->layer3_region_control := ADDRESS_LAUNDER_DISCOVER_EXISTING
      (mapping + index * CELLSIZEOF(layer3_region_control)) TO MUT->layer3_region_control;
    layer3_region_insert(@node node, @before root.detached<-);
  }
  root.mtx.unlock();
  RETURN TRUE;
}

PRIVATE(MODULE) ::layer3_region_empty DOC <$ Checks whether every payload slot has been returned while region access is held. $>
  FUNCTION(@region MUT->layer3_region): BOOL
{
  VAR words SZ := (region->.class_control->.slot_count + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(words) DO
  { IF (region->.bitmap[index].LOAD#ATOMIC_ACQUIRE() != 0) { RETURN FALSE; } }
  RETURN TRUE;
}

PRIVATE(MODULE) ::layer3_region_full DOC <$ Checks every valid slot while region access is held. $>
  FUNCTION(@region MUT->layer3_region): BOOL
{
  VAR slots SZ := region->.class_control->.slot_count;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL((slots + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits) DO
  {
    VAR mask layer3_bitmap_word := (0 AS layer3_bitmap_word) #!!;
    IF (slots - index * layer3_bitmap_word_bits < layer3_bitmap_word_bits) { mask := ((1 AS layer3_bitmap_word) #++ (slots - index * layer3_bitmap_word_bits)) - 1; }
    IF (region->.bitmap[index].LOAD#ATOMIC_ACQUIRE() != mask) { RETURN FALSE; }
  }
  RETURN TRUE;
}

PRIVATE(MODULE) ::layer3_region_retire DOC <$ Detaches empty backing under exclusive access before returning it to the shared pool. $>
  FUNCTION(@control MUT->layer3_region_control)
{
  IF (control->.try_exclusive() == FALSE) { RETURN; }
  VAR region MUT->layer3_region := control->.region;
  IF (region?? && layer3_region_empty(@region region))
  {
    VAR root MUT->layer3_region_class := region->.class_control;
    root->.mtx.lock();
    region->.available.STORE#ATOMIC_RELEASE(0);
    VAR no_region MUT->layer3_region;
    control->.region := no_region;
    control->.unlink();
    layer3_region_insert(@node control, @before root->.detached<-);
    root->.mtx.unlock();
    layer4_region_release(@region region);
  }
  control->.release_exclusive();
}

PRIVATE(MODULE) ::layer3_region_return_batch DOC <$
  Returns the final region group from an address-sorted plate. One shared
  region access protects all returns, with one atomic update per bitmap word.
  Availability publication and retirement checks occur once for the group.
  $> TEMPLATE(@count VALUE SZ)
  FUNCTION(@cache MUT& addr_cache#(@count count))
{
  ASSERT(cache.used > 0, "A region return batch requires at least one address.");
  VAR address ADDRESS := PUN cache.entries[cache.used - 1] AS ADDRESS;
  VAR base ADDRESS := address - (address % allocator_slab_region_size);
  VAR region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING base TO MUT->layer3_region;
  VAR control MUT->layer3_region_control := region->.control;
  control->.shared();
  VAR root MUT->layer3_region_class := region->.class_control;
  LOOP WHILE (cache.used > 0) DO
  {
    address := PUN cache.entries[cache.used - 1] AS ADDRESS;
    IF (address - (address % allocator_slab_region_size) != base) { BREAK; }
    VAR index SZ := ((address - base) - root->.payload_offset) / root->.block_size;
    VAR word SZ := index / layer3_bitmap_word_bits;
    VAR mask layer3_bitmap_word := 0;
    LOOP WHILE (cache.used > 0) DO
    {
      address := PUN cache.entries[cache.used - 1] AS ADDRESS;
      IF (address - (address % allocator_slab_region_size) != base) { BREAK; }
      index := ((address - base) - root->.payload_offset) / root->.block_size;
      IF (index / layer3_bitmap_word_bits != word) { BREAK; }
      VAR bit layer3_bitmap_word := (1 AS layer3_bitmap_word) #++ (index % layer3_bitmap_word_bits);
      ASSERT((mask #&& bit) == 0, "A region return batch contains a duplicate slot.");
      mask := mask #|| bit;
      cache.pop();
    }
    VAR previous layer3_bitmap_word := region->.bitmap[word].FETCH_BIT_AND#ATOMIC_RELEASE(mask #!!);
    ASSERT((previous #&& mask) == mask, "A region slot was returned twice.");
  }
  IF (region->.available.LOAD#ATOMIC_ACQUIRE() == 0)
  {
    root->.mtx.lock();
    IF (region->.available.LOAD#ATOMIC_RELAXED() == 0)
    {
      control->.unlink();
      layer3_region_insert(@node control, @before root->.available.next);
      region->.available.STORE#ATOMIC_RELEASE(1);
    }
    root->.mtx.unlock();
  }
  VAR empty BOOL := layer3_region_empty(@region region);
  control->.release_shared();
  IF (empty) { layer3_region_retire(@control control); }
}

PRIVATE(MODULE) ::layer3_region_return DOC <$
  Returns a single slot through the region batch protocol during uncached deallocation.
  $> FUNCTION(@address ADDRESS)
{
  VAR cache addr_cache#(@count 1);
  cache.push(address);
  layer3_region_return_batch#(@count 1)(@cache cache);
}

PRIVATE(MODULE) ::layer3_region_refill DOC <$
  Claims slots into a privately owned plate. List selection never retains the
  list mutex while acquiring region access, scanning bitmaps, or mapping memory.
  A failed refill returns false and leaves any claimed slots owned by the cache.
  $> TEMPLATE(@count VALUE SZ)
  FUNCTION(@root MUT& layer3_region_class, @cache MUT& addr_cache#(@count count)): BOOL
{
  LOOP WHILE (cache.used < count) DO
  {
    root.mtx.lock();
    VAR control MUT->layer3_region_control := root.available.next;
    VAR busy BOOL := control != root.available<-;
    LOOP WHILE (control != root.available<- &&
      ((control->.semaphore.LOAD#ATOMIC_RELAXED() #&& layer3_region_exclusive) != 0
      || (control->.semaphore.LOAD#ATOMIC_RELAXED() #&& layer3_region_readers) == layer3_region_readers)) DO
    { control := control->.next; }
    IF (control == root.available<-)
    {
      IF (busy) { root.mtx.unlock(); yield_thread_execution(); CONTINUE; }
      control := root.detached.next;
      IF (control == root.detached<-)
      {
        root.mtx.unlock();
        IF (layer3_region_controls(@root root) == FALSE) { RETURN FALSE; }
        CONTINUE;
      }
      root.mtx.unlock();
      IF (control->.try_exclusive() !!) {
        yield_thread_execution();
        CONTINUE;
      }
      IF (control->.region!?)
      {
        VAR region MUT->layer3_region := layer4_region_acquire();
        IF (region!?) { control->.release_exclusive(); RETURN FALSE; }
        region->.control := control;
        region->.class_control := root<-;
        LOOP VALUE(index) FROM(0 AS SZ) UNTIL(allocator_region_bitmap_word_count) DO
        { region->.bitmap[index].STORE#ATOMIC_RELAXED(0); }
        region->.available.STORE#ATOMIC_RELAXED(0);
        root.mtx.lock();
        control->.region := region;
        control->.unlink();
        layer3_region_insert(@node control, @before root.available.next);
        region->.available.STORE#ATOMIC_RELEASE(1);
        root.mtx.unlock();
      }
      control->.release_exclusive();
      CONTINUE;
    }
    root.mtx.unlock();
    IF (control->.try_shared() == FALSE) { yield_thread_execution(); CONTINUE; }
    VAR region MUT->layer3_region := control->.region;
    IF ((region??) == FALSE) { control->.release_shared(); CONTINUE; }
    VAR initial_count SZ := cache.used;
    VAR base ADDRESS := IBC_GETADDR(@PTR region);
    LOOP VALUE(word) FROM(0 AS SZ) UNTIL((root.slot_count + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits) DO
    {
      VAR valid layer3_bitmap_word := (0 AS layer3_bitmap_word) #!!;
      IF (root.slot_count - word * layer3_bitmap_word_bits < layer3_bitmap_word_bits)
      { valid := ((1 AS layer3_bitmap_word) #++ (root.slot_count - word * layer3_bitmap_word_bits)) - 1; }
      VAR observed layer3_bitmap_word := region->.bitmap[word].LOAD#ATOMIC_RELAXED();
      LOOP WHILE (cache.used < count && (observed #&& valid) != valid) DO
      {
        VAR clear layer3_bitmap_word := (observed #!!) #&& valid;
        VAR selected layer3_bitmap_word := 0;
        VAR selected_count SZ := 0;
        VAR remaining SZ := count - cache.used;
        LOOP WHILE (clear != 0 && selected_count < remaining) DO
        {
          VAR bit layer3_bitmap_word := clear #&& ((clear #!!) + 1);
          selected := selected #|| bit;
          clear := clear #^^ bit;
          selected_count++;
        }
        IF (region->.bitmap[word].COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed #|| selected))
        {
          observed := observed #|| selected;
          VAR bit_index SZ := 0;
          LOOP WHILE (selected != 0) DO
          {
            IF ((selected #&& 1) != 0)
            { cache.push(base + root.payload_offset + (word * layer3_bitmap_word_bits + bit_index) * root.block_size); }
            selected := selected #-- 1;
            bit_index++;
          }
        }
      }
      IF (cache.used == count) { BREAK; }
    }
    IF (cache.used == initial_count)
    {
      root.mtx.lock();
      IF (region->.available.LOAD#ATOMIC_RELAXED() != 0)
      { control->.unlink(); layer3_region_insert(@node control, @before root.available<-); }
      root.mtx.unlock();
    }
    control->.release_shared();
    // An exhausted scan can fill part of the plate while consuming the region.
    IF (cache.used < count && control->.try_exclusive())
    {
      region := control->.region;
      IF (region?? && layer3_region_full(@region region))
      {
        root.mtx.lock();
        control->.unlink();
        layer3_region_insert(@node control, @before root.issued<-);
        region->.available.STORE#ATOMIC_RELEASE(0);
        root.mtx.unlock();
      }
      control->.release_exclusive();
    }
  }
  RETURN TRUE;
}
