LANGUAGE QUXLANG EN 0.0;

::x86_cpuid_vendor_is_amd INCLUDE_IF(ARCH_IS_X86) ASM_PROCEDURE X86
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH EBX
  XOR EAX, EAX
  CPUID
  CMP EBX, 0x68747541
  SETE AL
  CMP EDX, 0x69746e65
  SETE DL
  AND AL, DL
  CMP ECX, 0x444d4163
  SETE DL
  AND AL, DL
  MOVZX EAX, AL
  POP EBX
  RET
}

::x86_cpuid_vendor_is_intel INCLUDE_IF(ARCH_IS_X86) ASM_PROCEDURE X86
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH EBX
  XOR EAX, EAX
  CPUID
  CMP EBX, 0x756e6547
  SETE AL
  CMP EDX, 0x49656e69
  SETE DL
  AND AL, DL
  CMP ECX, 0x6c65746e
  SETE DL
  AND AL, DL
  MOVZX EAX, AL
  POP EBX
  RET
}

::DETECT_X86_VENDOR_AMD INCLUDE_IF(ARCH_IS_X86) FUNCTION()
{
  X86_VENDOR_AMD_ENABLED := x86_cpuid_vendor_is_amd();
}

::DETECT_X86_VENDOR_INTEL INCLUDE_IF(ARCH_IS_X86) FUNCTION()
{
  X86_VENDOR_INTEL_ENABLED := x86_cpuid_vendor_is_intel();
}
