PRIVATE(MODULE) ::unwind_capture INCLUDE_IF(OS_WINDOWS) DOC <$ Saves the Windows x64 nonvolatile register state, including full XMM values. $>
ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL NOEXCEPT(@registers MUT -> [256]UINTPTR)
{
  MOV [RCX+0], RAX
  MOV [RCX+8], RDX
  MOV [RCX+16], RCX
  MOV [RCX+24], RBX
  MOV [RCX+32], RSI
  MOV [RCX+40], RDI
  MOV [RCX+48], RBP
  MOV [RCX+64], R8
  MOV [RCX+72], R9
  MOV [RCX+80], R10
  MOV [RCX+88], R11
  MOV [RCX+96], R12
  MOV [RCX+104], R13
  MOV [RCX+112], R14
  MOV [RCX+120], R15
  LEA RAX, [RSP+8]
  MOV [RCX+56], RAX
  MOV RAX, [RSP]
  MOV [RCX+128], RAX
  MOVQ [RCX+184], XMM6
  MOVHLPS XMM0, XMM6
  MOVQ [RCX+1208], XMM0
  MOVQ [RCX+192], XMM7
  MOVHLPS XMM0, XMM7
  MOVQ [RCX+1216], XMM0
  MOVQ [RCX+200], XMM8
  MOVHLPS XMM0, XMM8
  MOVQ [RCX+1224], XMM0
  MOVQ [RCX+208], XMM9
  MOVHLPS XMM0, XMM9
  MOVQ [RCX+1232], XMM0
  MOVQ [RCX+216], XMM10
  MOVHLPS XMM0, XMM10
  MOVQ [RCX+1240], XMM0
  MOVQ [RCX+224], XMM11
  MOVHLPS XMM0, XMM11
  MOVQ [RCX+1248], XMM0
  MOVQ [RCX+232], XMM12
  MOVHLPS XMM0, XMM12
  MOVQ [RCX+1256], XMM0
  MOVQ [RCX+240], XMM13
  MOVHLPS XMM0, XMM13
  MOVQ [RCX+1264], XMM0
  MOVQ [RCX+248], XMM14
  MOVHLPS XMM0, XMM14
  MOVQ [RCX+1272], XMM0
  MOVQ [RCX+256], XMM15
  MOVHLPS XMM0, XMM15
  MOVQ [RCX+1280], XMM0
  RET
}

PRIVATE(MODULE) ::unwind_restore INCLUDE_IF(OS_WINDOWS) DOC <$ Restores the Windows x64 register state and enters a landing pad. $>
ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL NOEXCEPT(@registers MUT -> [256]UINTPTR, @ip UINTPTR)
{
  MOV R10, RCX
  MOV R11, RDX
  MOV RBX, [R10+24]
  MOV RSI, [R10+32]
  MOV RDI, [R10+40]
  MOV RBP, [R10+48]
  MOV R12, [R10+96]
  MOV R13, [R10+104]
  MOV R14, [R10+112]
  MOV R15, [R10+120]
  MOVQ XMM6, [R10+184]
  MOVQ XMM0, [R10+1208]
  PUNPCKLQDQ XMM6, XMM0
  MOVQ XMM7, [R10+192]
  MOVQ XMM0, [R10+1216]
  PUNPCKLQDQ XMM7, XMM0
  MOVQ XMM8, [R10+200]
  MOVQ XMM0, [R10+1224]
  PUNPCKLQDQ XMM8, XMM0
  MOVQ XMM9, [R10+208]
  MOVQ XMM0, [R10+1232]
  PUNPCKLQDQ XMM9, XMM0
  MOVQ XMM10, [R10+216]
  MOVQ XMM0, [R10+1240]
  PUNPCKLQDQ XMM10, XMM0
  MOVQ XMM11, [R10+224]
  MOVQ XMM0, [R10+1248]
  PUNPCKLQDQ XMM11, XMM0
  MOVQ XMM12, [R10+232]
  MOVQ XMM0, [R10+1256]
  PUNPCKLQDQ XMM12, XMM0
  MOVQ XMM13, [R10+240]
  MOVQ XMM0, [R10+1264]
  PUNPCKLQDQ XMM13, XMM0
  MOVQ XMM14, [R10+248]
  MOVQ XMM0, [R10+1272]
  PUNPCKLQDQ XMM14, XMM0
  MOVQ XMM15, [R10+256]
  MOVQ XMM0, [R10+1280]
  PUNPCKLQDQ XMM15, XMM0
  MOV RSP, [R10+56]
  MOV RAX, [R10]
  MOV RDX, [R10+8]
  JMP R11
}

PRIVATE(MODULE) ::unwind_section_begin INCLUDE_IF(OS_WINDOWS) DOC <$ Returns a boundary of the executable DWARF unwind section. $>
ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  LEA RAX, [RIP+quxlang_unwind_begin]
  RET
}

PRIVATE(MODULE) ::unwind_section_end INCLUDE_IF(OS_WINDOWS) DOC <$ Returns a boundary of the executable DWARF unwind section. $>
ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  LEA RAX, [RIP+quxlang_unwind_end]
  RET
}
