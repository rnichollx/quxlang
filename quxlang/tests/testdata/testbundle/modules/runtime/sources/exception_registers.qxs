PRIVATE(MODULE) ::unwind_section_end INCLUDE_IF(OS_LINUX) DOC <$ Returns the end of the executable unwind section. $>
ASM_PROCEDURE Z_ARCH
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  LARL %r2, quxlang_unwind_end
