ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  LEA RAX, [RIP+_quxlang_unwind_end]
  RET
}

PRIVATE(MODULE) ::unwind_section_end INCLUDE_IF(OS_LINUX) DOC <$ Returns the end of the executable unwind section. $>
ASM_PROCEDURE X86
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  MOV EAX, OFFSET quxlang_unwind_end
  RET
}

PRIVATE(MODULE) ::unwind_section_end INCLUDE_IF(OS_LINUX) DOC <$ Returns the end of the executable unwind section. $>
ASM_PROCEDURE ARM64
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  ADRP X0, quxlang_unwind_end
  ADD X0, X0, :lo12:quxlang_unwind_end
  RET
}

PRIVATE(MODULE) ::unwind_section_end INCLUDE_IF(OS_MACOS) DOC <$ Returns the end of the executable unwind section. $>
ASM_PROCEDURE ARM64
  CALLABLE CALLCONV CCALL NOEXCEPT(; RETURN ADDRESS)
{
  ADRP X0, _quxlang_unwind_end@PAGE
  ADD X0, X0, _quxlang_unwind_end@PAGEOFF
  RET
