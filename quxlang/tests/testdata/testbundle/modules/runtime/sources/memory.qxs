LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;
IMPORT posix;

PRIVATE(MODULE) ::virtual_alloc INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"VirtualAlloc"]
  CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @allocation_type U32, @protect U32; RETURN ADDRESS);

PRIVATE(MODULE) ::virtual_free INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"VirtualFree"]
  CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @free_type U32; RETURN BOOL);

::memory_bucket_size DOC <$
  Returns the historical public bucket size used by runtime clients that need
  the 8, 16, 24, 32, 48, ... progression.
  $>
  FUNCTION(@size SZ): SZ
{
  VAR bucket SZ := 8;
  VAR step SZ := 8;
  VAR maximum_size SZ := (0 AS SZ) #!!;

  LOOP WHILE(bucket < size) DO
  {
    IF (bucket > maximum_size - step)
    {
      PANIC "Memory bucket size overflow.";
    }
    bucket += step;
    IF (bucket / step == 4)
    {
      IF (step > maximum_size / 2)
      {
        PANIC "Memory bucket step overflow.";
      }
      step *= 2;
    }
  };

  RETURN bucket;
}

PRIVATE(MODULE) ::layer5_mapping_size DOC <$
  Rounds an OS mapping request up to a nonzero whole number of 4096-byte pages.
  $>
  FUNCTION(@size SZ): SZ
{
  IF (size <= 4096)
  {
    RETURN 4096;
  }

  VAR remainder SZ := size % 4096;
  IF (remainder == 0)
  {
    RETURN size;
  }

  VAR padding SZ := 4096 - remainder;
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size - padding)
  {
    PANIC "OS mapping size overflow.";
  }
  RETURN size + padding;
}

PRIVATE(MODULE) ::mutex DOC <$
  A process-private mutex used to serialize allocator cache roots.
  $>
  STRUCT
{
  .state VAR ATOMIC#I32;

  .lock DOC <$ Acquires the mutex, blocking or yielding while another thread owns it. $>
    FUNCTION()
  {
    VAR expected I32 := 0;
    IF (.state.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_ACQUIRE)(% [expected, 1]))
    {
      RETURN;
    }

    LOOP WHILE(TRUE) DO
    {
      VAR expected_uncontended I32 := 1;
      .state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(% [expected_uncontended, 2]);

      VAR observed I32 := .state.LOAD#ATOMIC_ACQUIRE();
      IF (observed == 0)
      {
        VAR expected_unlocked I32 := 0;
        IF (.state.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(% [expected_unlocked, 2]))
        {
          RETURN;
        }
      }
      ELSE IF (observed == 2)
      {
        STATIC_IF(OS_LINUX)
        {
          syscall::linux::futex_wait(@address IBC_GETADDR(@PTR .state<-), @expected 2);
        }
        STATIC_ELSE STATIC_IF(OS_WINDOWS)
        {
          VAR compared I32 := 2;
          syscall::windows::wait_on_address(
            @address IBC_GETADDR(@PTR .state<-),
            @compare_address compared<-,
            @address_size SIZEOF(I32),
            @milliseconds 4294967295
          );
        }
        STATIC_ELSE STATIC_IF(OS_MACOS)
        {
          posix::sched_yield();
        }
      }
    };
  }

  .unlock DOC <$ Releases the mutex and notifies one sleeping contender. $>
    FUNCTION()
  {
    VAR expected_uncontended I32 := 1;
    IF (.state.COMPARE_EXCHANGE#(
      @SUCCESS ATOMIC_ACQREL,
      @FAILURE ATOMIC_ACQUIRE
    )(% [expected_uncontended, 0]))
    {
      RETURN;
    }

    ASSERT(expected_uncontended == 2, "Cannot unlock an unlocked allocator mutex.");
    .state.STORE#ATOMIC_RELEASE(0);
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wake(@address IBC_GETADDR(@PTR .state<-), @count 1);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wake_by_address_single(@address IBC_GETADDR(@PTR .state<-));
    }
  }
}

PRIVATE(MODULE) ::allocator_page_size STATIC SZ := 4096;
::allocator_allocation_region_bits DOC <$
  Configures the address-bit count of each allocation region. The region size is
  two raised to this count in bytes. The default is sixteen, giving 64 KiB.
  Native configurations require at least twelve bits and enough address bits
  for a mapping twice the region size. Bitmap storage scales with the region.
  $>
  OPTION NUMBER DEFAULT_VALUE(16);

PRIVATE(MODULE) ::allocator_slab_region_size STATIC SZ :=
  (1 AS SZ) #++ allocator_allocation_region_bits;
PRIVATE(MODULE) ::allocator_region_bitmap_word_count STATIC SZ :=
  allocator_slab_region_size / (8 * 32);
PRIVATE(MODULE) ::allocator_slab_maximum_block_size DOC <$
  Limits small allocations to one eighth of the configured region size.
  $> STATIC SZ := allocator_slab_region_size / 8;

PRIVATE(MODULE) ::layer2_full_cache_limit STATIC SZ := 8;
PRIVATE(MODULE) ::layer2_partial_cache_limit STATIC SZ := 2;

::allocator_thread_cache_refill_maximum_bytes DOC <$
  Configures the target payload bytes represented by one thread-local address
  cache. Each slab specialization rounds its entry count down to an even value
  and retains at least two entries so half-cache transfers remain well-defined.
  $>
  OPTION NUMBER DEFAULT_VALUE(16384);

::allocator_thread_cache_refill_minimum_bytes OPTION NUMBER DEFAULT_VALUE(4096);

::allocator_thread_cache_refill_target_count OPTION NUMBER DEFAULT_VALUE(64);

::allocator_thread_cache_refill_predict_threshold OPTION NUMBER DEFAULT_VALUE(20);

::allocator_thread_cache_refill_absolute_minimum OPTION NUMBER DEFAULT_VALUE(4);


PRIVATE(MODULE) ::allocator_null_address DOC <$ Returns a null ADDRESS. $>
  FUNCTION(): ADDRESS
{
  VAR null_address ADDRESS;
  RETURN null_address;
}

PRIVATE(MODULE) ::allocator_checked_bytes DOC <$
  Multiplies element size and count, terminating instead of wrapping.
  $>
  FUNCTION(@size SZ, @count SZ): SZ
{
  IF (count == 0 || size == 0)
  {
    RETURN 0;
  }
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size / count)
  {
    PANIC "Allocation size overflow.";
  }
  RETURN size * count;
}

PRIVATE(MODULE) ::allocator_validate_alignment DOC <$
  Validates an alignment supported by page-aligned slab and direct mappings.
  $>
  FUNCTION(@align SZ)
{
  IF (align == 0 || (align #&& (align - 1)) != 0)
  {
    PANIC "Allocator alignment must be a nonzero power of two.";
  }
  IF (align > allocator_page_size)
  {
    PANIC "Allocator alignment exceeds the OS page alignment.";
  }
}

PRIVATE(MODULE) ::layer5_try_map_region DOC <$ Maps a page-rounded region or returns a null address on failure. $>
  FUNCTION(@bytes SZ) NOEXCEPT: ADDRESS
{
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (bytes > maximum_size - (allocator_page_size - 1)) { RETURN allocator_null_address(); }
  VAR mapping_size SZ := layer5_mapping_size(@size bytes);
  VAR mapping_address ADDRESS;
  STATIC_IF(OS_LINUX)
  {
    mapping_address := syscall::linux::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_MACOS)
  {
    mapping_address := syscall::macos::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_WINDOWS)
  {
    VAR requested_address ADDRESS := allocator_null_address();
    mapping_address := virtual_alloc(
      @address requested_address,
      @size mapping_size,
      @allocation_type 12288,
      @protect 4
    );
  }
  RETURN mapping_address;
}

PRIVATE(MODULE) ::layer5_map_region DOC <$ Maps a page-rounded region or terminates on failure. $>
  FUNCTION(@bytes SZ): ADDRESS
{
  VAR mapping_address ADDRESS := layer5_try_map_region(@bytes bytes);
  IF ((mapping_address??) == FALSE)
  {
    PANIC "The operating system rejected an allocator mapping request.";
  }
  RETURN mapping_address;
}

PRIVATE(MODULE) ::layer5_unmap_region DOC <$ Releases one page-rounded direct allocation. $>
  FUNCTION(@address ADDRESS, @bytes SZ)
{
  VAR mapping_size SZ := layer5_mapping_size(@size bytes);
  VAR succeeded BOOL := FALSE;
  STATIC_IF(OS_LINUX)
  {
    succeeded := syscall::linux::munmap(@addr address, @len mapping_size) == 0;
  }
  STATIC_IF(OS_MACOS)
  {
    succeeded := syscall::macos::munmap(@address address, @size mapping_size) == 0;
  }
  STATIC_IF(OS_WINDOWS)
  {
    succeeded := virtual_free(@address address, @size 0, @free_type 32768);
  }
  IF (succeeded == FALSE)
  {
    PANIC "The operating system rejected an allocator unmap request.";
  }
}

PRIVATE(MODULE) ::allocator_address_cache_entry_count DOC <$
  Computes an even address-cache capacity for one slab block size.
  $>
  FUNCTION(@block_size SZ): SZ
{
  VAR entry_size SZ := block_size;
  VAR target_max_entries SZ  := allocator_thread_cache_refill_maximum_bytes / block_size;
  VAR target_min_entries SZ  := allocator_thread_cache_refill_minimum_bytes / block_size;
  VAR target_entries SZ := allocator_thread_cache_refill_target_count;
  IF  (target_entries > target_max_entries) {
    target_entries := target_max_entries;
  }
  IF (target_entries < target_min_entries) {
    target_entries := target_min_entries;
  }
  IF (target_entries < allocator_thread_cache_refill_absolute_minimum) {
    target_entries := allocator_thread_cache_refill_absolute_minimum;
  }

  IF (target_entries % 2 != 0) {
    target_entries--;
  }
  IF (target_entries == 0) {
    RETURN 2;
  }
  RETURN target_entries;
}

PRIVATE(MODULE) ::addr_cache DOC <$
  Stores free allocation addresses in a bounded LIFO stack. Only the used
  prefix contains live ADDRESS objects. An active thread cache tracks this
  prefix with its thread-local cursor and synchronizes used before operations
  on the cache object.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .entries VAR [count]TYPED_STORAGE(ADDRESS) ALIGN(64);
  .used VAR SZ;

  .push DOC <$ Adds one address to the top of the cache. $>
    FUNCTION(@entry ADDRESS)
  {
    ASSERT(.used < count, "An address cache cannot exceed its capacity.");
    PLACE AT(.entries[.used]) ADDRESS := entry;
    .used++;
  }

  .pop DOC <$ Removes and returns the address at the top of the cache. $>
    FUNCTION(): ADDRESS
  {
    ASSERT(.used > 0, "An empty address cache cannot be popped.");
    .used--;
    VAR result ADDRESS := PUN .entries[.used] AS ADDRESS;
    DESTROY AT(.entries[.used]) ADDRESS;
    RETURN result;
  }

  .move_entries_to DOC <$ Moves the requested top entries into another cache. $>
    FUNCTION(@destination MUT& addr_cache#(@count count), @entry_count SZ)
  {
    ASSERT(.used >= entry_count, "An address-cache transfer exceeds the source size.");
    ASSERT(destination.used <= count, "An address cache has an invalid used count.");
    ASSERT(entry_count <= count - destination.used, "An address-cache transfer exceeds the destination capacity.");
    LOOP VALUE(entry_index) FROM(0 AS SZ) UNTIL(entry_count) DO
    {
      destination.push(@entry .pop());
    };
  }
}

PRIVATE(MODULE) ::addr_cache_node DOC <$
  Owns one address cache and its allocator-internal global-list link.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .cache VAR addr_cache#(@count count);
  .next VAR MUT->addr_cache_node#(@count count);
}

PRIVATE(MODULE) ::addr_cache_list DOC <$
  Tracks address-cache objects without storing links in allocation payloads.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .head VAR MUT->addr_cache_node#(@count count);
  .node_count VAR SZ;

  .push DOC <$ Pushes one cache object onto the list. $>
    FUNCTION(@node MUT->addr_cache_node#(@count count))
  {
    ASSERT(node??, "A null address-cache node cannot be listed.");
    node->.next := .head;
    .head := node;
    .node_count++;
  }

  .pop DOC <$ Removes and returns the first cache object. $>
    FUNCTION(): MUT->addr_cache_node#(@count count)
  {
    ASSERT(.head??, "An empty address-cache list cannot be popped.");
    VAR result MUT->addr_cache_node#(@count count) := .head;
    .head := result->.next;
    .node_count--;
    VAR no_next MUT->addr_cache_node#(@count count);
    result->.next := no_next;
    RETURN result;
  }
}

PRIVATE(MODULE) ::layer2_empty_cache_root DOC <$
  Owns empty cache objects shared by all slab classes with the same capacity.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .mtx VAR mutex;
  .nodes VAR addr_cache_list#(@count count);
}

PRIVATE(MODULE) ::layer2_slab_root DOC <$
  Owns full and partial cache-object lists for one slab specialization.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .mtx VAR mutex;
  .full VAR addr_cache_list#(@count count);
  .partial VAR addr_cache_list#(@count count);
}

PRIVATE(MODULE) ::allocator_thread_cache_lifetime DOC <$
  Registers allocator cache cleanup with the thread runtime on first use.
  $>
STRUCT
{
  .DESTRUCTOR DOC <$ Keeps the thread-runtime cleanup registration nontrivial. $>
    FUNCTION()
  {
  }
}

PRIVATE(MODULE) ::layer2_empty_cache_root_for
  TEMPLATE(@count VALUE SZ)
  VAR layer2_empty_cache_root#(@count count);

PRIVATE(MODULE) ::layer2_slab_root_for
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ, @cache_count VALUE SZ)
  VAR layer2_slab_root#(@count cache_count);

PRIVATE(MODULE) ::allocator_thread_caches_disabled VAR PER_THREAD BOOL;
PRIVATE(MODULE) ::allocator_thread_cache_lifetime_state
  VAR PER_THREAD allocator_thread_cache_lifetime;

PRIVATE(MODULE) ::layer2_refill_empty_cache_nodes DOC <$
  Maps allocator-internal metadata storage and places empty cache objects in it.
  The metadata mappings remain valid for the process lifetime.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@root MUT& layer2_empty_cache_root#(@count count))
{
  VAR node_size SZ := SIZEOF(addr_cache_node#(@count count));
  VAR region_size SZ := allocator_slab_region_size;
  IF (region_size < node_size)
  {
    region_size := node_size;
  }
  VAR region_address ADDRESS := layer5_map_region(@bytes region_size);
  VAR node_count SZ := region_size / node_size;
  LOOP VALUE(node_index) FROM(0 AS SZ) UNTIL(node_count) DO
  {
    VAR node_address ADDRESS := region_address + node_index * node_size;
    VAR node_storage MUT->TYPED_STORAGE(addr_cache_node#(@count count)) :=
      ADDRESS_LAUNDER_DISCOVER_EXISTING node_address TO
        MUT->TYPED_STORAGE(addr_cache_node#(@count count));
    VAR node MUT->addr_cache_node#(@count count) :=
      PLACE AT(node_storage->) addr_cache_node#(@count count);
    root.nodes.push(@node node);
  };
}

PRIVATE(MODULE) ::layer2_acquire_empty_cache_node DOC <$
  Acquires an empty cache object without associating it with a slab size class.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(): MUT->addr_cache_node#(@count count)
{
  VAR root MUT& layer2_empty_cache_root#(@count count) :=
    layer2_empty_cache_root_for#(@count count);
  root.mtx.lock();
  IF ((root.nodes.head??) == FALSE)
  {
    layer2_refill_empty_cache_nodes#(@count count)(@root root);
  }
  VAR result MUT->addr_cache_node#(@count count) := root.nodes.pop();
  root.mtx.unlock();
  ASSERT(result->.cache.used == 0, "An acquired empty cache contains addresses.");
  RETURN result;
}

PRIVATE(MODULE) ::layer2_release_empty_cache_node DOC <$
  Returns an empty cache object to the capacity-specific global list.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@node MUT->addr_cache_node#(@count count))
{
  ASSERT(node->.cache.used == 0, "Only an empty cache can enter the empty-cache list.");
  VAR root MUT& layer2_empty_cache_root#(@count count) :=
    layer2_empty_cache_root_for#(@count count);
  root.mtx.lock();
  root.nodes.push(@node node);
  root.mtx.unlock();
}

PRIVATE(MODULE) ::layer2_release_empty_cache_nodes DOC <$
  Returns several empty cache objects under one capacity-root lock.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@nodes MUT& addr_cache_list#(@count count))
{
  VAR root MUT& layer2_empty_cache_root#(@count count) :=
    layer2_empty_cache_root_for#(@count count);
  root.mtx.lock();
  LOOP WHILE (nodes.head??) DO
  {
    VAR node MUT->addr_cache_node#(@count count) := nodes.pop();
    ASSERT(node->.cache.used == 0, "Only an empty cache can enter the empty-cache list.");
    root.nodes.push(@node node);
  }
  root.mtx.unlock();
}

PRIVATE(MODULE) ::large_allocator DOC <$
  Handles allocations above the slab limit with page-rounded direct mappings.
  $>
  STRUCT
{
  PRIVATE(MODULE) ::allocate DOC <$ Maps one allocation with the requested layout. $>
    FUNCTION(@size SZ, @align SZ): ADDRESS
  {
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    RETURN layer5_map_region(@bytes bytes);
  }

  PRIVATE(MODULE) ::deallocate DOC <$ Unmaps one allocation with the original layout. $>
    FUNCTION(@size SZ, @align SZ, @ptr ADDRESS)
  {
    ASSERT(ptr??);
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    layer5_unmap_region(@address ptr, @bytes bytes);
  }
}

PRIVATE(MODULE) ::slab_allocator DOC <$
  Implements one fixed block-size and alignment allocator with whole-cache
  transfers between thread-local and global state.
  $>
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ) STRUCT
{
  PRIVATE(MODULE) ::address_cache_count STATIC SZ :=
    allocator_address_cache_entry_count(@block_size block_size);

  PRIVATE(MODULE) ::layer1_cache_control_state DOC <$
    Stores the active cache cursor, bounds, and both cache ownership pointers.
    $> STRUCT
  {
    .entry DOC <$ Points to the first unused address slot in the active cache. $>
      VAR =>>TYPED_STORAGE(ADDRESS);
    .top DOC <$ Points one slot past the active cache storage capacity. $>
      VAR =>>TYPED_STORAGE(ADDRESS);
    .bottom DOC <$ Points to the first address slot, or null before initialization. $>
      VAR =>>TYPED_STORAGE(ADDRESS);
    .node DOC <$ Owns the active cache object whose used count is synchronized before transfers. $>
      VAR MUT->addr_cache_node#(@count address_cache_count);
    .secondary_node DOC <$ Owns the secondary cache, accessed during slow-path transfers. $>
      VAR MUT->addr_cache_node#(@count address_cache_count);
  }

  PRIVATE(MODULE) ::layer1_cache_control DOC <$
    Owns one thread's active and secondary cache state for this slab specialization.
    $> VAR PER_THREAD layer1_cache_control_state ALIGN(64);

  PRIVATE(MODULE) ::layer3_regions DOC <$ Owns the stable control lists for this slab class. $>
    VAR layer3_region_class;

  PRIVATE(MODULE) ::layer2_acquire_full_cache DOC <$
    Exchanges a full plate under the global lock or refills a private plate from
    region bitmaps after releasing that lock.
    $>
    FUNCTION(): MUT->addr_cache_node#(@count address_cache_count)
  {
    VAR root MUT& layer2_slab_root#(@count address_cache_count) := layer2_slab_root_for#(
      @block_size block_size, @block_align block_align, @cache_count address_cache_count
    );
    root.mtx.lock();
    IF (root.full.head??)
    {
      VAR full MUT->addr_cache_node#(@count address_cache_count) := root.full.pop();
      root.mtx.unlock();
      RETURN full;
    }
    root.mtx.unlock();
    VAR result MUT->addr_cache_node#(@count address_cache_count) :=
      layer2_acquire_empty_cache_node#(@count address_cache_count)();
    VAR emptied addr_cache_list#(@count address_cache_count);
    root.mtx.lock();
    LOOP WHILE (root.partial.head?? && result->.cache.used < address_cache_count) DO
    {
      VAR partial MUT->addr_cache_node#(@count address_cache_count) := root.partial.pop();
      VAR transferred SZ := partial->.cache.used;
      IF (transferred > address_cache_count - result->.cache.used)
      { transferred := address_cache_count - result->.cache.used; }
      partial->.cache.move_entries_to(@destination result->.cache, @entry_count transferred);
      IF (partial->.cache.used == 0) { emptied.push(@node partial); }
      ELSE { root.partial.push(@node partial); }
    }
    root.mtx.unlock();
    layer2_release_empty_cache_nodes#(@count address_cache_count)(@nodes emptied);
    IF (result->.cache.used < address_cache_count)
    {
      layer3_regions.mtx.lock();
      layer3_regions.initialize(@size block_size, @align block_align);
      layer3_regions.mtx.unlock();
      layer3_region_refill#(@count address_cache_count)(@root layer3_regions, @cache result->.cache);
    }
    RETURN result;
  }

  PRIVATE(MODULE) ::layer2_release_cache DOC <$
    Returns one cache object to the empty, partial, or full global list selected
    by its current entry count.
    $>
    FUNCTION(@node MUT->addr_cache_node#(@count address_cache_count))
  {
    IF (node->.cache.used == 0)
    {
      layer2_release_empty_cache_node#(@count address_cache_count)(@node node);
      RETURN;
    }

    VAR root MUT& layer2_slab_root#(@count address_cache_count) := layer2_slab_root_for#(
      @block_size block_size,
      @block_align block_align,
      @cache_count address_cache_count
    );
    root.mtx.lock();
    IF (node->.cache.used == address_cache_count && root.full.node_count < layer2_full_cache_limit)
    {
      root.full.push(@node node);
      root.mtx.unlock();
      RETURN;
    }
    IF (node->.cache.used < address_cache_count && root.partial.node_count < layer2_partial_cache_limit)
    {
      root.partial.push(@node node);
      root.mtx.unlock();
      RETURN;
    }
    root.mtx.unlock();
    LOOP WHILE (node->.cache.used > 0) DO
    { layer3_region_return(@address node->.cache.pop()); }
    layer2_release_empty_cache_node#(@count address_cache_count)(@node node);
  }

  PRIVATE(MODULE) ::layer1_initialize_thread_cache DOC <$
    Acquires the two empty cache objects owned by this thread and slab class.
    $>
    FUNCTION()
  {
    allocator_thread_cache_lifetime_state;
    ASSERT((layer1_cache_control.node??) == FALSE, "A thread cache already has an active cache object.");
    ASSERT((layer1_cache_control.secondary_node??) == FALSE, "A thread cache already has a secondary cache object.");
    layer1_cache_control.node := layer2_acquire_empty_cache_node#(@count address_cache_count)();
    layer1_cache_control.secondary_node := layer2_acquire_empty_cache_node#(@count address_cache_count)();
  }

  PRIVATE(MODULE) ::layer1_activate_thread_cache DOC <$
    Establishes the thread-local cursor and bounds from the active cache node
    after a slow-path transfer.
    $>
    FUNCTION()
  {
    layer1_cache_control.bottom := layer1_cache_control.node->.cache.entries[&0];
    layer1_cache_control.entry := layer1_cache_control.bottom + layer1_cache_control.node->.cache.used;
    layer1_cache_control.top := layer1_cache_control.bottom + address_cache_count;
  }

  PRIVATE(MODULE) ::layer2_allocate_without_thread_cache DOC <$
    Obtains an allocation through global plates after thread-local teardown.
    $> FUNCTION(): ADDRESS
  {
    VAR node MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_full_cache();
    VAR result ADDRESS := node->.cache.pop();
    layer2_release_cache(@node node);
    RETURN result;
  }

  PRIVATE(MODULE) ::layer3_deallocate_without_thread_cache DOC <$
    Returns a slot to its region after thread-local teardown.
    $> FUNCTION(@ptr ADDRESS)
  { layer3_region_return(@address ptr); }

  PRIVATE(MODULE) ::layer0_allocate DOC <$ Allocates one block from this slab allocator. $>
    FUNCTION(): ADDRESS
  {
    IF LIKELY (layer1_cache_control.entry != layer1_cache_control.bottom)
    {
      layer1_cache_control.entry--;
      VAR result ADDRESS := PUN layer1_cache_control.entry-> AS ADDRESS;
      DESTROY AT(layer1_cache_control.entry->) ADDRESS;
      RETURN result;
    }

    RETURN layer1_allocate();
  }

  PRIVATE(MODULE) ::layer1_allocate DOC <$
    Refills an empty active cache or allocates while thread caches are disabled.
    $>
    FUNCTION(): ADDRESS
  {
    IF UNLIKELY (allocator_thread_caches_disabled)
    {
      RETURN layer2_allocate_without_thread_cache();
    }

    IF (layer1_cache_control.node??)
    {
      layer1_cache_control.node->.cache.used := 0;
      INVARIANT(layer1_cache_control.secondary_node??, "A thread cache is missing its secondary cache object.");
      VAR secondary_entries SZ := layer1_cache_control.secondary_node->.cache.used;
      IF (secondary_entries == address_cache_count)
      {
        layer1_cache_control.secondary_node->.cache.move_entries_to(
          @destination layer1_cache_control.node->.cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        VAR previous_active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
        layer1_cache_control.node := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := previous_active;
      }
      ELSE
      {
        ASSERT(secondary_entries == 0, "A secondary address cache has an invalid state.");
      }
    }

    IF ((layer1_cache_control.node??) == FALSE || layer1_cache_control.node->.cache.used == 0)
    {
      IF ((layer1_cache_control.node??) == FALSE)
      {
        layer1_initialize_thread_cache();
      }
      ASSERT(layer1_cache_control.secondary_node->.cache.used == 0, "A thread cache refill requires an empty secondary cache.");
      layer2_release_empty_cache_node#(@count address_cache_count)(@node layer1_cache_control.secondary_node);
      layer1_cache_control.secondary_node := layer2_acquire_full_cache();
      layer1_cache_control.secondary_node->.cache.move_entries_to(
        @destination layer1_cache_control.node->.cache,
        @entry_count address_cache_count / 2
      );
    }
    layer1_activate_thread_cache();
    layer1_cache_control.entry--;
    VAR result ADDRESS := PUN layer1_cache_control.entry-> AS ADDRESS;
    DESTROY AT(layer1_cache_control.entry->) ADDRESS;
    RETURN result;
  }

  PRIVATE(MODULE) ::layer0_deallocate DOC <$ Returns one block to this slab allocator. $>
    FUNCTION(@ptr ADDRESS)
  {
    IF LIKELY (layer1_cache_control.entry != layer1_cache_control.top)
    {
      PLACE AT(layer1_cache_control.entry->) ADDRESS := ptr;
      layer1_cache_control.entry++;
      RETURN;
    }

    layer1_deallocate(@ptr ptr);
  }

  PRIVATE(MODULE) ::layer1_deallocate DOC <$
    Returns a block after a full active cache requires transfer or initialization.
    $>
    FUNCTION(@ptr ADDRESS)
  {
    INVARIANT(ptr??, "freeing nullptr is undefined");
    IF UNLIKELY (allocator_thread_caches_disabled)
    {
      layer3_deallocate_without_thread_cache(@ptr ptr);
      RETURN;
    }

    IF ((layer1_cache_control.node??) == FALSE)
    {
      layer1_initialize_thread_cache();
    }
    ELSE
    {
      layer1_cache_control.node->.cache.used := address_cache_count;
      VAR secondary_entries SZ := layer1_cache_control.secondary_node->.cache.used;
      IF (secondary_entries == 0)
      {
        layer1_cache_control.node->.cache.move_entries_to(
          @destination layer1_cache_control.secondary_node->.cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        VAR previous_active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
        layer1_cache_control.node := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := previous_active;
      }
      ELSE
      {
        INVARIANT(secondary_entries == address_cache_count, "A secondary address cache has an invalid state.");
        VAR full_cache MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := layer2_acquire_empty_cache_node#(@count address_cache_count)();
        layer2_release_cache(@node full_cache);
        layer1_cache_control.node->.cache.move_entries_to(
          @destination layer1_cache_control.secondary_node->.cache,
          @entry_count address_cache_count / 2
        );
      }
    }

    layer1_activate_thread_cache();
    PLACE AT(layer1_cache_control.entry->) ADDRESS := ptr;
    layer1_cache_control.entry++;
  }

  PRIVATE(MODULE) ::layer1_release_thread_cache DOC <$
    Returns both cache objects owned by this thread to global allocator state.
    $>
    FUNCTION()
  {
    IF ((layer1_cache_control.node??) == FALSE)
    {
      ASSERT((layer1_cache_control.secondary_node??) == FALSE, "A thread cache owns only one cache object.");
      RETURN;
    }
    ASSERT(layer1_cache_control.secondary_node??, "A thread cache is missing its secondary cache object.");
    VAR active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
    VAR secondary MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.secondary_node;
    active->.cache.used := (layer1_cache_control.entry - layer1_cache_control.bottom) AS CHECKED SZ;
    VAR no_entry =>>TYPED_STORAGE(ADDRESS);
    layer1_cache_control.entry := no_entry;
    layer1_cache_control.top := no_entry;
    layer1_cache_control.bottom := no_entry;
    VAR no_cache MUT->addr_cache_node#(@count address_cache_count);
    layer1_cache_control.node := no_cache;
    layer1_cache_control.secondary_node := no_cache;
    layer2_release_cache(@node active);
    layer2_release_cache(@node secondary);
  }

  PRIVATE(MODULE) ::thread_cached_block_count DOC <$
    Reports this thread's block count for allocator validation.
    $>
    FUNCTION(): SZ
  {
    IF ((layer1_cache_control.node??) == FALSE)
    {
      RETURN 0;
    }
    RETURN (layer1_cache_control.entry - layer1_cache_control.bottom) AS CHECKED SZ
      + layer1_cache_control.secondary_node->.cache.used;
  }
}

PRIVATE(MODULE) ::allocator_allocate_static DOC <$
  Routes a compile-time layout through the generated slab size classes.
  $>
  TEMPLATE(@size VALUE SZ, @align VALUE SZ) FUNCTION(): ADDRESS
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    STATIC_IF(size <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      RETURN slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_allocate();
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  RETURN large_allocator::allocate(@size size, @align align);
}

PRIVATE(MODULE) ::allocator_deallocate_static DOC <$
  Returns a compile-time layout through the generated slab size classes.
  $>
  TEMPLATE(@size VALUE SZ, @align VALUE SZ) FUNCTION(@ptr ADDRESS)
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    STATIC_IF(size <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_deallocate(@ptr ptr);
      RETURN;
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  large_allocator::deallocate(@size size, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_allocate_dynamic DOC <$
  Routes a runtime layout through the generated slab size classes.
  $>
  FUNCTION(@bytes SZ, @align SZ): ADDRESS
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size) {
      STATIC_EVAL block_align := allocator_page_size;
    }
    IF (bytes <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align)) {
      RETURN slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_allocate();
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4) {
      STATIC_EVAL step *= 2;
    }
  }
  RETURN large_allocator::allocate(@size bytes, @align align);
}

PRIVATE(MODULE) ::allocator_deallocate_dynamic DOC <$
  Returns a runtime layout through the generated slab size classes.
  $>
  FUNCTION(@bytes SZ, @align SZ, @ptr ADDRESS)
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    IF (bytes <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_deallocate(@ptr ptr);
      RETURN;
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  large_allocator::deallocate(@size bytes, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_allocate_multiple DOC <$
  Uses a slab allocator for a runtime count whenever the total layout is eligible.
  $>
  FUNCTION(@size SZ, @align SZ, @count SZ): ADDRESS
{
  VAR bytes SZ := allocator_checked_bytes(@size size, @count count);
  RETURN allocator_allocate_dynamic(@bytes bytes, @align align);
}

PRIVATE(MODULE) ::allocator_deallocate_multiple DOC <$
  Reconstructs the multi allocation's slab-or-large routing from its count.
  $>
  FUNCTION(@size SZ, @align SZ, @ptr ADDRESS, @count SZ)
{
  IF ((ptr??) == FALSE)
  {
    RETURN;
  }
  VAR bytes SZ := allocator_checked_bytes(@size size, @count count);
  allocator_deallocate_dynamic(@bytes bytes, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_release_all_thread_caches DOC <$
  Flushes every generated slab specialization used by the default allocator.
  $>
  FUNCTION()
{
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer1_release_thread_cache();
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
}

PRIVATE(MODULE) ::allocator_thread_cache_shutdown_begin DOC <$
  Disables thread-local caching and returns cached addresses to global state.
  Releasing the caches clears their cursors and bounds, so subsequent
  allocations and deallocations enter the slow path during thread teardown.
  $>
  FUNCTION()
{
  allocator_thread_caches_disabled := TRUE;
  allocator_release_all_thread_caches();
}

PRIVATE(MODULE) ::allocator_thread_cache_shutdown_finish DOC <$
  Returns this thread's remaining full, partial, and empty cache objects after
  every registered thread-local destructor has run.
  $>
  FUNCTION()
{
  allocator_release_all_thread_caches();
}

::DEFAULT_ALLOCATOR DOC <$
  Provides the standard typed allocator interfaces for `T`. The `VOID`
  specialization provides the typeless Size-Align and Virtual Allocator APIs.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$ Allocates storage for one object of `T`. $>
    FUNCTION(): ->TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#T();
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T();
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )();
        RETURN BEGIN_ALLOC_REGION addr TO ->TYPED_STORAGE(T);
      }
    }
  }

  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$ Releases storage previously returned by `ALLOC`. $>
    FUNCTION(@PTR:ptr ->TYPED_STORAGE(T))
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_ALLOC_REGION ptr;
        allocator_deallocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )(@ptr addr);
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#T(% [ptr]);
    }
  }

  ::MULTI_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$
    Allocates contiguous storage for `count` objects of `T`.
    $>
    FUNCTION(@COUNT:count SZ): =>>TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC_MULTIPLE#T(% [count]);
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T(% [count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_multiple(
          @size SIZEOF(T),
          @align ALIGNOF(T),
          @count count
        );
        RETURN BEGIN_MULTI_ALLOC_REGION addr SIZE count TO =>>TYPED_STORAGE(T);
      }
    }
  }

  ::MULTI_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$
    Releases storage previously returned by `MULTI_ALLOC`.
    $>
    FUNCTION(@PTR:ptr =>>TYPED_STORAGE(T), @COUNT:count SZ)
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr, count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_MULTI_ALLOC_REGION ptr SIZE count;
        allocator_deallocate_multiple(
          @size SIZEOF(T),
          @align ALIGNOF(T),
          @ptr addr,
          @count count
        );
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC_MULTIPLE#T(% [ptr, count]);
    }
  }

  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID)) DOC <$ Allocates storage with compile-time size and alignment. $>
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(): ->ALIGNED_STORAGE(size, align)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#(@SIZE size, @ALIGN align)();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_static#(
        @size size,
        @align align
      )();
      RETURN BEGIN_ALLOC_REGION addr TO ->ALIGNED_STORAGE(size, align);
    }
  }

  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID)) DOC <$ Releases storage allocated with compile-time size and alignment. $>
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(@PTR:ptr ->ALIGNED_STORAGE(size, align))
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_static#(
        @size size,
        @align align
      )(@ptr addr);
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#(@SIZE size, @ALIGN align)(% [ptr]);
    }
  }

  ::VIRTUAL_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Allocates storage with runtime-provided size and alignment.
    $>
    FUNCTION(@SIZE:size SZ, @ALIGN:align SZ): ->VIRTUAL_STORAGE
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#VIRTUAL_STORAGE();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_dynamic(
        @bytes size,
        @align align
      );
      RETURN BEGIN_ALLOC_REGION addr TO ->VIRTUAL_STORAGE;
    }
  }

  ::VIRTUAL_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Releases virtual storage using its original size and alignment.
    $>
    FUNCTION(@PTR:ptr ->VIRTUAL_STORAGE, @SIZE:size SZ, @ALIGN:align SZ)
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_dynamic(
        @bytes size,
        @align align,
        @ptr addr
      );
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#VIRTUAL_STORAGE(% [ptr]);
    }
  }
}
