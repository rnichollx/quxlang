LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;
IMPORT posix;

DOC <$
  Returns the historical public bucket size used by runtime clients that need
  the 8, 16, 24, 32, 48, ... progression.
  $>
::memory_bucket_size
  FUNCTION(@size SZ): SZ
{
  VAR bucket SZ := 8;
  VAR step SZ := 8;
  VAR maximum_size SZ := (0 AS SZ) #!!;

  LOOP WHILE(bucket < size) DO
  {
    IF (bucket > maximum_size - step)
    {
      PANIC "Memory bucket size overflow.";
    }
    bucket += step;
    IF (bucket / step == 4)
    {
      IF (step > maximum_size / 2)
      {
        PANIC "Memory bucket step overflow.";
      }
      step *= 2;
    }
  };

  RETURN bucket;
}

DOC <$
  Rounds an OS mapping request up to a nonzero whole number of 4096-byte pages.
  $>
PRIVATE(MODULE) ::layer5_mapping_size
  FUNCTION(@size SZ): SZ
{
  IF (size <= 4096)
  {
    RETURN 4096;
  }

  VAR remainder SZ := size % 4096;
  IF (remainder == 0)
  {
    RETURN size;
  }

  VAR padding SZ := 4096 - remainder;
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size - padding)
  {
    PANIC "OS mapping size overflow.";
  }
  RETURN size + padding;
}

DOC <$
  A process-private, non-recursive unfair mutex used to serialize allocator
  cache roots and shared queues. The mutex remains at a stable address until
  all users have left.
  $>
::mutex
  STRUCT ROOTED
{
  PRIVATE(CLASS) .state VAR ATOMIC#I32;

  DOC <$ Attempts acquisition without waiting. $>
  .try_lock FUNCTION(): BOOL
  {
    VAR expected I32 := 0;
    RETURN .state.COMPARE_EXCHANGE#(
      @SUCCESS ATOMIC_ACQUIRE, @FAILURE ATOMIC_RELAXED
    )(@EXPECTED expected, @DESIRED 1);
  }

  DOC <$ Acquires the mutex, blocking or yielding while another thread owns it. $>
  .lock
    FUNCTION()
  {
    VAR expected I32 := 0;
    IF (.state.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_ACQUIRE)(@EXPECTED expected, @DESIRED 1))
    {
      RETURN;
    }

    LOOP WHILE(TRUE) DO
    {
      VAR expected_uncontended I32 := 1;
      .state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(@EXPECTED expected_uncontended, @DESIRED 2);

      VAR observed I32 := .state.LOAD#ATOMIC_ACQUIRE();
      IF (observed == 0)
      {
        VAR expected_unlocked I32 := 0;
        IF (.state.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(@EXPECTED expected_unlocked, @DESIRED 2))
        {
          RETURN;
        }
      }
      ELSE IF (observed == 2)
      {
        STATIC_IF(OS_LINUX)
        {
          syscall::linux::futex_wait(@address IBC_GETADDR(@PTR .state<-), @expected 2);
        }
        STATIC_ELSE STATIC_IF(OS_WINDOWS)
        {
          VAR compared I32 := 2;
          syscall::windows::wait_on_address(
            @address IBC_GETADDR(@PTR .state<-),
            @compare_address compared<-,
            @address_size SIZEOF(I32),
            @milliseconds 4294967295
          );
        }
        STATIC_ELSE STATIC_IF(OS_MACOS)
        {
          wait_at_u32_address(@address IBC_GETADDR(@PTR .state<-), @expected 2);
        }
        STATIC_ELSE { UNIMPLEMENTED; }
      }
    };
  }

  DOC <$ Releases the mutex and notifies one sleeping contender. $>
  .unlock
    FUNCTION()
  {
    VAR expected_uncontended I32 := 1;
    IF (.state.COMPARE_EXCHANGE#(
      @SUCCESS ATOMIC_ACQREL,
      @FAILURE ATOMIC_ACQUIRE
    )(@EXPECTED expected_uncontended, @DESIRED 0))
    {
      RETURN;
    }

    ASSERT(expected_uncontended == 2, "Cannot unlock an unlocked allocator mutex.");
    .state.STORE#ATOMIC_RELEASE(0);
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wake(@address IBC_GETADDR(@PTR .state<-), @count 1);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wake_by_address_single(@address IBC_GETADDR(@PTR .state<-));
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      notify_one_at_address(@address IBC_GETADDR(@PTR .state<-), @size SIZEOF(I32));
    }
    STATIC_ELSE { UNIMPLEMENTED; }
  }
}

PRIVATE(MODULE) ::allocator_page_size STATIC SZ := 4096;
DOC <$
  Configures the address-bit count of each allocation region. The region size is
  two raised to this count in bytes. The default is sixteen, giving 64 KiB.
  Native configurations require at least twelve bits and enough address bits
  for a mapping twice the region size. Bitmap storage scales with the region.
  $>
::allocator_allocation_region_bits
  OPTION NUMBER DEFAULT_VALUE(16);

PRIVATE(MODULE) ::allocator_slab_region_size STATIC SZ :=
  (1 AS SZ) #++ allocator_allocation_region_bits;
PRIVATE(MODULE) ::allocator_region_bitmap_word_count STATIC SZ :=
  allocator_slab_region_size / (8 * layer3_bitmap_word_bits);
DOC <$
  Limits small allocations to one eighth of the configured region size.
  $>
PRIVATE(MODULE) ::allocator_slab_maximum_block_size STATIC SZ := allocator_slab_region_size / 8;

DOC <$ The slot count specifies the initial capacity of each empty-plate transfer queue. $>
PRIVATE(MODULE) ::layer2_plate_slot_count STATIC SZ := 32;
PRIVATE(MODULE) ::layer2_partial_plate_slot_count STATIC SZ := 4;
DOC <$
  The slot count specifies the initial capacity of each full-plate transfer queue.
  Each plate returns toward its first allocation region's home.
  $>
PRIVATE(MODULE) ::layer2_full_plate_slot_count STATIC SZ := 16;

DOC <$
  Configures the target payload bytes represented by one thread-local address
  cache. Each slab specialization rounds its entry count down to an even value
  and retains at least two entries so half-cache transfers remain well-defined.
  The byte ceiling permits the target entry count for allocations through
  8 KiB; the default target retains at most 512 KiB of payload per cache.
  $>
::allocator_thread_cache_refill_maximum_bytes
  OPTION NUMBER DEFAULT_VALUE(524288);

::allocator_thread_cache_refill_minimum_bytes OPTION NUMBER DEFAULT_VALUE(32768);

::allocator_thread_cache_refill_target_count OPTION NUMBER DEFAULT_VALUE(64);

::allocator_thread_cache_refill_predict_threshold OPTION NUMBER DEFAULT_VALUE(20);

::allocator_thread_cache_refill_absolute_minimum OPTION NUMBER DEFAULT_VALUE(4);


DOC <$
  Multiplies element size and count, terminating instead of wrapping.
  $>
PRIVATE(MODULE) ::allocator_checked_bytes
  FUNCTION(@size SZ, @count SZ): SZ
{
  IF (count == 0 || size == 0)
  {
    RETURN 0;
  }
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size / count)
  {
    PANIC "Allocation size overflow.";
  }
  RETURN size * count;
}

DOC <$
  Validates an alignment supported by page-aligned slab and direct mappings.
  $>
PRIVATE(MODULE) ::allocator_validate_alignment
  FUNCTION(@align SZ)
{
  IF (align == 0 || (align #&& (align - 1)) != 0)
  {
    PANIC "Allocator alignment must be a nonzero power of two.";
  }
  IF (align > allocator_page_size)
  {
    PANIC "Allocator alignment exceeds the OS page alignment.";
  }
}

DOC <$ Maps a page-rounded region or returns a null address on failure. $>
PRIVATE(MODULE) ::layer5_map_region
  FUNCTION(@bytes SZ) NOEXCEPT: ADDRESS
{
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (bytes > maximum_size - (allocator_page_size - 1)) { RETURN NULL; }
  VAR mapping_size SZ := layer5_mapping_size(@size bytes);
  VAR mapping_address ADDRESS;
  STATIC_IF(OS_LINUX)
  {
    mapping_address := syscall::linux::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_MACOS)
  {
    mapping_address := syscall::macos::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_WINDOWS)
  {
    VAR requested_address ADDRESS := NULL;
    mapping_address := syscall::windows::virtual_alloc(
      @address requested_address,
      @size mapping_size,
      @allocation_type 12288,
      @protect 4
    );
  }
  RETURN mapping_address;
}

DOC <$ Releases one page-rounded direct allocation. $>
PRIVATE(MODULE) ::layer5_unmap_region
  FUNCTION(@address ADDRESS, @bytes SZ)
{
  VAR mapping_size SZ := layer5_mapping_size(@size bytes);
  VAR succeeded BOOL := FALSE;
  STATIC_IF(OS_LINUX)
  {
    succeeded := syscall::linux::munmap(@addr address, @len mapping_size) == 0;
  }
  STATIC_IF(OS_MACOS)
  {
    succeeded := syscall::macos::munmap(@address address, @size mapping_size) == 0;
  }
  STATIC_IF(OS_WINDOWS)
  {
    succeeded := syscall::windows::virtual_free(@address address, @size 0, @free_type 32768) != 0;
  }
  IF (succeeded == FALSE)
  {
    PANIC "The operating system rejected an allocator unmap request.";
  }
}

DOC <$
  Computes an even address-cache capacity for one slab block size.
  $>
PRIVATE(MODULE) ::allocator_address_cache_entry_count
  FUNCTION(@block_size SZ): SZ
{
  VAR entry_size SZ := block_size;
  VAR target_max_entries SZ  := allocator_thread_cache_refill_maximum_bytes / block_size;
  VAR target_min_entries SZ  := allocator_thread_cache_refill_minimum_bytes / block_size;
  VAR target_entries SZ := allocator_thread_cache_refill_target_count;
  IF  (target_entries > target_max_entries) {
    target_entries := target_max_entries;
  }
  IF (target_entries < target_min_entries) {
    target_entries := target_min_entries;
  }
  IF (target_entries < allocator_thread_cache_refill_absolute_minimum) {
    target_entries := allocator_thread_cache_refill_absolute_minimum;
  }

  IF (target_entries % 2 != 0) {
    target_entries--;
  }
  IF (target_entries == 0) {
    RETURN 2;
  }
  RETURN target_entries;
}

DOC <$
  Stores free allocation addresses in a bounded LIFO stack. Only the used
  prefix contains live ADDRESS objects. An active thread cache tracks this
  prefix with its thread-local cursor and synchronizes used before operations
  on the cache object.
  $>
PRIVATE(MODULE) ::addr_cache
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .entries VAR [count]TYPED_STORAGE(ADDRESS) ALIGN(64);
  .used VAR SZ;

  DOC <$ Adds one address to the top of the cache. $>
  .push
    FUNCTION(@ARG:entry ADDRESS)
  {
    ASSERT(.used < count, "An address cache cannot exceed its capacity.");
    PLACE AT(.entries[.used]) ADDRESS := entry;
    .used++;
  }

  DOC <$ Removes and returns the address at the top of the cache. $>
  .pop
    FUNCTION(): ADDRESS
  {
    ASSERT(.used > 0, "An empty address cache cannot be popped.");
    .used--;
    VAR result ADDRESS := PUN .entries[.used] AS ADDRESS;
    DESTROY AT(.entries[.used]) ADDRESS;
    RETURN result;
  }

  DOC <$ Moves the requested top entries into another cache while preserving their array order. $>
  .move_entries_to
    FUNCTION(@destination MUT& addr_cache#(@count count), @entry_count SZ)
  {
    ASSERT(.used >= entry_count, "An address-cache transfer exceeds the source size.");
    ASSERT(destination.used <= count, "An address cache has an invalid used count.");
    ASSERT(entry_count <= count - destination.used, "An address-cache transfer exceeds the destination capacity.");
    VAR source_start SZ := .used - entry_count;
    VAR destination_start SZ := destination.used;
    LOOP HINT_CODE_ALIGN(128) VALUE(entry_index) FROM(0 AS SZ) UNTIL(entry_count) DO
    {
      PLACE AT(destination.entries[destination_start + entry_index]) ADDRESS :=
        PUN .entries[source_start + entry_index] AS ADDRESS;
      DESTROY AT(.entries[source_start + entry_index]) ADDRESS;
    };
    .used := source_start;
    destination.used := destination_start + entry_count;
  }

  DOC <$ Restores a maximum heap after replacing its root within the supplied prefix. $>
  .sift_down
    FUNCTION(@root SZ, @length SZ)
  {
    VAR current SZ := root;
    VAR value ADDRESS := PUN .entries[current] AS ADDRESS;
    LOOP WHILE (current < length / 2) DO
    {
      VAR child SZ := current * 2 + 1;
      VAR selected ADDRESS := PUN .entries[child] AS ADDRESS;
      IF (child + 1 < length)
      {
        VAR right ADDRESS := PUN .entries[child + 1] AS ADDRESS;
        IF (right > selected) { child++; selected := right; }
      }
      IF (value >= selected) { BREAK; }
      VAR destination MUT& ADDRESS := PUN .entries[current] AS ADDRESS;
      destination := selected;
      current := child;
    }
    VAR destination MUT& ADDRESS := PUN .entries[current] AS ADDRESS;
    destination := value;
  }

  DOC <$ Orders the live address prefix in place using an O(n log n) heap sort. $>
  .sort
    FUNCTION()
  {
    VAR root SZ := .used / 2;
    LOOP WHILE (root > 0) DO { root--; .sift_down(@root root, @length .used); }
    VAR end SZ := .used;
    LOOP WHILE (end > 1) DO
    {
      end--;
      VAR first MUT& ADDRESS := PUN .entries[0] AS ADDRESS;
      VAR last MUT& ADDRESS := PUN .entries[end] AS ADDRESS;
      VAR saved ADDRESS := first;
      first := last;
      last := saved;
      .sift_down(@root 0, @length end);
    }
  }
}

DOC <$
  Tracks constructed plate objects in one metadata mapping. Each plate retains
  one reference until it is discarded from the bounded empty-plate store.
  The last discarded plate releases the mapping.
  $>
PRIVATE(MODULE) ::layer2_metadata_region STRUCT
{
  .remaining VAR ATOMIC#SZ;
  .mapping_bytes VAR SZ;
  .transfer_home VAR SZ;
}

DOC <$
  Owns one address cache and retains its metadata mapping.
  $>
PRIVATE(MODULE) ::addr_cache_node
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .cache VAR addr_cache#(@count count);
  .metadata VAR MUT->layer2_metadata_region;
}

DOC <$ The slab root owns independent full and partial transfer stores for one plate capacity. $>
PRIVATE(MODULE) ::layer2_slab_root
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .full VAR layer2_home_plate_store#(@count count, @slot_count layer2_full_plate_slot_count, @empty_metadata FALSE);
  .partial VAR layer2_home_plate_store#(@count count, @slot_count layer2_partial_plate_slot_count, @empty_metadata FALSE);
}

DOC <$
  Registers allocator cache cleanup with the thread runtime on first use.
  $>
PRIVATE(MODULE) ::allocator_thread_cache_lifetime
STRUCT
{
  DOC <$ Keeps the thread-runtime cleanup registration nontrivial. $>
  .DESTRUCTOR
    FUNCTION()
  {
  }
}

PRIVATE(MODULE) ::layer2_empty_cache_root_for
  TEMPLATE(@count VALUE SZ)
  VAR layer2_home_plate_store#(@count count, @slot_count layer2_plate_slot_count, @empty_metadata TRUE);

PRIVATE(MODULE) ::layer2_slab_root_for
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ, @cache_count VALUE SZ)
  VAR layer2_slab_root#(@count cache_count);

PRIVATE(MODULE) ::allocator_thread_caches_disabled VAR PER_THREAD BOOL;
PRIVATE(MODULE) ::allocator_thread_cache_lifetime_state
  VAR PER_THREAD allocator_thread_cache_lifetime;

DOC <$
  Publishes an empty plate or discards it when the bounded store has no slot.
  Metadata mappings remain alive until every constructed plate is discarded.
  $>
PRIVATE(MODULE) ::layer2_release_empty_cache_node
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@node MUT->addr_cache_node#(@count count))
{
  ASSERT(node->.cache.used == 0, "Only an empty cache can enter the empty-cache store.");
  IF (layer2_empty_cache_root_for#(@count count).try_push(@node node)) { RETURN; }
  VAR metadata MUT->layer2_metadata_region := node->.metadata;
  VAR mapping_bytes SZ := metadata->.mapping_bytes;
  IF (metadata->.remaining.FETCH_SUBTRACT#ATOMIC_ACQREL(1) == 1)
  { layer5_unmap_region(@address IBC_GETADDR(@PTR metadata), @bytes mapping_bytes); }
}

DOC <$
  Constructs a batch of plate objects outside shared state. One plate is
  returned directly and the others are offered to the bounded empty store.
  $>
PRIVATE(MODULE) ::layer2_refill_empty_cache_nodes
  TEMPLATE(@count VALUE SZ)
  FUNCTION(): MUT->addr_cache_node#(@count count)
{
  VAR node_size SZ := CELLSIZEOF(addr_cache_node#(@count count));
  VAR node_align SZ := ALIGNOF(addr_cache_node#(@count count));
  VAR offset SZ := ((SIZEOF(layer2_metadata_region) + node_align - 1) / node_align) * node_align;
  VAR region_size SZ := offset + node_size * (layer2_plate_slot_count + 1);
  IF (region_size > allocator_slab_region_size) { region_size := allocator_slab_region_size; }
  IF (region_size < offset + node_size) { region_size := offset + node_size; }
  VAR region_address ADDRESS := layer5_map_region(@bytes region_size);
  IF (region_address!?) { VAR empty MUT->addr_cache_node#(@count count); RETURN empty; }
  VAR metadata_storage MUT->TYPED_STORAGE(layer2_metadata_region) :=
    ADDRESS_LAUNDER_DISCOVER_EXISTING region_address TO MUT->TYPED_STORAGE(layer2_metadata_region);
  VAR metadata MUT->layer2_metadata_region := PLACE AT(metadata_storage->) layer2_metadata_region;
  VAR node_count SZ := (region_size - offset) / node_size;
  metadata->.remaining.STORE#ATOMIC_RELAXED(node_count);
  metadata->.mapping_bytes := region_size;
  metadata->.transfer_home := layer2_random_home();
  VAR result MUT->addr_cache_node#(@count count);
  LOOP VALUE(node_index) FROM(0 AS SZ) UNTIL(node_count) DO
  {
    VAR node_address ADDRESS := region_address + offset + node_index * node_size;
    VAR node_storage MUT->TYPED_STORAGE(addr_cache_node#(@count count)) :=
      ADDRESS_LAUNDER_DISCOVER_EXISTING node_address TO MUT->TYPED_STORAGE(addr_cache_node#(@count count));
    VAR node MUT->addr_cache_node#(@count count) := PLACE AT(node_storage->) addr_cache_node#(@count count);
    node->.metadata := metadata;
    IF (node_index == 0) { result := node; }
    ELSE { layer2_release_empty_cache_node#(@count count)(@node node); }
  }
  RETURN result;
}

DOC <$
  Claims an empty plate or constructs a metadata batch after an unsuccessful scan.
  $>
PRIVATE(MODULE) ::layer2_acquire_empty_cache_node
  TEMPLATE(@count VALUE SZ)
  FUNCTION(): MUT->addr_cache_node#(@count count)
{
  VAR result MUT->addr_cache_node#(@count count) := layer2_empty_cache_root_for#(@count count).try_pop();
  IF ((result??) == FALSE) { result := layer2_refill_empty_cache_nodes#(@count count)(); }
  IF (result!?) { RETURN result; }
  ASSERT(result->.cache.used == 0, "An acquired empty cache contains addresses.");
  RETURN result;
}

DOC <$
  Sorts a privately owned plate by address and returns each region's slots in
  one batch. The empty plate remains owned by the caller.
  $>
PRIVATE(MODULE) ::layer2_drain_cache TEMPLATE(@count VALUE SZ)
  FUNCTION(@cache MUT& addr_cache#(@count count))
{
  cache.sort();
  LOOP WHILE (cache.used > 0) DO { layer3_region_return_batch#(@count count)(@cache cache); }
}

DOC <$
  Handles allocations above the slab limit with page-rounded direct mappings.
  $>
PRIVATE(MODULE) ::large_allocator
  STRUCT
{
  DOC <$ Maps one allocation with the requested layout. $>
  PRIVATE(MODULE) ::allocate
    FUNCTION(@size SZ, @align SZ): ADDRESS
  {
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    RETURN layer5_map_region(@bytes bytes);
  }

  DOC <$ Unmaps one allocation with the original layout. $>
  PRIVATE(MODULE) ::deallocate
    FUNCTION(@size SZ, @align SZ, @ptr ADDRESS)
  {
    ASSERT(ptr??);
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    layer5_unmap_region(@address ptr, @bytes bytes);
  }
}

DOC <$
  Implements one fixed block-size and alignment allocator with whole-cache
  transfers between thread-local and global state.
  $>
PRIVATE(MODULE) ::slab_allocator
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ) STRUCT
{
  PRIVATE(MODULE) ::address_cache_count STATIC SZ :=
    allocator_address_cache_entry_count(@block_size block_size);

  DOC <$
    Stores the active cache cursor, bounds, and both cache ownership pointers.
    $>
  PRIVATE(MODULE) ::layer1_cache_control_state STRUCT
  {
    DOC <$ Points to the first unused address slot in the active cache. $>
    .entry
      VAR =>>TYPED_STORAGE(ADDRESS);
    DOC <$ Points one slot past the active cache storage capacity. $>
    .top
      VAR =>>TYPED_STORAGE(ADDRESS);
    DOC <$ Points to the first address slot, or null before initialization. $>
    .bottom
      VAR =>>TYPED_STORAGE(ADDRESS);
    DOC <$ Owns the active cache object whose used count is synchronized before transfers. $>
    .node
      VAR MUT->addr_cache_node#(@count address_cache_count);
    DOC <$ Owns the secondary cache, accessed during slow-path transfers. $>
    .secondary_node
      VAR MUT->addr_cache_node#(@count address_cache_count);
    .home VAR SZ;
    .home_assigned VAR BOOL;
  }

  DOC <$
    Owns one thread's active and secondary cache state for this slab specialization.
    $>
  PRIVATE(MODULE) ::layer1_cache_control VAR PER_THREAD layer1_cache_control_state ALIGN(64);

  DOC <$ Owns the stable control lists for this slab class. $>
  PRIVATE(MODULE) ::layer3_regions
    VAR layer2_region_bank;

  PRIVATE(MODULE) ::layer2_next_home VAR ATOMIC#SZ ALIGN(64);

  PRIVATE(MODULE) ::layer2_allocation_home FUNCTION(): SZ
  {
    IF (layer1_cache_control.home_assigned == FALSE)
    {
      allocator_process_start();
      layer1_cache_control.home := layer2_next_home.FETCH_ADD#ATOMIC_RELAXED(1) #&& (allocator_transfer_shard_count - 1);
      layer1_cache_control.home_assigned := TRUE;
    }
    RETURN layer1_cache_control.home;
  }

  DOC <$
    Claims a full plate or aggregates privately claimed partial plates before
    refilling the remaining capacity from layer 3.
    $>
  PRIVATE(MODULE) ::layer2_acquire_full_cache
    FUNCTION(): MUT->addr_cache_node#(@count address_cache_count)
  {
    VAR root MUT& layer2_slab_root#(@count address_cache_count) := layer2_slab_root_for#(
      @block_size block_size, @block_align block_align, @cache_count address_cache_count
    );
    VAR result MUT->addr_cache_node#(@count address_cache_count) := root.full.pop_at(@home layer2_allocation_home());
    IF (result??) { RETURN result; }
    result := root.partial.pop_at(@home layer2_allocation_home());
    IF ((result??) == FALSE)
    { result := layer2_acquire_empty_cache_node#(@count address_cache_count)(); }
    IF (result!?) { RETURN result; }
    LOOP WHILE (result->.cache.used < address_cache_count) DO
    {
      VAR partial MUT->addr_cache_node#(@count address_cache_count) := root.partial.pop_at(@home layer2_allocation_home());
      IF ((partial??) == FALSE) { BREAK; }
      VAR transferred SZ := partial->.cache.used;
      IF (transferred > address_cache_count - result->.cache.used)
      { transferred := address_cache_count - result->.cache.used; }
      partial->.cache.move_entries_to(@destination result->.cache, @entry_count transferred);
      IF (partial->.cache.used == 0)
      { layer2_release_empty_cache_node#(@count address_cache_count)(@node partial); }
      ELSE
      {
        IF (root.partial.try_push(@node partial) == FALSE)
        {
          layer2_drain_cache#(@count address_cache_count)(@cache partial->.cache);
          layer2_release_empty_cache_node#(@count address_cache_count)(@node partial);
        }
      }
    }
    IF (result->.cache.used < address_cache_count)
    {
      VAR regions MUT->layer3_region_class := layer3_regions.get(@home layer2_allocation_home());
      IF (regions!?)
      {
        layer2_drain_cache#(@count address_cache_count)(@cache result->.cache);
        layer2_release_empty_cache_node#(@count address_cache_count)(@node result);
        RETURN NULL;
      }
      regions->.mtx.lock();
      regions->.initialize(@size block_size, @align block_align);
      regions->.mtx.unlock();
      IF (layer3_region_refill#(@count address_cache_count)(@root regions->, @cache result->.cache) == FALSE)
      {
        layer2_drain_cache#(@count address_cache_count)(@cache result->.cache);
        layer2_release_empty_cache_node#(@count address_cache_count)(@node result);
        VAR empty MUT->addr_cache_node#(@count address_cache_count);
        RETURN empty;
      }
    }
    RETURN result;
  }

  DOC <$
    Aggregates partial plates under private ownership and publishes full plates.
    A plate that cannot be retained returns its slots to layer 3 in region batches.
    $>
  PRIVATE(MODULE) ::layer2_release_cache
    FUNCTION(@node MUT->addr_cache_node#(@count address_cache_count))
  {
    IF (node->.cache.used == 0)
    {
      layer2_release_empty_cache_node#(@count address_cache_count)(@node node);
      RETURN;
    }
    VAR root MUT& layer2_slab_root#(@count address_cache_count) := layer2_slab_root_for#(
      @block_size block_size, @block_align block_align, @cache_count address_cache_count
    );
    IF (node->.cache.used < address_cache_count)
    {
      VAR partial MUT->addr_cache_node#(@count address_cache_count) := root.partial.pop_at(@home layer2_random_home());
      IF (partial??)
      {
        VAR transferred SZ := partial->.cache.used;
        IF (transferred > address_cache_count - node->.cache.used)
        { transferred := address_cache_count - node->.cache.used; }
        partial->.cache.move_entries_to(@destination node->.cache, @entry_count transferred);
        IF (partial->.cache.used == 0)
        { layer2_release_empty_cache_node#(@count address_cache_count)(@node partial); }
        ELSE IF (root.partial.try_push(@node partial) == FALSE)
        {
          layer2_drain_cache#(@count address_cache_count)(@cache partial->.cache);
          layer2_release_empty_cache_node#(@count address_cache_count)(@node partial);
        }
      }
    }
    IF (node->.cache.used == address_cache_count)
    {
      IF (root.full.try_push(@node node)) { RETURN; }
    }
    ELSE
    {
      IF (root.partial.try_push(@node node)) { RETURN; }
    }
    layer2_drain_cache#(@count address_cache_count)(@cache node->.cache);
    layer2_release_empty_cache_node#(@count address_cache_count)(@node node);
  }

  DOC <$
    Acquires and activates both empty cache objects, returning false if either allocation fails.
    $>
  PRIVATE(MODULE) ::layer1_initialize_thread_cache
    FUNCTION(): BOOL
  {
    allocator_thread_cache_lifetime_state;
    ASSERT((layer1_cache_control.node??) == FALSE, "A thread cache already has an active cache object.");
    ASSERT((layer1_cache_control.secondary_node??) == FALSE, "A thread cache already has a secondary cache object.");
    VAR active MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_empty_cache_node#(@count address_cache_count)();
    IF (active!?) { RETURN FALSE; }
    VAR secondary MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_empty_cache_node#(@count address_cache_count)();
    IF (secondary!?)
    {
      layer2_release_empty_cache_node#(@count address_cache_count)(@node active);
      RETURN FALSE;
    }
    layer1_cache_control.node := active;
    layer1_cache_control.secondary_node := secondary;
    layer1_activate_thread_cache();
    RETURN TRUE;
  }

  DOC <$
    Establishes the thread-local cursor and bounds from the active cache node
    after a slow-path transfer.
    $>
  PRIVATE(MODULE) ::layer1_activate_thread_cache
    FUNCTION()
  {
    layer1_cache_control.bottom := layer1_cache_control.node->.cache.entries[&0];
    layer1_cache_control.entry := layer1_cache_control.bottom + layer1_cache_control.node->.cache.used;
    layer1_cache_control.top := layer1_cache_control.bottom + address_cache_count;
  }

  DOC <$
    Obtains an allocation through global plates after thread-local teardown.
    $>
  PRIVATE(MODULE) ::layer2_allocate_without_thread_cache FUNCTION(): ADDRESS
  {
    VAR node MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_full_cache();
    IF (node!?) { RETURN NULL; }
    VAR result ADDRESS := node->.cache.pop();
    layer2_release_cache(@node node);
    RETURN result;
  }

  DOC <$
    Returns a slot to its region after thread-local teardown.
    $>
  PRIVATE(MODULE) ::layer3_deallocate_without_thread_cache FUNCTION(@ptr ADDRESS)
  { layer3_region_return(@address ptr); }

  DOC <$ Allocates one block from this slab allocator or returns null on allocation failure. $>
  PRIVATE(MODULE) ::layer0_allocate
    FUNCTION(): ADDRESS
  {
    VAR entry =>>TYPED_STORAGE(ADDRESS) := layer1_cache_control.entry;
    IF LIKELY (entry != layer1_cache_control.bottom)
    {
      entry--;
      VAR result ADDRESS := PUN entry-> AS ADDRESS;
      INVARIANT(result??, "A slab address cache contains a null address.");
      DESTROY AT(entry->) ADDRESS;
      layer1_cache_control.entry := entry;
      RETURN result;
    }

    RETURN layer1_allocate();
  }

  DOC <$
    Refills an empty active cache or allocates while thread caches are disabled.
    $>
  PRIVATE(MODULE) ::layer1_allocate
    FUNCTION(): ADDRESS
  {
    IF UNLIKELY (allocator_thread_caches_disabled)
    {
      RETURN layer2_allocate_without_thread_cache();
    }

    IF (layer1_cache_control.node??)
    {
      layer1_cache_control.node->.cache.used := 0;
      INVARIANT(layer1_cache_control.secondary_node??, "A thread cache is missing its secondary cache object.");
      VAR secondary_entries SZ := layer1_cache_control.secondary_node->.cache.used;
      IF (secondary_entries == address_cache_count)
      {
        layer1_cache_control.secondary_node->.cache.move_entries_to(
          @destination layer1_cache_control.node->.cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        VAR previous_active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
        layer1_cache_control.node := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := previous_active;
      }
      ELSE
      {
        ASSERT(secondary_entries == 0, "A secondary address cache has an invalid state.");
      }
    }

    IF ((layer1_cache_control.node??) == FALSE || layer1_cache_control.node->.cache.used == 0)
    {
      IF ((layer1_cache_control.node??) == FALSE)
      {
        IF (layer1_initialize_thread_cache() == FALSE) { RETURN NULL; }
      }
      ASSERT(layer1_cache_control.secondary_node->.cache.used == 0, "A thread cache refill requires an empty secondary cache.");
      VAR full MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_full_cache();
      IF (full!?) { RETURN NULL; }
      layer2_release_empty_cache_node#(@count address_cache_count)(@node layer1_cache_control.secondary_node);
      layer1_cache_control.secondary_node := full;
      layer1_cache_control.secondary_node->.cache.move_entries_to(
        @destination layer1_cache_control.node->.cache,
        @entry_count address_cache_count / 2
      );
    }
    layer1_activate_thread_cache();
    layer1_cache_control.entry--;
    VAR result ADDRESS := PUN layer1_cache_control.entry-> AS ADDRESS;
    DESTROY AT(layer1_cache_control.entry->) ADDRESS;
    RETURN result;
  }

  DOC <$ Returns one block to this slab allocator. $>
  PRIVATE(MODULE) ::layer0_deallocate
    FUNCTION(@ptr ADDRESS)
  {
    VAR entry =>>TYPED_STORAGE(ADDRESS) := layer1_cache_control.entry;
    IF LIKELY (entry != layer1_cache_control.top)
    {
      PLACE AT(entry->) ADDRESS := ptr;
      entry++;
      layer1_cache_control.entry := entry;
      RETURN;
    }

    layer1_deallocate(@ptr ptr);
  }

  DOC <$
    Returns a block after a full active cache requires transfer or initialization.
    $>
  PRIVATE(MODULE) ::layer1_deallocate
    FUNCTION(@ptr ADDRESS)
  {
    INVARIANT(ptr??, "freeing nullptr is undefined");
    IF UNLIKELY (allocator_thread_caches_disabled)
    {
      layer3_deallocate_without_thread_cache(@ptr ptr);
      RETURN;
    }

    IF ((layer1_cache_control.node??) == FALSE)
    {
      IF (layer1_initialize_thread_cache() == FALSE)
      {
        layer3_deallocate_without_thread_cache(@ptr ptr);
        RETURN;
      }
    }
    ELSE
    {
      layer1_cache_control.node->.cache.used := address_cache_count;
      VAR secondary_entries SZ := layer1_cache_control.secondary_node->.cache.used;
      IF (secondary_entries == 0)
      {
        layer1_cache_control.node->.cache.move_entries_to(
          @destination layer1_cache_control.secondary_node->.cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        VAR previous_active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
        layer1_cache_control.node := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := previous_active;
      }
      ELSE
      {
        INVARIANT(secondary_entries == address_cache_count, "A secondary address cache has an invalid state.");
        VAR empty_cache MUT->addr_cache_node#(@count address_cache_count) := layer2_acquire_empty_cache_node#(@count address_cache_count)();
        IF (empty_cache!?)
        {
          layer3_deallocate_without_thread_cache(@ptr ptr);
          RETURN;
        }
        VAR full_cache MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.secondary_node;
        layer1_cache_control.secondary_node := empty_cache;
        layer2_release_cache(@node full_cache);
        layer1_cache_control.node->.cache.move_entries_to(
          @destination layer1_cache_control.secondary_node->.cache,
          @entry_count address_cache_count / 2
        );
      }
    }

    layer1_activate_thread_cache();
    PLACE AT(layer1_cache_control.entry->) ADDRESS := ptr;
    layer1_cache_control.entry++;
  }

  DOC <$
    Returns both cache objects owned by this thread to global allocator state.
    $>
  PRIVATE(MODULE) ::layer1_release_thread_cache
    FUNCTION()
  {
    IF ((layer1_cache_control.node??) == FALSE)
    {
      ASSERT((layer1_cache_control.secondary_node??) == FALSE, "A thread cache owns only one cache object.");
      RETURN;
    }
    ASSERT(layer1_cache_control.secondary_node??, "A thread cache is missing its secondary cache object.");
    VAR active MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.node;
    VAR secondary MUT->addr_cache_node#(@count address_cache_count) := layer1_cache_control.secondary_node;
    active->.cache.used := (layer1_cache_control.entry - layer1_cache_control.bottom) AS CHECKED SZ;
    VAR no_entry =>>TYPED_STORAGE(ADDRESS);
    layer1_cache_control.entry := no_entry;
    layer1_cache_control.top := no_entry;
    layer1_cache_control.bottom := no_entry;
    VAR no_cache MUT->addr_cache_node#(@count address_cache_count);
    layer1_cache_control.node := no_cache;
    layer1_cache_control.secondary_node := no_cache;
    layer2_release_cache(@node active);
    layer2_release_cache(@node secondary);
  }

  DOC <$
    Reports this thread's block count for allocator validation.
    $>
  PRIVATE(MODULE) ::thread_cached_block_count
    FUNCTION(): SZ
  {
    IF ((layer1_cache_control.node??) == FALSE)
    {
      RETURN 0;
    }
    RETURN (layer1_cache_control.entry - layer1_cache_control.bottom) AS CHECKED SZ
      + layer1_cache_control.secondary_node->.cache.used;
  }
}

DOC <$
  Routes a compile-time layout through the generated slab size classes.
  $>
PRIVATE(MODULE) ::allocator_allocate_static
  TEMPLATE(@size VALUE SZ, @align VALUE SZ) FUNCTION(): ADDRESS
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    STATIC_IF(size <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      RETURN slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_allocate();
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  RETURN large_allocator::allocate(@size size, @align align);
}

DOC <$
  Returns a compile-time layout through the generated slab size classes.
  $>
PRIVATE(MODULE) ::allocator_deallocate_static
  TEMPLATE(@size VALUE SZ, @align VALUE SZ) FUNCTION(@ptr ADDRESS)
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    STATIC_IF(size <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_deallocate(@ptr ptr);
      RETURN;
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  large_allocator::deallocate(@size size, @align align, @ptr ptr);
}

DOC <$
  Routes a runtime layout through the generated slab size classes.
  $>
PRIVATE(MODULE) ::allocator_allocate_dynamic
  FUNCTION(@bytes SZ, @align SZ): ADDRESS
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size) {
      STATIC_EVAL block_align := allocator_page_size;
    }
    IF (bytes <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align)) {
      RETURN slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_allocate();
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4) {
      STATIC_EVAL step *= 2;
    }
  }
  RETURN large_allocator::allocate(@size bytes, @align align);
}

DOC <$
  Returns a runtime layout through the generated slab size classes.
  $>
PRIVATE(MODULE) ::allocator_deallocate_dynamic
  FUNCTION(@bytes SZ, @align SZ, @ptr ADDRESS)
{
  allocator_validate_alignment(@align align);
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    IF (bytes <= SNAPSHOT(block_size) && align <= SNAPSHOT(block_align))
    {
      slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer0_deallocate(@ptr ptr);
      RETURN;
    }
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  large_allocator::deallocate(@size bytes, @align align, @ptr ptr);
}

DOC <$
  Uses a slab allocator for a runtime count whenever the total layout is eligible.
  $>
PRIVATE(MODULE) ::allocator_allocate_multiple
  FUNCTION(@size SZ, @align SZ, @count SZ): ADDRESS
{
  IF (count != 0 && size > ((0 AS SZ) #!!) / count) { RETURN NULL; }
  VAR bytes SZ := size * count;
  RETURN allocator_allocate_dynamic(@bytes bytes, @align align);
}

DOC <$
  Reconstructs the multi allocation's slab-or-large routing from its count.
  $>
PRIVATE(MODULE) ::allocator_deallocate_multiple
  FUNCTION(@size SZ, @align SZ, @ptr ADDRESS, @count SZ)
{
  IF ((ptr??) == FALSE)
  {
    RETURN;
  }
  VAR bytes SZ := allocator_checked_bytes(@size size, @count count);
  allocator_deallocate_dynamic(@bytes bytes, @align align, @ptr ptr);
}

DOC <$
  Flushes every generated slab specialization used by the default allocator.
  $>
PRIVATE(MODULE) ::allocator_release_all_thread_caches
  FUNCTION()
{
  STATIC_VAR block_size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (block_size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR block_align SZ := block_size #&& ((block_size #!!) + 1);
    STATIC_IF(block_align > allocator_page_size)
    { STATIC_EVAL block_align := allocator_page_size; }
    slab_allocator#(@block_size SNAPSHOT(block_size), @block_align SNAPSHOT(block_align))::layer1_release_thread_cache();
    STATIC_EVAL block_size += step;
    STATIC_IF(block_size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
}

DOC <$
  Disables thread-local caching and returns cached addresses to global state.
  Releasing the caches clears their cursors and bounds, so subsequent
  allocations and deallocations enter the slow path during thread teardown.
  $>
PRIVATE(MODULE) ::allocator_thread_cache_shutdown_begin
  FUNCTION()
{
  allocator_thread_caches_disabled := TRUE;
  allocator_release_all_thread_caches();
}

DOC <$
  Returns this thread's remaining full, partial, and empty cache objects after
  every registered thread-local destructor has run.
  $>
PRIVATE(MODULE) ::allocator_thread_cache_shutdown_finish
  FUNCTION()
{
  allocator_release_all_thread_caches();
}

DOC <$
  Provides the standard typed allocator interfaces for `T`. The `VOID`
  specialization provides the typeless Size-Align and Virtual Allocator APIs.
  $>
::DEFAULT_ALLOCATOR
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  DOC <$ Allocates storage for one object of `T`. $>
  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE)
    FUNCTION(): ->TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#T();
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T();
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )();
        IF (addr!?) { THROW UNWIND_OUT_OF_MEMORY; }
        RETURN BEGIN_ALLOC_REGION addr TO ->TYPED_STORAGE(T);
      }
    }
  }

  DOC <$ Releases storage previously returned by `ALLOC`. $>
  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE)
    FUNCTION(@PTR:ptr ->TYPED_STORAGE(T))
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_ALLOC_REGION ptr;
        allocator_deallocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )(@ptr addr);
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#T(% [ptr]);
    }
  }

  DOC <$
    Allocates contiguous storage for `count` objects of `T`.
    $>
  ::MULTI_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE)
    FUNCTION(@COUNT:count SZ): =>>TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC_MULTIPLE#T(% [count]);
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T(% [count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_multiple(
          @size CELLSIZEOF(T),
          @align ALIGNOF(T),
          @count count
        );
        IF (addr!?) { THROW UNWIND_OUT_OF_MEMORY; }
        RETURN BEGIN_MULTI_ALLOC_REGION addr SIZE count TO =>>TYPED_STORAGE(T);
      }
    }
  }

  DOC <$
    Releases storage previously returned by `MULTI_ALLOC`.
    $>
  ::MULTI_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE)
    FUNCTION(@PTR:ptr =>>TYPED_STORAGE(T), @COUNT:count SZ)
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr, count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_MULTI_ALLOC_REGION ptr SIZE count;
        allocator_deallocate_multiple(
          @size CELLSIZEOF(T),
          @align ALIGNOF(T),
          @ptr addr,
          @count count
        );
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC_MULTIPLE#T(% [ptr, count]);
    }
  }

  DOC <$ Allocates storage with compile-time size and alignment. $>
  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID))
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(): ->ALIGNED_STORAGE(size, align)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#(@SIZE size, @ALIGN align)();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_static#(
        @size size,
        @align align
      )();
      IF (addr!?) { THROW UNWIND_OUT_OF_MEMORY; }
      RETURN BEGIN_ALLOC_REGION addr TO ->ALIGNED_STORAGE(size, align);
    }
  }

  DOC <$ Releases storage allocated with compile-time size and alignment. $>
  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID))
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(@PTR:ptr ->ALIGNED_STORAGE(size, align))
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_static#(
        @size size,
        @align align
      )(@ptr addr);
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#(@SIZE size, @ALIGN align)(% [ptr]);
    }
  }

  DOC <$
    Allocates storage with runtime-provided size and alignment.
    $>
  ::VIRTUAL_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE)
    FUNCTION(@SIZE:size SZ, @ALIGN:align SZ): ->VIRTUAL_STORAGE
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#VIRTUAL_STORAGE();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_dynamic(
        @bytes size,
        @align align
      );
      IF (addr!?) { THROW UNWIND_OUT_OF_MEMORY; }
      RETURN BEGIN_ALLOC_REGION addr TO ->VIRTUAL_STORAGE;
    }
  }

  DOC <$
    Releases virtual storage using its original size and alignment.
    $>
  ::VIRTUAL_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE)
    FUNCTION(@PTR:ptr ->VIRTUAL_STORAGE, @SIZE:size SZ, @ALIGN:align SZ)
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_dynamic(
        @bytes size,
        @align align,
        @ptr addr
      );
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#VIRTUAL_STORAGE(% [ptr]);
    }
  }
}
