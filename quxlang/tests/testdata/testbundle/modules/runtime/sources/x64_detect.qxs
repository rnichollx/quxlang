// No reliable generic probe is implemented for this microarchitectural fact.
// Leaving the compiler-owned flag clear makes the detector a conservative stub.
::DETECT_X64_PERF_FAST_GATHER INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  X64_PERF_FAST_GATHER_ENABLED := FALSE;
}
