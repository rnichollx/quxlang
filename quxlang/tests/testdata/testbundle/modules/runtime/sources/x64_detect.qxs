::x64_cpuid_extended_state_leaf1_eax INCLUDE_IF(ARCH_IS_X64) DOC <$
  Returns the CPUID leaf 0xD subleaf 1 EAX register, or zero when the leaf is unavailable.
  $>
  ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN U32)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 0xd
  SETAE R8B
  MOV EAX, 0xd
  MOV ECX, 1
  CPUID
  MOVZX R8D, R8B
  NEG R8D
  AND EAX, R8D
  POP RBX
  RET
}

::x64_cpuid_extended_state_leaf1_eax_bit INCLUDE_IF(ARCH_IS_X64) DOC <$
  Tests one bit of the CPUID register using the target calling convention.
  $>
  FUNCTION(@bit I32): BOOL
{
  RETURN ((x64_cpuid_extended_state_leaf1_eax() #-- (bit AS CHECKED U32)) #&& (1 AS U32)) != 0;
}

::x64_cpuid_has_avx_os_support INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  MOV EAX, ECX
  AND EAX, 0x18000000
  CMP EAX, 0x18000000
  SETE AL
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_xcr0_has_avx_state INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  XOR ECX, ECX
  XGETBV
  AND EAX, 0x6
  CMP EAX, 0x6
  SETE AL
  MOVZX EAX, AL
  RET
}

::x64_cpuid_has_avx2 INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 7
  SETAE R8B
  MOV EAX, 7
  XOR ECX, ECX
  CPUID
  BT EBX, 5
  SETC AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_xcr0_has_avx512_state INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  XOR ECX, ECX
  XGETBV
  AND EAX, 0xe6
  CMP EAX, 0xe6
  SETE AL
  MOVZX EAX, AL
  RET
}

::x64_cpuid_has_avx512f INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 7
  SETAE R8B
  MOV EAX, 7
  XOR ECX, ECX
  CPUID
  BT EBX, 16
  SETC AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::DETECT_X64_FEATURE_SSE2 INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  X64_FEATURE_SSE2_ENABLED := x64_cpuid_has_sse2();
}

