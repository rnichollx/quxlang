LANGUAGE QUXLANG EN 0.0;

::x64_cpuid_vendor_is_amd INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EBX, 0x68747541
  SETE R8B
  CMP EDX, 0x69746e65
  SETE R9B
  AND R8B, R9B
  CMP ECX, 0x444d4163
  SETE AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_cpuid_vendor_is_intel INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EBX, 0x756e6547
  SETE R8B
  CMP EDX, 0x49656e69
  SETE R9B
  AND R8B, R9B
  CMP ECX, 0x6c65746e
  SETE AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_cpuid_has_sse2 INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  BT EDX, 26
  SETC AL
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_cpuid_leaf1_ecx INCLUDE_IF(ARCH_IS_X64) DOC <$
  Returns the CPUID leaf 1 ECX register.
  $>
  ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN U32)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  MOV EAX, ECX
  POP RBX
  RET
}

::x64_cpuid_leaf1_ecx_bit INCLUDE_IF(ARCH_IS_X64) DOC <$
  Tests one bit of the CPUID register using the target calling convention.
  $>
  FUNCTION(@bit I32): BOOL
{
  RETURN ((x64_cpuid_leaf1_ecx() #-- (bit AS CHECKED U32)) #&& (1 AS U32)) != 0;
}

::x64_cpuid_leaf1_edx INCLUDE_IF(ARCH_IS_X64) DOC <$
  Returns the CPUID leaf 1 EDX register.
  $>
  ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN U32)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  MOV EAX, EDX
  POP RBX
  RET
}

::x64_cpuid_leaf1_edx_bit INCLUDE_IF(ARCH_IS_X64) DOC <$
  Tests one bit of the CPUID register using the target calling convention.
  $>
  FUNCTION(@bit I32): BOOL
{
  RETURN ((x64_cpuid_leaf1_edx() #-- (bit AS CHECKED U32)) #&& (1 AS U32)) != 0;
}

::x64_cpuid_leaf7_ebx INCLUDE_IF(ARCH_IS_X64) DOC <$
  Returns the CPUID leaf 7 EBX register, or zero when the leaf is unavailable.
  $>
  ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN U32)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 7
  SETAE R8B
  MOV EAX, 7
  XOR ECX, ECX
  CPUID
  MOV EAX, EBX
  MOVZX R8D, R8B
  NEG R8D
  AND EAX, R8D
  POP RBX
  RET
}

::x64_cpuid_leaf7_ebx_bit INCLUDE_IF(ARCH_IS_X64) DOC <$
  Tests one bit of the CPUID register using the target calling convention.
  $>
  FUNCTION(@bit I32): BOOL
{
  RETURN ((x64_cpuid_leaf7_ebx() #-- (bit AS CHECKED U32)) #&& (1 AS U32)) != 0;
}

::x64_cpuid_extended_leaf1_ecx INCLUDE_IF(ARCH_IS_X64) DOC <$
  Returns CPUID leaf 0x80000001 ECX, or zero when the leaf is unavailable.
  $>
  ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN U32)
{
  PUSH RBX
  MOV EAX, 0x80000000
  CPUID
  CMP EAX, 0x80000001
  SETAE R8B
  MOV EAX, 0x80000001
  CPUID
  MOV EAX, ECX
  MOVZX R8D, R8B
  NEG R8D
  AND EAX, R8D
  POP RBX
  RET
}

::x64_cpuid_extended_leaf1_ecx_bit INCLUDE_IF(ARCH_IS_X64) DOC <$
