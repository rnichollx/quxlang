LANGUAGE QUXLANG EN 0.0;

DOC <$ Converts an encoded cleanup offset whose storage extent has been validated for the compilation target. $>
PRIVATE(MODULE) ::coroutine_cleanup_offset FUNCTION(@ARG U64) NOEXCEPT: SZ
{
  STATIC_IF(SAME_TYPES(SZ, U64)) { RETURN ARG; }
  STATIC_ELSE { RETURN ARG AS PARTIAL SZ; }
}

DOC <$ Finds a logical slot in a shared immutable lifetime tree. $>
PRIVATE(MODULE) ::coroutine_cleanup_find FUNCTION(@RECORD:nodes CONST =>> U64, @NODE:root U64, @INDEX:key U64) NOEXCEPT: U64
{
  VAR node U64 := root;
  LOOP WHILE(node != 0) DO
  {
    VAR branch U64 := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 3))->;
    IF(branch == 0)
    {
      IF((nodes + coroutine_cleanup_offset(@ARG node * 12 + 2))-> == key) { RETURN node; }
      RETURN 0;
    }
    IF((key #&& branch) == 0) { node := (nodes + coroutine_cleanup_offset(@ARG node * 12))->; }
    ELSE { node := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 1))->; }
  }
  RETURN 0;
}

DOC <$ Selects the greatest departing logical slot below the cleanup boundary while skipping shared lifetime subtrees. $>
PRIVATE(MODULE) ::coroutine_cleanup_previous FUNCTION(@RECORD:nodes CONST =>> U64, @NODE:root U64, @OUTPUT:target U64, @COUNT:before U64) NOEXCEPT: U64
{
  IF(root == 0) { RETURN 0; }
  VAR boundary U64 := before;
  LOOP DO
  {
    IF((nodes + coroutine_cleanup_offset(@ARG root * 12 + 2))-> >= boundary) { RETURN 0; }
    VAR node U64 := root;
    VAR matching U64 := target;
    LOOP DO
    {
      VAR branch U64 := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 3))->;
      VAR key U64 := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 2))->;
      LOOP WHILE(matching != 0) DO
      {
        VAR target_branch U64 := (nodes + coroutine_cleanup_offset(@ARG matching * 12 + 3))->;
        IF(target_branch <= branch) { BREAK; }
        IF((key #&& target_branch) == 0) { matching := (nodes + coroutine_cleanup_offset(@ARG matching * 12))->; }
        ELSE { matching := (nodes + coroutine_cleanup_offset(@ARG matching * 12 + 1))->; }
      }
      IF(node == matching)
      {
        boundary := key;
        BREAK;
      }
      IF(branch == 0) { RETURN node; }
      VAR right U64 := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 1))->;
      IF((nodes + coroutine_cleanup_offset(@ARG right * 12 + 2))-> < boundary) { node := right; }
      ELSE { node := (nodes + coroutine_cleanup_offset(@ARG node * 12))->; }
    }
  }
}

DOC <$ Tests whether an ownership ancestor has already accepted destruction. $>
PRIVATE(MODULE) ::coroutine_cleanup_owner_retired FUNCTION(@RECORD:nodes CONST =>> U64, @GUARD:statuses CONST =>> U8, @INPUT:source U64, @VALUE:version U64) NOEXCEPT: BOOL
{
  VAR node U64 := version;
  LOOP WHILE(node != 0) DO
  {
    IF((nodes + coroutine_cleanup_offset(@ARG node * 12 + 6))-> != 0) { RETURN FALSE; }
    VAR owner U64 := (nodes + coroutine_cleanup_offset(@ARG node * 12 + 5))->;
    IF(owner == 0) { RETURN FALSE; }
    IF((statuses + coroutine_cleanup_offset(@ARG owner - 1))-> != 0) { RETURN TRUE; }
    node := coroutine_cleanup_find(@RECORD nodes, @NODE source, @INDEX owner - 1);
  }
  RETURN FALSE;
}

DOC <$ Tests whether the destination retains an ownership ancestor of a delegated destructor. $>
PRIVATE(MODULE) ::coroutine_cleanup_owner_survives FUNCTION(@RECORD:nodes CONST =>> U64, @INPUT:source U64, @OUTPUT:target U64, @OTHER:initial_owner U64) NOEXCEPT: BOOL
{
  VAR owner U64 := initial_owner;
  LOOP WHILE(owner != 0) DO
  {
    VAR destination U64 := coroutine_cleanup_find(@RECORD nodes, @NODE target, @INDEX owner - 1);
    IF(destination != 0)
    {
      IF(((nodes + coroutine_cleanup_offset(@ARG destination * 12 + 4))-> #&& 1) != 0) { RETURN TRUE; }
    }
    VAR source_node U64 := coroutine_cleanup_find(@RECORD nodes, @NODE source, @INDEX owner - 1);
    IF(source_node == 0) { RETURN FALSE; }
    IF((nodes + coroutine_cleanup_offset(@ARG source_node * 12 + 6))-> != 0) { RETURN FALSE; }
    owner := (nodes + coroutine_cleanup_offset(@ARG source_node * 12 + 5))->;
  }
  RETURN FALSE;
}

DOC <$ Selects a statically typed cleanup action while preserving retirement and destination ownership. $>
::COROUTINE_CLEANUP_NEXT FUNCTION(@RECORD:nodes CONST =>> U64, @STATE:cursor MUT& [8]U64, @GUARD:statuses CONST =>> U8) NOEXCEPT: U64
{
  LOOP WHILE(cursor[3] < 4) DO
  {
    VAR version U64 := coroutine_cleanup_previous(@RECORD nodes, @NODE cursor[0], @OUTPUT cursor[1], @COUNT cursor[2]);
    IF(version == 0)
    {
      cursor[3] += 1;
      cursor[2] := cursor[7];
      CONTINUE;
    }
    VAR key U64 := (nodes + coroutine_cleanup_offset(@ARG version * 12 + 2))->;
    cursor[2] := key;
    VAR retired U8 := (statuses + coroutine_cleanup_offset(@ARG key))->;
    IF(retired == 2) { CONTINUE; }
    VAR flags U64 := (nodes + coroutine_cleanup_offset(@ARG version * 12 + 4))->;
    VAR destination U64 := coroutine_cleanup_find(@RECORD nodes, @NODE cursor[1], @INDEX key);
    IF(destination != 0)
    {
      VAR target_flags U64 := (nodes + coroutine_cleanup_offset(@ARG destination * 12 + 4))->;
      IF((target_flags #&& 1) != 0) { CONTINUE; }
      IF((flags #&& 1) == 0 && (target_flags #&& 2) != 0) { CONTINUE; }
      IF((flags #&& target_flags #&& 4) != 0) { CONTINUE; }
    }
    VAR actions U64 := (nodes + coroutine_cleanup_offset(@ARG version * 12 + 7 + cursor[4]))->;
    IF(cursor[3] == 3)
    {
      IF((actions #&& 17179869184) == 0) { CONTINUE; }
      cursor[5] := version;
      cursor[6] := 8;
      RETURN version * 16 + 9;
    }
    IF(cursor[3] == 2)
    {
      IF((actions #&& 8589934592) == 0) { CONTINUE; }
      cursor[5] := version;
      cursor[6] := 7;
      RETURN version * 16 + 7;
    }
    IF(coroutine_cleanup_owner_retired(@RECORD nodes, @GUARD statuses, @INPUT cursor[0], @VALUE version)) { CONTINUE; }
    IF(cursor[3] == 0)
    {
      IF(retired != 0 || (actions #&& 4294967296) == 0) { CONTINUE; }
      VAR owner U64 := (nodes + coroutine_cleanup_offset(@ARG version * 12 + 5))->;
      IF(coroutine_cleanup_owner_survives(@RECORD nodes, @INPUT cursor[0], @OUTPUT cursor[1], @OTHER owner)) { CONTINUE; }
      cursor[5] := version;
      cursor[6] := 0;
      RETURN version * 16 + 1;
    }
    actions := actions #&& 63;
    IF(retired == 1) { actions := actions #&& 62; }
    VAR operation U64;
    LOOP WHILE(operation < 6) DO
    {
      IF((actions #&& 1) != 0)
      {
        cursor[5] := version;
        cursor[6] := operation;
        RETURN version * 16 + operation + 1;
      }
      actions := actions / 2;
      operation += 1;
    }
  }
  RETURN 0;
}
