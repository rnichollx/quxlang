LANGUAGE QUXLANG EN 0.0;

::test_selection_tests NAMESPACE
{
  ::matches DOC <$ Exercises the runner's filter matcher using constant text instead of process arguments. $>
    FUNCTION(@name STRING_CONSTANT, @filter STRING_CONSTANT): BOOL
  {
    VAR pattern test_text;
    pattern.literal := filter;
    RETURN test_name_matches(@name name, @pattern pattern);
  }

  ::plain_filters DOC <$ Plain filters are case-sensitive substrings, including empty names and filters. $>
    UNIT_TEST
  {
    TEST_ASSERT(matches(@name "alpha::beta", @filter ""));
    TEST_ASSERT(matches(@name "alpha::beta", @filter "alpha"));
    TEST_ASSERT(matches(@name "alpha::beta", @filter "::b"));
    TEST_ASSERT(matches(@name "alpha::beta", @filter "beta"));
    TEST_ASSERT(matches(@name "alpha::beta", @filter "Beta") == FALSE);
    TEST_ASSERT(matches(@name "alpha", @filter "alphabet") == FALSE);
    TEST_ASSERT(matches(@name "", @filter ""));
    TEST_ASSERT(matches(@name "", @filter "x") == FALSE);
  }

  ::wildcard_filters DOC <$ Wildcard filters match whole names with backtracking and zero-length star matches. $>
    UNIT_TEST
  {
    TEST_ASSERT(matches(@name "alpha::beta", @filter "*::b?ta"));
    TEST_ASSERT(matches(@name "alpha::beta", @filter "alpha*beta"));
    TEST_ASSERT(matches(@name "alpha", @filter "a**lpha*"));
    TEST_ASSERT(matches(@name "ababa", @filter "*aba"));
    TEST_ASSERT(matches(@name "abcabcabd", @filter "*abc*abd"));
    TEST_ASSERT(matches(@name "alpha", @filter "*"));
    TEST_ASSERT(matches(@name "", @filter "**"));
    TEST_ASSERT(matches(@name "alpha", @filter "lpha*") == FALSE);
    TEST_ASSERT(matches(@name "alpha", @filter "*alph") == FALSE);
    TEST_ASSERT(matches(@name "a", @filter "??") == FALSE);
    TEST_ASSERT(matches(@name "ab", @filter "?") == FALSE);
    TEST_ASSERT(matches(@name "abc", @filter "*z") == FALSE);
    TEST_ASSERT(matches(@name "", @filter "?") == FALSE);
  }

  ::option_boundaries DOC <$ Option matching distinguishes exact names from prefixes and sliced filters. $>
    UNIT_TEST
  {
    VAR option test_text;
    option.literal := "--list-tests";
    TEST_ASSERT(test_text_equal(@text option, @literal "--list-tests", @prefix FALSE));
    TEST_ASSERT(test_text_equal(@text option, @literal "--list", @prefix FALSE) == FALSE);
    option.literal := "--list-tests-extra";
    TEST_ASSERT(test_text_equal(@text option, @literal "--list-tests", @prefix FALSE) == FALSE);
    option.literal := "--test-filter=beta";
    TEST_ASSERT(test_text_equal(@text option, @literal "--test-filter=", @prefix TRUE));
    option.offset := 14;
    TEST_ASSERT(test_name_matches(@name "alpha::beta", @pattern option));
  }
  ::option_boundaries_constexpr DOC <$ Retains the compilable constant-text matcher regression that currently fails in constexpr interpretation. $>
    STATIC_TEST KNOWN_FAILING
  {
    VAR option test_text;
    option.literal := "--list-tests";
    TEST_ASSERT(test_text_equal(@text option, @literal "--list-tests", @prefix FALSE));
    TEST_ASSERT(test_text_equal(@text option, @literal "--list", @prefix FALSE) == FALSE);
    option.literal := "--list-tests-extra";
    TEST_ASSERT(test_text_equal(@text option, @literal "--list-tests", @prefix FALSE) == FALSE);
    option.literal := "--test-filter=beta";
    TEST_ASSERT(test_text_equal(@text option, @literal "--test-filter=", @prefix TRUE));
    option.offset := 14;
    TEST_ASSERT(test_name_matches(@name "alpha::beta", @pattern option));
  }
}
