LANGUAGE QUXLANG EN 0.0;

::stdout STATIC I32 := 1;

::print_selected_stepping OPTION BOOL DEFAULT_VALUE(FALSE);

::POST_DETECT FUNCTION()
{
  STATIC_IF(OS_LINUX)
  {
    STATIC_IF(require_linux_waitv)
    {
      IF (detect_kernel_linux_waitv() == FALSE)
      {
        PANIC "The runtime requires Linux futex_waitv, but it is unavailable.";
      }
    }
  }
  thread_process_start();
  VAR no_identity MUT->thread_identity;
  thread_runtime_start(@identity no_identity);
  STATIC_IF(print_selected_stepping)
  {
    write(@fd stdout, @msg "selected stepping: ");
    write_decimal(@fd stdout, @value ACTIVE_STEPPING);
    write(@fd stdout, @msg "\n");
  }
  VAR stepping SZ := ACTIVE_STEPPING;
  VAR code I32 := MAIN_FUNCTION_ARRAY[stepping]();
  thread_finish();
  exit(@code code);
}
