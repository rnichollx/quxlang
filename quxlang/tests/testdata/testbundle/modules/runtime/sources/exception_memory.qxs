LANGUAGE QUXLANG EN 0.0;

DOC <$ Allocates exception storage without recursively throwing on allocation failure. $>
::exception_allocate_storage
TEMPLATE(@T TYPE AUTO) FUNCTION() NOEXCEPT: MUT->TYPED_STORAGE(T)
{
  RUNTIME CONSTEXPR
  {
    RETURN CONSTEXPR_ALLOC#T();
  }
  ELSE
  {
    STATIC_IF(ARCH_IS_JVM)
    {
      RETURN JVM_ALLOCATE_OBJECT_STORAGE#T();
    }
    STATIC_ELSE
    {
      VAR address ADDRESS := allocator_allocate_static#(@size SIZEOF(T), @align ALIGNOF(T))();
      IF (address!?) { VAR empty MUT->TYPED_STORAGE(T); RETURN empty; }
      RETURN BEGIN_ALLOC_REGION address TO MUT->TYPED_STORAGE(T);
    }
  }
}

DOC <$ Releases storage obtained from exception_allocate_storage. $>
::exception_deallocate_storage
TEMPLATE(@T TYPE AUTO) FUNCTION(@storage MUT->TYPED_STORAGE(T)) NOEXCEPT
{
  DEFAULT_ALLOCATOR#(T)::DEALLOC(@PTR storage);
}
