LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

::BENCHMARK_JAVA_CLOCK INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/lang/System":"nanoTime"]
  CALLABLE CALLCONV JVM_STATIC(; RETURN I64);

DOC <$ The clock returns a target monotonic timestamp in nanoseconds. $>
::BENCHMARK_CLOCK INCLUDE_IF(OS_LINUX) FUNCTION(): U64
{
  VAR stamp syscall::timespec64;
  IF (syscall::linux::clock_gettime(@clock 1, @output stamp<-) != 0)
  { BENCHMARK_ERROR(@MESSAGE "Monotonic benchmark clock failed."); }
  RETURN ((stamp.seconds AS CHECKED U64) *? 1000000000) +? (stamp.nanoseconds AS CHECKED U64);
}

::BENCHMARK_CLOCK INCLUDE_IF(OS_MACOS) FUNCTION(): U64
{
  VAR stamp syscall::timespec64;
  IF (syscall::macos::clock_gettime(@clock 6, @output stamp<-) != 0)
  { BENCHMARK_ERROR(@MESSAGE "Monotonic benchmark clock failed."); }
  RETURN ((stamp.seconds AS CHECKED U64) *? 1000000000) +? (stamp.nanoseconds AS CHECKED U64);
}

::BENCHMARK_CLOCK INCLUDE_IF(OS_WINDOWS) FUNCTION(): U64
{
  VAR counter I64;
  VAR frequency I64;
  IF (syscall::windows::query_performance_counter(@output counter<-) == 0
    || syscall::windows::query_performance_frequency(@output frequency<-) == 0 || frequency <= 0)
  { BENCHMARK_ERROR(@MESSAGE "Monotonic benchmark clock failed."); }
  VAR ticks U64 := counter AS CHECKED U64;
  VAR rate U64 := frequency AS CHECKED U64;
  RETURN ((ticks / rate) *? 1000000000) +? (((ticks % rate) *? 1000000000) / rate);
}

::BENCHMARK_CLOCK INCLUDE_IF(ARCH_IS_JVM) FUNCTION(): U64
{
  VAR signed I64 := BENCHMARK_JAVA_CLOCK();
  RETURN signed AS PARTIAL U64;
}

::BENCHMARK_CLOCK
  INCLUDE_IF(OS_LINUX == FALSE && OS_MACOS == FALSE && OS_WINDOWS == FALSE && ARCH_IS_JVM == FALSE)
  FUNCTION(): U64
{
  COMPILATION_ERROR ON_LOWER "Benchmark timing is unavailable on this target";
}

DOC <$ Converts and validates one measurement operation count before timing starts. $>
::BENCHMARK_OPERATION_COUNT
  FUNCTION(@VALUE:value AUTO(count_type)): U64
{
  VAR result U64;
  STATIC_IF(SAME_TYPES(count_type, U64)) { result := value; }
  STATIC_ELSE { result := value AS CHECKED U64; }
  IF (result == 0) { BENCHMARK_ERROR(@MESSAGE "Benchmark COUNT must be positive."); }
  RETURN result;
}

DOC <$ Adds a completed measurement with checked duration and operation totals. $>
::BENCHMARK_ACCUMULATE
  FUNCTION(@ELAPSED:elapsed U64, @COUNT:count U64, @CHANNEL:channel SZ, @STATE:state MUT& BENCHMARK_STATE)
{
  state.durations[channel] := state.durations[channel] +? elapsed;
  state.counts[channel] := state.counts[channel] +? count;
}

DOC <$ Stops a measurement before updating its channel accumulators. $>
::BENCHMARK_RECORD
  FUNCTION(@START:start U64, @COUNT:count U64, @CHANNEL:channel SZ, @STATE:state MUT& BENCHMARK_STATE)
{
  VAR end U64 := BENCHMARK_CLOCK();
  BENCHMARK_ACCUMULATE(@ELAPSED end -? start, @COUNT count, @CHANNEL channel, @STATE state);
}
