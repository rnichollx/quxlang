LANGUAGE QUXLANG EN 0.0;

DOC <$
    Checks that metadata is excluded from payload slots for small, non-power-of-two,
    and page-aligned classes, including the final partial bitmap word.
    $>
PRIVATE(MODULE) ::allocation_region_layout_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
{
  VAR small layer3_region_class;
  small.initialize(@size 12, @align 4);
  TEST_ASSERT(small.payload_offset >= SIZEOF(layer3_region));
  TEST_ASSERT(small.payload_offset % 4 == 0);
  TEST_ASSERT(small.payload_offset + small.slot_count * 12 <= allocator_slab_region_size);
  TEST_ASSERT(small.payload_offset + (small.slot_count + 1) * 12 > allocator_slab_region_size);
  VAR large layer3_region_class;
  VAR alignment SZ := allocator_slab_maximum_block_size;
  IF (alignment > allocator_page_size) { alignment := allocator_page_size; }
  large.initialize(@size allocator_slab_maximum_block_size, @align alignment);
  TEST_ASSERT(large.payload_offset >= SIZEOF(layer3_region));
  TEST_ASSERT(large.payload_offset % alignment == 0);
  TEST_ASSERT(large.slot_count >= 7 && large.slot_count < 32);
}

DOC <$
    Exercises bitmap claims, plate ownership, retirement, and delayed access
    through a stable detached control after its backing has been reused.
    $>
PRIVATE(MODULE) ::allocation_region_lifecycle_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR root layer3_region_class;
  VAR alignment SZ := allocator_slab_maximum_block_size;
  IF (alignment > allocator_page_size) { alignment := allocator_page_size; }
  root.initialize(@size allocator_slab_maximum_block_size, @align alignment);
  VAR cache addr_cache#(@count 32);
  layer3_region_refill#(@count 32)(@root root, @cache cache);
  VAR address ADDRESS := PUN cache.entries[0] AS ADDRESS;
  VAR base ADDRESS := address - (address % allocator_slab_region_size);
  VAR region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING base TO MUT->layer3_region;
  VAR retained MUT->layer3_region_control := region->.control;
  retained->.shared();
  TEST_ASSERT(layer3_region_empty(@region region) == FALSE);
  retained->.release_shared();
  layer3_region_retire(@control retained);
  retained->.shared();
  TEST_ASSERT(retained->.region == region);
  retained->.release_shared();
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(cache.used) DO
  {
    VAR current ADDRESS := PUN cache.entries[index] AS ADDRESS;
    TEST_ASSERT(current % alignment == 0);
    LOOP VALUE(previous) FROM(0 AS SZ) UNTIL(index) DO
    { TEST_ASSERT(current != (PUN cache.entries[previous] AS ADDRESS)); }
  }
  LOOP WHILE (cache.used > 0) DO { layer3_region_return(@address cache.pop()); }
  retained->.shared();
  TEST_ASSERT((retained->.region??) == FALSE);
  retained->.release_shared();
  VAR other layer3_region_class;
  other.initialize(@size 12, @align 4);
  layer3_region_refill#(@count 32)(@root other, @cache cache);
  retained->.shared();
  TEST_ASSERT((retained->.region??) == FALSE);
  retained->.release_shared();
  LOOP WHILE (cache.used > 0) DO { layer3_region_return(@address cache.pop()); }
  TEST_ASSERT(root.available.next == root.available<-);
  TEST_ASSERT(root.issued.next == root.issued<-);
  TEST_ASSERT(other.available.next == other.available<-);
}

DOC <$
    Returns more regions than the shared pool can retain, exercising OS release
    and verifying that the retained stack stays within its configured limit.
    $>
PRIVATE(MODULE) ::allocation_region_backing_limit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR regions [layer4_region_backing_limit + 4]MUT->layer3_region;
  LOOP ITEM(region) IN(regions) DO { region := layer4_region_acquire(); }
  LOOP VALUE(region) IN(regions) DO { layer4_region_release(@region region); }
  layer4_region_backing.mtx.lock();
  TEST_ASSERT(layer4_region_backing.count == layer4_region_backing_limit);
  layer4_region_backing.mtx.unlock();
}

DOC <$ Backing remains valid until the final inventory or region reference is released. $>
PRIVATE(MODULE) ::allocation_region_extent_lifetime_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  LOOP VALUE(kind) FROM(0 AS SZ) UNTIL(2 AS SZ) DO
  {
    VAR requested_span SZ := allocator_slab_region_size;
    IF (kind == 1 && requested_span < 2097152) { requested_span := 2097152; }
    VAR extent MUT->layer4_backing_extent := layer4_extent_create(@span requested_span);
    TEST_ASSERT(extent??);
    TEST_ASSERT(extent->.unissued > 0);
    TEST_ASSERT(extent->.next % allocator_slab_region_size == 0);
    VAR span SZ := extent->.mapping_bytes / 2;
    TEST_ASSERT(extent->.next % span == 0);
    TEST_ASSERT(extent->.unissued * allocator_slab_region_size == span);
    TEST_ASSERT(extent->.references.LOAD#ATOMIC_ACQUIRE() == 1);
    VAR address ADDRESS := extent->.next;
    VAR storage MUT->TYPED_STORAGE(U64) := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO MUT->TYPED_STORAGE(U64);
    PLACE AT(storage->) U64 := 123;
    extent->.references.FETCH_ADD#ATOMIC_RELAXED(2);
    layer4_extent_release(@extent extent);
    TEST_ASSERT(extent->.references.LOAD#ATOMIC_ACQUIRE() == 2);
    TEST_ASSERT(IBC_LOAD#U64(@ADDR address) == 123);
    layer4_extent_release(@extent extent);
    TEST_ASSERT(extent->.references.LOAD#ATOMIC_ACQUIRE() == 1);
    TEST_ASSERT(IBC_LOAD#U64(@ADDR address) == 123);
    DESTROY AT(storage->) U64;
    layer4_extent_release(@extent extent);
  }
}

DOC <$ An unordered region group returns every bitmap slot except a held allocation. $>
PRIVATE(MODULE) ::allocation_region_unordered_return_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR root layer3_region_class;
  root.initialize(@size 12, @align 4);
  VAR cache addr_cache#(@count ((layer3_bitmap_word_bits * 2) + 7));
  TEST_ASSERT(layer3_region_refill#(@count ((layer3_bitmap_word_bits * 2) + 7))(@root root, @cache cache));
  VAR held ADDRESS := cache.pop();
  VAR base ADDRESS := held - (held % allocator_slab_region_size);
  VAR region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING base TO MUT->layer3_region;
  VAR control MUT->layer3_region_control := region->.control;
  VAR addresses [(layer3_bitmap_word_bits * 2) + 6]ADDRESS;
  LOOP ITEM(address) IN(addresses) DO { address := cache.pop(); }
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL((layer3_bitmap_word_bits * 2) + 6) DO
  { cache.push(addresses[(index * 11) % ((layer3_bitmap_word_bits * 2) + 6)]); }
  layer3_region_return_batch#(@count ((layer3_bitmap_word_bits * 2) + 7))(@cache cache);
  TEST_ASSERT(cache.used == 0);
  TEST_ASSERT(control->.region == region);
  TEST_ASSERT(layer3_region_empty(@region region) == FALSE);
  cache.push(held);
  layer3_region_return_batch#(@count ((layer3_bitmap_word_bits * 2) + 7))(@cache cache);
  TEST_ASSERT((control->.region??) == FALSE);
}

DOC <$
    Checks bitmap coverage and the reserved metadata budget for every generated
    class, including at least seven slots in the largest allocation class.
    $>
PRIVATE(MODULE) ::allocation_region_capacity_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STATIC_TEST
{
  TEST_ASSERT(allocator_allocation_region_bits >= 12);
  TEST_ASSERT(allocator_allocation_region_bits < SIZEOF(SZ) * 8 - 1);
  TEST_ASSERT(allocator_region_bitmap_word_count * layer3_bitmap_word_bits >= allocator_slab_region_size / 8);
  STATIC_VAR size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (size <= allocator_slab_maximum_block_size)
  {
    STATIC_VAR align SZ := size #&& ((size #!!) + 1);
    STATIC_IF(align > allocator_page_size)
    { STATIC_EVAL align := allocator_page_size; }
    VAR root layer3_region_class;
    root.initialize(@size SNAPSHOT(size), @align SNAPSHOT(align));
    TEST_ASSERT(root.payload_offset <= allocator_slab_region_size / 8);
    TEST_ASSERT(root.slot_count >= 7);
    TEST_ASSERT(root.slot_count * SNAPSHOT(size) >= (allocator_slab_region_size / 8) * 7);
    TEST_ASSERT((root.slot_count + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits <= allocator_region_bitmap_word_count);
    STATIC_EVAL size += step;
    STATIC_IF(size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
}

DOC <$
    Returns interleaved slots from two regions across bitmap-word boundaries,
    preserves held slots, and retires both regions after their final return.
    $>
PRIVATE(MODULE) ::layer3_region_batch_return_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR first_root layer3_region_class;
  VAR second_root layer3_region_class;
  first_root.initialize(@size 12, @align 4);
  second_root.initialize(@size 24, @align 8);
  VAR first addr_cache#(@count (layer3_bitmap_word_bits * 2 + 6));
  VAR second addr_cache#(@count (layer3_bitmap_word_bits * 2 + 6));
  layer3_region_refill#(@count (layer3_bitmap_word_bits * 2 + 6))(@root first_root, @cache first);
  layer3_region_refill#(@count (layer3_bitmap_word_bits * 2 + 6))(@root second_root, @cache second);
  VAR held_first ADDRESS := first.pop();
  VAR held_second ADDRESS := second.pop();
  VAR first_base ADDRESS := held_first - (held_first % allocator_slab_region_size);
  VAR second_base ADDRESS := held_second - (held_second % allocator_slab_region_size);
  VAR first_region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING first_base TO MUT->layer3_region;
  VAR second_region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING second_base TO MUT->layer3_region;
  VAR first_control MUT->layer3_region_control := first_region->.control;
  VAR second_control MUT->layer3_region_control := second_region->.control;
  VAR mixed addr_cache#(@count (layer3_bitmap_word_bits * 4 + 10));
  LOOP WHILE (first.used > 0) DO
  { mixed.push(first.pop()); mixed.push(second.pop()); }
  layer2_drain_cache#(@count (layer3_bitmap_word_bits * 4 + 10))(@cache mixed);
  TEST_ASSERT(mixed.used == 0);
  TEST_ASSERT(first_control->.region == first_region);
  TEST_ASSERT(second_control->.region == second_region);
  LOOP VALUE(word) FROM(0 AS SZ) UNTIL(3 AS SZ) DO
  {
    VAR expected layer3_bitmap_word := 0;
    IF (word == 2) { expected := (1 AS layer3_bitmap_word) #++ 5; }
    TEST_ASSERT(first_region->.bitmap[word].LOAD#ATOMIC_ACQUIRE() == expected);
    TEST_ASSERT(second_region->.bitmap[word].LOAD#ATOMIC_ACQUIRE() == expected);
  }
  mixed.push(held_first);
  mixed.push(held_second);
  layer2_drain_cache#(@count (layer3_bitmap_word_bits * 4 + 10))(@cache mixed);
  TEST_ASSERT((first_control->.region??) == FALSE);
  TEST_ASSERT((second_control->.region??) == FALSE);
}

DOC <$
    Refills a plate across multiple regions, preserves unique ownership, and
    retires full and partially issued regions after returning every address.
    $>
PRIVATE(MODULE) ::layer3_refill_across_full_regions_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR root layer3_region_class;
  root.initialize(@size allocator_slab_maximum_block_size, @align allocator_slab_maximum_block_size);
  VAR cache addr_cache#(@count 32);
  layer3_region_refill#(@count 32)(@root root, @cache cache);
  TEST_ASSERT(cache.used == 32);
  TEST_ASSERT(root.issued.next != root.issued<-);
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(cache.used) DO
  {
    VAR address ADDRESS := PUN cache.entries[index] AS ADDRESS;
    TEST_ASSERT(address % allocator_slab_maximum_block_size == 0);
    LOOP VALUE(previous) FROM(0 AS SZ) UNTIL(index) DO
    { TEST_ASSERT(address != (PUN cache.entries[previous] AS ADDRESS)); }
  }
  layer2_drain_cache#(@count 32)(@cache cache);
  TEST_ASSERT(cache.used == 0);
  TEST_ASSERT(root.available.next == root.available<-);
  TEST_ASSERT(root.issued.next == root.issued<-);
}

DOC <$ The promotion policy scales with physical memory, clamps native counts, and switches spans at the selected threshold. $>
PRIVATE(MODULE) ::allocation_region_promotion_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
{
  TEST_ASSERT(layer4_extent_promotion_count(@memory_bytes 1) == 1);
  TEST_ASSERT(layer4_extent_promotion_count(@memory_bytes allocator_slab_region_size AS U64) == 1);
  VAR fallback SZ := 16777216 / allocator_slab_region_size;
  IF (fallback == 0) { fallback := 1; }
  TEST_ASSERT(layer4_extent_promotion_count(@memory_bytes 0) == fallback);
  VAR memory U64 := 1073741824;
  VAR threshold SZ := layer4_extent_promotion_count(@memory_bytes memory);
  VAR large_span SZ := allocator_slab_region_size;
  IF (large_span < 2097152) { large_span := 2097152; }
  TEST_ASSERT(layer4_extent_span(@issued_count 0, @memory_bytes memory) == allocator_slab_region_size);
  TEST_ASSERT(layer4_extent_span(@issued_count threshold - 1, @memory_bytes memory) == allocator_slab_region_size);
  TEST_ASSERT(layer4_extent_span(@issued_count threshold, @memory_bytes memory) == large_span);
  STATIC_IF((allocator_slab_region_size AS U64) <= (((0 AS U64) #!!) / 512))
  { TEST_ASSERT(layer4_extent_promotion_count(@memory_bytes (allocator_slab_region_size AS U64) * 512) == 2); }
  STATIC_IF(CELLSIZEOF(SZ) < CELLSIZEOF(U64))
  { TEST_ASSERT(layer4_extent_promotion_count(@memory_bytes (0 AS U64) #!!) == (((0 AS SZ) #!!) / 2)); }
}

DOC <$ The pool counts each issued region once across acquisition, caching, and release. $>
PRIVATE(MODULE) ::allocation_region_pool_accounting_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  layer4_region_backing.mtx.lock();
  VAR initial SZ := layer4_region_backing.issued_count;
  layer4_region_backing.mtx.unlock();
  VAR first MUT->layer3_region := layer4_region_acquire();
  VAR second MUT->layer3_region := layer4_region_acquire();
  TEST_ASSERT(first?? && second??);
  layer4_region_backing.mtx.lock();
  VAR issued SZ := layer4_region_backing.issued_count;
  layer4_region_backing.mtx.unlock();
  TEST_ASSERT(issued == initial + 2);
  layer4_region_release(@region first);
  layer4_region_backing.mtx.lock();
  issued := layer4_region_backing.issued_count;
  layer4_region_backing.mtx.unlock();
  TEST_ASSERT(issued == initial + 1);
  layer4_region_release(@region second);
  layer4_region_backing.mtx.lock();
  issued := layer4_region_backing.issued_count;
  layer4_region_backing.mtx.unlock();
  TEST_ASSERT(issued == initial);
}
