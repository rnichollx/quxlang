LANGUAGE QUXLANG EN 0.0;

DOC <$ The test buffer constructs address storage in a mapping without affecting slab-cache counts. $>
PRIVATE(MODULE) ::allocator_test_addresses INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) STRUCT
{
  .entries VAR MUT=>>TYPED_STORAGE(ADDRESS);
  .count VAR SZ;
  .bytes VAR SZ;

  .initialize FUNCTION(@count SZ) MUT
  {
    .count := count;
    .bytes := allocator_checked_bytes(@size CELLSIZEOF(ADDRESS), @count count);
    VAR mapping ADDRESS := layer5_map_region(@bytes .bytes);
    TEST_ASSERT(mapping??);
    .entries := ADDRESS_LAUNDER_DISCOVER_EXISTING mapping TO MUT=>>TYPED_STORAGE(ADDRESS);
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO { PLACE AT(.entries[index]) ADDRESS := NULL; }
  }

  .at FUNCTION(@index SZ) MUT: MUT& ADDRESS
  { RETURN PUN .entries[index] AS ADDRESS; }

  .release FUNCTION() MUT
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(.count) DO { DESTROY AT(.entries[index]) ADDRESS; }
    layer5_unmap_region(@address IBC_GETADDR(@PTR .entries[0]<-), @bytes .bytes);
    .entries := NULL;
    .count := 0;
    .bytes := 0;
  }
}

PRIVATE(MODULE) ::addr_cache_tests NAMESPACE
{
  DOC <$
    Exercises address construction, destruction, and reconstruction through
    empty, partial, and half-cache transfers into a nonempty destination.
    Native execution also verifies transfer order using distinct addresses.
    $>
  ::slot_reuse_and_transfer INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
  {
    VAR source addr_cache#(@count 4);
    VAR destination addr_cache#(@count 4);
    VAR values [5]U64;
    VAR addresses [5]ADDRESS;
    RUNTIME NATIVE
    {
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(5) DO
      { addresses[index] := IBC_GETADDR(@PTR values[index]<-); }
    }
    LOOP VALUE(round) FROM(0 AS SZ) UNTIL(3) DO
    {
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(4) DO
      { source.push(addresses[index]); }
      destination.push(addresses[4]);
      source.move_entries_to(@destination destination, @entry_count 0);
      TEST_ASSERT(source.used == 4);
      TEST_ASSERT(destination.used == 1);
      VAR transferred SZ := round + 1;
      source.move_entries_to(@destination destination, @entry_count transferred);
      TEST_ASSERT(source.used == 4 - transferred);
      TEST_ASSERT(destination.used == 1 + transferred);
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(4 - transferred) DO
      { TEST_ASSERT(source.pop() == addresses[3 - transferred - index]); }
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(transferred) DO
      { TEST_ASSERT(destination.pop() == addresses[3 - index]); }
      TEST_ASSERT(destination.pop() == addresses[4]);
      TEST_ASSERT(source.used == 0);
      TEST_ASSERT(destination.used == 0);
    }
  }
}

PRIVATE(MODULE) ::default_allocator_dealloc_multiple_count_test_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR first ADDRESS := allocator_allocate_multiple(
    @size 1,
    @align 1,
    @count 8
  );
  allocator_deallocate_multiple(
    @size 1,
    @align 1,
    @ptr first,
    @count 8
  );

  VAR second ADDRESS := allocator_allocate_multiple(
    @size 4,
    @align 4,
    @count 2
  );
  TEST_ASSERT(second == first);
  allocator_deallocate_multiple(
    @size 4,
    @align 4,
    @ptr second,
    @count 2
  );
}

DOC <$
    Verifies that one slab specialization reuses a block through an address
    cache without accessing the freed allocation payload.
    $>
PRIVATE(MODULE) ::slab_allocator_thread_cache_reuse_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  allocator_release_all_thread_caches();

  VAR first ADDRESS := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
  slab_allocator#(@block_size 8, @block_align 8)::layer1_release_thread_cache();

  slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr first);
  TEST_ASSERT(
    slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count()
      == 1
  );

  VAR second ADDRESS := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
  TEST_ASSERT(second == first);
  slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr second);
  allocator_release_all_thread_caches();
}

DOC <$
    Verifies that shutdown clears both fast-path boundaries and releases a
    partial active cache and a full secondary cache. Allocations and frees
    during shutdown must leave the thread caches empty.
    $>
PRIVATE(MODULE) ::slab_allocator_shutdown_cursor_reset_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR previous_disabled BOOL := allocator_thread_caches_disabled;
  VAR blocks allocator_test_addresses;
  blocks.initialize(@count slab_allocator#(@block_size 8, @block_align 8)::address_cache_count * 2 + 1);
  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    block := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
  }
  slab_allocator#(@block_size 8, @block_align 8)::layer1_release_thread_cache();
  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr block);
  }
  TEST_ASSERT(
    slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count()
      == slab_allocator#(@block_size 8, @block_align 8)::address_cache_count + 1
  );

  allocator_thread_cache_shutdown_begin();
  TEST_ASSERT(allocator_thread_caches_disabled);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.entry!?);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.top!?);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.bottom!?);
  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    block := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
  }
  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr block);
  }
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.entry!?);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.top!?);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::layer1_cache_control.bottom!?);
  TEST_ASSERT(slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count() == 0);
  allocator_thread_cache_shutdown_finish();
  allocator_thread_caches_disabled := previous_disabled;
  blocks.release();
}

DOC <$
    Exercises empty, half-full, and full secondary-cache transitions and the
    whole-cache handoff that occurs when both thread caches are full. Repeated
    drains verify address uniqueness and live counts across cursor transitions.
    $>
PRIVATE(MODULE) ::slab_allocator_two_cache_transitions_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR blocks allocator_test_addresses;
  blocks.initialize(@count slab_allocator#(@block_size 8, @block_align 8)::address_cache_count * 2 + 1);
  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    block := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
  }
  slab_allocator#(@block_size 8, @block_align 8)::layer1_release_thread_cache();

  LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(blocks.count) DO
  {
    VAR block MUT& ADDRESS := blocks.at(@index buffer_index);
    slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr block);
  }

  TEST_ASSERT(
    slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count()
      == slab_allocator#(@block_size 8, @block_align 8)::address_cache_count + 1
  );
  VAR cache_capacity SZ := slab_allocator#(@block_size 8, @block_align 8)::address_cache_count;
  VAR reused allocator_test_addresses;
  reused.initialize(@count slab_allocator#(@block_size 8, @block_align 8)::address_cache_count + 1);
  LOOP VALUE(round) FROM(0 AS SZ) UNTIL(3) DO
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(cache_capacity + 1) DO
    {
      reused.at(@index index) := slab_allocator#(@block_size 8, @block_align 8)::layer0_allocate();
      TEST_ASSERT(
        slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count()
          == cache_capacity - index
      );
      LOOP VALUE(previous) FROM(0 AS SZ) UNTIL(index) DO
      {
        TEST_ASSERT(reused.at(@index previous) != reused.at(@index index));
      };
    };
    LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(reused.count) DO
    {
      VAR block MUT& ADDRESS := reused.at(@index buffer_index);
      slab_allocator#(@block_size 8, @block_align 8)::layer0_deallocate(@ptr block);
    }
  };
  allocator_release_all_thread_caches();
  TEST_ASSERT(
    slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count() == 0
  );
  slab_allocator#(@block_size 8, @block_align 8)::layer1_release_thread_cache();
  reused.release();
  blocks.release();
}

DOC <$
    Exercises the configured cache transitions used by the 12-byte slab class.
    Addresses occupy aligned typed storage in the cache object rather than
    the four-byte-aligned allocation payloads.
    $>
PRIVATE(MODULE) ::slab_allocator_twelve_byte_cache_transitions_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR capacity SZ := slab_allocator#(@block_size 12, @block_align 4)::address_cache_count;
  VAR blocks allocator_test_addresses;
  blocks.initialize(@count slab_allocator#(@block_size 12, @block_align 4)::address_cache_count * 2 + 1);
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(capacity * 2 + 1) DO
  {
    blocks.at(@index index) := slab_allocator#(@block_size 12, @block_align 4)::layer0_allocate();
  };
  slab_allocator#(@block_size 12, @block_align 4)::layer1_release_thread_cache();
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(capacity * 2 + 1) DO
  {
    slab_allocator#(@block_size 12, @block_align 4)::layer0_deallocate(
      @ptr blocks.at(@index index)
    );
  };
  TEST_ASSERT(
    slab_allocator#(@block_size 12, @block_align 4)::thread_cached_block_count()
      == capacity + 1
  );
  VAR reused allocator_test_addresses;
  reused.initialize(@count slab_allocator#(@block_size 12, @block_align 4)::address_cache_count + 1);
  LOOP VALUE(round) FROM(0 AS SZ) UNTIL(3) DO
  {
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(capacity + 1) DO
    {
      reused.at(@index index) := slab_allocator#(@block_size 12, @block_align 4)::layer0_allocate();
      TEST_ASSERT(
        slab_allocator#(@block_size 12, @block_align 4)::thread_cached_block_count()
          == capacity - index
      );
      LOOP VALUE(previous) FROM(0 AS SZ) UNTIL(index) DO
      {
        TEST_ASSERT(reused.at(@index previous) != reused.at(@index index));
      };
    };
    LOOP VALUE(buffer_index) FROM(0 AS SZ) UNTIL(reused.count) DO
    {
      VAR block MUT& ADDRESS := reused.at(@index buffer_index);
      slab_allocator#(@block_size 12, @block_align 4)::layer0_deallocate(@ptr block);
    }
  };
  allocator_release_all_thread_caches();
  TEST_ASSERT(
    slab_allocator#(@block_size 12, @block_align 4)::thread_cached_block_count() == 0
  );
  slab_allocator#(@block_size 12, @block_align 4)::layer1_release_thread_cache();
  reused.release();
  blocks.release();
}

DOC <$
    Verifies that simultaneous zero-count allocations have unique addresses and
    that their alignment-compatible slab storage is reclaimed.
    $>
PRIVATE(MODULE) ::zero_count_allocations_are_unique_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR first ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  VAR second ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  TEST_ASSERT(first??);
  TEST_ASSERT(second??);
  TEST_ASSERT(first != second);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr first, @count 0);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr second, @count 0);
  VAR reused ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  TEST_ASSERT(reused == second);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr reused, @count 0);
  allocator_release_all_thread_caches();
}

DOC <$
    Verifies that a multi allocation shares the final slab specialization with
    static allocation and that the next byte routes to the large allocator.
    $>
PRIVATE(MODULE) ::multi_allocator_slab_and_large_boundary_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  STATIC_VAR block_align SZ := allocator_slab_maximum_block_size;
  STATIC_IF(block_align > allocator_page_size)
  { STATIC_EVAL block_align := allocator_page_size; }
  allocator_release_all_thread_caches();
  VAR multi_address ADDRESS := allocator_allocate_multiple(
    @size 1,
    @align 1,
    @count allocator_slab_maximum_block_size
  );
  slab_allocator#(@block_size allocator_slab_maximum_block_size, @block_align SNAPSHOT(block_align))::layer1_release_thread_cache();
  allocator_deallocate_multiple(
    @size 1,
    @align 1,
    @ptr multi_address,
    @count allocator_slab_maximum_block_size
  );

  VAR static_address ADDRESS := allocator_allocate_static#(
    @size allocator_slab_maximum_block_size,
    @align SNAPSHOT(block_align)
  )();
  TEST_ASSERT(static_address == multi_address);
  allocator_deallocate_static#(
    @size allocator_slab_maximum_block_size,
    @align SNAPSHOT(block_align)
  )(@ptr static_address);

  VAR cached_blocks_before_large SZ :=
    slab_allocator#(@block_size allocator_slab_maximum_block_size, @block_align SNAPSHOT(block_align))::thread_cached_block_count();
  VAR large_address ADDRESS := allocator_allocate_static#(
    @size allocator_slab_maximum_block_size + 1,
    @align SNAPSHOT(block_align)
  )();
  TEST_ASSERT(large_address??);
  allocator_deallocate_static#(
    @size allocator_slab_maximum_block_size + 1,
    @align SNAPSHOT(block_align)
  )(@ptr large_address);
  TEST_ASSERT(
    slab_allocator#(@block_size allocator_slab_maximum_block_size, @block_align SNAPSHOT(block_align))::thread_cached_block_count()
      == cached_blocks_before_large
  );
  allocator_release_all_thread_caches();
}

DOC <$
    Checks matching static and dynamic routing across class boundaries and the
    direct-mapping boundary, including layouts requiring page alignment.
    $>
PRIVATE(MODULE) ::allocator_generated_layout_routing_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  STATIC_VAR size SZ := 8;
  STATIC_VAR step SZ := 4;
  STATIC_WHILE (size <= 32768)
  {
    VAR dynamic ADDRESS := allocator_allocate_dynamic(@bytes SNAPSHOT(size), @align 4);
    TEST_ASSERT(dynamic?? && dynamic % 4 == 0);
    allocator_deallocate_static#(@size SNAPSHOT(size), @align 4)(@ptr dynamic);
    VAR fixed ADDRESS := allocator_allocate_static#(@size SNAPSHOT(size) + 1, @align 4096)();
    TEST_ASSERT(fixed?? && fixed % 4096 == 0);
    allocator_deallocate_dynamic(@bytes SNAPSHOT(size) + 1, @align 4096, @ptr fixed);
    STATIC_EVAL size += step;
    STATIC_IF(size / step == 4)
    { STATIC_EVAL step *= 2; }
  }
  allocator_release_all_thread_caches();
}

DOC <$
  The test verifies address ordering and preservation for empty, singleton, odd,
  and even plates with repeated values and mixed initial order.
  $>
PRIVATE(MODULE) ::layer2_address_sort_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR null_address ADDRESS := NULL;
  VAR cache addr_cache#(@count 65);
  VAR counts [17]SZ;
  LOOP VALUE(length) FROM(0 AS SZ) UNTIL(66 AS SZ) DO
  {
    LOOP ITEM(value) IN(counts) DO { value := 0; }
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(length) DO
    {
      VAR offset SZ := (index * 11 + length) % 17;
      cache.push(null_address + offset);
      counts[offset]++;
    }
    cache.sort();
    VAR previous SZ := 17;
    LOOP WHILE (cache.used > 0) DO
    {
      VAR offset SZ := (cache.pop() - NULL) AS SZ;
      TEST_ASSERT(offset <= previous);
      TEST_ASSERT(counts[offset] > 0);
      counts[offset]--;
      previous := offset;
    }
    LOOP VALUE(value) IN(counts) DO { TEST_ASSERT(value == 0); }
  }
}

DOC <$
    Combines two half plates without a region refill and returns the exact
    issued address set through the full-plate store.
    $>
PRIVATE(MODULE) ::layer2_partial_aggregation_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  // This class is outside the generated size classes, isolating its shared stores.
  VAR first MUT->addr_cache_node#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count) :=
    slab_allocator#(@block_size 40, @block_align 8)::layer2_acquire_full_cache();
  VAR second MUT->addr_cache_node#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count) :=
    layer2_acquire_empty_cache_node#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count)();
  VAR expected [slab_allocator#(@block_size 40, @block_align 8)::address_cache_count]ADDRESS;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(first->.cache.used) DO
  { expected[index] := PUN first->.cache.entries[index] AS ADDRESS; }
  first->.cache.move_entries_to(@destination second->.cache,
    @entry_count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count / 2);
  slab_allocator#(@block_size 40, @block_align 8)::layer2_release_cache(@node first);
  slab_allocator#(@block_size 40, @block_align 8)::layer2_release_cache(@node second);
  VAR combined MUT->addr_cache_node#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count) :=
    slab_allocator#(@block_size 40, @block_align 8)::layer2_acquire_full_cache();
  TEST_ASSERT(combined->.cache.used == slab_allocator#(@block_size 40, @block_align 8)::address_cache_count);
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(combined->.cache.used) DO
  {
    VAR address ADDRESS := PUN combined->.cache.entries[index] AS ADDRESS;
    VAR found BOOL := FALSE;
    LOOP ITEM(original) IN(expected) DO
    {
      IF (original == address) { found := TRUE; original := NULL; BREAK; }
    }
    TEST_ASSERT(found);
  }
  layer2_drain_cache#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count)(@cache combined->.cache);
  layer2_release_empty_cache_node#(@count slab_allocator#(@block_size 40, @block_align 8)::address_cache_count)(@node combined);
}

DOC <$ Raw allocation reports unrepresentable requests with null, while public allocation throws the permanent allocation-failure exception. $>
::allocator_failure_contract INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE)
  UNIT_TEST
{
  VAR maximum SZ := (0 AS SZ) #!!;
  TEST_ASSERT(allocator_allocate_dynamic(@bytes maximum, @align 1) == NULL);
  TEST_ASSERT(allocator_allocate_multiple(@size 8, @align 8, @count maximum) == NULL);
  VAR caught BOOL := FALSE;
  TRY
  {
    VAR storage ->VIRTUAL_STORAGE := DEFAULT_ALLOCATOR#(VOID)::VIRTUAL_ALLOC(@SIZE maximum, @ALIGN 1);
    DEFAULT_ALLOCATOR#(VOID)::VIRTUAL_DEALLOC(@PTR storage, @SIZE maximum, @ALIGN 1);
  }
  CATCH UNWIND_OUT_OF_MEMORY
  {
    caught := TRUE;
    TEST_ASSERT(CURRENT_EXCEPTION().IS_OUT_OF_MEMORY());
  }
  TEST_ASSERT(caught);
  VAR storage MUT->TYPED_STORAGE(I32) := exception_allocate_storage#I32();
  TEST_ASSERT(storage??);
  VAR value MUT->I32 := PLACE AT(storage->) I32 := 17;
  TEST_ASSERT(value-> == 17);
  DESTROY AT(storage->) I32;
  exception_deallocate_storage#I32(@storage storage);
}
