  DOC <$ The receive_from procedure invokes the Linux receive operation through the Z_ARCH system-call ABI. $>
  ::receive_from ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@socket I32, @buffer MUT=>>BYTE, @count SZ, @flags I32, @address MUT->socket_address_storage, @length MUT->U32; RETURN signed_byte_count)
  {
    AGHI %r15, -168
    STG %r7, 160(%r15)
    LG %r7, 328(%r15)
    LGHI %r1, 371
    SVC 0
    LG %r7, 160(%r15)
    AGHI %r15, 168
    BR %r14
  }

