  DOC <$ The receive_from procedure invokes the Linux receive operation through the X64 system-call ABI. $>
  ::receive_from ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@socket I32, @buffer MUT=>>BYTE, @count SZ, @flags I32, @address MUT->socket_address_storage, @length MUT->U32; RETURN signed_byte_count)
  {
    MOV R10, RCX
    MOV RAX, 45
    SYSCALL
    RET
  }

  DOC <$ The receive_from procedure invokes the Linux receive operation through the X86 system-call ABI. $>
  ::receive_from ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@socket I32, @buffer MUT=>>BYTE, @count SZ, @flags I32, @address MUT->socket_address_storage, @length MUT->U32; RETURN signed_byte_count)
  {
    PUSH EBX
    PUSH ESI
    PUSH EDI
    PUSH EBP
    MOV EBX, [ESP+20]
    MOV ECX, [ESP+24]
    MOV EDX, [ESP+28]
    MOV ESI, [ESP+32]
    MOV EDI, [ESP+36]
    MOV EBP, [ESP+40]
    MOV EAX, 371
    INT 0x80
    POP EBP
    POP EDI
    POP ESI
    POP EBX
    RET
  }

  DOC <$ The receive_from procedure invokes the Linux receive operation through the ARM64 system-call ABI. $>
  ::receive_from ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@socket I32, @buffer MUT=>>BYTE, @count SZ, @flags I32, @address MUT->socket_address_storage, @length MUT->U32; RETURN signed_byte_count)
