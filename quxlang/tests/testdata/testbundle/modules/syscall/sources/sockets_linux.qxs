  {
    PUSH EBX
    PUSH ESI
    MOV EBX, [ESP+12]
    MOV ECX, [ESP+16]
    MOV EDX, [ESP+20]
    MOV ESI, [ESP+24]
    MOV EAX, 364
    INT 0x80
    POP ESI
    POP EBX
    RET
  }

