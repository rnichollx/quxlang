LANGUAGE QUXLANG EN 0.0;

::linux INCLUDE_IF(OS_LINUX) NAMESPACE
{
  DOC <$ The socket procedure invokes the Linux socket operation through the X64 system-call ABI. $>
  ::socket ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@family I32, @kind I32, @protocol I32; RETURN I32)
  {
    MOV RAX, 41
    SYSCALL
    RET
  }

  DOC <$ The socket procedure invokes the Linux socket operation through the X86 system-call ABI. $>
  ::socket ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@family I32, @kind I32, @protocol I32; RETURN I32)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV ECX, [ESP+12]
    MOV EDX, [ESP+16]
    MOV EAX, 359
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ The socket procedure invokes the Linux socket operation through the ARM64 system-call ABI. $>
  ::socket ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@family I32, @kind I32, @protocol I32; RETURN I32)
  {
    MOV X8, 198
    SVC 0
    RET
  }

  DOC <$ The socket procedure invokes the Linux socket operation through the Z_ARCH system-call ABI. $>
  ::socket ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@family I32, @kind I32, @protocol I32; RETURN I32)
  {
    LGHI %r1, 359
    SVC 0
    BR %r14
  }

