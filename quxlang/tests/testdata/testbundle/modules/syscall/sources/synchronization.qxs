LANGUAGE QUXLANG EN 0.0;


::windows INCLUDE_IF(OS_WINDOWS) NAMESPACE
{
  DOC <$
    Storage matching CRITICAL_SECTION on 64-bit x86 Windows.
    $>
  ::native_mutex_storage INCLUDE_IF(ARCH_IS_X64)
    ALIAS ALIGNED_STORAGE(40, 8);

  ::wait_on_address
    EXTERN_PROCEDURE["api-ms-win-core-synch-l1-2-0":"WaitOnAddress"]
    CALLABLE CALLCONV CCALL(
      @address ADDRESS,
      @compare_address CONST->I32,
      @address_size SZ,
      @milliseconds U32;
      RETURN BOOL
    );

  ::wake_by_address_single
    EXTERN_PROCEDURE["api-ms-win-core-synch-l1-2-0":"WakeByAddressSingle"]
    CALLABLE CALLCONV CCALL(@address ADDRESS);

  ::wake_by_address_all
    EXTERN_PROCEDURE["api-ms-win-core-synch-l1-2-0":"WakeByAddressAll"]
    CALLABLE CALLCONV CCALL(@address ADDRESS);

  ::initialize_critical_section INCLUDE_IF(ARCH_IS_X64)
    EXTERN_PROCEDURE["kernel32":"InitializeCriticalSection"]
    CALLABLE CALLCONV CCALL(
      @native_mutex MUT->native_mutex_storage
    );

  ::delete_critical_section INCLUDE_IF(ARCH_IS_X64)
    EXTERN_PROCEDURE["kernel32":"DeleteCriticalSection"]
    CALLABLE CALLCONV CCALL(
      @native_mutex MUT->native_mutex_storage
    );

  ::enter_critical_section INCLUDE_IF(ARCH_IS_X64)
    EXTERN_PROCEDURE["kernel32":"EnterCriticalSection"]
    CALLABLE CALLCONV CCALL(
      @native_mutex MUT->native_mutex_storage
    );

  ::try_enter_critical_section INCLUDE_IF(ARCH_IS_X64)
    EXTERN_PROCEDURE["kernel32":"TryEnterCriticalSection"]
    CALLABLE CALLCONV CCALL(
      @native_mutex MUT->native_mutex_storage;
      RETURN BOOL
    );

  ::leave_critical_section INCLUDE_IF(ARCH_IS_X64)
    EXTERN_PROCEDURE["kernel32":"LeaveCriticalSection"]
    CALLABLE CALLCONV CCALL(
      @native_mutex MUT->native_mutex_storage
    );
}


::os_unfair_lock_lock INCLUDE_IF(OS_MACOS)
  EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_unfair_lock_lock"]
  CALLABLE CALLCONV CCALL(@native_mutex MUT->ATOMIC#I32);

::os_unfair_lock_trylock INCLUDE_IF(OS_MACOS)
  EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_unfair_lock_trylock"]
  CALLABLE CALLCONV CCALL(@native_mutex MUT->ATOMIC#I32; RETURN BOOL);

::os_unfair_lock_unlock INCLUDE_IF(OS_MACOS)
  EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_unfair_lock_unlock"]
  CALLABLE CALLCONV CCALL(@native_mutex MUT->ATOMIC#I32);


::macos INCLUDE_IF(OS_MACOS) NAMESPACE
{
  DOC <$ Atomically compares and waits on an address using macOS 14.4 or later. $>
  ::wait_on_address
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_sync_wait_on_address"]
    CALLABLE CALLCONV CCALL(@address ADDRESS, @value U64, @size SZ, @flags U32; RETURN I32);

  DOC <$ Wakes one address waiter using macOS 14.4 or later. $>
  ::wake_by_address_any
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_sync_wake_by_address_any"]
    CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @flags U32; RETURN I32);

  DOC <$ Wakes all address waiters using macOS 14.4 or later. $>
  ::wake_by_address_all
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"os_sync_wake_by_address_all"]
    CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @flags U32; RETURN I32);

  DOC <$ Returns the calling thread's errno storage. $>
  ::error_number
    EXTERN_PROCEDURE["/usr/lib/libSystem.B.dylib":"__error"]
    CALLABLE CALLCONV CCALL(; RETURN MUT->I32);
}

::linux INCLUDE_IF(OS_LINUX) NAMESPACE
{
  DOC <$ Yields execution to another runnable thread. $>
  ::sched_yield
    ASM_PROCEDURE X64 CALLABLE CALLCONV CCALL(; RETURN I32)
  {
    MOV RAX, 24
    SYSCALL
    RET
  }
  DOC <$ Yields execution to another runnable thread. $>
  ::sched_yield
    ASM_PROCEDURE X86 CALLABLE CALLCONV CCALL(; RETURN I32)
  {
    MOV EAX, 158
    INT 0x80
    RET
  }
  DOC <$ Yields execution to another runnable thread. $>
  ::sched_yield
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(; RETURN I32)
  {
    MOV X8, 124
    SVC 0
    RET
  }
  DOC <$ Yields execution to another runnable thread. $>
  ::sched_yield
    ASM_PROCEDURE Z_ARCH CALLABLE CALLCONV CCALL(; RETURN I32)
  {
    LGHI %r1, 158
    SVC 0
    BR %r14
  }
}

::windows INCLUDE_IF(OS_WINDOWS) NAMESPACE
{
  DOC <$ Yields execution to another runnable thread. $>
  ::switch_to_thread
    EXTERN_PROCEDURE["kernel32":"SwitchToThread"]
    CALLABLE CALLCONV CCALL(; RETURN BOOL);
}
