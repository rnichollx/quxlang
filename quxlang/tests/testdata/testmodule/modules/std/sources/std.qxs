LANGUAGE QUXLANG EN 0.0;

// Read-only access to process command-line arguments. Index zero identifies the
// launcher, and user-supplied arguments begin at index one on every target.
::args NAMESPACE
{
  ::count FUNCTION(): SZ
  {
    STATIC_IF(OS_LINUX)
    {
      RETURN RUNTIME_MODULE::linux_argument_count;
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      RETURN RUNTIME_MODULE::macos_argument_count;
    }
    STATIC_ELSE STATIC_IF(ARCH_IS_JVM)
    {
      RETURN RUNTIME_MODULE::jvm_command_argument_count() AS CHECKED SZ;
    }
    STATIC_ELSE
    {
      COMPILATION_ERROR ON_LOWER "std::args is not supported on this platform.";
    }
  }

  ::address_at FUNCTION(@index SZ): ADDRESS
  {
    STATIC_IF(OS_LINUX)
    {
      ASSERT(index < RUNTIME_MODULE::linux_argument_count);
      RETURN RUNTIME_MODULE::linux_arguments[index];
    }
    STATIC_ELSE STATIC_IF(OS_MACOS)
    {
      ASSERT(index < RUNTIME_MODULE::macos_argument_count);
      RETURN RUNTIME_MODULE::macos_arguments[index];
    }
    STATIC_ELSE
    {
      COMPILATION_ERROR ON_LOWER "std::args is not supported on this platform.";
    }
  }

  ::at FUNCTION(@index SZ): string
  {
    ASSERT(index < count());
    STATIC_IF(ARCH_IS_JVM)
    {
      VAR java_value ~> RUNTIME_MODULE::java_string :=
        RUNTIME_MODULE::jvm_command_argument_at(@index (index AS CHECKED I32));
      RETURN string_from_java_string(@value java_value);
    }
    STATIC_ELSE
    {
      VAR address ADDRESS := address_at(@index index);
      VAR bytes CONST=>>BYTE := ADDRESS_LAUNDER address TO CONST=>>BYTE;
      VAR result string;
      VAR byte_index SZ := 0;
      WHILE (bytes[byte_index] != 0)
      {
        result.push_back(@value bytes[byte_index]);
        byte_index++;
      }
      RETURN result;
    }
  }
}

// Read-only access to process environment entry addresses.
::env NAMESPACE
{
  ::count FUNCTION(): SZ
  {
    STATIC_IF(OS_LINUX)
    {
      RETURN RUNTIME_MODULE::linux_environment_count;
    }
    STATIC_ELSE
    {
      COMPILATION_ERROR ON_LOWER "std::env is not supported on this platform.";
    }
  }

  ::at FUNCTION(@index SZ): ADDRESS
  {
    STATIC_IF(OS_LINUX)
    {
      ASSERT(index < RUNTIME_MODULE::linux_environment_count);
      RETURN RUNTIME_MODULE::linux_environment[index];
    }
    STATIC_ELSE
    {
      COMPILATION_ERROR ON_LOWER "std::env is not supported on this platform.";
    }
  }
}
