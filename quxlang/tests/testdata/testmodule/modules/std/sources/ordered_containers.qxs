::set_const_iterator DOC <$ Traverses a constant set in ascending order. $>
  TEMPLATE(TYPE AUTO(k)) STRUCT
{
  PRIVATE(MODULE)
  {
    .node VAR MUT->ordered_tree_node#(ordered_set_entry#(k));

    .CONSTRUCTOR DOC <$ Creates an iterator positioned at node. $>
      FUNCTION(@node MUT->ordered_tree_node#(ordered_set_entry#(k)))
    {
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an unpositioned constant set iterator. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Converts a mutable set iterator to a constant iterator. $>
    FUNCTION(@OTHER CONST& set_iterator#(k))
  {
    .node := OTHER.node;
  }

  .OPERATOR== DOC <$ Compares iterator positions. $>
    FUNCTION(@OTHER CONST& set_const_iterator#(k)) CONST: BOOL
  {
    RETURN .node == OTHER.node;
  }

  .OPERATOR++ DOC <$ Advances to the next key and returns the previous position. $>
    FUNCTION() MUT: set_const_iterator#(k)
  {
    ASSERT(.node??, "A set end iterator cannot be incremented.");
    VAR previous set_const_iterator#(k) := THIS;
    .node := ordered_tree_successor#(ordered_set_entry#(k))(@node .node);
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns the current immutable key. $>
    FUNCTION() CONST: CONST& k
  {
    ASSERT(.node??, "A set end iterator cannot be dereferenced.");
    RETURN (.node->).entry.key;
  }
}


::set_range DOC <$ Provides a mutable set's immutable keys in ascending order. $>
  TEMPLATE(TYPE AUTO(k)) STRUCT
{
  PRIVATE(MODULE)
  {
    .first VAR MUT->ordered_tree_node#(ordered_set_entry#(k));

    .CONSTRUCTOR DOC <$ Creates a set range beginning at first. $>
      FUNCTION(@first MUT->ordered_tree_node#(ordered_set_entry#(k)))
    {
      .first := first;
    }
  }

  .BEGIN DOC <$ Returns the first set iterator. $>
    FUNCTION() CONST: set_iterator#(k)
  {
    RETURN set_iterator#(k)(@node .first);
  }

  .END DOC <$ Returns the past-the-end set iterator. $>
    FUNCTION() CONST: set_iterator#(k)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_set_entry#(k));
    RETURN set_iterator#(k)(@node end_node);
  }
}


::set_const_range DOC <$ Provides a constant set's keys in ascending order. $>
  TEMPLATE(TYPE AUTO(k)) STRUCT
{
  PRIVATE(MODULE)
  {
    .first VAR MUT->ordered_tree_node#(ordered_set_entry#(k));

    .CONSTRUCTOR DOC <$ Creates a constant set range beginning at first. $>
      FUNCTION(@first MUT->ordered_tree_node#(ordered_set_entry#(k)))
    {
      .first := first;
    }
  }

  .BEGIN DOC <$ Returns the first constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(k)
  {
    RETURN set_const_iterator#(k)(@node .first);
  }

  .END DOC <$ Returns the past-the-end constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(k)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_set_entry#(k));
    RETURN set_const_iterator#(k)(@node end_node);
  }
}


::set DOC <$
  Owns unique keys in ascending order. Lookup, insertion, and removal have
  worst-case logarithmic complexity.
  $>
  TEMPLATE(TYPE AUTO(k)) STRUCT
{
  PRIVATE(CLASS)
  {
    .tree VAR ordered_tree#(ordered_set_entry#(k));
  }

  .CONSTRUCTOR DOC <$ Constructs an empty set. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copy-constructs all keys from OTHER. $>
    FUNCTION(@OTHER CONST& set#(k))
  {
    ordered_tree_copy#(ordered_set_entry#(k))(
      @destination .tree,
      @source OTHER.tree
    );
  }

  .CONSTRUCTOR DOC <$ Transfers all keys from OTHER. $>
    FUNCTION(@OTHER TEMP& set#(k))
  {
    VAR source MUT& ordered_tree#(ordered_set_entry#(k)) :=
      OTHER.tree AS MUT& ordered_tree#(ordered_set_entry#(k));
    ordered_tree_take#(ordered_set_entry#(k))(
      @destination .tree,
      @source source
    );
  }

  .DESTRUCTOR DOC <$ Destroys every key and releases every node allocation. $>
    FUNCTION()
  {
    ordered_tree_clear#(ordered_set_entry#(k))(@tree .tree);
  }

  .size DOC <$ Returns the number of keys. $>
    FUNCTION() CONST: SZ
  {
    RETURN .tree.count;
  }

  .empty DOC <$ Reports whether the set contains no keys. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .tree.count == 0;
  }

  .clear DOC <$ Removes and destroys every set key. $>
    FUNCTION() MUT
  {
    ordered_tree_clear#(ordered_set_entry#(k))(@tree .tree);
  }

  .contains DOC <$ Reports whether key is present. $>
    FUNCTION(@key CONST& k) CONST: BOOL
  {
    RETURN ordered_tree_find_node#(ordered_set_entry#(k), k)(
      @tree .tree,
      @key key
    )??;
  }

  .find DOC <$ Returns an iterator for key or END when absent. $>
    FUNCTION(@key CONST& k) MUT: set_iterator#(k)
  {
    VAR node MUT->ordered_tree_node#(ordered_set_entry#(k)) :=
      ordered_tree_find_node#(ordered_set_entry#(k), k)(@tree .tree, @key key);
    RETURN set_iterator#(k)(@node node);
  }

  .find DOC <$ Returns a constant iterator for key or END when absent. $>
    FUNCTION(@key CONST& k) CONST: set_const_iterator#(k)
  {
    VAR node MUT->ordered_tree_node#(ordered_set_entry#(k)) :=
      ordered_tree_find_node#(ordered_set_entry#(k), k)(@tree .tree, @key key);
    RETURN set_const_iterator#(k)(@node node);
  }

  .insert DOC <$ Inserts a key, consuming a temporary only when insertion succeeds. $>
    FUNCTION(@key AUTO& k) MUT: BOOL
  {
    RETURN ordered_set_insert_key#(k)(@tree .tree, @key FORWARD(key));
  }

  .erase DOC <$ Removes key when present and reports whether a key was erased. $>
    FUNCTION(@key CONST& k) MUT: BOOL
  {
    VAR node MUT->ordered_tree_node#(ordered_set_entry#(k)) :=
      ordered_tree_find_node#(ordered_set_entry#(k), k)(@tree .tree, @key key);
    IF ((node??) == FALSE)
    {
      RETURN FALSE;
    }
    ordered_tree_erase_node#(ordered_set_entry#(k))(@tree .tree, @node node);
    RETURN TRUE;
  }

  .BEGIN DOC <$ Returns an iterator to the first set key. $>
    FUNCTION() MUT: set_iterator#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_iterator#(k)(@node first);
  }

  .BEGIN DOC <$ Returns an iterator to the first constant set key. $>
    FUNCTION() CONST: set_const_iterator#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_const_iterator#(k)(@node first);
  }

  .END DOC <$ Returns the past-the-end set iterator. $>
    FUNCTION() MUT: set_iterator#(k)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_set_entry#(k));
    RETURN set_iterator#(k)(@node end_node);
  }

  .END DOC <$ Returns the past-the-end constant set iterator. $>
    FUNCTION() CONST: set_const_iterator#(k)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_set_entry#(k));
    RETURN set_const_iterator#(k)(@node end_node);
  }

  .items DOC <$ Returns this mutable set's immutable keys in ascending order. $>
    FUNCTION() MUT: set_range#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_range#(k)(@first first);
  }

  .items DOC <$ Returns this constant set's keys in ascending order. $>
    FUNCTION() CONST: set_const_range#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_const_range#(k)(@first first);
  }

  .VALUES DOC <$ Returns this mutable set's immutable keys in ascending order. $>
    FUNCTION() MUT: set_range#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_range#(k)(@first first);
  }

  .VALUES DOC <$ Returns this constant set's keys in ascending order. $>
    FUNCTION() CONST: set_const_range#(k)
  {
    VAR first MUT->ordered_tree_node#(ordered_set_entry#(k)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_set_entry#(k))(@node first);
    }
    RETURN set_const_range#(k)(@first first);
  }
}
