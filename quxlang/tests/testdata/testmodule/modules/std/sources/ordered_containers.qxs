::map DOC <$
  Owns unique keys and associated values in ascending key order. Lookup,
  insertion, and removal have worst-case logarithmic complexity.
  $>
  TEMPLATE(@INDEX TYPE AUTO(k), @VALUE TYPE AUTO(v)) STRUCT
{
  PRIVATE(CLASS)
  {
    .tree VAR ordered_tree#(ordered_map_entry#(k, v));
  }

  .CONSTRUCTOR DOC <$ Constructs an empty map. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copy-constructs all entries from OTHER. $>
    FUNCTION(@OTHER CONST& map#[k:v])
  {
    ordered_tree_copy#(ordered_map_entry#(k, v))(
      @destination .tree,
      @source OTHER.tree
    );
  }

  .CONSTRUCTOR DOC <$ Transfers all entries from OTHER. $>
    FUNCTION(@OTHER TEMP& map#[k:v])
  {
    VAR source MUT& ordered_tree#(ordered_map_entry#(k, v)) :=
      OTHER.tree AS MUT& ordered_tree#(ordered_map_entry#(k, v));
    ordered_tree_take#(ordered_map_entry#(k, v))(
      @destination .tree,
      @source source
    );
  }

  .DESTRUCTOR DOC <$ Destroys every entry and releases every node allocation. $>
    FUNCTION()
  {
    ordered_tree_clear#(ordered_map_entry#(k, v))(@tree .tree);
  }

  .size DOC <$ Returns the number of entries. $>
    FUNCTION() CONST: SZ
  {
    RETURN .tree.count;
  }

  .empty DOC <$ Reports whether the map contains no entries. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .tree.count == 0;
  }

  .clear DOC <$ Removes and destroys every map entry. $>
    FUNCTION() MUT
  {
    ordered_tree_clear#(ordered_map_entry#(k, v))(@tree .tree);
  }

  .contains DOC <$ Reports whether key is present. $>
    FUNCTION(@key CONST& k) CONST: BOOL
  {
    RETURN ordered_tree_find_node#(ordered_map_entry#(k, v), k)(
      @tree .tree,
      @key key
    )??;
  }

  .find DOC <$ Returns a mutable iterator for key or END when absent. $>
    FUNCTION(@key CONST& k) MUT: map_iterator#(k, v)
  {
    VAR node MUT->ordered_tree_node#(ordered_map_entry#(k, v)) :=
      ordered_tree_find_node#(ordered_map_entry#(k, v), k)(@tree .tree, @key key);
    RETURN map_iterator#(k, v)(@node node);
  }

  .find DOC <$ Returns a constant iterator for key or END when absent. $>
    FUNCTION(@key CONST& k) CONST: map_const_iterator#(k, v)
  {
    VAR node MUT->ordered_tree_node#(ordered_map_entry#(k, v)) :=
      ordered_tree_find_node#(ordered_map_entry#(k, v), k)(@tree .tree, @key key);
    RETURN map_const_iterator#(k, v)(@node node);
  }

  .insert DOC <$
    Inserts key and value, consuming temporary arguments only when insertion
    succeeds.
    $>
    FUNCTION(
      @key AUTO& k,
      @value AUTO& v
    ) MUT: BOOL
  {
    RETURN ordered_map_insert_value#(k, v)(
      @tree .tree,
      @key FORWARD(key),
      @value FORWARD(value)
    );
  }

  .insert_or_assign DOC <$
    Inserts a missing key or assigns value to the existing associated value.
    Returns true only when a new entry was inserted.
    $>
    FUNCTION(
      @key AUTO& k,
      @value AUTO& v
    ) MUT: BOOL
  {
    RETURN ordered_map_insert_or_assign_value#(k, v)(
      @tree .tree,
      @key FORWARD(key),
      @value FORWARD(value)
    );
  }

  .erase DOC <$ Removes key when present and reports whether an entry was erased. $>
    FUNCTION(@key CONST& k) MUT: BOOL
  {
    VAR node MUT->ordered_tree_node#(ordered_map_entry#(k, v)) :=
      ordered_tree_find_node#(ordered_map_entry#(k, v), k)(@tree .tree, @key key);
    IF ((node??) == FALSE)
    {
      RETURN FALSE;
    }
    ordered_tree_erase_node#(ordered_map_entry#(k, v))(@tree .tree, @node node);
    RETURN TRUE;
  }

  .at DOC <$ Returns the mutable value associated with key. $>
    FUNCTION(@key CONST& k) MUT: MUT& v
  {
    VAR node MUT->ordered_tree_node#(ordered_map_entry#(k, v)) :=
      ordered_tree_find_node#(ordered_map_entry#(k, v), k)(@tree .tree, @key key);
    ASSERT(node??, "The requested map key is absent.");
    RETURN (node->).entry.value;
  }

  .at DOC <$ Returns the constant value associated with key. $>
    FUNCTION(@key CONST& k) CONST: CONST& v
  {
    VAR node MUT->ordered_tree_node#(ordered_map_entry#(k, v)) :=
      ordered_tree_find_node#(ordered_map_entry#(k, v), k)(@tree .tree, @key key);
    ASSERT(node??, "The requested map key is absent.");
    RETURN (node->).entry.value;
  }

  .OPERATOR[] DOC <$ Returns the value for key, default-inserting when absent. $>
    FUNCTION(%key AUTO& k) MUT: MUT& v
  {
    RETURN ordered_map_index_value#(k, v)(@tree .tree, @key FORWARD(key));
  }

  .BEGIN DOC <$ Returns an iterator to the first mutable map item. $>
    FUNCTION() MUT: map_iterator#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_iterator#(k, v)(@node first);
  }

  .BEGIN DOC <$ Returns an iterator to the first constant map item. $>
    FUNCTION() CONST: map_const_iterator#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_const_iterator#(k, v)(@node first);
  }

  .END DOC <$ Returns the past-the-end mutable map iterator. $>
    FUNCTION() MUT: map_iterator#(k, v)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_map_entry#(k, v));
    RETURN map_iterator#(k, v)(@node end_node);
  }

  .END DOC <$ Returns the past-the-end constant map iterator. $>
    FUNCTION() CONST: map_const_iterator#(k, v)
  {
    VAR end_node MUT->ordered_tree_node#(ordered_map_entry#(k, v));
    RETURN map_const_iterator#(k, v)(@node end_node);
  }

  .items DOC <$ Returns a mutable item range in ascending key order. $>
    FUNCTION() MUT: map_item_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_item_range#(k, v)(@first first);
  }

  .items DOC <$ Returns a constant item range in ascending key order. $>
    FUNCTION() CONST: map_const_item_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_const_item_range#(k, v)(@first first);
  }

  .INDEXES DOC <$ Returns the immutable keys in ascending order. $>
    FUNCTION() CONST: map_key_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_key_range#(k, v)(@first first);
  }

  .VALUES DOC <$ Returns the mutable values in ascending key order. $>
    FUNCTION() MUT: map_value_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_value_range#(k, v)(@first first);
  }

  .VALUES DOC <$ Returns the constant values in ascending key order. $>
    FUNCTION() CONST: map_const_value_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_const_value_range#(k, v)(@first first);
  }

  .IV_PAIRS DOC <$ Returns mutable INDEX/VALUE pairs in ascending key order. $>
    FUNCTION() MUT: map_item_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_item_range#(k, v)(@first first);
  }

  .IV_PAIRS DOC <$ Returns constant INDEX/VALUE pairs in ascending key order. $>
    FUNCTION() CONST: map_const_item_range#(k, v)
  {
    VAR first MUT->ordered_tree_node#(ordered_map_entry#(k, v)) := .tree.root;
    IF (first??)
    {
      first := ordered_tree_minimum#(ordered_map_entry#(k, v))(@node first);
    }
    RETURN map_const_item_range#(k, v)(@first first);
  }
}


