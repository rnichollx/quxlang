LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

::transfer_result DOC <$
  Reports the outcome of one file transfer. A successful transfer may contain
  fewer bytes than requested, including zero bytes at end of file.
  $>
  STRUCT
{
  .size VAR SZ;
  .succeeded VAR BOOL;
}

::buffer_ref DOC <$
  A non-owning reference to a mutable byte range. The referenced storage must
  remain alive for every operation that uses the reference.
  $>
  STRUCT
{
  .data VAR MUT=>>BYTE;
  .size VAR SZ;

  .CONSTRUCTOR DOC <$ Creates a reference to data[0..size). $>
    FUNCTION(@data MUT=>>BYTE, @size SZ)
  {
    .data := data;
    .size := size;
  }
}

::java_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/File"];

::java_random_access_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/RandomAccessFile"];

::jvm_file_create_temp_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"createTempFile"]
  CALLABLE CALLCONV JVM_STATIC(
    @prefix ~> RUNTIME_MODULE::java_string,
    @suffix ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_file
  );

::jvm_file_get_path INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"getPath"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_file;
    RETURN ~> RUNTIME_MODULE::java_string
  );

::jvm_file_delete_on_exit INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"deleteOnExit"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_file);

::jvm_random_access_file_constructor INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"<init>"]
  CALLABLE CALLCONV JVM_CONSTRUCTOR(
    @path ~> RUNTIME_MODULE::java_string,
    @mode ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_random_access_file
  );

::jvm_random_access_file_read INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"read"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I32
  );

::jvm_random_access_file_write INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"write"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @value I32
  );

::jvm_random_access_file_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"length"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I64
  );

::jvm_random_access_file_set_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"setLength"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @length I64
  );

::jvm_random_access_file_close INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"close"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_random_access_file);

::file_ref INCLUDE_IF(OS_LINUX) DOC <$
  A non-owning reference to an open Linux file descriptor. Destroying this
  value does not close the descriptor.
  $>
  STRUCT
{
  .descriptor VAR I32;

  .CONSTRUCTOR DOC <$ Creates a non-owning reference to descriptor. $>
    FUNCTION(@descriptor I32)
  {
    .descriptor := descriptor;
  }

  .read DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::linux::read(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  .write DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::linux::write(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  .close DOC <$
    Closes the referenced descriptor. This operation does not track whether
    another file_ref still refers to the same descriptor.
    $>
    FUNCTION(): BOOL
  {
    RETURN syscall::linux::close(@fd .descriptor) == 0;
  }
}

::file_ref INCLUDE_IF(OS_MACOS) DOC <$
  A non-owning reference to an open macOS file descriptor. Destroying this
  value does not close the descriptor.
  $>
  STRUCT
{
  .descriptor VAR I32;

  .CONSTRUCTOR DOC <$ Creates a non-owning reference to descriptor. $>
    FUNCTION(@descriptor I32)
  {
    .descriptor := descriptor;
  }

  .read DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::macos::read(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  .write DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := syscall::macos::write(
      @fd .descriptor,
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.size := 0;
    }
    result := outcome;
  }

  .close DOC <$
    Closes the referenced descriptor. This operation does not track whether
    another file_ref still refers to the same descriptor.
    $>
    FUNCTION(): BOOL
  {
    RETURN syscall::macos::close(@fd .descriptor) == 0;
  }
}

::file_ref INCLUDE_IF(ARCH_IS_JVM) DOC <$
  A non-owning reference to an open Java random-access file. Destroying this
  value does not close the Java object.
  $>
  STRUCT
{
  .random_access_file VAR ~> java_random_access_file;

  .CONSTRUCTOR DOC <$ Creates a non-owning reference to random_access_file. $>
    FUNCTION(@random_access_file ~> java_random_access_file)
  {
    .random_access_file := random_access_file;
  }

  .read DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.succeeded := TRUE;
    WHILE (outcome.size < buffer.size)
    {
      VAR value I32 := jvm_random_access_file_read(@THIS .random_access_file);
      IF (value < 0)
      {
        result := outcome;
        RETURN;
      }
      buffer.data[outcome.size] := (value AS CHECKED U8) AS BYTE;
      outcome.size++;
    }
    result := outcome;
  }

  .write DOC <$ Writes buffer.size bytes from buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    WHILE (outcome.size < buffer.size)
    {
      VAR value BYTE := buffer.data[outcome.size];
      jvm_random_access_file_write(
        @THIS .random_access_file,
        @value ((value AS U8) AS ASSUME I32)
      );
      outcome.size++;
    }
    outcome.succeeded := TRUE;
    result := outcome;
  }

  .size DOC <$ Returns the current file length in bytes. $>
    FUNCTION(): SZ
  {
    VAR length I64 := jvm_random_access_file_length(
      @THIS .random_access_file
    );
    RETURN length AS CHECKED SZ;
  }

  .truncate DOC <$ Truncates the file to zero bytes. $>
    FUNCTION()
  {
    jvm_random_access_file_set_length(
      @THIS .random_access_file,
      @length 0
    );
  }

  .close DOC <$ Closes the referenced Java random-access file. $>
    FUNCTION(): BOOL
  {
    jvm_random_access_file_close(@THIS .random_access_file);
    RETURN TRUE;
  }
}

::windows_read_file INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"ReadFile"]
  CALLABLE CALLCONV CCALL(
    @handle ADDRESS,
    @buffer MUT=>>BYTE,
    @count U32,
    @transferred MUT->U32,
    @overlapped =>>BYTE;
    RETURN BOOL
  );

::windows_write_file INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"WriteFile"]
  CALLABLE CALLCONV CCALL(
    @handle ADDRESS,
    @buffer CONST=>>BYTE,
    @count U32,
    @transferred MUT->U32,
    @overlapped =>>BYTE;
    RETURN BOOL
  );

::windows_close_handle INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"CloseHandle"]
  CALLABLE CALLCONV CCALL(@handle ADDRESS; RETURN BOOL);

::windows_transfer_size INCLUDE_IF(OS_WINDOWS) DOC <$
  Limits one Windows transfer to the DWORD count accepted by ReadFile and
  WriteFile. Callers can continue with the untransferred suffix.
  $>
  FUNCTION(@size SZ): U32
{
  VAR maximum U32 := (0 AS U32) #!!;
  IF (size > maximum AS SZ)
  {
    RETURN maximum;
  }
  RETURN size AS ASSUME U32;
}

::file_ref INCLUDE_IF(OS_WINDOWS) DOC <$
  A non-owning reference to an open Windows file HANDLE. Destroying this value
  does not close the handle.
  $>
  STRUCT
{
  .handle VAR ADDRESS;

  .CONSTRUCTOR DOC <$ Creates a non-owning reference to handle. $>
    FUNCTION(@handle ADDRESS)
  {
    .handle := handle;
  }

  .read DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped =>>BYTE;
    outcome.succeeded := windows_read_file(
      @handle .handle,
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    );
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  .write DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped =>>BYTE;
    outcome.succeeded := windows_write_file(
      @handle .handle,
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    );
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  .close DOC <$
    Closes the referenced handle. This operation does not track whether another
    file_ref still refers to the same handle.
    $>
    FUNCTION(): BOOL
  {
    RETURN windows_close_handle(@handle .handle);
  }
}

::file DOC <$
  An owning open file. The file is closed when this move-only value is destroyed.
  Constructing from a file_ref transfers ownership of its native file reference.
  $>
  STRUCT MOVE_ONLY
{
  .native_ref VAR file_ref;
  .open VAR I32;

  .CONSTRUCTOR DOC <$ Takes ownership of native_ref. $>
    FUNCTION(@native_ref file_ref)
  {
    .native_ref := native_ref;
    .open := 1;
  }

  .CONSTRUCTOR DOC <$ Transfers ownership from another file. $>
    FUNCTION(@OTHER TEMP& file)
  {
    .native_ref := OTHER.native_ref;
    .open := 0;
    VAR other_open MUT& I32 := OTHER.open AS MUT& I32;
    .open <-> other_open;
  }

  .DESTRUCTOR DOC <$ Closes the owned file if it is still open. $>
    FUNCTION()
  {
    IF (.open != 0)
    {
      .native_ref.close();
      .open := 0;
    }
  }

  .reference DOC <$ Returns a non-owning reference to the owned file. $>
    FUNCTION(): file_ref
  {
    RETURN .native_ref;
  }

  .is_open DOC <$ Reports whether this value still owns an open file. $>
    FUNCTION(): BOOL
  {
    RETURN .open != 0;
  }

  .read DOC <$ Reads from the owned file into buffer and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.open != 0)
    {
      .native_ref.read(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    outcome.size := 0;
    outcome.succeeded := FALSE;
    result := outcome;
  }

  .write DOC <$ Writes from buffer to the owned file and stores the outcome in result. $>
    FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.open != 0)
    {
      .native_ref.write(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    outcome.size := 0;
    outcome.succeeded := FALSE;
    result := outcome;
  }

  .close DOC <$
    Closes the owned file and relinquishes ownership. A failed close is reported,
    but the native reference is not closed again.
    $>
    FUNCTION(): BOOL
  {
    IF (.open == 0)
    {
      RETURN TRUE;
    }
    .open := 0;
    RETURN .native_ref.close();
  }
}

::open_read_write INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Opens path for Java random-access reading and writing and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

::open_read INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Opens path for Java random-access reading and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "r";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

::open_replace INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Opens path for Java random-access reading and writing, truncates it, and
  returns its owner. Java I/O exceptions propagate out of the generated JVM
  program.
  $>
  FUNCTION(@path CONST& string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value path);
  VAR mode string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  VAR reference file_ref := file_ref(
    @random_access_file random_access_file
  );
  reference.truncate();
  RETURN file(@native_ref reference);
}

::create_temporary_path INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Creates an empty temporary file, schedules deletion when the JVM exits, and
  returns its path.
  $>
  FUNCTION(): string
{
  VAR prefix string := "quxlang-cortado-";
  VAR suffix string := ".tmp";
  VAR java_prefix ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value prefix);
  VAR java_suffix ~> RUNTIME_MODULE::java_string :=
    java_string_from_string(@value suffix);
  VAR temporary_file ~> java_file := jvm_file_create_temp_file(
    @prefix java_prefix,
    @suffix java_suffix
  );
  jvm_file_delete_on_exit(@THIS temporary_file);
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    jvm_file_get_path(@THIS temporary_file);
  RETURN string_from_java_string(@value java_path);
}
