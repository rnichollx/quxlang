LANGUAGE QUXLANG EN 0.0;


PRIVATE(MODULE, RUNTIME_MODULE)
{
  ::list_node DOC <$
    Stores one list element and the links joining it to adjacent nodes.
    $>
    TEMPLATE(TYPE AUTO(t)) STRUCT MOVE_ONLY
  {
    .previous VAR MUT->list_node#(t);
    .next VAR MUT->list_node#(t);
    .value VAR t;

    .CONSTRUCTOR DOC <$ Copy-constructs the element stored by this node. $>
      FUNCTION(@value CONST& t) :> .value:(@OTHER FORWARD(value))
    {
    }

    .CONSTRUCTOR DOC <$ Move-constructs the element stored by this node. $>
      FUNCTION(@value TEMP& t) :> .value:(@OTHER FORWARD(value))
    {
    }
  }
}


::list_iterator DOC <$
  Provides mutable bidirectional traversal over the elements of list#(t).
  $>
  TEMPLATE(TYPE AUTO(t)) STRUCT
{
  PRIVATE(MODULE)
  {
    .owner VAR MUT->list#(t);
    .node VAR MUT->list_node#(t);

    .CONSTRUCTOR DOC <$ Creates an iterator at node within owner. $>
      FUNCTION(@owner MUT->list#(t), @node MUT->list_node#(t))
    {
      .owner := owner;
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an iterator that is not associated with a list. $>
    FUNCTION()
  {
  }

  .OPERATOR== DOC <$ Reports whether both iterators identify the same position. $>
    FUNCTION(@OTHER CONST& list_iterator#(t)) CONST: BOOL
  {
    RETURN (.owner == OTHER.owner) && (.node == OTHER.node);
  }

  .OPERATOR++ DOC <$ Advances to the next element and returns the previous position. $>
    FUNCTION() MUT: list_iterator#(t)
  {
    ASSERT(.node??, "Cannot advance a past-the-end list iterator.");
    VAR previous list_iterator#(t) := THIS;
    .node := (.node->).next;
    RETURN previous;
  }

  .OPERATOR-- DOC <$ Retreats to the previous element and returns the previous position. $>
    FUNCTION() MUT: list_iterator#(t)
  {
    ASSERT(.owner??, "Cannot retreat an unassociated list iterator.");
    VAR previous list_iterator#(t) := THIS;
    IF (.node??)
    {
      .node := (.node->).previous;
    }
    ELSE
    {
      .node := (.owner->).tail;
    }
    ASSERT(.node??, "Cannot retreat before the beginning of a list.");
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns a mutable reference to the current element. $>
    FUNCTION() CONST: MUT& t
  {
    ASSERT(.node??, "Cannot dereference a past-the-end list iterator.");
    RETURN (.node->).value;
  }
}


::list_const_iterator DOC <$
  Provides read-only bidirectional traversal over the elements of list#(t).
  $>
  TEMPLATE(TYPE AUTO(t)) STRUCT
{
  PRIVATE(MODULE)
  {
    .owner VAR CONST->list#(t);
    .node VAR MUT->list_node#(t);

    .CONSTRUCTOR DOC <$ Creates a constant iterator at node within owner. $>
      FUNCTION(@owner CONST->list#(t), @node MUT->list_node#(t))
    {
      .owner := owner;
      .node := node;
    }
  }

  .CONSTRUCTOR DOC <$ Creates an iterator that is not associated with a list. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Converts a mutable iterator to a read-only iterator. $>
    FUNCTION(@OTHER CONST& list_iterator#(t))
  {
    .owner := OTHER.owner;
    .node := OTHER.node;
  }

  .OPERATOR== DOC <$ Reports whether both iterators identify the same position. $>
    FUNCTION(@OTHER CONST& list_const_iterator#(t)) CONST: BOOL
  {
    RETURN (.owner == OTHER.owner) && (.node == OTHER.node);
  }

  .OPERATOR++ DOC <$ Advances to the next element and returns the previous position. $>
    FUNCTION() MUT: list_const_iterator#(t)
  {
    ASSERT(.node??, "Cannot advance a past-the-end list iterator.");
    VAR previous list_const_iterator#(t) := THIS;
    .node := (.node->).next;
    RETURN previous;
  }

  .OPERATOR-- DOC <$ Retreats to the previous element and returns the previous position. $>
    FUNCTION() MUT: list_const_iterator#(t)
  {
    ASSERT(.owner??, "Cannot retreat an unassociated list iterator.");
    VAR previous list_const_iterator#(t) := THIS;
    IF (.node??)
    {
      .node := (.node->).previous;
    }
    ELSE
    {
      .node := (.owner->).tail;
    }
    ASSERT(.node??, "Cannot retreat before the beginning of a list.");
    RETURN previous;
  }

  .OPERATOR-> DOC <$ Returns a constant reference to the current element. $>
    FUNCTION() CONST: CONST& t
  {
    ASSERT(.node??, "Cannot dereference a past-the-end list iterator.");
    RETURN (.node->).value AS CONST& t;
  }
}


::list DOC <$
  Owns a sequence of elements in individually allocated doubly linked nodes.
  Insertion and erasure preserve iterators to every element not erased.
  $>
  TEMPLATE(TYPE AUTO(t)) STRUCT
{
  PRIVATE(MODULE)
  {
    .head VAR MUT->list_node#(t);
    .tail VAR MUT->list_node#(t);
    .length VAR SZ;
  }

  .CONSTRUCTOR DOC <$ Creates an empty list. $>
    FUNCTION()
  {
  }

  .CONSTRUCTOR DOC <$ Copy-constructs each element from OTHER in sequence order. $>
    FUNCTION(@OTHER CONST& list#(t))
  {
    VAR source MUT->list_node#(t) := OTHER.head;
    WHILE (source??)
    {
      .push_back(@value (source->).value AS CONST& t);
      source := (source->).next;
    }
  }

  .CONSTRUCTOR DOC <$ Transfers all nodes from OTHER in constant time. $>
    FUNCTION(@OTHER TEMP& list#(t))
  {
    VAR empty_head MUT->list_node#(t);
    VAR empty_tail MUT->list_node#(t);
    .head := empty_head;
    .tail := empty_tail;
    .length := 0;

    VAR other_head MUT& MUT->list_node#(t) :=
      OTHER.head AS MUT& MUT->list_node#(t);
    VAR other_tail MUT& MUT->list_node#(t) :=
      OTHER.tail AS MUT& MUT->list_node#(t);
    VAR other_length MUT& SZ := OTHER.length AS MUT& SZ;
    .head <-> other_head;
    .tail <-> other_tail;
    .length <-> other_length;
  }

  .DESTRUCTOR DOC <$ Destroys every remaining element and releases every node. $>
    FUNCTION()
  {
    .clear();
  }

  .size DOC <$ Returns the number of elements in this list. $>
    FUNCTION() CONST: SZ
  {
    RETURN .length;
  }

  .empty DOC <$ Reports whether this list contains no elements. $>
    FUNCTION() CONST: BOOL
  {
    RETURN .length == 0;
  }

  .clear DOC <$ Destroys every element and leaves this list empty. $>
    FUNCTION() MUT
  {
    WHILE (.head??)
    {
      .pop_front();
    }
  }

  .push_front DOC <$ Copy-constructs value at the beginning of this list. $>
    FUNCTION(@value CONST& t) MUT
  {
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) := NEW list_node#(t) :(@value value);
    (added->).next := .head;
    IF (.head??)
    {
      (.head->).previous := added;
    }
    ELSE
    {
      .tail := added;
    }
    .head := added;
    .length++;
  }

  .push_front DOC <$ Move-constructs value at the beginning of this list. $>
    FUNCTION(@value TEMP& t) MUT
  {
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) :=
      NEW list_node#(t) :(@value FORWARD(value));
    (added->).next := .head;
    IF (.head??)
    {
      (.head->).previous := added;
    }
    ELSE
    {
      .tail := added;
    }
    .head := added;
    .length++;
  }

  .push_back DOC <$ Copy-constructs value at the end of this list. $>
    FUNCTION(@value CONST& t) MUT
  {
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) := NEW list_node#(t) :(@value value);
    (added->).previous := .tail;
    IF (.tail??)
    {
      (.tail->).next := added;
    }
    ELSE
    {
      .head := added;
    }
    .tail := added;
    .length++;
  }

  .push_back DOC <$ Move-constructs value at the end of this list. $>
    FUNCTION(@value TEMP& t) MUT
  {
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) :=
      NEW list_node#(t) :(@value FORWARD(value));
    (added->).previous := .tail;
    IF (.tail??)
    {
      (.tail->).next := added;
    }
    ELSE
    {
      .head := added;
    }
    .tail := added;
    .length++;
  }

  .pop_front DOC <$ Removes and destroys the first element. $>
    FUNCTION() MUT
  {
    ASSERT(.head??, "Cannot pop_front from an empty list.");
    VAR removed MUT->list_node#(t) := .head;
    .head := (removed->).next;
    IF (.head??)
    {
      (.head->).previous := (removed->).previous;
    }
    ELSE
    {
      .tail := (removed->).previous;
    }
    .length--;
    DELETE removed;
  }

  .pop_back DOC <$ Removes and destroys the final element. $>
    FUNCTION() MUT
  {
    ASSERT(.tail??, "Cannot pop_back from an empty list.");
    VAR removed MUT->list_node#(t) := .tail;
    .tail := (removed->).previous;
    IF (.tail??)
    {
      (.tail->).next := (removed->).next;
    }
    ELSE
    {
      .head := (removed->).next;
    }
    .length--;
    DELETE removed;
  }

  .front DOC <$ Returns a mutable reference to the first element. $>
    FUNCTION() MUT: MUT& t
  {
    ASSERT(.head??, "Cannot access the front of an empty list.");
    RETURN (.head->).value;
  }

  .front DOC <$ Returns a constant reference to the first element. $>
    FUNCTION() CONST: CONST& t
  {
    ASSERT(.head??, "Cannot access the front of an empty list.");
    RETURN (.head->).value AS CONST& t;
  }

  .back DOC <$ Returns a mutable reference to the final element. $>
    FUNCTION() MUT: MUT& t
  {
    ASSERT(.tail??, "Cannot access the back of an empty list.");
    RETURN (.tail->).value;
  }

  .back DOC <$ Returns a constant reference to the final element. $>
    FUNCTION() CONST: CONST& t
  {
    ASSERT(.tail??, "Cannot access the back of an empty list.");
    RETURN (.tail->).value AS CONST& t;
  }

  .insert DOC <$ Copy-constructs value immediately before position. $>
    FUNCTION(
      @position CONST& list_const_iterator#(t),
      @value CONST& t
    ) MUT: list_iterator#(t)
  {
    ASSERT(position.owner == THIS<-, "List insertion requires an iterator from this list.");
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) := NEW list_node#(t) :(@value value);
    (added->).next := position.node;
    IF (position.node??)
    {
      (added->).previous := (position.node->).previous;
      (position.node->).previous := added;
    }
    ELSE
    {
      (added->).previous := .tail;
      .tail := added;
    }
    IF ((added->).previous??)
    {
      ((added->).previous->).next := added;
    }
    ELSE
    {
      .head := added;
    }
    .length++;
    RETURN list_iterator#(t)(@owner THIS<-, @node added);
  }

  .insert DOC <$ Move-constructs value immediately before position. $>
    FUNCTION(
      @position CONST& list_const_iterator#(t),
      @value TEMP& t
    ) MUT: list_iterator#(t)
  {
    ASSERT(position.owner == THIS<-, "List insertion requires an iterator from this list.");
    ASSERT(.length != ((0 AS SZ) #!!), "List size overflow.");
    VAR added MUT->list_node#(t) :=
      NEW list_node#(t) :(@value FORWARD(value));
    (added->).next := position.node;
    IF (position.node??)
    {
      (added->).previous := (position.node->).previous;
      (position.node->).previous := added;
    }
    ELSE
    {
      (added->).previous := .tail;
      .tail := added;
    }
    IF ((added->).previous??)
    {
      ((added->).previous->).next := added;
    }
    ELSE
    {
      .head := added;
    }
    .length++;
    RETURN list_iterator#(t)(@owner THIS<-, @node added);
  }

  .erase DOC <$ Removes position and returns an iterator to its successor. $>
    FUNCTION(@position CONST& list_const_iterator#(t)) MUT: list_iterator#(t)
  {
    ASSERT(position.owner == THIS<-, "List erasure requires an iterator from this list.");
    ASSERT(position.node??, "Cannot erase the past-the-end list position.");
    VAR removed MUT->list_node#(t) := position.node;
    VAR previous MUT->list_node#(t) := (removed->).previous;
    VAR next MUT->list_node#(t) := (removed->).next;
    IF (previous??)
    {
      (previous->).next := next;
    }
    ELSE
    {
      .head := next;
    }
    IF (next??)
    {
      (next->).previous := previous;
    }
    ELSE
    {
      .tail := previous;
    }
    .length--;
    DELETE removed;
    RETURN list_iterator#(t)(@owner THIS<-, @node next);
  }

  .BEGIN DOC <$ Returns a mutable iterator to the first element. $>
    FUNCTION() MUT: list_iterator#(t)
  {
    RETURN list_iterator#(t)(@owner THIS<-, @node .head);
  }

  .BEGIN DOC <$ Returns a constant iterator to the first element. $>
    FUNCTION() CONST: list_const_iterator#(t)
  {
    RETURN list_const_iterator#(t)(@owner THIS<-, @node .head);
  }

  .END DOC <$ Returns a mutable past-the-end iterator. $>
    FUNCTION() MUT: list_iterator#(t)
  {
    VAR end_node MUT->list_node#(t);
    RETURN list_iterator#(t)(@owner THIS<-, @node end_node);
  }

  .END DOC <$ Returns a constant past-the-end iterator. $>
    FUNCTION() CONST: list_const_iterator#(t)
  {
    VAR end_node MUT->list_node#(t);
    RETURN list_const_iterator#(t)(@owner THIS<-, @node end_node);
  }

  .VALUES DOC <$ Returns this list as a mutable element range. $>
    FUNCTION() MUT: MUT& list#(t)
  {
    RETURN THIS;
  }

  .VALUES DOC <$ Returns this list as a constant element range. $>
    FUNCTION() CONST: CONST& list#(t)
  {
    RETURN THIS;
  }
}
