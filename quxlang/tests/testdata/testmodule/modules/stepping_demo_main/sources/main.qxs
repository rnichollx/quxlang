LANGUAGE QUXLANG EN 0.0;

::main FUNCTION(): I32
{
  RUNTIME_MODULE::write(@fd RUNTIME_MODULE::stdout, @msg "selected stepping: ");
  RUNTIME_MODULE::write_decimal(@fd RUNTIME_MODULE::stdout, @value ACTIVE_STEPPING);
  RUNTIME_MODULE::write(@fd RUNTIME_MODULE::stdout, @msg "\n");

  VAR products [1024]I32;
  VAR seed I32 := 1;
  IF (ACTIVE_STEPPING != 0 AS SZ)
  {
    seed := 2;
  }

  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(1024 AS SZ) DO
  {
    VAR value I32 := index AS ASSUME I32;
    products[index] := (value + seed) * (value + 3);
  };

  VAR checksum I32 := 0;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(1024 AS SZ) DO
  {
    checksum := checksum + products[index];
  };

  IF (checksum == 0)
  {
    RETURN 1;
  }
  RETURN 0;
}
