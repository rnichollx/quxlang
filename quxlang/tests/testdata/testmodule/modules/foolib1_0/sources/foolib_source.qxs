LANGUAGE QUXLANG EN 0.0;


::imported_function FUNCTION(): I32
{
    RETURN 42;
}


::accept_type DOC <$ Accepts any explicitly supplied type without inspecting its declaration. $>
  TEMPLATE(@T TYPE AUTO) FUNCTION(): BOOL
{
  RETURN SAME_TYPES(T, T);
}


::accept_deduced_type DOC <$ Accepts a value whose type is deduced by the function template. $>
  FUNCTION(@ARG:value AUTO& AUTO(t)): BOOL
{
  RETURN SAME_TYPES(t, t);
}
