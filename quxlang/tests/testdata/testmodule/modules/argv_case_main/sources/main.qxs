LANGUAGE QUXLANG EN 0.0;

IMPORT std;

// Swaps the case of an ASCII letter and preserves every other byte.
::swap_ascii_case FUNCTION(@value BYTE): BYTE
{
  IF (value >= 65 && value <= 90)
  {
    RETURN ((value AS U8) + 32) AS BYTE;
  }
  IF (value >= 97 && value <= 122)
  {
    RETURN ((value AS U8) - 32) AS BYTE;
  }
  RETURN value;
}

// Echoes all user-supplied command-line arguments with ASCII case swapped.
::main FUNCTION(): I32
{
  LOOP VALUE(argument_index) FROM(1 AS SZ) UNTIL(std::args::count()) DO {
    IF (argument_index != 1)
    {
      RUNTIME_MODULE::write(@fd RUNTIME_MODULE::stdout, @msg " ");
    }

    VAR argument std::string := std::args::at(@index argument_index);
    VAR output [1]BYTE;

    LOOP INIT { VAR character_index SZ := 0; }
      TEST(character_index < argument.size())
      STEP { character_index++; }
      DO
    {
      VAR character BYTE := argument[character_index];
      output[0] := swap_ascii_case(@value character);
      RUNTIME_MODULE::write_bytes(
        @fd RUNTIME_MODULE::stdout,
        @begin output[& 0],
        @end output[& 1]
      );
    };
  };

  RUNTIME_MODULE::write(@fd RUNTIME_MODULE::stdout, @msg "\n");
  RETURN 0;
}
