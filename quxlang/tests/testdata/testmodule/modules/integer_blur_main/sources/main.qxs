LANGUAGE QUXLANG EN 0.0;

IMPORT std;
IMPORT syscall;

::file_header_size STATIC SZ := 16;
::convolution_radius STATIC SZ := 3;
::convolution_iteration_count STATIC SZ := 256;
::maximum_file_size STATIC SZ := 8589934608;

::image_data STRUCT
{
  .width VAR SZ;
  .height VAR SZ;
  .pixel_count VAR SZ;
  .pixels VAR =>>TYPED_STORAGE(U16);
}

::open_input_file DOC <$ Opens one input file for reading on the target operating system. $>
  FUNCTION(@path CONST=>>BYTE): I32
{
  VAR descriptor I32 := 0 - 1;
  STATIC_IF(OS_LINUX)
  {
    descriptor := syscall::linux::open(
      @path path,
      @flags syscall::linux::rdonly,
      @mode syscall::linux::file_mode::rusr
    );
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    descriptor := syscall::macos::open(
      @path path,
      @flags syscall::macos::rdonly,
      @mode syscall::macos::file_mode::rusr
    );
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file input is not implemented for this operating system";
  }
  RETURN descriptor;
}

::open_output_file DOC <$ Opens one output file for replacement on the target operating system. $>
  FUNCTION(@path CONST=>>BYTE): I32
{
  VAR descriptor I32 := 0 - 1;
  STATIC_IF(OS_LINUX)
  {
    VAR flags syscall::linux::open_flags := syscall::linux::open_flags::wronly;
    flags #||= syscall::linux::open_flags::creat;
    flags #||= syscall::linux::open_flags::trunc;
    VAR mode syscall::linux::file_mode := syscall::linux::file_mode::rusr;
    mode #||= syscall::linux::file_mode::wusr;
    mode #||= syscall::linux::file_mode::rgrp;
    mode #||= syscall::linux::file_mode::roth;
    descriptor := syscall::linux::open(@path path, @flags flags, @mode mode);
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    VAR flags syscall::macos::open_flags := syscall::macos::open_flags::wronly;
    flags #||= syscall::macos::open_flags::creat;
    flags #||= syscall::macos::open_flags::trunc;
    VAR mode syscall::macos::file_mode := syscall::macos::file_mode::rusr;
    mode #||= syscall::macos::file_mode::wusr;
    mode #||= syscall::macos::file_mode::rgrp;
    mode #||= syscall::macos::file_mode::roth;
    descriptor := syscall::macos::open(@path path, @flags flags, @mode mode);
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file output is not implemented for this operating system";
  }
  RETURN descriptor;
}

::seek_file_end DOC <$ Seeks one descriptor to its end and returns the resulting offset. $>
  FUNCTION(@fd I32): SZ
{
  VAR result SZ := (0 AS SZ) #!!;
  STATIC_IF(OS_LINUX)
  {
    result := syscall::linux::lseek(
      @fd fd,
      @offset 0,
      @whence syscall::linux::seek_whence::end
    );
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    VAR macos_result I64 := syscall::macos::lseek(
      @fd fd,
      @offset 0,
      @whence syscall::macos::seek_whence::end
    );
    IF (macos_result >= 0)
    {
      result := macos_result AS ASSUME SZ;
    }
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file seeking is not implemented for this operating system";
  }
  RETURN result;
}

::seek_file_start DOC <$ Seeks one descriptor to its beginning and returns the resulting offset. $>
  FUNCTION(@fd I32): SZ
{
  VAR result SZ := (0 AS SZ) #!!;
  STATIC_IF(OS_LINUX)
  {
    result := syscall::linux::lseek(
      @fd fd,
      @offset 0,
      @whence syscall::linux::seek_whence::set
    );
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    VAR macos_result I64 := syscall::macos::lseek(
      @fd fd,
      @offset 0,
      @whence syscall::macos::seek_whence::set
    );
    IF (macos_result >= 0)
    {
      result := macos_result AS ASSUME SZ;
    }
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file seeking is not implemented for this operating system";
  }
  RETURN result;
}

::map_file_storage DOC <$ Maps anonymous storage for one complete image file. $>
  FUNCTION(@size SZ): ADDRESS
{
  VAR result ADDRESS;
  STATIC_IF(OS_LINUX)
  {
    result := syscall::linux::mmap_anonymous_private(@size size);
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    result := syscall::macos::mmap_anonymous_private(@size size);
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file storage is not implemented for this operating system";
  }
  RETURN result;
}

::unmap_file_storage DOC <$ Unmaps storage previously returned by map_file_storage. $>
  FUNCTION(@address ADDRESS, @size SZ): I32
{
  VAR result I32 := 0 - 1;
  STATIC_IF(OS_LINUX)
  {
    result := syscall::linux::munmap(@addr address, @len size);
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    result := syscall::macos::munmap(@address address, @size size);
  }
  STATIC_ELSE
  {
    COMPILATION_ERROR "integer blur file storage is not implemented for this operating system";
  }
  RETURN result;
}

::argument_equals DOC <$ Returns whether a null-terminated argument equals one string constant. $>
  FUNCTION(@argument CONST=>>BYTE, @expected STRING_CONSTANT): BOOL
{
  VAR index SZ := 0;
  VAR expected_size SZ := (expected.END() - expected.BEGIN()) AS ASSUME SZ;
  WHILE (index != expected_size)
  {
    IF (argument[index] != expected.BEGIN()[index])
    {
      RETURN FALSE;
    }
    index++;
  }
  RETURN argument[index] == 0;
}

::report_active_stepping DOC <$ Prints the selected benchmark stepping. $>
  FUNCTION(): I32
{
  VAR stepping SZ := ACTIVE_STEPPING;
  STATIC_IF(ARCH_IS_JVM)
  {
    RUNTIME_MODULE::write(@fd 1, @msg "jvm\n");
  }
  STATIC_ELSE STATIC_IF(OS_MACOS)
  {
    IF (stepping == 0)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "apple-m1\n");
    }
    ELSE IF (stepping == 1)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "apple-m2\n");
    }
    ELSE IF (stepping == 2)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "apple-m4\n");
    }
    ELSE
    {
      RUNTIME_MODULE::write(@fd 1, @msg "apple-m5\n");
    }
  }
  STATIC_ELSE
  {
    IF (stepping == 0)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "x64-v1\n");
    }
    ELSE IF (stepping == 1)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "x64-v2\n");
    }
    ELSE IF (stepping == 2)
    {
      RUNTIME_MODULE::write(@fd 1, @msg "x64-v3\n");
    }
    ELSE
    {
      RUNTIME_MODULE::write(@fd 1, @msg "x64-v4\n");
    }
  }
  RETURN 0;
}

::fail DOC <$ Writes one benchmark diagnostic and returns the failure exit code. $>
  FUNCTION(@message STRING_CONSTANT): I32
{
  RUNTIME_MODULE::write(@fd 2, @msg "integer_blur: ");
  RUNTIME_MODULE::write(@fd 2, @msg message);
  RUNTIME_MODULE::write(@fd 2, @msg "\n");
  RETURN 1;
}

::read_complete DOC <$ Reads exactly count bytes and rejects an error or early end of file. $>
  FUNCTION(@file MUT& std::file, @buffer MUT=>>BYTE, @count SZ): BOOL
{
  VAR offset SZ := 0;
  WHILE (offset != count)
  {
    VAR remaining SZ := count - offset;
    VAR read_buffer std::buffer_ref := std::buffer_ref(
      @data buffer + offset,
      @size remaining
    );
    VAR result std::transfer_result;
    file.read(@buffer read_buffer, @result result);
    IF (result.succeeded == FALSE || result.size == 0)
    {
      RETURN FALSE;
    }
    offset += result.size;
  }
  RETURN TRUE;
}

::write_complete DOC <$ Writes exactly count bytes and rejects an error or stalled write. $>
  FUNCTION(@file MUT& std::file, @buffer MUT=>>BYTE, @count SZ): BOOL
{
  VAR offset SZ := 0;
  WHILE (offset != count)
  {
    VAR remaining SZ := count - offset;
    VAR write_buffer std::buffer_ref := std::buffer_ref(
      @data buffer + offset,
      @size remaining
    );
    VAR result std::transfer_result;
    file.write(@buffer write_buffer, @result result);
    IF (result.succeeded == FALSE || result.size == 0)
    {
      RETURN FALSE;
    }
    offset += result.size;
  }
  RETURN TRUE;
}

::decode_u32 DOC <$ Decodes one little-endian 32-bit integer. $>
  FUNCTION(@bytes CONST=>>BYTE): U32
{
  VAR result U32 := bytes[0] AS U8 AS U32;
  result #||= bytes[1] AS U8 AS U32 #++ 8;
  result #||= bytes[2] AS U8 AS U32 #++ 16;
  result #||= bytes[3] AS U8 AS U32 #++ 24;
  RETURN result;
}

::encode_u32 DOC <$ Encodes one 32-bit integer in little-endian byte order. $>
  FUNCTION(@bytes MUT=>>BYTE, @value U32)
{
  bytes[0] := value AS PARTIAL U8 AS BYTE;
  bytes[1] := value #-- 8 AS PARTIAL U8 AS BYTE;
  bytes[2] := value #-- 16 AS PARTIAL U8 AS BYTE;
  bytes[3] := value #-- 24 AS PARTIAL U8 AS BYTE;
}

::header_is_valid DOC <$ Returns whether a byte buffer starts with the QIMG16LE signature. $>
  FUNCTION(@bytes CONST=>>BYTE): BOOL
{
  RETURN bytes[0] == 81 && bytes[1] == 73 && bytes[2] == 77 && bytes[3] == 71 &&
         bytes[4] == 49 && bytes[5] == 54 && bytes[6] == 76 && bytes[7] == 69;
}

::horizontal_border_pixel DOC <$ Loads one source pixel with horizontal edge clamping. $>
  FUNCTION(
    @source CONST=>>TYPED_STORAGE(U16),
    @width SZ,
    @row SZ,
    @column I64
  ): U32
{
  VAR selected_column SZ := 0;
  IF (column >= 0)
  {
    selected_column := column AS ASSUME SZ;
    IF (selected_column >= width)
    {
      selected_column := width - 1;
    }
  }
  RETURN (PUN source[row * width + selected_column] AS U16) AS U32;
}

::vertical_border_pixel DOC <$ Loads one source pixel with vertical edge clamping. $>
  FUNCTION(
    @source CONST=>>TYPED_STORAGE(U16),
    @width SZ,
    @height SZ,
    @row I64,
    @column SZ
  ): U32
{
  VAR selected_row SZ := 0;
  IF (row >= 0)
  {
    selected_row := row AS ASSUME SZ;
    IF (selected_row >= height)
    {
      selected_row := height - 1;
    }
  }
  RETURN (PUN source[selected_row * width + column] AS U16) AS U32;
}

::horizontal_pass DOC <$ Applies one horizontal seven-tap integer convolution pass. $>
  FUNCTION(
    @source CONST=>>TYPED_STORAGE(U16),
    @destination =>>TYPED_STORAGE(U16),
    @width SZ,
    @height SZ
  )
{
  FOR VALUE(row) FROM(0 AS SZ) UNTIL(height) LOOP
  {
    VAR row_offset SZ := row * width;
    FOR VALUE(column) FROM(0 AS SZ) UNTIL(convolution_radius) LOOP
    {
      VAR signed_column I64 := column AS ASSUME I64;
      VAR sum U32 := horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 3);
      sum += 6 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 2);
      sum += 15 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 1);
      sum += 20 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column);
      sum += 15 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 1);
      sum += 6 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 2);
      sum += horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 3);
      PLACE AT(destination[row_offset + column]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };

    FOR VALUE(column) FROM(convolution_radius) UNTIL(width - convolution_radius) LOOP
    {
      VAR index SZ := row_offset + column;
      VAR sum U32 := (PUN source[index - 3] AS U16) AS U32;
      sum += 6 * ((PUN source[index - 2] AS U16) AS U32);
      sum += 15 * ((PUN source[index - 1] AS U16) AS U32);
      sum += 20 * ((PUN source[index] AS U16) AS U32);
      sum += 15 * ((PUN source[index + 1] AS U16) AS U32);
      sum += 6 * ((PUN source[index + 2] AS U16) AS U32);
      sum += (PUN source[index + 3] AS U16) AS U32;
      PLACE AT(destination[index]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };

    FOR VALUE(column) FROM(width - convolution_radius) UNTIL(width) LOOP
    {
      VAR signed_column I64 := column AS ASSUME I64;
      VAR sum U32 := horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 3);
      sum += 6 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 2);
      sum += 15 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column - 1);
      sum += 20 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column);
      sum += 15 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 1);
      sum += 6 * horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 2);
      sum += horizontal_border_pixel(@source source, @width width, @row row, @column signed_column + 3);
      PLACE AT(destination[row_offset + column]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };
  };
}

::vertical_pass DOC <$ Applies one vertical seven-tap integer convolution pass. $>
  FUNCTION(
    @source CONST=>>TYPED_STORAGE(U16),
    @destination =>>TYPED_STORAGE(U16),
    @width SZ,
    @height SZ
  )
{
  FOR VALUE(row) FROM(0 AS SZ) UNTIL(convolution_radius) LOOP
  {
    VAR signed_row I64 := row AS ASSUME I64;
    FOR VALUE(column) FROM(0 AS SZ) UNTIL(width) LOOP
    {
      VAR sum U32 := vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 3, @column column);
      sum += 6 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 2, @column column);
      sum += 15 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 1, @column column);
      sum += 20 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row, @column column);
      sum += 15 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 1, @column column);
      sum += 6 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 2, @column column);
      sum += vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 3, @column column);
      PLACE AT(destination[row * width + column]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };
  };

  FOR VALUE(row) FROM(convolution_radius) UNTIL(height - convolution_radius) LOOP
  {
    VAR row_offset SZ := row * width;
    FOR VALUE(column) FROM(0 AS SZ) UNTIL(width) LOOP
    {
      VAR index SZ := row_offset + column;
      VAR sum U32 := (PUN source[index - 3 * width] AS U16) AS U32;
      sum += 6 * ((PUN source[index - 2 * width] AS U16) AS U32);
      sum += 15 * ((PUN source[index - width] AS U16) AS U32);
      sum += 20 * ((PUN source[index] AS U16) AS U32);
      sum += 15 * ((PUN source[index + width] AS U16) AS U32);
      sum += 6 * ((PUN source[index + 2 * width] AS U16) AS U32);
      sum += (PUN source[index + 3 * width] AS U16) AS U32;
      PLACE AT(destination[index]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };
  };

  FOR VALUE(row) FROM(height - convolution_radius) UNTIL(height) LOOP
  {
    VAR signed_row I64 := row AS ASSUME I64;
    FOR VALUE(column) FROM(0 AS SZ) UNTIL(width) LOOP
    {
      VAR sum U32 := vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 3, @column column);
      sum += 6 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 2, @column column);
      sum += 15 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row - 1, @column column);
      sum += 20 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row, @column column);
      sum += 15 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 1, @column column);
      sum += 6 * vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 2, @column column);
      sum += vertical_border_pixel(@source source, @width width, @height height, @row signed_row + 3, @column column);
      PLACE AT(destination[row * width + column]) U16 := (sum + 32) #-- 6 AS PARTIAL U16;
    };
  };
}

::destroy_pixels DOC <$ Ends the lifetime of every constructed pixel in one buffer. $>
  FUNCTION(@pixels =>>TYPED_STORAGE(U16), @count SZ)
{
  FOR VALUE(index) FROM(0 AS SZ) UNTIL(count) LOOP
  {
    DESTROY AT(pixels[index]) U16;
  };
}

::blur DOC <$ Executes the complete fixed integer-blur workload. $>
  FUNCTION(@value MUT& image_data)
{
  VAR temporary =>>TYPED_STORAGE(U16) :=
    RUNTIME_MODULE::DEFAULT_ALLOCATOR::allocate_multiple#U16(@count value.pixel_count);
  FOR VALUE(iteration) FROM(0 AS SZ) UNTIL(convolution_iteration_count) LOOP
  {
    horizontal_pass(
      @source value.pixels,
      @destination temporary,
      @width value.width,
      @height value.height
    );
    destroy_pixels(@pixels value.pixels, @count value.pixel_count);
    vertical_pass(
      @source temporary,
      @destination value.pixels,
      @width value.width,
      @height value.height
    );
    destroy_pixels(@pixels temporary, @count value.pixel_count);
  };
  RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(
    @ptr temporary,
    @count value.pixel_count
  );
}

::load_jvm_image INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Loads one QIMG16LE image through the Java file API.
  $>
  FUNCTION(
    @input_path CONST& std::string,
    @value MUT& image_data,
    @header MUT& [16]BYTE
  ): BOOL
{
  VAR input_file std::file := std::open_read(@path input_path);
  VAR input_reference std::file_ref := input_file.reference();
  VAR file_size SZ := input_reference.size();
  IF (file_size < file_header_size || file_size > maximum_file_size)
  {
    input_file.close();
    fail(@message "input size is outside the supported range");
    RETURN FALSE;
  }

  VAR header_buffer std::buffer_ref := std::buffer_ref(
    @data header[& 0],
    @size file_header_size
  );
  IF (read_complete(
    @file input_file,
    @buffer header_buffer.data,
    @count header_buffer.size
  )!!)
  {
    input_file.close();
    fail(@message "could not read complete input header");
    RETURN FALSE;
  }
  IF (header_is_valid(@bytes header[& 0])!!)
  {
    input_file.close();
    fail(@message "input has an invalid QIMG16LE header");
    RETURN FALSE;
  }

  value.width := decode_u32(@bytes header[& 8]) AS ASSUME SZ;
  value.height := decode_u32(@bytes header[& 12]) AS ASSUME SZ;
  IF (value.width < 7 || value.height < 7 || value.width > 65536 || value.height > 65536)
  {
    input_file.close();
    fail(@message "input dimensions are outside the supported range");
    RETURN FALSE;
  }
  value.pixel_count := value.width * value.height;
  IF (file_size != file_header_size + value.pixel_count * 2)
  {
    input_file.close();
    fail(@message "input size does not match its dimensions");
    RETURN FALSE;
  }

  value.pixels := RUNTIME_MODULE::DEFAULT_ALLOCATOR::allocate_multiple#U16(
    @count value.pixel_count
  );
  VAR pixel_bytes [2]BYTE;
  VAR pixel_buffer std::buffer_ref := std::buffer_ref(
    @data pixel_bytes[& 0],
    @size 2
  );
  VAR loaded_pixels SZ := 0;
  WHILE (loaded_pixels < value.pixel_count)
  {
    IF (read_complete(
      @file input_file,
      @buffer pixel_buffer.data,
      @count pixel_buffer.size
    )!!)
    {
      destroy_pixels(@pixels value.pixels, @count loaded_pixels);
      RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(
        @ptr value.pixels,
        @count value.pixel_count
      );
      input_file.close();
      fail(@message "could not read complete input pixels");
      RETURN FALSE;
    }
    VAR pixel U16 := pixel_bytes[0] AS U8 AS U16;
    pixel #||= pixel_bytes[1] AS U8 AS U16 #++ 8;
    PLACE AT(value.pixels[loaded_pixels]) U16 := pixel;
    loaded_pixels++;
  }
  IF (input_file.close() == FALSE)
  {
    destroy_pixels(@pixels value.pixels, @count value.pixel_count);
    RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(
      @ptr value.pixels,
      @count value.pixel_count
    );
    fail(@message "could not close input");
    RETURN FALSE;
  }
  RETURN TRUE;
}

::write_jvm_image INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Writes one QIMG16LE image through the Java file API.
  $>
  FUNCTION(
    @output_path CONST& std::string,
    @value CONST& image_data,
    @header MUT& [16]BYTE
  ): BOOL
{
  encode_u32(@bytes header[& 8], @value value.width AS ASSUME U32);
  encode_u32(@bytes header[& 12], @value value.height AS ASSUME U32);

  VAR output_file std::file := std::open_replace(
    @path output_path
  );
  VAR write_succeeded BOOL := write_complete(
    @file output_file,
    @buffer header[& 0],
    @count file_header_size
  );
  VAR pixel_bytes [2]BYTE;
  VAR pixel_buffer std::buffer_ref := std::buffer_ref(
    @data pixel_bytes[& 0],
    @size 2
  );
  VAR written_pixels SZ := 0;
  WHILE (written_pixels < value.pixel_count)
  {
    VAR output_pixel U16 := PUN value.pixels[written_pixels] AS U16;
    pixel_bytes[0] := output_pixel AS PARTIAL U8 AS BYTE;
    pixel_bytes[1] := output_pixel #-- 8 AS PARTIAL U8 AS BYTE;
    write_succeeded := write_complete(
      @file output_file,
      @buffer pixel_buffer.data,
      @count pixel_buffer.size
    );
    IF (write_succeeded!!)
    {
      BREAK;
    }
    written_pixels++;
  }
  VAR close_succeeded BOOL := output_file.close();

  IF (write_succeeded!!)
  {
    fail(@message "could not write complete output");
    RETURN FALSE;
  }
  IF (close_succeeded == FALSE)
  {
    fail(@message "could not close output");
    RETURN FALSE;
  }
  RETURN TRUE;
}

::run_jvm INCLUDE_IF(ARCH_IS_JVM) DOC <$
  Loads, blurs, and writes one QIMG16LE image through the Java file API.
  $>
  FUNCTION(
    @input_path CONST& std::string,
    @output_path CONST& std::string
  ): I32
{
  VAR value image_data;
  VAR header [16]BYTE;
  IF (load_jvm_image(
    @input_path input_path,
    @value value,
    @header header
  )!!)
  {
    RETURN 1;
  }

  blur(@value value);
  VAR write_succeeded BOOL := write_jvm_image(
    @output_path output_path,
    @value value,
    @header header
  );
  destroy_pixels(@pixels value.pixels, @count value.pixel_count);
  RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(
    @ptr value.pixels,
    @count value.pixel_count
  );
  IF (write_succeeded!!)
  {
    RETURN 1;
  }
  RETURN 0;
}

::main FUNCTION(): I32
{
  STATIC_IF(ARCH_IS_JVM)
  {
    IF (std::args::count() == 2)
    {
      VAR mode std::string := std::args::at(@index 1);
      IF (mode == "--report-stepping")
      {
        RETURN report_active_stepping();
      }
    }
    IF (std::args::count() != 3)
    {
      RUNTIME_MODULE::write(@fd 2, @msg "usage: integer_blur <input-file> <output-file>\n");
      RETURN 2;
    }
    VAR input_path std::string := std::args::at(@index 1);
    VAR output_path std::string := std::args::at(@index 2);
    RETURN run_jvm(@input_path input_path, @output_path output_path);
  }
  STATIC_ELSE
  {
  IF (std::args::count() == 2)
  {
    VAR mode_address ADDRESS := std::args::address_at(@index 1);
    VAR mode CONST=>>BYTE := ADDRESS_LAUNDER_DISCOVER_EXISTING mode_address TO CONST=>>BYTE;
    IF (argument_equals(@argument mode, @expected "--report-stepping"))
    {
      RETURN report_active_stepping();
    }
  }
  IF (std::args::count() != 3)
  {
    RUNTIME_MODULE::write(@fd 2, @msg "usage: integer_blur <input-file> <output-file>\n");
    RETURN 2;
  }

  VAR input_path_address ADDRESS := std::args::address_at(@index 1);
  VAR input_path CONST=>>BYTE := ADDRESS_LAUNDER_DISCOVER_EXISTING input_path_address TO CONST=>>BYTE;
  VAR output_path_address ADDRESS := std::args::address_at(@index 2);
  VAR output_path CONST=>>BYTE := ADDRESS_LAUNDER_DISCOVER_EXISTING output_path_address TO CONST=>>BYTE;

  VAR input_fd I32 := open_input_file(@path input_path);
  IF (input_fd < 0)
  {
    RETURN fail(@message "could not open input");
  }
  VAR input_file std::file := std::file(
    @native_ref std::file_ref(@descriptor input_fd)
  );

  VAR file_size SZ := seek_file_end(@fd input_fd);
  IF (file_size < file_header_size || file_size > maximum_file_size)
  {
    input_file.close();
    RETURN fail(@message "input size is outside the supported range");
  }
  VAR seek_result SZ := seek_file_start(@fd input_fd);
  IF (seek_result != 0)
  {
    input_file.close();
    RETURN fail(@message "could not seek input");
  }

  VAR file_address ADDRESS := map_file_storage(@size file_size);
  IF (file_address?? !!)
  {
    input_file.close();
    RETURN fail(@message "could not allocate file buffer");
  }
  VAR file_bytes =>>BYTE := BEGIN_MULTI_ALLOC_REGION
    file_address SIZE file_size TO =>>BYTE;
  IF (read_complete(@file input_file, @buffer file_bytes, @count file_size)!!)
  {
    input_file.close();
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "could not read complete input");
  }
  IF (input_file.close() == FALSE)
  {
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "could not close input");
  }
  IF (header_is_valid(@bytes file_bytes)!!)
  {
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "input has an invalid QIMG16LE header");
  }

  VAR value image_data;
  value.width := decode_u32(@bytes file_bytes + 8) AS ASSUME SZ;
  value.height := decode_u32(@bytes file_bytes + 12) AS ASSUME SZ;
  IF (value.width < 7 || value.height < 7 || value.width > 65536 || value.height > 65536)
  {
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "input dimensions are outside the supported range");
  }
  value.pixel_count := value.width * value.height;
  IF (file_size != file_header_size + value.pixel_count * 2)
  {
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "input size does not match its dimensions");
  }

  value.pixels := RUNTIME_MODULE::DEFAULT_ALLOCATOR::allocate_multiple#U16(@count value.pixel_count);
  FOR VALUE(index) FROM(0 AS SZ) UNTIL(value.pixel_count) LOOP
  {
    VAR byte_offset SZ := file_header_size + index * 2;
    VAR pixel U16 := file_bytes[byte_offset] AS U8 AS U16;
    pixel #||= file_bytes[byte_offset + 1] AS U8 AS U16 #++ 8;
    PLACE AT(value.pixels[index]) U16 := pixel;
  };

  blur(@value value);

  encode_u32(@bytes file_bytes + 8, @value value.width AS ASSUME U32);
  encode_u32(@bytes file_bytes + 12, @value value.height AS ASSUME U32);
  FOR VALUE(index) FROM(0 AS SZ) UNTIL(value.pixel_count) LOOP
  {
    VAR pixel U16 := PUN value.pixels[index] AS U16;
    VAR byte_offset SZ := file_header_size + index * 2;
    file_bytes[byte_offset] := pixel AS PARTIAL U8 AS BYTE;
    file_bytes[byte_offset + 1] := pixel #-- 8 AS PARTIAL U8 AS BYTE;
  };

  VAR output_fd I32 := open_output_file(@path output_path);
  IF (output_fd < 0)
  {
    destroy_pixels(@pixels value.pixels, @count value.pixel_count);
    RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(@ptr value.pixels, @count value.pixel_count);
    file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
    unmap_file_storage(@address file_address, @size file_size);
    RETURN fail(@message "could not open output");
  }
  VAR output_file std::file := std::file(
    @native_ref std::file_ref(@descriptor output_fd)
  );
  VAR write_succeeded BOOL := write_complete(@file output_file, @buffer file_bytes, @count file_size);
  VAR close_succeeded BOOL := output_file.close();

  destroy_pixels(@pixels value.pixels, @count value.pixel_count);
  RUNTIME_MODULE::DEFAULT_ALLOCATOR::dealloc_multiple#U16(@ptr value.pixels, @count value.pixel_count);
  file_address := END_MULTI_ALLOC_REGION file_bytes SIZE file_size;
  unmap_file_storage(@address file_address, @size file_size);

  IF (write_succeeded!!)
  {
    RETURN fail(@message "could not write complete output");
  }
  IF (close_succeeded == FALSE)
  {
    RETURN fail(@message "could not close output");
  }
  RETURN 0;
  }
}
