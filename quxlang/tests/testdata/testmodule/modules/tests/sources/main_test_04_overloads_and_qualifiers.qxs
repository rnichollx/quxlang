::buf FUNCTION(@ARG:a MUT& I32)
{
    VAR zz yak;
    zz.z := a<-;
}

::biz FUNCTION(%a I32, %b I32): I32
{
  VAR y I32;
  VAR q [3]I32;
  q[0] := 1;
  q[1] := 2;
  q[2] := 3;

  IF (y == 0)
  {
    VAR x yak;
    x.z := y<-;
    x.f := q[& 0];
    x.f_count := 3;
  }
  buf(a);
  RETURN a + b + y + q[0] + q[1] + q[2] + 1;
}


::mif FUNCTION(): I64
{
  VAR x [4]I64;
  x[0] := 1;
  x[1] := 2;
  x[2] := 3;
  x[3] := 4;


  RETURN x[0] + x[1] + x[2] + x[3];
}


// [4]->I32
// ->  [4]I32
// ->  [4]->I32
// =>> I32
// [4]I32

// *I32
// ^I32


::boq FUNCTION(): I32
{
  RETURN 5;
}

::boq FUNCTION(@ARG:a I32): I32
{
  RETURN a + 5;
}

::yip FUNCTION(@ARG:a AUTO(t1)) : t1
{
  RETURN a + 1;
}

::deduced_auto_return FUNCTION(@ARG:a AUTO(t1)) : AUTO
{
  RETURN a;
}

::deduced_const_ref_return FUNCTION(@ARG:a MUT& I32) : CONST& AUTO
{
  RETURN a;
}

::deduced_auto_ref_return FUNCTION(@ARG:a MUT& I32) : AUTO& AUTO
{
  RETURN a;
}

::deduced_void_return FUNCTION() : AUTO
{
}

::deduced_void_return_test STATIC_TEST
{
  deduced_void_return();
}

::forward_ref_value FUNCTION(@ARG:a AUTO& AUTO): I32
{
  RETURN FORWARD(a);
}

::decltype_parameter_return FUNCTION(@ARG:a AUTO& AUTO): DECLTYPE(a)
{
  RETURN FORWARD(a);
}

::typeof_side_effect_probe FUNCTION(@target WRITE& I32): I32
{
  target := 44;
  RETURN 7;
}

::fibbonachi FUNCTION(@n AUTO): AUTO
{
  IF (n <= 1)
  {
    RETURN n;
  }
  RETURN fibbonachi(@n n - 1) + fibbonachi(@n n - 2);
}

::self_recursive_auto_return_test DUAL_TEST
{
  ASSERT( fibbonachi(@n 0 AS I32) == 0 );
  ASSERT( fibbonachi(@n 1 AS I32) == 1 );
  ASSERT( fibbonachi(@n 5 AS I32) == 5 );
  ASSERT( fibbonachi(@n 10 AS I64) == 55 );
}



::yip FUNCTION(): I32
{
  VAR x I32;
  x := 7;
  RETURN yip(x);
}

::overload_resolution_test DUAL_TEST
{
  ASSERT( boq() == 5 );
  ASSERT( boq(10) == 15 );
  ASSERT( yip() == 8 );
  ASSERT( deduced_auto_return(11 AS I32) == 11 );

  VAR ref_source I32 := 12;
  VAR const_ref CONST& I32 := deduced_const_ref_return(ref_source);
  VAR mut_ref MUT& I32 := deduced_auto_ref_return(ref_source);

  ASSERT( const_ref == 12 );
  mut_ref := 13;
  ASSERT( ref_source == 13 );
}



::type_expression_fixed_integer_sizeof_test DUAL_TEST
{
  ASSERT(SIZEOF(I8) == 1);
  ASSERT(SIZEOF(U16) == 2);
  ASSERT(SIZEOF(I32) == 4);
  ASSERT(SIZEOF(U64) == 8);
  ASSERT(TYPE_IS_LAYOUTLESS(I8) == FALSE);
  ASSERT(TYPE_IS_LAYOUTLESS(U64) == FALSE);
  STATIC_IF(ARCH_IS_LAYOUTLESS)
  {
    ASSERT(TYPE_IS_LAYOUTLESS(U24));
    ASSERT(TYPE_IS_LAYOUTLESS(U128));
    ASSERT(TYPE_IS_LAYOUTLESS([3] I32));
  }
  STATIC_ELSE
  {
    ASSERT(TYPE_IS_LAYOUTLESS(U24) == FALSE);
    ASSERT(TYPE_IS_LAYOUTLESS(U128) == FALSE);
    ASSERT(TYPE_IS_LAYOUTLESS([3] I32) == FALSE);
  }
}


::type_index_identity_test DUAL_TEST
{
  VAR default_index TYPE_INDEX;
  ASSERT(default_index == TYPE_INDEX_OF(VOID));

  VAR i32_index TYPE_INDEX := TYPE_INDEX_OF(I32);
  VAR copied_index TYPE_INDEX := i32_index;
  ASSERT(copied_index == TYPE_INDEX_OF(I32));
  ASSERT(TYPE_INDEX_OF(I32) == TYPE_INDEX_OF(I32));
  ASSERT(TYPE_INDEX_OF(I32) != TYPE_INDEX_OF(I64));
  ASSERT(TYPE_INDEX_OF(I32) < TYPE_INDEX_OF(I64));
  ASSERT(TYPE_INDEX_OF(U32) < TYPE_INDEX_OF(I32));
  ASSERT(TYPE_INDEX_OF(I32) != TYPE_INDEX_OF(CONST& I32));
  ASSERT(TYPE_INDEX_OF(I32) != TYPE_INDEX_OF([1] I32));
  ASSERT(TYPE_INDEX_OF(TYPE_INDEX) != TYPE_INDEX_OF(I32));

  copied_index := TYPE_INDEX_OF(F64);
  ASSERT(copied_index == TYPE_INDEX_OF(F64));
}


::type_index_pointer_sized_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
{
  ASSERT(SIZEOF(TYPE_INDEX) == SIZEOF(ADDRESS));
  ASSERT(ALIGNOF(TYPE_INDEX) == ALIGNOF(ADDRESS));
}



::type_expression_bits_sizeof_test INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DUAL_TEST
{
  VAR x I32;
  x := 4;

  // ASSERT( SIZEOF(I32) == 4  );

  ASSERT( SIZEOF(I32)  == x );
  ASSERT( ALIGNOF(I32) == x );

  x := 1;

  ASSERT( ALIGNOF([3]BYTE) == 1 );

  x := 8;

  ASSERT( ALIGNOF(ALIGNED_STORAGE(24, 8)) == x );

  x := 32;

  ASSERT( BITS(I32) == x );


}



::pointer_qualifier_probe FUNCTION(@ARG:p MUT -> I32): I32
{
  RETURN 1;
}

::pointer_qualifier_probe FUNCTION(@ARG:p CONST -> I32): I32
{
  RETURN 2;
}

::procedure_pointer_probe FUNCTION(@ARG:p CONST -> PROCEDURE(I32, I32: I32)): I32
{
  RETURN 1;
}

::procedure_pointer_parse_probe FUNCTION(@ARG:p CONST -> PROCEDURE CCALL NOEXCEPT(I32, I32: I32)): I32
{
  RETURN 2;
}

::reference_qualifier_address_of_test DUAL_TEST
{
  VAR x I32 := 7;
  VAR cx CONST& I32 := x;

  ASSERT( pointer_qualifier_probe(x<-) == 1 );
  ASSERT( pointer_qualifier_probe(cx<-) == 2 );
}




::vfunc FUNCTION(@val & I32)
{
    val := val + 1;
}

::procedure_pointer_call_test DUAL_TEST
{
  VAR proc CONST -> PROCEDURE(I32, I32: I32) := foo<-;
  ASSERT( procedure_pointer_probe(proc) == 1 );
  ASSERT( proc(% [4, 5]) == 9 );

  proc := bar<-;
  ASSERT( proc(% [4, 5]) == 20 );
  proc := foo<-;

  VAR proc_ref CONST& PROCEDURE(I32, I32: I32) := proc->;
  ASSERT( proc_ref(% [6, 7]) == 13 );

  VAR mutproc CONST -> PROCEDURE(@val & I32) := vfunc<-;
  VAR x I32 := 10;
  mutproc(@val x);
  ASSERT(x == 11);
}



::functum_binding_call_helper FUNCTION(%f AUTO(fn), %x I32, %y I32): I32
{
  RETURN f(% [x, y]);
}

::functum_binding_forward_helper FUNCTION(@ARG:f AUTO(fn)): I32
{
  RETURN functum_binding_call_helper(% [f, 3, 4]);
}

::functum_binding_copy_helper FUNCTION(@ARG:f AUTO(fn)): I32
{
  VAR g AUTO := f;
  RETURN g(% [6, 7]);
}

::functum_binding_same_type_helper FUNCTION(%a AUTO(fn), %b AUTO(fn)): I32
{
  RETURN a(% [2, 3]) + b(% [4, 5]);
}

::functum_binding_counter STRUCT
{
  .value VAR I32;

  .CONSTRUCTOR FUNCTION()
  {
    .value := 0;
  }

  .add FUNCTION(@ARG:x I32): I32
  {
    .value := .value + x;
    RETURN .value;
  }
}

::bound_functum_binding_call_helper FUNCTION(@ARG:f AUTO(fn)): I32
{
  RETURN f(4) + f(5);
}

::bound_functum_binding_copy_helper FUNCTION(@ARG:f AUTO(fn)): I32
{
  VAR g AUTO := f;
  RETURN g(2) + f(3);
}

::functum_binding_holder TEMPLATE(@fn TYPE AUTO) STRUCT
{
  .fn VAR fn;

  .call FUNCTION(%x I32, %y I32): I32
  {
    RETURN .fn(% [x, y]);
  }
}

::whole_template_type_binding
  TEMPLATE(@arg TYPE MUT& AUTO)
  FUNCTION(): BOOL
{
  RETURN SAME_TYPES(arg, MUT& I32);
}

::nested_template_type_capture
  TEMPLATE(@arg TYPE MUT& AUTO(captured_type))
  FUNCTION(): BOOL
{
  RETURN SAME_TYPES(arg, MUT& I32) && SAME_TYPES(captured_type, I32);
}

::exact_reference_template_parameter
  TEMPLATE(@T TYPE)
  FUNCTION(): BOOL
{
  RETURN SAME_TYPES(T, MUT& I32);
}

::class_template_parameter
  TEMPLATE(@T CLASS)
  FUNCTION(): BOOL
{
  RETURN SAME_TYPES(T, I32);
}

::auto_class_template_parameter
  TEMPLATE(@T TYPE AUTO)
  FUNCTION(): BOOL
{
  RETURN SAME_TYPES(T, I32);
}

::function_auto_parameter_accepts_reference
  FUNCTION(@ARG:value AUTO(value_type)): BOOL
{
  RETURN SAME_TYPES(value_type, I32);
}

::whole_template_type_binding_test STATIC_TEST
{
  ASSERT(whole_template_type_binding#(@arg MUT& I32)());
  ASSERT(nested_template_type_capture#(@arg MUT& I32)());
}

::template_parameter_kinds_test STATIC_TEST
{
  ASSERT(exact_reference_template_parameter#(@T MUT& I32)());
  ASSERT(class_template_parameter#(@T I32)());
  ASSERT(auto_class_template_parameter#(@T I32)());

  VAR source I32 := 1;
  ASSERT(function_auto_parameter_accepts_reference(source));
}

::class_template_parameter_rejects_reference_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  ASSERT(class_template_parameter#(@T MUT& I32)());
}

::auto_class_template_parameter_rejects_reference_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  ASSERT(auto_class_template_parameter#(@T MUT& I32)());
}

::functum_binding_auto_argument_test DUAL_TEST
{
  ASSERT(functum_binding_call_helper(% [foo, 4, 5]) == 9);
  ASSERT(functum_binding_forward_helper(foo) == 7);
  ASSERT(functum_binding_copy_helper(foo) == 13);
  ASSERT(functum_binding_same_type_helper(% [foo, foo]) == 14);

  VAR holder functum_binding_holder#(@fn foo);
  ASSERT(holder.call(% [8, 9]) == 17);

  VAR holder_copy DECLTYPE(holder) := holder;
  ASSERT(holder_copy.call(% [10, 11]) == 21);
}



::bound_functum_binding_auto_argument_test DUAL_TEST
{
  VAR counter functum_binding_counter;
  ASSERT(bound_functum_binding_call_helper(counter.add) == 13);
  ASSERT(counter.value == 9);

  VAR counter2 functum_binding_counter;
  ASSERT(bound_functum_binding_copy_helper(counter2.add) == 7);
  ASSERT(counter2.value == 5);
}




::include_if_helper FUNCTION(@ARG:a AUTO(t1)) ENABLE_IF( BITS(t1) < 32 AS I32 ): I32
{
  RETURN 1;
}

::include_if_helper FUNCTION(@ARG:a AUTO(t1)) ENABLE_IF( BITS(t1) == 32 AS I64 ): I32
{
  RETURN 2;
}

::include_if_helper FUNCTION(@ARG:a AUTO(t1)) ENABLE_IF( BITS(t1) > 32 AS I32 ): I32
{
  RETURN 3;
}
::include_if_overload_resolution_test DUAL_TEST
{
    VAR x I32;

    x := include_if_helper( 0 AS I16 );
    ASSERT( x == 1 );

    x := include_if_helper( 0 AS I32 );
    ASSERT( x == 2 );

    x := include_if_helper( 0 AS I64 );
    ASSERT( x == 3 );
}



::forward_decltype_typeof_test DUAL_TEST
{
  VAR x I32 := 12;

  ASSERT(SAME_TYPES(DECLTYPE(x), I32));
  ASSERT(SAME_TYPES(TYPEOF(x), MUT& I32));
  ASSERT(SAME_TYPES(TYPEOF(typeof_side_effect_probe(@target x)), I32));
  ASSERT(x == 12);
  ASSERT(forward_ref_value(x) == 12);
  VAR y I32 := decltype_parameter_return(x);
  ASSERT(y == 12);
}



::forward_non_reference_value_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR x I32 := 12;
  VAR y I32 := FORWARD(x);
}

::pack_count FUNCTION(%a I32, %...b I32): I32
{
    RETURN PACK_SIZE(b) AS I32;
}

::pack_pick_second FUNCTION(%a I32, %...b I32): I32
{
    RETURN PACK_ARG(b, 1);
}

::pack_first FUNCTION(%...b AUTO): PACK_ARG_TYPE(b, 0)
{
    RETURN PACK_ARG(b, 0);
}

::pack_first_is_i32 FUNCTION(%...b AUTO): BOOL
{
    RETURN SAME_TYPES(PACK_ARG_TYPE(b, 0), I32);
}

::pack_arg_type_variable FUNCTION(%...b AUTO): I32
{
    VAR x PACK_ARG_TYPE(b, 0) := PACK_ARG(b, 0);
    RETURN x;
}

::pack_enable_if_helper FUNCTION(%...b AUTO) ENABLE_IF(SAME_TYPES(PACK_ARG_TYPE(b, 0), I32)): I32
{
    RETURN 1;
}

::pack_enable_if_helper FUNCTION(%...b AUTO) ENABLE_IF(SAME_TYPES(PACK_ARG_TYPE(b, 0), I64)): I32
{
    RETURN 2;
}

::pack_size_enable_if_helper FUNCTION(%...b I32) ENABLE_IF(PACK_SIZE(b) == 1 AS I32): I32
{
    RETURN 1;
}

::pack_size_enable_if_helper FUNCTION(%...b I32) ENABLE_IF(PACK_SIZE(b) == 2 AS I32): I32
{
    RETURN 2;
}

::pack_overload FUNCTION(%a I32): I32
{
    RETURN 1;
}

::pack_overload FUNCTION(%a I32, %...b I32): I32
{
    RETURN 2;
}

::pack_prefix FUNCTION(%a I32, %...b I32): I32
{
    RETURN 1;
}

::pack_prefix FUNCTION(%a I32, %b I32, %...c I32): I32
{
    RETURN 2;
}

::pack_hetero FUNCTION(%...b AUTO): BOOL
{
    RETURN SAME_TYPES(PACK_ARG_TYPE(b, 0), I32) && SAME_TYPES(PACK_ARG_TYPE(b, 1), I64);
}

::pack_same_type FUNCTION(%...b AUTO(t1)): I32
{
    RETURN PACK_SIZE(b) AS I32;
}

::pack_repeated_auto FUNCTION(%a AUTO(t1), %b AUTO(t1)): I32
{
    RETURN 1;
}

::pack_ambiguous_variadic FUNCTION(%...b AUTO(t1)): I32
{
    RETURN 1;
}

::pack_ambiguous_variadic FUNCTION(%...b AUTO(t2)): I32
{
    RETURN 2;
}

::pack_static_var_sum FUNCTION(%...b I32): I32
{
    VAR result I32 := 0;
    STATIC_VAR i U64 := 0;
    STATIC_WHILE (i < PACK_SIZE(b)) {
        result := result + PACK_ARG(b, i);
        STATIC_EVAL i++;
    }
    RETURN result;
}

::variadic_argument_pack_test DUAL_TEST
{
    ASSERT(pack_count(% [1]) == 0);
    ASSERT(pack_count(% [1, 2, 3]) == 2);
    ASSERT(pack_pick_second(% [1, 2, 7]) == 7);
    ASSERT(pack_first(% [4 AS I32, 5 AS I64]) == 4);
    ASSERT(pack_first_is_i32(% [4 AS I32, 5 AS I64]) == TRUE);
    ASSERT(pack_arg_type_variable(% [9 AS I32]) == 9);
    ASSERT(pack_enable_if_helper(% [0 AS I32]) == 1);
    ASSERT(pack_enable_if_helper(% [0 AS I64]) == 2);
    ASSERT(pack_size_enable_if_helper(% [1]) == 1);
    ASSERT(pack_size_enable_if_helper(% [1, 2]) == 2);
    ASSERT(pack_overload(% [1]) == 1);
    ASSERT(pack_overload(% [1, 2]) == 2);
    ASSERT(pack_prefix(% [1, 2]) == 2);
    ASSERT(pack_hetero(% [1 AS I32, 2 AS I64]) == TRUE);
    ASSERT(pack_same_type(% [1 AS I32, 2 AS I32]) == 2);
    ASSERT(pack_repeated_auto(% [1 AS I32, 2 AS I32]) == 1);
    ASSERT(pack_static_var_sum() == 0);
    ASSERT(pack_static_var_sum(% [4]) == 4);
    ASSERT(pack_static_var_sum(% [1, 2, 3]) == 6);
}



::pack_same_type_mismatch_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR x I32 := pack_same_type(% [1 AS I32, 2 AS I64]);
}

::pack_repeated_auto_mismatch_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR x I32 := pack_repeated_auto(% [1 AS I32, 2 AS I64]);
}

::pack_ambiguous_variadic_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR x I32 := pack_ambiguous_variadic(% [1 AS I32]);
}

