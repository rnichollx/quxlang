::constexpr_alloc_use_after_free_pointer_ops_test STATIC_TEST EXPECT_FAIL
{
  VAR count SZ := 2;
  VAR slots =>> TYPED_STORAGE(BYTE) := CONSTEXPR_ALLOC_MULTIPLE#BYTE(% [count]);
  VAR freed_slots =>> TYPED_STORAGE(BYTE) := slots;
