LANGUAGE QUXLANG EN 0.0;

::arrytest_cls STRUCT
{
  .val VAR I32;

  .CONSTRUCTOR FUNCTION()
  {
     .val := 5;
  }

}

::array_default_constructor_test DUAL_TEST

{
    VAR x [3]arrytest_cls;

    ASSERT( x[0].val == 5 );
    ASSERT( x[1].val == 5 );
    ASSERT( x[2].val == 5 );
}



::array_positional_element_cls STRUCT
{
  .val VAR I32;

  .CONSTRUCTOR FUNCTION(@OTHER I32)
  {
     .val := OTHER;
  }
}

::array_positional_constructor_test DUAL_TEST
{
    VAR x [3]I32 :[1, 2, 3];

    ASSERT( x[0] == 1 );
    ASSERT( x[1] == 2 );
    ASSERT( x[2] == 3 );

    VAR y [2]array_positional_element_cls :[4, 7];
    ASSERT( y[0].val == 4 );
    ASSERT( y[1].val == 7 );
}



::array_zero_length_positional_default_test DUAL_TEST
{
    VAR x [0]I32 :[];
    ASSERT(x.BEGIN() == x.END());
}

::user_positional_constructor_value STRUCT
{
  .first VAR I32;
  .second VAR I32;

  .CONSTRUCTOR FUNCTION(%first I32, %second I32)
  {
    .first := first;
    .second := second;
  }
}

::user_positional_constructor_test DUAL_TEST
{
  VAR value user_positional_constructor_value :[4, 7];
  ASSERT(value.first == 4);
  ASSERT(value.second == 7);
}

::user_positional_constructor_place_test DUAL_TEST
{
  VAR slot TYPED_STORAGE(user_positional_constructor_value);
  VAR value ->user_positional_constructor_value :=
    PLACE AT(slot) user_positional_constructor_value:[5, 9];
  ASSERT((value->).first == 5);
  ASSERT((value->).second == 9);
  DESTROY AT(slot) user_positional_constructor_value;
}

::positional_delegate_member STRUCT
{
  .value VAR I32;

  .CONSTRUCTOR FUNCTION(%value I32)
  {
    .value := value;
  }
}

::positional_delegate_owner STRUCT
{
  .member VAR positional_delegate_member;

  .CONSTRUCTOR FUNCTION(%value I32) :> .member:[value]
  {
  }
}

::user_positional_constructor_delegate_test DUAL_TEST
{
  VAR value positional_delegate_owner :[11];
  ASSERT(value.member.value == 11);
}

::positional_constructor_rejects_unsupported_builtin_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  VAR value I32 :[1];
}



::array_positional_too_many_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR x [2]I32 :[1, 2, 3];
}

::array_positional_too_few_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
    VAR x [3]I32 :[1, 2];
}

::array_lifecycle_test DUAL_TEST
{
   VAR original [3]I32 :[2, 4, 6];
   VAR copied [3]I32 := original;
   ASSERT(copied == original);

   copied[1] := 9;
   ASSERT(copied != original);
   ASSERT(original[1] == 4);

   VAR assigned [3]I32;
   assigned := copied;
   ASSERT(assigned == copied);

   original <-> assigned;
   ASSERT(original[1] == 9);
   ASSERT(assigned[1] == 4);
}

::array_move_probe FUNCTION(@source TEMP& [3]I32): BOOL
{
   VAR moved [3]I32 := FORWARD(source);
   RETURN moved[0] == 10 && moved[1] == 20 && moved[2] == 30;
}

::array_move_test DUAL_TEST
{
   ASSERT(array_move_probe(@source [3]I32(% [10, 20, 30])));
}

::array_iteration_test DUAL_TEST
{
   VAR values [4]I32 :[1, 2, 3, 4];
   VAR sum I32 := 0;
   FOR ITEM(item) IN(values) LOOP {
      sum := sum + item;
      item++;
   };
   ASSERT(sum == 10);
   ASSERT(values[0] == 2);
   ASSERT(values[3] == 5);

   VAR projected_sum I32 := 0;
   FOR VALUE(value) IN(values) LOOP {
      projected_sum := projected_sum + value;
   };
   ASSERT(projected_sum == 14);
   ASSERT(values.BEGIN() + (4 AS SZ) == values.END());
}

::array_destructor_element STRUCT
{
   .counter VAR ->I32;

   .DESTRUCTOR FUNCTION()
   {
      IF (.counter??) {
         .counter-> := .counter-> + 1;
      }
   }
}

::destroy_array_elements FUNCTION(@counter MUT& I32)
{
   VAR values [3]array_destructor_element;
   values[0].counter := counter<-;
   values[1].counter := counter<-;
   values[2].counter := counter<-;
}

::array_element_destructor_test DUAL_TEST
{
   VAR counter I32 := 0;
   destroy_array_elements(@counter counter);
   ASSERT(counter == 3);
}


::runtime_statement_branching_test STATIC_TEST
{

   VAR x I32;

   RUNTIME CONSTEXPR {
      x := 10;
   } ELSE {
      x := 20;
   }
   ASSERT( x == 10 );

   RUNTIME NATIVE {
      x := 30;
   } ELSE {
      x := 40;
   }

   ASSERT( x == 40 );

   UNLESS (FALSE) {
      x := 50;
   } ELSE {
      x := 60;
   }

   ASSERT( x == 50 );

   UNLESS (TRUE) {
      x := 70;
   } ELSE UNLESS (FALSE) {
      x := 80;
   } ELSE {
      x := 90;
   }

   ASSERT( x == 80 );

   UNLESS (TRUE) {
      x := 90;
   }

   ASSERT( x == 80 );

   UNLESS (FALSE) {
      x := 100;
   }

   ASSERT( x == 100 );

   IF (FALSE) {
      x := 110;
   } ELSE UNLESS (FALSE) {
      x := 120;
   } ELSE {
      x := 130;
   }

   ASSERT( x == 120 );

   UNLESS (TRUE) {
      x := 140;
   } ELSE IF (TRUE) {
      x := 150;
   } ELSE {
      x := 160;
   }

   ASSERT( x == 150 );

}

::runtime_statement_branching_test_unit_test UNIT_TEST
{

   VAR x I32;

   RUNTIME CONSTEXPR {
      x := 10;
   } ELSE {
      x := 20;
   }
   ASSERT( x == 20 );

   RUNTIME NATIVE {
      x := 30;
   } ELSE {
      x := 40;
   }

   ASSERT( x == 30 );

   UNLESS (FALSE) {
      x := 50;
   } ELSE {
      x := 60;
   }

   ASSERT( x == 50 );

   UNLESS (TRUE) {
      x := 70;
   } ELSE UNLESS (FALSE) {
      x := 80;
   } ELSE {
      x := 90;
   }

   ASSERT( x == 80 );

   UNLESS (TRUE) {
      x := 90;
   }

   ASSERT( x == 80 );

   UNLESS (FALSE) {
      x := 100;
   }

   ASSERT( x == 100 );

   IF (FALSE) {
      x := 110;
   } ELSE UNLESS (FALSE) {
      x := 120;
   } ELSE {
      x := 130;
   }

   ASSERT( x == 120 );

   UNLESS (TRUE) {
      x := 140;
   } ELSE IF (TRUE) {
      x := 150;
   } ELSE {
      x := 160;
   }

   ASSERT( x == 150 );

}




::foo FUNCTION(%a I32, %b I32): I32
{
  RETURN a + b;
}

::foo_error FUNCTION(%a I32, %b I32): I32
{
  RETURN a + b; // + not_defined(@z 1);
}

::bar FUNCTION(%a I32, %b I32): I32
{
  RETURN a * b;
}

::option_num OPTION NUMBER DEFAULT(42);

::option_test DUAL_TEST
{
  ASSERT(option_num == 5);
}




::buz STRUCT
{
  .x VAR I32;

  .CONSTRUCTOR FUNCTION()
  {
     .x := 9;
  }

  .DESTRUCTOR FUNCTION()
  {

  }

  .foo FUNCTION()
  {
    .x := .x + 1;
  }
}

::storage_buz_helper FUNCTION(): I32
{
  VAR slot TYPED_STORAGE(buz);
  VAR p ->buz := PLACE AT(slot) buz;
  ASSERT(p??);
  ASSERT(buz_x(PUN slot AS buz) == 9);
  buz_inc(PUN slot AS buz);
  ASSERT(buz_x(PUN slot AS buz) == 10);
  DESTROY AT(slot) buz;

  VAR slot2 TYPED_STORAGE(I32);
  VAR iptr ->I32 := PLACE AT(slot2) I32 := 9;
  ASSERT(iptr??);
  ASSERT((PUN slot2 AS I32) == 9);
  DESTROY AT(slot2) I32;
  RETURN 10;
}

::storage_buz_lifetime_test DUAL_TEST
{
  ASSERT(storage_buz_helper() == 10);
}



::constexpr_alloc_i32_helper FUNCTION(): I32
{
  VAR slot_ptr -> TYPED_STORAGE(I32) := CONSTEXPR_ALLOC#I32();
  VAR placed_ptr ->I32 := PLACE AT(slot_ptr->) I32 := 123;
  ASSERT(placed_ptr??);
  ASSERT((PUN (slot_ptr->) AS I32) == 123);
  DESTROY AT(slot_ptr->) I32;
  CONSTEXPR_DEALLOC#I32(% [slot_ptr]);
  RETURN 123;
}

::constexpr_alloc_i32_test STATIC_TEST
{
  ASSERT(constexpr_alloc_i32_helper() == 123);
}

::constexpr_alloc_buz_helper FUNCTION(): I32
{
  VAR slot_ptr -> TYPED_STORAGE(buz) := CONSTEXPR_ALLOC#buz();
  VAR placed_ptr ->buz := PLACE AT(slot_ptr->) buz;
  ASSERT(placed_ptr??);
  ASSERT(buz_x(PUN (slot_ptr->) AS buz) == 9);
  DESTROY AT(slot_ptr->) buz;
  CONSTEXPR_DEALLOC#buz(% [slot_ptr]);
  RETURN 9;
}

::constexpr_alloc_buz_test STATIC_TEST
{
  ASSERT(constexpr_alloc_buz_helper() == 9);
}

::constexpr_multialloc_helper FUNCTION(): I32
{
  VAR count SZ := 3;
  VAR slots =>> TYPED_STORAGE(BYTE) := CONSTEXPR_ALLOC_MULTIPLE#BYTE(% [count]);
  VAR first ->BYTE := PLACE AT(slots->) BYTE := 7;
  VAR second ->BYTE := PLACE AT((slots + 1)->) BYTE := 9;
  VAR third ->BYTE := PLACE AT((slots + 2)->) BYTE := 11;
  ASSERT(first??);
  ASSERT(second??);
  ASSERT(third??);
  ASSERT((PUN (slots->) AS BYTE) == 7);
  ASSERT((PUN slots[1] AS BYTE) == 9);
  ASSERT((PUN ((slots + 2)->) AS BYTE) == 11);
  ASSERT((slots[&1] - slots) == 1);
  DESTROY AT((slots + 2)->) BYTE;
  DESTROY AT(slots[1]) BYTE;
  DESTROY AT(slots->) BYTE;
  CONSTEXPR_DEALLOC_MULTIPLE#BYTE(% [slots, count]);
  RETURN 27;
}

::constexpr_multialloc_test STATIC_TEST
{
  ASSERT(constexpr_multialloc_helper() == 27);
}

::constexpr_multialloc_zero_count_test STATIC_TEST
{
  VAR count SZ := 0;
  VAR slots =>> TYPED_STORAGE(BYTE) := CONSTEXPR_ALLOC_MULTIPLE#BYTE(% [count]);
  CONSTEXPR_DEALLOC_MULTIPLE#BYTE(% [slots, count]);
}

::byte_storage_buffer STRUCT
{
  .data VAR =>> TYPED_STORAGE(BYTE);
  .count VAR SZ;
}

::constexpr_multialloc_container_test STATIC_TEST
{
  VAR buffer byte_storage_buffer;
  buffer.count := 2;
  buffer.data := CONSTEXPR_ALLOC_MULTIPLE#BYTE(% [buffer.count]);
  PLACE AT(buffer.data->) BYTE := 4;
  PLACE AT((buffer.data + 1)->) BYTE := 8;
  ASSERT((PUN (buffer.data->) AS BYTE) == 4);
  ASSERT((PUN ((buffer.data + 1)->) AS BYTE) == 8);
  DESTROY AT((buffer.data + 1)->) BYTE;
  DESTROY AT(buffer.data->) BYTE;
  CONSTEXPR_DEALLOC_MULTIPLE#BYTE(% [buffer.data, buffer.count]);
}

