LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::string_tests DUAL_TEST
{
  VAR str1 std::string := "Hello, ";
  VAR str2 std::string := "world!";
  VAR str3 std::string := str1 + str2;

  ASSERT(str3 == "Hello, world!");

  ASSERT(str3 == static_string);

  VAR str4 std::string := str3;
  ASSERT(str4 == str3);

  VAR str5 std::string;
  str5 := str1;
  ASSERT(str5 == "Hello, ");
}

::get_static_string FUNCTION(): std::string
{
  RETURN ("Hello, " AS std::string) + ("world!" AS std::string);
}

::static_string_object STATIC std::string := get_static_string();
::static_string STATIC STRING_CONSTANT := static_string_object;
