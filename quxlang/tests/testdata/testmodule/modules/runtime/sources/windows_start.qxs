LANGUAGE QUXLANG EN 0.0;

::PROGRAM_START INCLUDE_IF(OS_WINDOWS) ASM_PROCEDURE X64
{
  SUB RSP, 40
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV R10, RAX
  MOVABS RAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [RAX], R10
  MOVABS RAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV RAX, [RAX + R10 * 8]
  CALL RAX
  MOV RAX, 127
  ADD RSP, 40
  RET
}
