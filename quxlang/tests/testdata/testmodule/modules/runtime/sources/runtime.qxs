LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

::windows_get_std_handle INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"GetStdHandle"]
  CALLABLE CALLCONV CCALL(@kind I32; RETURN ADDRESS);

::windows_write_file INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"WriteFile"]
  CALLABLE CALLCONV CCALL(@handle ADDRESS, @buffer CONST=>>BYTE, @count SZ, @written MUT->U32, @overlapped =>>BYTE; RETURN BOOL);

::windows_exit_process INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"ExitProcess"]
  CALLABLE CALLCONV CCALL(@code I32);

::stdout STATIC I32 := 1;

::print_selected_stepping OPTION BOOL DEFAULT_VALUE(FALSE);

::write_bytes FUNCTION(@fd I32, @begin CONST =>> BYTE, @end CONST =>> BYTE)
{
  STATIC_IF(OS_LINUX)
  {
    syscall::linux::write(@fd fd, @buffer begin, @count end - begin AS ASSUME SZ);
  }
  STATIC_IF(OS_WINDOWS)
  {
    VAR handle ADDRESS := windows_get_std_handle(@kind 0 - 11);
    VAR written U32 := 0;
    VAR overlapped =>>BYTE;
    windows_write_file(
      @handle handle,
      @buffer begin,
      @count end - begin AS ASSUME SZ,
      @written written<-,
      @overlapped overlapped
    );
  }
}

::write FUNCTION(@fd I32, @msg STRING_CONSTANT)
{
  write_bytes(@fd fd, @begin msg.BEGIN(), @end msg.END());
}

::write_decimal FUNCTION(@fd I32, @value SZ)
{
  VAR digits [20]BYTE;
  VAR remaining SZ := value;
  VAR digit_count SZ := 0;

  IF (remaining == 0)
  {
    digits[19] := 48;
    write_bytes(@fd fd, @begin digits[& 19], @end digits[& 20]);
    RETURN;
  }

  WHILE (remaining != 0)
  {
    digit_count++;
    VAR digit BYTE := (((remaining % 10) + 48) AS PARTIAL U8) AS BYTE;
    digits[20 - digit_count] := digit;
    remaining := remaining / 10;
  }

  write_bytes(@fd fd, @begin digits[& (20 - digit_count)], @end digits[& 20]);
}

::exit FUNCTION(@code I32)
{
  STATIC_IF(OS_LINUX)
  {
    syscall::linux::exit(@code code);
  }
  STATIC_IF(OS_WINDOWS)
  {
    windows_exit_process(@code code);
  }
}

::ASSERT_FAIL FUNCTION(@expr STRING_CONSTANT, @file SZ, @line SZ, @column SZ, @tag CONST -> STRING_CONSTANT)
{
  IF (active_test.BEGIN()??)
  {
     write(@fd stdout, @msg "FAILED: ");
     write(@fd stdout, @msg active_test);
     write(@fd stdout, @msg "\n");
  }
  write(@msg "Assert failed: ", @fd stdout);
  write(@fd stdout, @msg expr);
  write(@msg "\n", @fd stdout);
  exit(@code 1);
}

::PANIC FUNCTION(@message STRING_CONSTANT, @file SZ, @line SZ, @column SZ)
{
  write(@fd stdout, @msg "Panic: ");
  write(@fd stdout, @msg message);
  write(@fd stdout, @msg "\n");
  exit(@code 1);
}

::INITGUARD_TRY_ACQUIRE FUNCTION(@guard MUT& INITGUARD): BOOL
{
  WHILE (TRUE)
  {
    VAR state UINTPTR := guard.LOAD#ATOMIC_ACQUIRE();
    IF (state == 2)
    {
      RETURN FALSE;
    }
    IF (state == 0)
    {
      VAR expected UINTPTR := 0;
      IF (guard.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_ACQUIRE)(expected, 1))
      {
        RETURN TRUE;
      }
    }
    ELSE IF (state != 1)
    {
      ASSERT(FALSE, "Invalid initguard state");
    }
  }
}

::INITGUARD_COMPLETE FUNCTION(@guard MUT& INITGUARD)
{
  guard.STORE#ATOMIC_RELEASE(2);
}

::INITGUARD_ABORT FUNCTION(@guard MUT& INITGUARD)
{
  guard.STORE#ATOMIC_RELEASE(0);
}

::x64_cpuid_has_sse2 INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  BT EDX, 26
  SETC AL
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_cpuid_has_avx_os_support INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  MOV EAX, 1
  CPUID
  MOV EAX, ECX
  AND EAX, 0x18000000
  CMP EAX, 0x18000000
  SETE AL
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_xcr0_has_avx_state INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  XOR ECX, ECX
  XGETBV
  AND EAX, 0x6
  CMP EAX, 0x6
  SETE AL
  MOVZX EAX, AL
  RET
}

::x64_cpuid_has_avx2 INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 7
  SETAE R8B
  MOV EAX, 7
  XOR ECX, ECX
  CPUID
  BT EBX, 5
  SETC AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::x64_xcr0_has_avx512_state INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  XOR ECX, ECX
  XGETBV
  AND EAX, 0xe6
  CMP EAX, 0xe6
  SETE AL
  MOVZX EAX, AL
  RET
}

::x64_cpuid_has_avx512f INCLUDE_IF(ARCH_IS_X64) ASM_PROCEDURE X64
  CALLABLE CALLCONV CCALL(; RETURN BOOL)
{
  PUSH RBX
  XOR EAX, EAX
  CPUID
  CMP EAX, 7
  SETAE R8B
  MOV EAX, 7
  XOR ECX, ECX
  CPUID
  BT EBX, 16
  SETC AL
  AND AL, R8B
  MOVZX EAX, AL
  POP RBX
  RET
}

::DETECT_X64_FEATURE_SSE2 INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  X64_FEATURE_SSE2_ENABLED := x64_cpuid_has_sse2();
}

::DETECT_X64_FEATURE_AVX INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  VAR has_os_support BOOL := x64_cpuid_has_avx_os_support();
  IF (has_os_support)
  {
    X64_FEATURE_AVX_ENABLED := x64_xcr0_has_avx_state();
  }
}

::DETECT_X64_FEATURE_AVX2 INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  VAR has_os_support BOOL := x64_cpuid_has_avx_os_support();
  IF (has_os_support)
  {
    VAR has_avx_state BOOL := x64_xcr0_has_avx_state();
    IF (has_avx_state)
    {
      X64_FEATURE_AVX2_ENABLED := x64_cpuid_has_avx2();
    }
  }
}

::DETECT_X64_FEATURE_AVX512F INCLUDE_IF(ARCH_IS_X64) FUNCTION()
{
  VAR has_os_support BOOL := x64_cpuid_has_avx_os_support();
  IF (has_os_support)
  {
    VAR has_avx512_state BOOL := x64_xcr0_has_avx512_state();
    IF (has_avx512_state)
    {
      X64_FEATURE_AVX512F_ENABLED := x64_cpuid_has_avx512f();
    }
  }
}

::POST_DETECT FUNCTION()
{
  STATIC_IF(print_selected_stepping)
  {
    write(@fd stdout, @msg "selected stepping: ");
    write_decimal(@fd stdout, @value ACTIVE_STEPPING);
    write(@fd stdout, @msg "\n");
  }
  VAR stepping SZ := ACTIVE_STEPPING;
  VAR code I32 := MAIN_FUNCTION_ARRAY[stepping]();
  exit(@code code);
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE X64
{
  MOV RDI, RSP
  MOVABS RAX, OFFSET PROCEDURE_REF("", linux_parse_initial_stack#[0])
  CALL RAX
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV R10, RAX
  MOVABS RAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [RAX], R10
  MOVABS RAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV RAX, [RAX + R10 * 8]
  CALL RAX
  MOV RDI, 127
  MOV RAX, 60
  SYSCALL
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE X86
{
  MOV ECX, ESP
  PUSH ECX
  MOV EAX, OFFSET PROCEDURE_REF("", linux_parse_initial_stack#[0])
  CALL EAX
  ADD ESP, 4
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV ECX, EAX
  MOV EAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [EAX], ECX
  MOV EAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV EAX, [EAX + ECX * 4]
  CALL EAX
  MOV EBX, 127
  MOV EAX, 1
  INT 0x80
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE ARM64
{
  MOV X0, SP
  LDR X16, PROCEDURE_REF("", linux_parse_initial_stack#[0])
  BLR X16
  BL DETECT_CPU_ARCHINFO
  BL PICK_STEPPING
  MOV X19, X0
  ADRP X16, :got:OBJECT_REF(ACTIVE_STEPPING)
  LDR X16, [X16, :got_lo12:OBJECT_REF(ACTIVE_STEPPING)]
  STR X19, [X16]
  ADRP X16, :got:OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LDR X16, [X16, :got_lo12:OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)]
  LDR X16, [X16, X19, LSL 3]
  BLR X16
  MOV X0, 127
  MOV X8, 93
  SVC 0
}

::active_test VAR STRING_CONSTANT;

::UNIT_TEST_MAIN FUNCTION(): I32
{
  VAR i SZ := 0;
  VAR proc_offset SZ := ACTIVE_STEPPING * UNIT_TEST_COUNT;
  WHILE (i < UNIT_TEST_COUNT)
  {
    active_test := UNIT_TEST_NAMES[i];
    write(@fd stdout, @msg "Testing: ");
    write(@fd stdout, @msg active_test);
    write(@fd stdout, @msg "\n");
    UNIT_TEST_PROC[proc_offset + i]();
    write(@fd stdout, @msg "PASSED: ");
    write(@fd stdout, @msg UNIT_TEST_NAMES[i]);
    write(@fd stdout, @msg "\n");
    i++;
  }
  write(@fd stdout, @msg "All ");
  write_decimal(@fd stdout, @value UNIT_TEST_COUNT);
  write(@fd stdout, @msg " unit tests passed\n");
  RETURN 0;
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE Z_ARCH
{
  BRASL %r14, DETECT_CPU_ARCHINFO
  BRASL %r14, PICK_STEPPING
  LARL %r1, OBJECT_REF(ACTIVE_STEPPING)
  STG %r2, 0(%r1)
  LARL %r1, OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MGHI %r2, 8
  AGR %r2, %r1
  LG %r1, 0(%r2)
  BASR %r14, %r1
  LGHI %r2, 127
  LGHI %r1, 1
  SVC 0
}

::PROGRAM_START INCLUDE_IF(OS_WINDOWS) ASM_PROCEDURE X64
{
  SUB RSP, 40
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV R10, RAX
  MOVABS RAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [RAX], R10
  MOVABS RAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV RAX, [RAX + R10 * 8]
  CALL RAX
  MOV RAX, 127
  ADD RSP, 40
  RET
}
