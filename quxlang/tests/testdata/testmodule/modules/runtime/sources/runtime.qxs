LANGUAGE QUXLANG EN 0.0;

::stdout STATIC I32 := 1;

::print_selected_stepping OPTION BOOL DEFAULT_VALUE(FALSE);

::POST_DETECT FUNCTION()
{
  STATIC_IF(print_selected_stepping)
  {
    write(@fd stdout, @msg "selected stepping: ");
    write_decimal(@fd stdout, @value ACTIVE_STEPPING);
    write(@fd stdout, @msg "\n");
  }
  VAR stepping SZ := ACTIVE_STEPPING;
  VAR code I32 := MAIN_FUNCTION_ARRAY[stepping]();
  exit(@code code);
}
