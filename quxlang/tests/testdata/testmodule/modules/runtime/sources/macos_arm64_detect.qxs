LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

::macos_arm64_capabilities VAR [16]BYTE;
::macos_arm64_capabilities_size VAR SZ;
::macos_arm64_capabilities_loaded VAR BOOL;
::macos_arm64_capabilities_available VAR BOOL;

::macos_arm64_has_capability INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) DOC <$
  Returns whether hw.optional.arm.caps contains one public Apple capability bit.
  $>
  FUNCTION(@bit SZ): BOOL
{
  IF (macos_arm64_capabilities_loaded == FALSE)
  {
    VAR sysctl_name [21]BYTE;
    // hw.optional.arm.caps\0
    sysctl_name[0] := 104; sysctl_name[1] := 119; sysctl_name[2] := 46;
    sysctl_name[3] := 111; sysctl_name[4] := 112; sysctl_name[5] := 116;
    sysctl_name[6] := 105; sysctl_name[7] := 111; sysctl_name[8] := 110;
    sysctl_name[9] := 97; sysctl_name[10] := 108; sysctl_name[11] := 46;
    sysctl_name[12] := 97; sysctl_name[13] := 114; sysctl_name[14] := 109;
    sysctl_name[15] := 46; sysctl_name[16] := 99; sysctl_name[17] := 97;
    sysctl_name[18] := 112; sysctl_name[19] := 115; sysctl_name[20] := 0;

    macos_arm64_capabilities_size := 16;
    VAR capabilities_address ADDRESS := ADDRESS_LAUNDER_FROM macos_arm64_capabilities[& 0];
    VAR null_pointer =>>VOID;
    VAR null_address ADDRESS := ADDRESS_LAUNDER_FROM null_pointer;
    VAR status I32 := syscall::macos::sysctlbyname(
      @name sysctl_name[& 0],
      @old_value capabilities_address,
      @old_size macos_arm64_capabilities_size<-,
      @new_value null_address,
      @new_size 0
    );
    macos_arm64_capabilities_available := status == 0;
    macos_arm64_capabilities_loaded := TRUE;
  }

  IF (macos_arm64_capabilities_available == FALSE || bit >= macos_arm64_capabilities_size * 8)
  {
    RETURN FALSE;
  }

  VAR masks [8]U8;
  masks[0] := 1; masks[1] := 2; masks[2] := 4; masks[3] := 8;
  masks[4] := 16; masks[5] := 32; masks[6] := 64; masks[7] := 128;
  VAR byte_index SZ := bit / 8;
  VAR bit_index SZ := bit % 8;
  RETURN (((macos_arm64_capabilities[byte_index] AS U8) #&& masks[bit_index]) != 0);
}

::DETECT_ARM64_FEATURE_ADVANCED_SIMD INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) FUNCTION()
{
  ARM64_FEATURE_ADVANCED_SIMD_ENABLED := macos_arm64_has_capability(@bit 49);
}

::DETECT_ARM64_FEATURE_AES INCLUDE_IF(OS_MACOS && ARCH_IS_ARM64) FUNCTION()
{
  ARM64_FEATURE_AES_ENABLED :=
    macos_arm64_has_capability(@bit 10) && macos_arm64_has_capability(@bit 11);
}

