LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;
IMPORT posix;

PRIVATE(MODULE) ::virtual_alloc INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"VirtualAlloc"]
  CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @allocation_type U32, @protect U32; RETURN ADDRESS);

PRIVATE(MODULE) ::virtual_free INCLUDE_IF(OS_WINDOWS) EXTERN_PROCEDURE["kernel32":"VirtualFree"]
  CALLABLE CALLCONV CCALL(@address ADDRESS, @size SZ, @free_type U32; RETURN BOOL);

::memory_bucket_size DOC <$
  Returns the historical public bucket size used by runtime clients that need
  the 8, 16, 24, 32, 48, ... progression.
  $>
  FUNCTION(@size SZ): SZ
{
  VAR bucket SZ := 8;
  VAR step SZ := 8;
  VAR maximum_size SZ := (0 AS SZ) #!!;

  FOR TEST(bucket < size) LOOP
  {
    IF (bucket > maximum_size - step)
    {
      PANIC "Memory bucket size overflow.";
    }
    bucket += step;
    IF (bucket / step == 4)
    {
      IF (step > maximum_size / 2)
      {
        PANIC "Memory bucket step overflow.";
      }
      step *= 2;
    }
  };

  RETURN bucket;
}

PRIVATE(MODULE) ::memory_region_size DOC <$
  Rounds an OS mapping request up to a nonzero whole number of 4096-byte pages.
  $>
  FUNCTION(@size SZ): SZ
{
  IF (size <= 4096)
  {
    RETURN 4096;
  }

  VAR remainder SZ := size % 4096;
  IF (remainder == 0)
  {
    RETURN size;
  }

  VAR padding SZ := 4096 - remainder;
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size - padding)
  {
    PANIC "OS mapping size overflow.";
  }
  RETURN size + padding;
}

PRIVATE(MODULE) ::mutex DOC <$
  A process-private mutex used to serialize allocator cache roots.
  $>
  STRUCT
{
  .state VAR ATOMIC#I32;

  .lock DOC <$ Acquires the mutex, blocking or yielding while another thread owns it. $>
    FUNCTION()
  {
    VAR expected I32 := 0;
    IF (.state.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_ACQUIRE)(% [expected, 1]))
    {
      RETURN;
    }

    FOR TEST(TRUE) LOOP
    {
      VAR expected_uncontended I32 := 1;
      .state.COMPARE_EXCHANGE#(
        @SUCCESS ATOMIC_ACQREL,
        @FAILURE ATOMIC_ACQUIRE
      )(% [expected_uncontended, 2]);

      VAR observed I32 := .state.LOAD#ATOMIC_ACQUIRE();
      IF (observed == 0)
      {
        VAR expected_unlocked I32 := 0;
        IF (.state.COMPARE_EXCHANGE#(
          @SUCCESS ATOMIC_ACQREL,
          @FAILURE ATOMIC_ACQUIRE
        )(% [expected_unlocked, 2]))
        {
          RETURN;
        }
      }
      ELSE IF (observed == 2)
      {
        STATIC_IF(OS_LINUX)
        {
          syscall::linux::futex_wait(@address .state<-, @expected 2);
        }
        STATIC_ELSE STATIC_IF(OS_WINDOWS)
        {
          VAR compared I32 := 2;
          syscall::windows::wait_on_address(
            @address .state<-,
            @compare_address compared<-,
            @address_size SIZEOF(I32),
            @milliseconds 4294967295
          );
        }
        STATIC_ELSE STATIC_IF(OS_MACOS)
        {
          posix::sched_yield();
        }
      }
    };
  }

  .unlock DOC <$ Releases the mutex and notifies one sleeping contender. $>
    FUNCTION()
  {
    VAR expected_uncontended I32 := 1;
    IF (.state.COMPARE_EXCHANGE#(
      @SUCCESS ATOMIC_ACQREL,
      @FAILURE ATOMIC_ACQUIRE
    )(% [expected_uncontended, 0]))
    {
      RETURN;
    }

    ASSERT(expected_uncontended == 2, "Cannot unlock an unlocked allocator mutex.");
    .state.STORE#ATOMIC_RELEASE(0);
    STATIC_IF(OS_LINUX)
    {
      syscall::linux::futex_wake(@address .state<-, @count 1);
    }
    STATIC_ELSE STATIC_IF(OS_WINDOWS)
    {
      syscall::windows::wake_by_address_single(@address .state<-);
    }
  }
}

PRIVATE(MODULE) ::allocator_page_size STATIC SZ := 4096;
PRIVATE(MODULE) ::allocator_slab_region_size STATIC SZ := 65536;
PRIVATE(MODULE) ::allocator_slab_maximum_block_size STATIC SZ := 12288;

::allocator_thread_cache_refill_maximum_bytes DOC <$
  Configures the target payload bytes represented by one thread-local address
  cache. Each slab specialization rounds its entry count down to an even value
  and retains at least two entries so half-cache transfers remain well-defined.
  $>
  OPTION NUMBER DEFAULT_VALUE(1024);

PRIVATE(MODULE) ::allocator_null_address DOC <$ Returns a null ADDRESS. $>
  FUNCTION(): ADDRESS
{
  VAR null_pointer =>>BYTE;
  RETURN ADDRESS_LAUNDER_ESCAPE_ALLOC_REGION null_pointer;
}

PRIVATE(MODULE) ::allocator_checked_bytes DOC <$
  Multiplies element size and count, terminating instead of wrapping.
  $>
  FUNCTION(@size SZ, @count SZ): SZ
{
  IF (count == 0 || size == 0)
  {
    RETURN 0;
  }
  VAR maximum_size SZ := (0 AS SZ) #!!;
  IF (size > maximum_size / count)
  {
    PANIC "Allocation size overflow.";
  }
  RETURN size * count;
}

PRIVATE(MODULE) ::allocator_validate_alignment DOC <$
  Validates an alignment supported by page-aligned slab and direct mappings.
  $>
  FUNCTION(@align SZ)
{
  IF (align == 0 || (align #&& (align - 1)) != 0)
  {
    PANIC "Allocator alignment must be a nonzero power of two.";
  }
  IF (align > allocator_page_size)
  {
    PANIC "Allocator alignment exceeds the OS page alignment.";
  }
}

PRIVATE(MODULE) ::allocator_map_region DOC <$ Maps a page-rounded region or terminates on failure. $>
  FUNCTION(@bytes SZ): ADDRESS
{
  VAR mapping_size SZ := memory_region_size(@size bytes);
  VAR mapping_address ADDRESS;
  STATIC_IF(OS_LINUX)
  {
    mapping_address := syscall::linux::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_MACOS)
  {
    mapping_address := syscall::macos::mmap_anonymous_private(@size mapping_size);
  }
  STATIC_IF(OS_WINDOWS)
  {
    VAR requested_address ADDRESS := allocator_null_address();
    mapping_address := virtual_alloc(
      @address requested_address,
      @size mapping_size,
      @allocation_type 12288,
      @protect 4
    );
  }
  IF ((mapping_address??) == FALSE)
  {
    PANIC "The operating system rejected an allocator mapping request.";
  }
  RETURN mapping_address;
}

PRIVATE(MODULE) ::allocator_unmap_region DOC <$ Releases one page-rounded direct allocation. $>
  FUNCTION(@address ADDRESS, @bytes SZ)
{
  VAR mapping_size SZ := memory_region_size(@size bytes);
  VAR succeeded BOOL := FALSE;
  STATIC_IF(OS_LINUX)
  {
    succeeded := syscall::linux::munmap(@addr address, @len mapping_size) == 0;
  }
  STATIC_IF(OS_MACOS)
  {
    succeeded := syscall::macos::munmap(@address address, @size mapping_size) == 0;
  }
  STATIC_IF(OS_WINDOWS)
  {
    succeeded := virtual_free(@address address, @size 0, @free_type 32768);
  }
  IF (succeeded == FALSE)
  {
    PANIC "The operating system rejected an allocator unmap request.";
  }
}

PRIVATE(MODULE) ::allocator_address_cache_entry_count DOC <$
  Computes an even address-cache capacity for one slab block size.
  $>
  FUNCTION(@block_size SZ): SZ
{
  VAR target_bytes SZ := allocator_thread_cache_refill_maximum_bytes AS CHECKED SZ;
  VAR result SZ := target_bytes / block_size;
  IF (result < 2)
  {
    RETURN 2;
  }
  IF ((result % 2) != 0)
  {
    result--;
  }
  RETURN result;
}

PRIVATE(MODULE) ::addr_cache DOC <$
  Stores free allocation addresses in a bounded LIFO stack.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .entries VAR [count]ADDRESS;
  .used VAR SZ;

  .push DOC <$ Adds one address to the top of the cache. $>
    FUNCTION(@entry ADDRESS)
  {
    ASSERT(.used < count, "An address cache cannot exceed its capacity.");
    .entries[.used] := entry;
    .used++;
  }

  .pop DOC <$ Removes and returns the address at the top of the cache. $>
    FUNCTION(): ADDRESS
  {
    ASSERT(.used > 0, "An empty address cache cannot be popped.");
    .used--;
    RETURN .entries[.used];
  }

  .move_entries_to DOC <$ Moves the requested top entries into another cache. $>
    FUNCTION(@destination MUT& addr_cache#(@count count), @entry_count SZ)
  {
    ASSERT(.used >= entry_count, "An address-cache transfer exceeds the source size.");
    ASSERT(destination.used <= count, "An address cache has an invalid used count.");
    ASSERT(entry_count <= count - destination.used, "An address-cache transfer exceeds the destination capacity.");
    FOR VALUE(entry_index) FROM(0 AS SZ) UNTIL(entry_count) LOOP
    {
      destination.push(@entry .pop());
    };
  }
}

PRIVATE(MODULE) ::addr_cache_node DOC <$
  Owns one address cache and its allocator-internal global-list link.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .next VAR MUT->addr_cache_node#(@count count);
  .cache VAR addr_cache#(@count count);
}

PRIVATE(MODULE) ::addr_cache_list DOC <$
  Tracks address-cache objects without storing links in allocation payloads.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .head VAR MUT->addr_cache_node#(@count count);

  .push DOC <$ Pushes one cache object onto the list. $>
    FUNCTION(@node MUT->addr_cache_node#(@count count))
  {
    ASSERT(node??, "A null address-cache node cannot be listed.");
    (node->).next := .head;
    .head := node;
  }

  .pop DOC <$ Removes and returns the first cache object. $>
    FUNCTION(): MUT->addr_cache_node#(@count count)
  {
    ASSERT(.head??, "An empty address-cache list cannot be popped.");
    VAR result MUT->addr_cache_node#(@count count) := .head;
    .head := (result->).next;
    VAR no_next MUT->addr_cache_node#(@count count);
    (result->).next := no_next;
    RETURN result;
  }
}

PRIVATE(MODULE) ::addr_cache_empty_root DOC <$
  Owns empty cache objects shared by all slab classes with the same capacity.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .mtx VAR mutex;
  .nodes VAR addr_cache_list#(@count count);
}

PRIVATE(MODULE) ::slab_global_root DOC <$
  Owns full and partial cache-object lists for one slab specialization.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .mtx VAR mutex;
  .full VAR addr_cache_list#(@count count);
  .partial VAR addr_cache_list#(@count count);
  .bypass_active VAR MUT->addr_cache_node#(@count count);
}

PRIVATE(MODULE) ::slab_thread_cache DOC <$
  Holds the active and secondary address caches for one thread and slab class.
  $>
  TEMPLATE(@count VALUE SZ) STRUCT
{
  .active VAR MUT->addr_cache_node#(@count count);
  .secondary VAR MUT->addr_cache_node#(@count count);
}

PRIVATE(MODULE) ::allocator_thread_cache_lifetime DOC <$
  Registers allocator cache cleanup with the thread runtime on first use.
  $>
STRUCT
{
  .DESTRUCTOR DOC <$ Keeps the thread-runtime cleanup registration nontrivial. $>
    FUNCTION()
  {
  }
}

PRIVATE(MODULE) ::addr_cache_empty_root_for
  TEMPLATE(@count VALUE SZ)
  VAR addr_cache_empty_root#(@count count);

PRIVATE(MODULE) ::slab_global_root_for
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ, @cache_count VALUE SZ)
  VAR slab_global_root#(@count cache_count);

PRIVATE(MODULE) ::slab_thread_cache_for
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ, @cache_count VALUE SZ)
  PER_THREAD VAR slab_thread_cache#(@count cache_count);

PRIVATE(MODULE) ::allocator_thread_caches_disabled PER_THREAD VAR BOOL;
PRIVATE(MODULE) ::allocator_thread_cache_lifetime_state
  PER_THREAD VAR allocator_thread_cache_lifetime;

PRIVATE(MODULE) ::refill_empty_addr_cache_nodes DOC <$
  Maps allocator-internal metadata storage and places empty cache objects in it.
  The metadata mappings remain valid for the process lifetime.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@root MUT& addr_cache_empty_root#(@count count))
{
  VAR node_size SZ := SIZEOF(addr_cache_node#(@count count));
  VAR region_size SZ := allocator_slab_region_size;
  IF (region_size < node_size)
  {
    region_size := node_size;
  }
  VAR region_address ADDRESS := allocator_map_region(@bytes region_size);
  VAR node_count SZ := region_size / node_size;
  FOR VALUE(node_index) FROM(0 AS SZ) UNTIL(node_count) LOOP
  {
    VAR node_address ADDRESS := region_address + node_index * node_size;
    VAR node_storage MUT->TYPED_STORAGE(addr_cache_node#(@count count)) :=
      ADDRESS_LAUNDER_DISCOVER_EXISTING node_address TO
        MUT->TYPED_STORAGE(addr_cache_node#(@count count));
    VAR node MUT->addr_cache_node#(@count count) :=
      PLACE AT(node_storage->) addr_cache_node#(@count count);
    root.nodes.push(@node node);
  };
}

PRIVATE(MODULE) ::acquire_empty_addr_cache_node DOC <$
  Acquires an empty cache object without associating it with a slab size class.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(): MUT->addr_cache_node#(@count count)
{
  VAR root MUT& addr_cache_empty_root#(@count count) :=
    addr_cache_empty_root_for#(@count count);
  root.mtx.lock();
  IF ((root.nodes.head??) == FALSE)
  {
    refill_empty_addr_cache_nodes#(@count count)(@root root);
  }
  VAR result MUT->addr_cache_node#(@count count) := root.nodes.pop();
  root.mtx.unlock();
  ASSERT((result->).cache.used == 0, "An acquired empty cache contains addresses.");
  RETURN result;
}

PRIVATE(MODULE) ::acquire_empty_addr_cache_nodes DOC <$
  Acquires several empty cache objects under one capacity-root lock.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(
    @destination MUT& addr_cache_list#(@count count),
    @node_count SZ
  )
{
  VAR root MUT& addr_cache_empty_root#(@count count) :=
    addr_cache_empty_root_for#(@count count);
  root.mtx.lock();
  FOR VALUE(node_index) FROM(0 AS SZ) UNTIL(node_count) LOOP
  {
    IF ((root.nodes.head??) == FALSE)
    {
      refill_empty_addr_cache_nodes#(@count count)(@root root);
    }
    VAR node MUT->addr_cache_node#(@count count) := root.nodes.pop();
    ASSERT((node->).cache.used == 0, "An acquired empty cache contains addresses.");
    destination.push(@node node);
  };
  root.mtx.unlock();
}

PRIVATE(MODULE) ::release_empty_addr_cache_node DOC <$
  Returns an empty cache object to the capacity-specific global list.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@node MUT->addr_cache_node#(@count count))
{
  ASSERT((node->).cache.used == 0, "Only an empty cache can enter the empty-cache list.");
  VAR root MUT& addr_cache_empty_root#(@count count) :=
    addr_cache_empty_root_for#(@count count);
  root.mtx.lock();
  root.nodes.push(@node node);
  root.mtx.unlock();
}

PRIVATE(MODULE) ::release_empty_addr_cache_nodes DOC <$
  Returns several empty cache objects under one capacity-root lock.
  $>
  TEMPLATE(@count VALUE SZ)
  FUNCTION(@nodes MUT& addr_cache_list#(@count count))
{
  VAR root MUT& addr_cache_empty_root#(@count count) :=
    addr_cache_empty_root_for#(@count count);
  root.mtx.lock();
  WHILE (nodes.head??)
  {
    VAR node MUT->addr_cache_node#(@count count) := nodes.pop();
    ASSERT((node->).cache.used == 0, "Only an empty cache can enter the empty-cache list.");
    root.nodes.push(@node node);
  }
  root.mtx.unlock();
}

PRIVATE(MODULE) ::large_allocator DOC <$
  Handles allocations above the slab limit with page-rounded direct mappings.
  $>
  STRUCT
{
  PRIVATE(MODULE) ::allocate DOC <$ Maps one allocation with the requested layout. $>
    FUNCTION(@size SZ, @align SZ): ADDRESS
  {
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    RETURN allocator_map_region(@bytes bytes);
  }

  PRIVATE(MODULE) ::deallocate DOC <$ Unmaps one allocation with the original layout. $>
    FUNCTION(@size SZ, @align SZ, @ptr ADDRESS)
  {
    IF ((ptr??) == FALSE)
    {
      RETURN;
    }
    allocator_validate_alignment(@align align);
    VAR bytes SZ := size;
    IF (bytes < align)
    {
      bytes := align;
    }
    allocator_unmap_region(@address ptr, @bytes bytes);
  }
}

PRIVATE(MODULE) ::slab_allocator DOC <$
  Implements one fixed block-size and alignment allocator with whole-cache
  transfers between thread-local and global state.
  $>
  TEMPLATE(@block_size VALUE SZ, @block_align VALUE SZ) STRUCT
{
  PRIVATE(MODULE) ::address_cache_count STATIC SZ :=
    allocator_address_cache_entry_count(@block_size block_size);

  PRIVATE(MODULE) ::acquire_full_cache_locked DOC <$
    Removes a full cache from this class or constructs one from partial caches
    and newly mapped slabs. The class root must remain locked for the call.
    $>
    FUNCTION(
      @root MUT& slab_global_root#(@count address_cache_count)
    ): MUT->addr_cache_node#(@count address_cache_count)
  {
    IF (root.full.head??)
    {
      RETURN root.full.pop();
    }

    VAR result MUT->addr_cache_node#(@count address_cache_count) :=
      acquire_empty_addr_cache_node#(@count address_cache_count)();
    VAR emptied_nodes addr_cache_list#(@count address_cache_count);

    WHILE (root.partial.head?? && (result->).cache.used < address_cache_count)
    {
      VAR partial MUT->addr_cache_node#(@count address_cache_count) := root.partial.pop();
      VAR transfer_count SZ := (partial->).cache.used;
      VAR available_entries SZ := address_cache_count - (result->).cache.used;
      IF (transfer_count > available_entries)
      {
        transfer_count := available_entries;
      }
      (partial->).cache.move_entries_to(
        @destination (result->).cache,
        @entry_count transfer_count
      );
      IF ((partial->).cache.used == 0)
      {
        emptied_nodes.push(@node partial);
      }
      ELSE
      {
        root.partial.push(@node partial);
      }
    }
    IF (emptied_nodes.head??)
    {
      release_empty_addr_cache_nodes#(@count address_cache_count)(
        @nodes emptied_nodes
      );
    }

    IF (root.bypass_active?? && (root.bypass_active->).cache.used > 0)
    {
      VAR bypass_transfer_count SZ := (root.bypass_active->).cache.used;
      VAR bypass_available_entries SZ := address_cache_count - (result->).cache.used;
      IF (bypass_transfer_count > bypass_available_entries)
      {
        bypass_transfer_count := bypass_available_entries;
      }
      (root.bypass_active->).cache.move_entries_to(
        @destination (result->).cache,
        @entry_count bypass_transfer_count
      );
    }

    WHILE ((result->).cache.used < address_cache_count)
    {
      VAR slab_address ADDRESS := allocator_map_region(@bytes allocator_slab_region_size);
      VAR block_count SZ := allocator_slab_region_size / block_size;
      VAR result_capacity SZ := address_cache_count - (result->).cache.used;
      VAR overflow_entry_count SZ := 0;
      IF (block_count > result_capacity)
      {
        overflow_entry_count := block_count - result_capacity;
      }
      VAR overflow_node_count SZ := overflow_entry_count / address_cache_count;
      IF ((overflow_entry_count % address_cache_count) != 0)
      {
        overflow_node_count++;
      }
      VAR overflow_nodes addr_cache_list#(@count address_cache_count);
      IF (overflow_node_count > 0)
      {
        acquire_empty_addr_cache_nodes#(@count address_cache_count)(
          @destination overflow_nodes,
          @node_count overflow_node_count
        );
      }
      VAR overflow_cache MUT->addr_cache_node#(@count address_cache_count);
      FOR VALUE(block_index) FROM(0 AS SZ) UNTIL(block_count) LOOP
      {
        VAR block ADDRESS := slab_address + block_index * block_size;
        IF ((result->).cache.used < address_cache_count)
        {
          (result->).cache.push(@entry block);
        }
        ELSE
        {
          IF ((overflow_cache??) == FALSE)
          {
            ASSERT(overflow_nodes.head??, "A slab refill did not acquire enough overflow caches.");
            overflow_cache := overflow_nodes.pop();
          }
          (overflow_cache->).cache.push(@entry block);
          IF ((overflow_cache->).cache.used == address_cache_count)
          {
            root.full.push(@node overflow_cache);
            VAR no_overflow_cache MUT->addr_cache_node#(@count address_cache_count);
            overflow_cache := no_overflow_cache;
          }
        }
      };
      IF (overflow_cache??)
      {
        root.partial.push(@node overflow_cache);
      }
      ASSERT((overflow_nodes.head??) == FALSE, "A slab refill acquired unused overflow caches.");
    }
    RETURN result;
  }

  PRIVATE(MODULE) ::acquire_full_cache DOC <$
    Acquires one full cache object from this slab class.
    $>
    FUNCTION(): MUT->addr_cache_node#(@count address_cache_count)
  {
    VAR root MUT& slab_global_root#(@count address_cache_count) := slab_global_root_for#(
      @block_size block_size,
      @block_align block_align,
      @cache_count address_cache_count
    );
    root.mtx.lock();
    VAR result MUT->addr_cache_node#(@count address_cache_count) :=
      acquire_full_cache_locked(@root root);
    root.mtx.unlock();
    ASSERT((result->).cache.used == address_cache_count, "A full cache was not populated.");
    RETURN result;
  }

  PRIVATE(MODULE) ::release_cache_to_global DOC <$
    Returns one cache object to the empty, partial, or full global list selected
    by its current entry count.
    $>
    FUNCTION(@node MUT->addr_cache_node#(@count address_cache_count))
  {
    IF ((node->).cache.used == 0)
    {
      release_empty_addr_cache_node#(@count address_cache_count)(@node node);
      RETURN;
    }

    VAR root MUT& slab_global_root#(@count address_cache_count) := slab_global_root_for#(
      @block_size block_size,
      @block_align block_align,
      @cache_count address_cache_count
    );
    root.mtx.lock();
    IF ((node->).cache.used == address_cache_count)
    {
      root.full.push(@node node);
    }
    ELSE
    {
      root.partial.push(@node node);
    }
    root.mtx.unlock();
  }

  PRIVATE(MODULE) ::initialize_thread_cache DOC <$
    Acquires the two empty cache objects owned by this thread and slab class.
    $>
    FUNCTION(
      @cache MUT& slab_thread_cache#(@count address_cache_count)
    )
  {
    allocator_thread_cache_lifetime_state;
    ASSERT((cache.active??) == FALSE, "A thread cache already has an active cache object.");
    ASSERT((cache.secondary??) == FALSE, "A thread cache already has a secondary cache object.");
    cache.active := acquire_empty_addr_cache_node#(@count address_cache_count)();
    cache.secondary := acquire_empty_addr_cache_node#(@count address_cache_count)();
  }

  PRIVATE(MODULE) ::swap_thread_caches DOC <$
    Exchanges the active and secondary cache-object roles.
    $>
    FUNCTION(
      @cache MUT& slab_thread_cache#(@count address_cache_count)
    )
  {
    VAR previous_active MUT->addr_cache_node#(@count address_cache_count) := cache.active;
    cache.active := cache.secondary;
    cache.secondary := previous_active;
  }

  PRIVATE(MODULE) ::allocate_without_thread_cache DOC <$
    Allocates through the class root's active bypass cache.
    $>
    FUNCTION(): ADDRESS
  {
    VAR root MUT& slab_global_root#(@count address_cache_count) := slab_global_root_for#(
      @block_size block_size,
      @block_align block_align,
      @cache_count address_cache_count
    );
    root.mtx.lock();
    IF ((root.bypass_active??) == FALSE)
    {
      root.bypass_active := acquire_empty_addr_cache_node#(@count address_cache_count)();
    }
    IF ((root.bypass_active->).cache.used == 0)
    {
      VAR empty_active MUT->addr_cache_node#(@count address_cache_count) :=
        root.bypass_active;
      VAR no_active MUT->addr_cache_node#(@count address_cache_count);
      root.bypass_active := no_active;
      release_empty_addr_cache_node#(@count address_cache_count)(@node empty_active);
      root.bypass_active := acquire_full_cache_locked(@root root);
    }
    VAR result ADDRESS := (root.bypass_active->).cache.pop();
    root.mtx.unlock();
    RETURN result;
  }

  PRIVATE(MODULE) ::deallocate_without_thread_cache DOC <$
    Returns one address through the class root's active bypass cache.
    $>
    FUNCTION(@ptr ADDRESS)
  {
    VAR root MUT& slab_global_root#(@count address_cache_count) := slab_global_root_for#(
      @block_size block_size,
      @block_align block_align,
      @cache_count address_cache_count
    );
    root.mtx.lock();
    IF ((root.bypass_active??) == FALSE)
    {
      root.bypass_active := acquire_empty_addr_cache_node#(@count address_cache_count)();
    }
    IF ((root.bypass_active->).cache.used == address_cache_count)
    {
      root.full.push(@node root.bypass_active);
      root.bypass_active := acquire_empty_addr_cache_node#(@count address_cache_count)();
    }
    (root.bypass_active->).cache.push(@entry ptr);
    root.mtx.unlock();
  }

  PRIVATE(MODULE) ::allocate DOC <$ Allocates one block from this slab allocator. $>
    FUNCTION(): ADDRESS
  {
    VAR cache MUT& slab_thread_cache#(@count address_cache_count) :=
      slab_thread_cache_for#(
        @block_size block_size,
        @block_align block_align,
        @cache_count address_cache_count
      );

    IF (cache.active?? && (cache.active->).cache.used > 0)
    {
      RETURN (cache.active->).cache.pop();
    }

    IF (cache.active??)
    {
      ASSERT(cache.secondary??, "A thread cache is missing its secondary cache object.");
      VAR secondary_entries SZ := (cache.secondary->).cache.used;
      IF (secondary_entries == address_cache_count)
      {
        (cache.secondary->).cache.move_entries_to(
          @destination (cache.active->).cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        swap_thread_caches(@cache cache);
      }
      ELSE
      {
        ASSERT(secondary_entries == 0, "A secondary address cache has an invalid state.");
      }

      IF ((cache.active->).cache.used > 0)
      {
        RETURN (cache.active->).cache.pop();
      }
    }

    IF (allocator_thread_caches_disabled)
    {
      RETURN allocate_without_thread_cache();
    }

    IF ((cache.active??) == FALSE)
    {
      initialize_thread_cache(@cache cache);
    }
    ASSERT((cache.active->).cache.used == 0, "A thread cache refill requires an empty active cache.");
    ASSERT((cache.secondary->).cache.used == 0, "A thread cache refill requires an empty secondary cache.");
    release_empty_addr_cache_node#(@count address_cache_count)(@node cache.active);
    cache.active := acquire_full_cache();
    RETURN (cache.active->).cache.pop();
  }

  PRIVATE(MODULE) ::deallocate DOC <$ Returns one block to this slab allocator. $>
    FUNCTION(@ptr ADDRESS)
  {
    IF ((ptr??) == FALSE)
    {
      RETURN;
    }
    IF (allocator_thread_caches_disabled)
    {
      deallocate_without_thread_cache(@ptr ptr);
      RETURN;
    }

    VAR cache MUT& slab_thread_cache#(@count address_cache_count) :=
      slab_thread_cache_for#(
        @block_size block_size,
        @block_align block_align,
        @cache_count address_cache_count
      );
    IF ((cache.active??) == FALSE)
    {
      initialize_thread_cache(@cache cache);
    }

    IF ((cache.active->).cache.used == address_cache_count)
    {
      VAR secondary_entries SZ := (cache.secondary->).cache.used;
      IF (secondary_entries == 0)
      {
        (cache.active->).cache.move_entries_to(
          @destination (cache.secondary->).cache,
          @entry_count address_cache_count / 2
        );
      }
      ELSE IF (secondary_entries == address_cache_count / 2)
      {
        swap_thread_caches(@cache cache);
      }
      ELSE
      {
        ASSERT(secondary_entries == address_cache_count, "A secondary address cache has an invalid state.");
        VAR full_cache MUT->addr_cache_node#(@count address_cache_count) := cache.active;
        cache.active := acquire_empty_addr_cache_node#(@count address_cache_count)();
        release_cache_to_global(@node full_cache);
      }
    }

    (cache.active->).cache.push(@entry ptr);
  }

  PRIVATE(MODULE) ::release_thread_cache DOC <$
    Returns both cache objects owned by this thread to global allocator state.
    $>
    FUNCTION()
  {
    VAR cache MUT& slab_thread_cache#(@count address_cache_count) :=
      slab_thread_cache_for#(
        @block_size block_size,
        @block_align block_align,
        @cache_count address_cache_count
      );
    IF ((cache.active??) == FALSE)
    {
      ASSERT((cache.secondary??) == FALSE, "A thread cache owns only one cache object.");
      RETURN;
    }
    ASSERT(cache.secondary??, "A thread cache is missing its secondary cache object.");
    VAR active MUT->addr_cache_node#(@count address_cache_count) := cache.active;
    VAR secondary MUT->addr_cache_node#(@count address_cache_count) := cache.secondary;
    VAR no_cache MUT->addr_cache_node#(@count address_cache_count);
    cache.active := no_cache;
    cache.secondary := no_cache;
    release_cache_to_global(@node active);
    release_cache_to_global(@node secondary);
  }

  PRIVATE(MODULE) ::thread_cached_block_count DOC <$
    Reports this thread's block count for allocator validation.
    $>
    FUNCTION(): SZ
  {
    VAR cache MUT& slab_thread_cache#(@count address_cache_count) :=
      slab_thread_cache_for#(
        @block_size block_size,
        @block_align block_align,
        @cache_count address_cache_count
      );
    IF ((cache.active??) == FALSE)
    {
      RETURN 0;
    }
    RETURN (cache.active->).cache.used + (cache.secondary->).cache.used;
  }
}

PRIVATE(MODULE) ::allocator_allocate_static DOC <$
  Selects the slab allocator for a compile-time size and alignment. No runtime
  size-class search is emitted for a selected slab specialization.
  $>
  TEMPLATE(@size VALUE SZ, @align VALUE SZ) FUNCTION(): ADDRESS
{
  allocator_validate_alignment(@align align);
  STATIC_IF(size <= 8 && align <= 8)
  {
    RETURN slab_allocator#(@block_size 8, @block_align 8)::allocate();
  }
  STATIC_IF(size <= 12 && align <= 4)
  {
    RETURN slab_allocator#(@block_size 12, @block_align 4)::allocate();
  }
  STATIC_IF(size <= 16 && align <= 16)
  {
    RETURN slab_allocator#(@block_size 16, @block_align 16)::allocate();
  }
  STATIC_IF(size <= 24 && align <= 8)
  {
    RETURN slab_allocator#(@block_size 24, @block_align 8)::allocate();
  }
  STATIC_IF(size <= 32 && align <= 32)
  {
    RETURN slab_allocator#(@block_size 32, @block_align 32)::allocate();
  }
  STATIC_IF(size <= 48 && align <= 16)
  {
    RETURN slab_allocator#(@block_size 48, @block_align 16)::allocate();
  }
  STATIC_IF(size <= 64 && align <= 64)
  {
    RETURN slab_allocator#(@block_size 64, @block_align 64)::allocate();
  }
  STATIC_IF(size <= 96 && align <= 32)
  {
    RETURN slab_allocator#(@block_size 96, @block_align 32)::allocate();
  }
  STATIC_IF(size <= 128 && align <= 128)
  {
    RETURN slab_allocator#(@block_size 128, @block_align 128)::allocate();
  }
  STATIC_IF(size <= 192 && align <= 64)
  {
    RETURN slab_allocator#(@block_size 192, @block_align 64)::allocate();
  }
  STATIC_IF(size <= 256 && align <= 256)
  {
    RETURN slab_allocator#(@block_size 256, @block_align 256)::allocate();
  }
  STATIC_IF(size <= 384 && align <= 128)
  {
    RETURN slab_allocator#(@block_size 384, @block_align 128)::allocate();
  }
  STATIC_IF(size <= 512 && align <= 512)
  {
    RETURN slab_allocator#(@block_size 512, @block_align 512)::allocate();
  }
  STATIC_IF(size <= 768 && align <= 256)
  {
    RETURN slab_allocator#(@block_size 768, @block_align 256)::allocate();
  }
  STATIC_IF(size <= 1024 && align <= 1024)
  {
    RETURN slab_allocator#(@block_size 1024, @block_align 1024)::allocate();
  }
  STATIC_IF(size <= 1536 && align <= 512)
  {
    RETURN slab_allocator#(@block_size 1536, @block_align 512)::allocate();
  }
  STATIC_IF(size <= 2048 && align <= 2048)
  {
    RETURN slab_allocator#(@block_size 2048, @block_align 2048)::allocate();
  }
  STATIC_IF(size <= 3072 && align <= 1024)
  {
    RETURN slab_allocator#(@block_size 3072, @block_align 1024)::allocate();
  }
  STATIC_IF(size <= 4096 && align <= 4096)
  {
    RETURN slab_allocator#(@block_size 4096, @block_align 4096)::allocate();
  }
  STATIC_IF(size <= 6144 && align <= 2048)
  {
    RETURN slab_allocator#(@block_size 6144, @block_align 2048)::allocate();
  }
  STATIC_IF(size <= 8192 && align <= 4096)
  {
    RETURN slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  }
  STATIC_IF(size <= allocator_slab_maximum_block_size && align <= 4096)
  {
    RETURN slab_allocator#(@block_size 12288, @block_align 4096)::allocate();
  }
  RETURN large_allocator::allocate(@size size, @align align);
}

