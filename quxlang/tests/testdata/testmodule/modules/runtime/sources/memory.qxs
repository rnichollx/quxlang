    RETURN;
  }
  IF (bytes <= 48 && align <= 16)
  {
    slab_allocator#(@block_size 48, @block_align 16)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 64 && align <= 64)
  {
    slab_allocator#(@block_size 64, @block_align 64)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 96 && align <= 32)
  {
    slab_allocator#(@block_size 96, @block_align 32)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 128 && align <= 128)
  {
    slab_allocator#(@block_size 128, @block_align 128)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 192 && align <= 64)
  {
    slab_allocator#(@block_size 192, @block_align 64)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 256 && align <= 256)
  {
    slab_allocator#(@block_size 256, @block_align 256)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 384 && align <= 128)
  {
    slab_allocator#(@block_size 384, @block_align 128)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 512 && align <= 512)
  {
    slab_allocator#(@block_size 512, @block_align 512)::deallocate(@ptr ptr);
