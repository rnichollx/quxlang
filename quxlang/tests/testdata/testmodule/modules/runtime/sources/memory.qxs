  }
  IF (bytes <= 768 && align <= 256)
  {
    slab_allocator#(@block_size 768, @block_align 256)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 1024 && align <= 1024)
  {
    slab_allocator#(@block_size 1024, @block_align 1024)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 1536 && align <= 512)
  {
    slab_allocator#(@block_size 1536, @block_align 512)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 2048 && align <= 2048)
  {
    slab_allocator#(@block_size 2048, @block_align 2048)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 3072 && align <= 1024)
  {
    slab_allocator#(@block_size 3072, @block_align 1024)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 4096 && align <= 4096)
  {
    slab_allocator#(@block_size 4096, @block_align 4096)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 6144 && align <= 2048)
  {
    slab_allocator#(@block_size 6144, @block_align 2048)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= 8192 && align <= 4096)
  {
    slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr ptr);
    RETURN;
  }
  IF (bytes <= allocator_slab_maximum_block_size && align <= 4096)
  {
    slab_allocator#(@block_size 12288, @block_align 4096)::deallocate(@ptr ptr);
    RETURN;
  }
  large_allocator::deallocate(@size bytes, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_allocate_multiple DOC <$
  Uses a slab allocator for a runtime count whenever the total layout is eligible.
  $>
  FUNCTION(@size SZ, @align SZ, @count SZ): ADDRESS
{
  VAR bytes SZ := allocator_checked_bytes(@size size, @count count);
  RETURN allocator_allocate_dynamic(@bytes bytes, @align align);
}

PRIVATE(MODULE) ::allocator_deallocate_multiple DOC <$
  Reconstructs the multi allocation's slab-or-large routing from its count.
  $>
  FUNCTION(@size SZ, @align SZ, @ptr ADDRESS, @count SZ)
{
  IF ((ptr??) == FALSE)
  {
    RETURN;
  }
  VAR bytes SZ := allocator_checked_bytes(@size size, @count count);
  allocator_deallocate_dynamic(@bytes bytes, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_release_all_thread_caches DOC <$
  Flushes every slab specialization used by the default allocator test surface.
  $>
  FUNCTION()
{
  slab_allocator#(@block_size 8, @block_align 8)::release_thread_cache();
  slab_allocator#(@block_size 12, @block_align 4)::release_thread_cache();
  slab_allocator#(@block_size 16, @block_align 16)::release_thread_cache();
  slab_allocator#(@block_size 24, @block_align 8)::release_thread_cache();
  slab_allocator#(@block_size 32, @block_align 32)::release_thread_cache();
  slab_allocator#(@block_size 48, @block_align 16)::release_thread_cache();
  slab_allocator#(@block_size 64, @block_align 64)::release_thread_cache();
  slab_allocator#(@block_size 96, @block_align 32)::release_thread_cache();
  slab_allocator#(@block_size 128, @block_align 128)::release_thread_cache();
  slab_allocator#(@block_size 192, @block_align 64)::release_thread_cache();
  slab_allocator#(@block_size 256, @block_align 256)::release_thread_cache();
  slab_allocator#(@block_size 384, @block_align 128)::release_thread_cache();
  slab_allocator#(@block_size 512, @block_align 512)::release_thread_cache();
  slab_allocator#(@block_size 768, @block_align 256)::release_thread_cache();
  slab_allocator#(@block_size 1024, @block_align 1024)::release_thread_cache();
  slab_allocator#(@block_size 1536, @block_align 512)::release_thread_cache();
  slab_allocator#(@block_size 2048, @block_align 2048)::release_thread_cache();
  slab_allocator#(@block_size 3072, @block_align 1024)::release_thread_cache();
  slab_allocator#(@block_size 4096, @block_align 4096)::release_thread_cache();
  slab_allocator#(@block_size 6144, @block_align 2048)::release_thread_cache();
  slab_allocator#(@block_size 8192, @block_align 4096)::release_thread_cache();
  slab_allocator#(@block_size 12288, @block_align 4096)::release_thread_cache();
}

PRIVATE(MODULE) ::allocator_thread_cache_shutdown_begin DOC <$
  Prevents this thread from acquiring additional thread-local cache contents.
  Existing addresses remain available to allocations until they are consumed.
  $>
  FUNCTION()
{
  allocator_thread_caches_disabled := TRUE;
}

PRIVATE(MODULE) ::allocator_thread_cache_shutdown_finish DOC <$
  Returns this thread's remaining full, partial, and empty cache objects after
  every registered thread-local destructor has run.
  $>
  FUNCTION()
{
  allocator_release_all_thread_caches();
}

::DEFAULT_ALLOCATOR DOC <$
  Provides the standard typed allocator interfaces for `T`. The `VOID`
  specialization provides the typeless Size-Align and Virtual Allocator APIs.
  $>
  TEMPLATE(@T TYPE AUTO) STRUCT
{
  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$ Allocates storage for one object of `T`. $>
    FUNCTION(): ->TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#T();
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T();
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )();
        RETURN BEGIN_ALLOC_REGION addr TO ->TYPED_STORAGE(T);
      }
    }
  }

  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$ Releases storage previously returned by `ALLOC`. $>
    FUNCTION(@PTR:ptr ->TYPED_STORAGE(T))
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_ALLOC_REGION ptr;
        allocator_deallocate_static#(
          @size SIZEOF(T),
          @align ALIGNOF(T)
        )(@ptr addr);
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#T(% [ptr]);
    }
  }

  ::MULTI_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$
    Allocates contiguous storage for `count` objects of `T`.
    $>
    FUNCTION(@COUNT:count SZ): =>>TYPED_STORAGE(T)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC_MULTIPLE#T(% [count]);
    }
    ELSE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        RETURN JVM_ALLOCATE_OBJECT_STORAGE#T(% [count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := allocator_allocate_multiple(
          @size SIZEOF(T),
          @align ALIGNOF(T),
          @count count
        );
        RETURN BEGIN_MULTI_ALLOC_REGION addr SIZE count TO =>>TYPED_STORAGE(T);
      }
    }
  }

  ::MULTI_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) == FALSE) DOC <$
    Releases storage previously returned by `MULTI_ALLOC`.
    $>
    FUNCTION(@PTR:ptr =>>TYPED_STORAGE(T), @COUNT:count SZ)
  {
    RUNTIME NATIVE
    {
      STATIC_IF(ARCH_IS_JVM)
      {
        JVM_DEALLOCATE_OBJECT_STORAGE#T(% [ptr, count]);
      }
      STATIC_ELSE
      {
        VAR addr ADDRESS := END_MULTI_ALLOC_REGION ptr SIZE count;
        allocator_deallocate_multiple(
          @size SIZEOF(T),
          @align ALIGNOF(T),
          @ptr addr,
          @count count
        );
      }
    }
    ELSE
    {
      CONSTEXPR_DEALLOC_MULTIPLE#T(% [ptr, count]);
    }
  }

  ::ALLOC INCLUDE_IF(SAME_TYPES(T, VOID)) DOC <$ Allocates storage with compile-time size and alignment. $>
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(): ->ALIGNED_STORAGE(size, align)
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#(@SIZE size, @ALIGN align)();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_static#(
        @size size,
        @align align
      )();
      RETURN BEGIN_ALLOC_REGION addr TO ->ALIGNED_STORAGE(size, align);
    }
  }

  ::DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID)) DOC <$ Releases storage allocated with compile-time size and alignment. $>
    TEMPLATE(@SIZE:size VALUE SZ, @ALIGN:align VALUE SZ)
    FUNCTION(@PTR:ptr ->ALIGNED_STORAGE(size, align))
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_static#(
        @size size,
        @align align
      )(@ptr addr);
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#(@SIZE size, @ALIGN align)(% [ptr]);
    }
  }

  ::VIRTUAL_ALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Allocates storage with runtime-provided size and alignment.
    $>
    FUNCTION(@SIZE:size SZ, @ALIGN:align SZ): ->VIRTUAL_STORAGE
  {
    RUNTIME CONSTEXPR
    {
      RETURN CONSTEXPR_ALLOC#VIRTUAL_STORAGE();
    }
    ELSE
    {
      VAR addr ADDRESS := allocator_allocate_dynamic(
        @bytes size,
        @align align
      );
      RETURN BEGIN_ALLOC_REGION addr TO ->VIRTUAL_STORAGE;
    }
  }

  ::VIRTUAL_DEALLOC INCLUDE_IF(SAME_TYPES(T, VOID) && ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Releases virtual storage using its original size and alignment.
    $>
    FUNCTION(@PTR:ptr ->VIRTUAL_STORAGE, @SIZE:size SZ, @ALIGN:align SZ)
  {
    RUNTIME NATIVE
    {
      VAR addr ADDRESS := END_ALLOC_REGION ptr;
      allocator_deallocate_dynamic(
        @bytes size,
        @align align,
        @ptr addr
      );
    }
    ELSE
    {
      CONSTEXPR_DEALLOC#VIRTUAL_STORAGE(% [ptr]);
    }
  }
}

PRIVATE(MODULE) ::default_allocator_dealloc_multiple_count_test_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) UNIT_TEST
{
  VAR first ADDRESS := allocator_allocate_multiple(
    @size 1,
    @align 1,
    @count 8
  );
  allocator_deallocate_multiple(
    @size 1,
    @align 1,
    @ptr first,
    @count 8
  );

  VAR second ADDRESS := allocator_allocate_multiple(
    @size 4,
    @align 4,
    @count 2
  );
  ASSERT(second == first);
  allocator_deallocate_multiple(
    @size 4,
    @align 4,
    @ptr second,
    @count 2
  );
}

PRIVATE(MODULE) ::slab_allocator_thread_cache_reuse_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Verifies that one slab specialization reuses a block through an address
    cache without accessing the freed allocation payload.
    $>
  UNIT_TEST
{
  allocator_release_all_thread_caches();

  VAR first ADDRESS := slab_allocator#(@block_size 8, @block_align 8)::allocate();
  slab_allocator#(@block_size 8, @block_align 8)::release_thread_cache();

  slab_allocator#(@block_size 8, @block_align 8)::deallocate(@ptr first);
  ASSERT(
    slab_allocator#(@block_size 8, @block_align 8)::thread_cached_block_count()
      == 1
  );

  VAR second ADDRESS := slab_allocator#(@block_size 8, @block_align 8)::allocate();
  ASSERT(second == first);
  slab_allocator#(@block_size 8, @block_align 8)::deallocate(@ptr second);
  allocator_release_all_thread_caches();
}

PRIVATE(MODULE) ::slab_allocator_two_cache_transitions_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Exercises empty, half-full, and full secondary-cache transitions and the
    whole-cache handoff that occurs when both thread caches are full.
    $>
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR first ADDRESS := slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  VAR second ADDRESS := slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  VAR third ADDRESS := slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  VAR fourth ADDRESS := slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  VAR fifth ADDRESS := slab_allocator#(@block_size 8192, @block_align 4096)::allocate();
  slab_allocator#(@block_size 8192, @block_align 4096)::release_thread_cache();

  slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr first);
  slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr second);
  slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr third);
  slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr fourth);
  slab_allocator#(@block_size 8192, @block_align 4096)::deallocate(@ptr fifth);

  ASSERT(
    slab_allocator#(@block_size 8192, @block_align 4096)::thread_cached_block_count()
      == 3
  );
  allocator_release_all_thread_caches();
}

PRIVATE(MODULE) ::slab_allocator_twelve_byte_cache_transitions_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Exercises the count-84 cache transitions used by the 12-byte slab class.
    Addresses remain in the cache object's aligned ADDRESS array rather than
    being loaded from the four-byte-aligned allocation payloads.
    $>
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  ASSERT(
    slab_allocator#(@block_size 12, @block_align 4)::address_cache_count == 84
  );
  VAR blocks [169]ADDRESS;
  FOR VALUE(index) FROM(0 AS SZ) UNTIL(169 AS SZ) LOOP
  {
    blocks[index] := slab_allocator#(@block_size 12, @block_align 4)::allocate();
  };
  slab_allocator#(@block_size 12, @block_align 4)::release_thread_cache();
  FOR VALUE(index) FROM(0 AS SZ) UNTIL(169 AS SZ) LOOP
  {
    slab_allocator#(@block_size 12, @block_align 4)::deallocate(
      @ptr blocks[index]
    );
  };
  ASSERT(
    slab_allocator#(@block_size 12, @block_align 4)::thread_cached_block_count()
      == 85
  );
  allocator_release_all_thread_caches();
}

PRIVATE(MODULE) ::zero_count_allocations_are_unique_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Verifies that simultaneous zero-count allocations have unique addresses and
    that their alignment-compatible slab storage is reclaimed.
    $>
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR first ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  VAR second ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  ASSERT(first??);
  ASSERT(second??);
  ASSERT(first != second);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr first, @count 0);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr second, @count 0);
  VAR reused ADDRESS := allocator_allocate_multiple(@size 1, @align 1, @count 0);
  ASSERT(reused == second);
  allocator_deallocate_multiple(@size 1, @align 1, @ptr reused, @count 0);
  allocator_release_all_thread_caches();
}

PRIVATE(MODULE) ::multi_allocator_slab_and_large_boundary_unit_test
  INCLUDE_IF(ARCH_IS_LAYOUTLESS == FALSE) DOC <$
    Verifies that a multi allocation shares the final slab specialization with
    static allocation and that the next byte routes to the large allocator.
    $>
  UNIT_TEST
{
  allocator_release_all_thread_caches();
  VAR multi_address ADDRESS := allocator_allocate_multiple(
    @size 3,
    @align 1,
    @count 4096
  );
  slab_allocator#(@block_size 12288, @block_align 4096)::release_thread_cache();
  allocator_deallocate_multiple(
    @size 3,
    @align 1,
    @ptr multi_address,
    @count 4096
  );

  VAR static_address ADDRESS := allocator_allocate_static#(
    @size 12288,
    @align 4096
  )();
  ASSERT(static_address == multi_address);
  allocator_deallocate_static#(
    @size 12288,
    @align 4096
  )(@ptr static_address);

  VAR cached_blocks_before_large SZ :=
    slab_allocator#(@block_size 12288, @block_align 4096)::thread_cached_block_count();
  VAR large_address ADDRESS := allocator_allocate_static#(
    @size 12289,
    @align 4096
  )();
  ASSERT(large_address??);
  allocator_deallocate_static#(
    @size 12289,
    @align 4096
  )(@ptr large_address);
  ASSERT(
    slab_allocator#(@block_size 12288, @block_align 4096)::thread_cached_block_count()
      == cached_blocks_before_large
  );
  allocator_release_all_thread_caches();
}
