  large_allocator::deallocate(@size size, @align align, @ptr ptr);
}

PRIVATE(MODULE) ::allocator_allocate_dynamic DOC <$
  Routes a runtime layout to a compatible slab, falling back above 12 KiB.
  $>
  FUNCTION(@bytes SZ, @align SZ): ADDRESS
{
  allocator_validate_alignment(@align align);
  IF (bytes <= 8 && align <= 8) { RETURN slab_allocator#(@block_size 8, @block_align 8)::allocate(); }
  IF (bytes <= 12 && align <= 4) { RETURN slab_allocator#(@block_size 12, @block_align 4)::allocate(); }
  IF (bytes <= 16 && align <= 16) { RETURN slab_allocator#(@block_size 16, @block_align 16)::allocate(); }
  IF (bytes <= 24 && align <= 8) { RETURN slab_allocator#(@block_size 24, @block_align 8)::allocate(); }
  IF (bytes <= 32 && align <= 32) { RETURN slab_allocator#(@block_size 32, @block_align 32)::allocate(); }
  IF (bytes <= 48 && align <= 16) { RETURN slab_allocator#(@block_size 48, @block_align 16)::allocate(); }
  IF (bytes <= 64 && align <= 64) { RETURN slab_allocator#(@block_size 64, @block_align 64)::allocate(); }
  IF (bytes <= 96 && align <= 32) { RETURN slab_allocator#(@block_size 96, @block_align 32)::allocate(); }
  IF (bytes <= 128 && align <= 128) { RETURN slab_allocator#(@block_size 128, @block_align 128)::allocate(); }
  IF (bytes <= 192 && align <= 64) { RETURN slab_allocator#(@block_size 192, @block_align 64)::allocate(); }
  IF (bytes <= 256 && align <= 256) { RETURN slab_allocator#(@block_size 256, @block_align 256)::allocate(); }
  IF (bytes <= 384 && align <= 128) { RETURN slab_allocator#(@block_size 384, @block_align 128)::allocate(); }
  IF (bytes <= 512 && align <= 512) { RETURN slab_allocator#(@block_size 512, @block_align 512)::allocate(); }
  IF (bytes <= 768 && align <= 256) { RETURN slab_allocator#(@block_size 768, @block_align 256)::allocate(); }
  IF (bytes <= 1024 && align <= 1024) { RETURN slab_allocator#(@block_size 1024, @block_align 1024)::allocate(); }
  IF (bytes <= 1536 && align <= 512) { RETURN slab_allocator#(@block_size 1536, @block_align 512)::allocate(); }
  IF (bytes <= 2048 && align <= 2048) { RETURN slab_allocator#(@block_size 2048, @block_align 2048)::allocate(); }
  IF (bytes <= 3072 && align <= 1024) { RETURN slab_allocator#(@block_size 3072, @block_align 1024)::allocate(); }
  IF (bytes <= 4096 && align <= 4096) { RETURN slab_allocator#(@block_size 4096, @block_align 4096)::allocate(); }
  IF (bytes <= 6144 && align <= 2048) { RETURN slab_allocator#(@block_size 6144, @block_align 2048)::allocate(); }
  IF (bytes <= 8192 && align <= 4096) { RETURN slab_allocator#(@block_size 8192, @block_align 4096)::allocate(); }
  IF (bytes <= allocator_slab_maximum_block_size && align <= 4096)
  {
    RETURN slab_allocator#(@block_size 12288, @block_align 4096)::allocate();
  }
  RETURN large_allocator::allocate(@size bytes, @align align);
}

PRIVATE(MODULE) ::allocator_deallocate_dynamic DOC <$
  Returns a runtime layout through the same slab-or-large routing decision.
  $>
  FUNCTION(@bytes SZ, @align SZ, @ptr ADDRESS)
{
  allocator_validate_alignment(@align align);
  IF (bytes <= 8 && align <= 8)
  {
    slab_allocator#(@block_size 8, @block_align 8)::deallocate(@ptr ptr);
