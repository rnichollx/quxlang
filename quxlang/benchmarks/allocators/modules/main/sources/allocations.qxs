LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::benchmark_barrier NAMESPACE
{
  DOC <$ Writes one payload word without exposing the implementation to optimization. $>
  ::write_word
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(@address ADDRESS, @value U64)
  {
    STR X1, [X0]
    RET
  }
  ::write_word INCLUDE_IF(OS_LINUX)
    ASM_PROCEDURE X64 CALLABLE CALLCONV CCALL(@address ADDRESS, @value U64)
  {
    MOV QWORD PTR [RDI], RSI
    RET
  }
  DOC <$ Writes one byte at the allocation address and makes it observable. $>
  ::write_byte
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(@ARG ADDRESS)
  {
    MOV W1, 1
    STRB W1, [X0]
    RET
  }
  DOC <$ Reads the architecture timer with instruction ordering barriers. $>
  ::ticks
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(; RETURN U64)
  {
    ISB
    MRS X0, CNTVCT_EL0
    ISB
    RET
  }
  // Keeps an allocation address observable to the optimizer.
  ::do_not_optimize
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(@ARG ADDRESS)
  {
    RET
  }
  ::do_not_optimize
    ASM_PROCEDURE X64 CALLABLE CALLCONV CCALL(@ARG ADDRESS)
  {
    RET
  }

  DOC <$ Returns the architecture timer frequency in ticks per second. $>
  ::frequency
    ASM_PROCEDURE ARM64 CALLABLE CALLCONV CCALL(; RETURN U64)
  {
    MRS X0, CNTFRQ_EL0
    RET
  }

  DOC <$ The Linux x64 procedure writes one byte at the allocation address. $>
  ::write_byte INCLUDE_IF(OS_LINUX)
    ASM_PROCEDURE X64 CALLABLE CALLCONV CCALL(@ARG ADDRESS)
  {
    MOV BYTE PTR [RDI], 1
    RET
  }

  DOC <$ The Linux x64 timer returns a monotonic timestamp in nanoseconds. $>
  ::ticks INCLUDE_IF(ARCH_IS_X64 && OS_LINUX) FUNCTION(): U64
  {
    RETURN RUNTIME_MODULE::BENCHMARK_CLOCK();
  }

  DOC <$ The Linux x64 timer frequency is one billion ticks per second. $>
  ::frequency INCLUDE_IF(ARCH_IS_X64 && OS_LINUX) FUNCTION(): U64
  {
    RETURN 1000000000;
  }

}

::allocation_workload TEMPLATE(@bytes VALUE SZ) STRUCT
{
  ::block STRUCT { .words VAR [bytes / 8]U64; }

  ::allocate_batches FUNCTION(@n SZ, @batch SZ)
  {
    VAR pointers [20]->TYPED_STORAGE(block);
    LOOP INIT { VAR completed SZ := 0; } WHILE (completed < n) DO
    {
      VAR count SZ := batch;
      IF (count > n - completed) { count := n - completed; }
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
      {
        VAR pointer ->TYPED_STORAGE(block) := RUNTIME_MODULE::DEFAULT_ALLOCATOR#(block)::ALLOC();
        pointers[index] := pointer;
      }
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
      {
        benchmark_barrier::do_not_optimize(IBC_GETADDR(@PTR pointers[index]));
      }
      LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
      {
        RUNTIME_MODULE::DEFAULT_ALLOCATOR#(block)::DEALLOC(@PTR pointers[index]);
      }
      completed += count;
    }
  }

  DOC <$ Coordinates warmed workers and delays thread teardown until timing ends. $>
  ::parallel_state STRUCT ROOTED
  {
    .mutex VAR std::ordering_mutex;
    .condition VAR std::condition_variable;
    .progress VAR std::condition_variable;
    .n VAR SZ;
    .batch VAR SZ;
    .ready VAR SZ;
    .finished VAR SZ;
    .start VAR BOOL;
    .release VAR BOOL;
    .last_finish VAR U64;
  }

  DOC <$ Executes allocation batches with private pointers on one native thread. $>
  ::worker STRUCT
  {
    .state VAR MUT->parallel_state;

    .OPERATOR() FUNCTION()
    {
      VAR state MUT& parallel_state := .state->;
      allocate_batches(@n 10000, @batch state.batch);
      state.mutex.lock();
      state.ready++;
      state.progress.notify_one();
      LOOP WHILE (state.start == FALSE) DO
      { state.condition.wait(@locked_mutex state.mutex); }
      state.mutex.unlock();
      allocate_batches(@n state.n, @batch state.batch);
      VAR finish U64 := benchmark_barrier::ticks();
      state.mutex.lock();
      IF (finish > state.last_finish) { state.last_finish := finish; }
      state.finished++;
      state.progress.notify_one();
      LOOP WHILE (state.release == FALSE) DO
      { state.condition.wait(@locked_mutex state.mutex); }
      state.mutex.unlock();
    }
  }

  DOC <$ The parallel workload measures the requested warmed workers through the final allocation batch. $>
  ::run_parallel
    FUNCTION(@n SZ, @batch SZ, @threads SZ): U64
  {
    VAR state parallel_state;
    state.n := n;
    state.batch := batch;
    VAR workers [128]TYPED_STORAGE(std::thread);
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(threads) DO
    {
      VAR entry worker;
      entry.state := state<-;
      PLACE AT(workers[index]) std::thread :(entry);
    }
    state.mutex.lock();
    LOOP WHILE (state.ready != threads) DO
    { state.progress.wait(@locked_mutex state.mutex); }
    VAR start U64 := benchmark_barrier::ticks();
    state.start := TRUE;
    state.condition.notify_all();
    LOOP WHILE (state.finished != threads) DO
    { state.progress.wait(@locked_mutex state.mutex); }
    VAR elapsed U64 := state.last_finish - start;
    state.release := TRUE;
    state.condition.notify_all();
    state.mutex.unlock();
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(threads) DO
    {
      (PUN workers[index] AS std::thread).join();
      DESTROY AT(workers[index]) std::thread;
    }
    RETURN elapsed;
  }

  ::run FUNCTION(@n SZ, @batch SZ, @threads SZ)
  {
    VAR elapsed U64;
    IF (threads > 1)
    { elapsed := run_parallel(@n n, @batch batch, @threads threads); }
    ELSE
    {
      VAR start U64 := benchmark_barrier::ticks();
      allocate_batches(@n n, @batch batch);
      elapsed := benchmark_barrier::ticks() - start;
    }
    VAR output std::buffered_writer :(@EXPLICIT std::standard_output());
    output.write_unsigned(elapsed); output.write_byte(32);
    output.write_unsigned(benchmark_barrier::frequency());
    output.write_byte(10); output.flush();
  }
}

::allocations BENCHMARK(@n SZ, @size SZ, @batch SZ, @threads SZ) ONESHOT
{
  IF (n == 0 || batch == 0 || batch > 20 || (threads == 0 || threads > 128)) { THROW (1 AS I32); }
  IF (size == 8) { allocation_workload#(@bytes 8)::run(@n n, @batch batch, @threads threads); }
  ELSE IF (size == 16) { allocation_workload#(@bytes 16)::run(@n n, @batch batch, @threads threads); }
  ELSE IF (size == 24) { allocation_workload#(@bytes 24)::run(@n n, @batch batch, @threads threads); }
  ELSE IF (size == 32) { allocation_workload#(@bytes 32)::run(@n n, @batch batch, @threads threads); }
  ELSE IF (size == 64) { allocation_workload#(@bytes 64)::run(@n n, @batch batch, @threads threads); }
  ELSE { THROW (1 AS I32); }
}
