// This Quxlang implementation was ported from the original Benchmarks Game
// source nbody-gpp-9:
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/program/nbody-gpp-9.html

// The original C++ implementation was contributed by Martin Jambrek.
// That implementation was based on Java #2 by Mark C. Lewis, with modifications
// by Chad Whipkey.

LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::n_body_fast_implementation TEMPLATE(@alignment VALUE SZ) STRUCT
{
  ::body STRUCT ALIGN(alignment)
  {
    .x VAR F64;
    .y VAR F64;
    .z VAR F64;
    .pad0 VAR F64;
    .vx VAR F64;
    .vy VAR F64;
    .vz VAR F64;
    .pad1 VAR F64;
    .mass VAR F64;
  }

  ::advance FUNCTION(@bodies MUT& [5]body, @dt F64)
  {
    {
      STATIC_VAR i SZ := 0 AS SZ;
      STATIC_WHILE (i < 5)
      {
        {
          STATIC_VAR j SZ := i + 1;
          STATIC_WHILE (j < 5)
          {
            VAR dx F64 := bodies[SNAPSHOT(i)].x - bodies[SNAPSHOT(j)].x;
            VAR dy F64 := bodies[SNAPSHOT(i)].y - bodies[SNAPSHOT(j)].y;
            VAR dz F64 := bodies[SNAPSHOT(i)].z - bodies[SNAPSHOT(j)].z;
            VAR squared F64 := ((dx * dx) + (dy * dy)) + (dz * dz);
            VAR magnitude F64 := dt / (squared * SQRT(squared));
            bodies[SNAPSHOT(i)].vx -= (dx * bodies[SNAPSHOT(j)].mass) * magnitude;
            bodies[SNAPSHOT(i)].vy -= (dy * bodies[SNAPSHOT(j)].mass) * magnitude;
            bodies[SNAPSHOT(i)].vz -= (dz * bodies[SNAPSHOT(j)].mass) * magnitude;
            bodies[SNAPSHOT(j)].vx += (dx * bodies[SNAPSHOT(i)].mass) * magnitude;
            bodies[SNAPSHOT(j)].vy += (dy * bodies[SNAPSHOT(i)].mass) * magnitude;
            bodies[SNAPSHOT(j)].vz += (dz * bodies[SNAPSHOT(i)].mass) * magnitude;
            STATIC_EVAL j++;
          }
        }
        STATIC_EVAL i++;
      }
    }
    {
      STATIC_VAR i SZ := 0 AS SZ;
      STATIC_WHILE (i < 5)
      {
        bodies[SNAPSHOT(i)].x += dt * bodies[SNAPSHOT(i)].vx;
        bodies[SNAPSHOT(i)].y += dt * bodies[SNAPSHOT(i)].vy;
        bodies[SNAPSHOT(i)].z += dt * bodies[SNAPSHOT(i)].vz;
        STATIC_EVAL i++;
      }
    }
  }

  ::energy FUNCTION(@ARG:bodies CONST& [5]body): F64
  {
    VAR result F64 := 0.0;
    {
      STATIC_VAR i SZ := 0 AS SZ;
      STATIC_WHILE (i < 5)
      {
        VAR speed_squared F64 := ((bodies[SNAPSHOT(i)].vx * bodies[SNAPSHOT(i)].vx) + (bodies[SNAPSHOT(i)].vy * bodies[SNAPSHOT(i)].vy)) + (bodies[SNAPSHOT(i)].vz * bodies[SNAPSHOT(i)].vz);
        result += (0.5 * bodies[SNAPSHOT(i)].mass) * speed_squared;
        {
          STATIC_VAR j SZ := i + 1;
          STATIC_WHILE (j < 5)
          {
            VAR dx F64 := bodies[SNAPSHOT(i)].x - bodies[SNAPSHOT(j)].x;
            VAR dy F64 := bodies[SNAPSHOT(i)].y - bodies[SNAPSHOT(j)].y;
            VAR dz F64 := bodies[SNAPSHOT(i)].z - bodies[SNAPSHOT(j)].z;
            VAR distance F64 := SQRT(((dx * dx) + (dy * dy)) + (dz * dz));
            result -= (bodies[SNAPSHOT(i)].mass * bodies[SNAPSHOT(j)].mass) / distance;
            STATIC_EVAL j++;
          }
        }
        STATIC_EVAL i++;
      }
    }
    RETURN result;
  }

  ::initialize_bodies FUNCTION(@ARG:bodies MUT& [5]body)
  {
    VAR pi F64 := 3.141592653589793 AS APPROXIMATE F64;
    VAR solar F64 := (4.0 * pi) * pi;
    VAR year F64 := 365.24 AS APPROXIMATE F64;
    bodies[0].mass := solar;
    bodies[1].x := (4.84143144246472090 AS APPROXIMATE F64);
    bodies[1].y := (-1.16032004402742839 AS APPROXIMATE F64);
    bodies[1].z := (-0.103622044471123109 AS APPROXIMATE F64);
    bodies[1].vx := (0.00166007664274403694 AS APPROXIMATE F64) * year;
    bodies[1].vy := (0.00769901118419740425 AS APPROXIMATE F64) * year;
    bodies[1].vz := (-0.0000690460016972063023 AS APPROXIMATE F64) * year;
    bodies[1].mass := (0.000954791938424326609 AS APPROXIMATE F64) * solar;
    bodies[2].x := (8.34336671824457987 AS APPROXIMATE F64);
    bodies[2].y := (4.12479856412430479 AS APPROXIMATE F64);
    bodies[2].z := (-0.403523417114321381 AS APPROXIMATE F64);
    bodies[2].vx := (-0.00276742510726862411 AS APPROXIMATE F64) * year;
    bodies[2].vy := (0.00499852801234917238 AS APPROXIMATE F64) * year;
    bodies[2].vz := (0.0000230417297573763929 AS APPROXIMATE F64) * year;
    bodies[2].mass := (0.000285885980666130812 AS APPROXIMATE F64) * solar;
    bodies[3].x := (12.8943695621391310 AS APPROXIMATE F64);
    bodies[3].y := (-15.1111514016986312 AS APPROXIMATE F64);
    bodies[3].z := (-0.223307578892655734 AS APPROXIMATE F64);
    bodies[3].vx := (0.00296460137564761618 AS APPROXIMATE F64) * year;
    bodies[3].vy := (0.00237847173959480950 AS APPROXIMATE F64) * year;
    bodies[3].vz := (-0.0000296589568540237556 AS APPROXIMATE F64) * year;
    bodies[3].mass := (0.0000436624404335156298 AS APPROXIMATE F64) * solar;
    bodies[4].x := (15.3796971148509165 AS APPROXIMATE F64);
    bodies[4].y := (-25.9193146099879641 AS APPROXIMATE F64);
    bodies[4].z := (0.179258772950371181 AS APPROXIMATE F64);
    bodies[4].vx := (0.00268067772490389322 AS APPROXIMATE F64) * year;
    bodies[4].vy := (0.00162824170038242295 AS APPROXIMATE F64) * year;
    bodies[4].vz := (-0.0000951592254519715870 AS APPROXIMATE F64) * year;
    bodies[4].mass := (0.0000515138902046611451 AS APPROXIMATE F64) * solar;
  }


  ::run FUNCTION(@ARG:n SZ)
  {
    VAR bodies [5]body;
    initialize_bodies(bodies);
    VAR px F64 := 0.0;
    VAR py F64 := 0.0;
    VAR pz F64 := 0.0;
    {
      STATIC_VAR i SZ := 0 AS SZ;
      STATIC_WHILE (i < 5)
      {
        px += bodies[SNAPSHOT(i)].vx * bodies[SNAPSHOT(i)].mass;
        py += bodies[SNAPSHOT(i)].vy * bodies[SNAPSHOT(i)].mass;
        pz += bodies[SNAPSHOT(i)].vz * bodies[SNAPSHOT(i)].mass;
        STATIC_EVAL i++;
      }
    }
    bodies[0].vx := (-1.0 * px) / bodies[0].mass;
    bodies[0].vy := (-1.0 * py) / bodies[0].mass;
    bodies[0].vz := (-1.0 * pz) / bodies[0].mass;
    VAR output std::buffered_writer :(@EXPLICIT std::standard_output());
    output.write_fixed(@value energy(bodies), @precision 9);
    output.write("\n");
    LOOP VALUE(iteration) FROM(0 AS SZ) UNTIL(n) DO
    { advance(@bodies bodies, @dt 0.01 AS APPROXIMATE F64); }
    output.write_fixed(@value energy(bodies), @precision 9);
    output.write("\n");
    output.flush();
  }

}

::n_body_fast BENCHMARK(@n SZ) ONESHOT
{
  n_body_fast_implementation#(@alignment 32)::run(n);
}

::n_body_fast_natural BENCHMARK(@n SZ) ONESHOT
{
  n_body_fast_implementation#(@alignment 1)::run(n);
}

::n_body_fast_align64 BENCHMARK(@n SZ) ONESHOT
{
  n_body_fast_implementation#(@alignment 64)::run(n);
}
