// This Quxlang implementation was ported from the original Benchmarks Game
// source mandelbrot-gpp-5:
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/program/mandelbrot-gpp-5.html

// The original C++ implementation was contributed by Elam Kolenovic.

IMPORT std;

::mandelbrot_fast BENCHMARK(@n SZ) ONESHOT
{
  IF (n == 0 || n % 8 != 0) { THROW (1 AS I32); }
  VAR output std::buffered_writer :(@EXPLICIT std::standard_output());
  output.write("P4\n"); output.write_unsigned(n AS U64); output.write(" ");
  output.write_unsigned(n AS U64); output.write("\n");
  LOOP VALUE(y) FROM(0 AS SZ) UNTIL(n) DO
  {
    VAR imaginary_origin F64 := ((2.0 * (y AS APPROXIMATE F64)) / (n AS APPROXIMATE F64)) - 1.0;
    LOOP VALUE(x) FROM(0 AS SZ) UNTIL(n / 8) DO
    {
      VAR origin [8]F64;
      VAR real [8]F64;
      VAR imaginary [8]F64;
      LOOP VALUE(lane) FROM(0 AS SZ) UNTIL(8) DO
      {
        origin[lane] := ((2.0 * ((8 * x + lane) AS APPROXIMATE F64)) / (n AS APPROXIMATE F64)) - 1.5;
        real[lane] := origin[lane]; imaginary[lane] := imaginary_origin;
      }
      VAR bits U8 := 0;
      LOOP VALUE(iteration) FROM(0 AS SZ) UNTIL(50) DO
      {
        IF (bits == 255) { BREAK; }
        LOOP VALUE(lane) FROM(0 AS SZ) UNTIL(8) DO
        {
          VAR mask U8 := (1 AS U8) #++ (7 - lane);
          IF ((bits #&& mask) == 0)
          {
            VAR r F64 := real[lane]; VAR i F64 := imaginary[lane];
            VAR rr F64 := r * r; VAR ii F64 := i * i;
            real[lane] := rr - ii + origin[lane];
            imaginary[lane] := 2.0 * r * i + imaginary_origin;
            IF (rr + ii > 4.0) { bits := bits #|| mask; }
          }
        }
      }
      output.write_byte((bits #!!) AS BYTE);
    }
  }
  output.flush();
}
